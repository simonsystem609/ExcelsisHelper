Const swThisConfiguration As Long = 1
Const swSuppressFeature As Long = 0
Const swUnSuppressFeature As Long = 2

#If VBA7 Then
Private Declare PtrSafe Function ExcelsisGetCurrentProcessId Lib "kernel32" Alias "GetCurrentProcessId" () As Long
Private Declare PtrSafe Function DxfGetAsyncKeyState Lib "user32" Alias "GetAsyncKeyState" (ByVal key As Long) As Integer
