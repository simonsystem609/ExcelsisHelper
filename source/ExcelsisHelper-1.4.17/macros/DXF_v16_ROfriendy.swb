#End If

Private gExcelsisMacroMarkerOwned As Boolean
Private gExcelsisMacroMarkerPayload As String
Private gExcelsisMacroSettingsLoaded As Boolean
Private gExcelsisMacroSettingsJson As String
Private gExcelsisMacroSettingsReadError As String

Private Function ExcelsisMacroRoot() As String
    ExcelsisMacroRoot = CreateObject("WScript.Shell").SpecialFolders("MyDocuments") & "\Excelsis Helper"
End Function

Private Function ExcelsisReadUtf8Text(ByVal filePath As String) As String
    Dim stream As Object
    On Error GoTo ReadFailed
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 2
    stream.Charset = "utf-8"
    stream.Open
    stream.LoadFromFile filePath
    ExcelsisReadUtf8Text = stream.ReadText(-1)
    stream.Close
    Exit Function
ReadFailed:
    gExcelsisMacroSettingsReadError = Err.Description
    On Error Resume Next
    If Not stream Is Nothing Then stream.Close
    On Error GoTo 0
End Function

Private Sub ExcelsisResetMacroSettings()
    ' SOLIDWORKS can keep the VBA module loaded between runs.
    gExcelsisMacroSettingsLoaded = False
    gExcelsisMacroSettingsJson = ""
    gExcelsisMacroSettingsReadError = ""
End Sub

Private Function ExcelsisJsonStringValue(ByVal jsonText As String, ByVal settingName As String, ByVal fallbackValue As String) As String
    Dim keyPos As Long
    Dim colonPos As Long
    Dim quotePos As Long
    Dim pos As Long
    Dim ch As String
    Dim escapedChar As String
    Dim value As String
    On Error GoTo UseFallback
    keyPos = InStr(1, jsonText, """" & settingName & """", vbTextCompare)
    If keyPos = 0 Then GoTo UseFallback
    colonPos = InStr(keyPos + Len(settingName) + 2, jsonText, ":")
    If colonPos = 0 Then GoTo UseFallback
    quotePos = InStr(colonPos + 1, jsonText, """")
    If quotePos = 0 Then GoTo UseFallback
    pos = quotePos + 1
    Do While pos <= Len(jsonText)
        ch = Mid$(jsonText, pos, 1)
        If ch = """" Then
            ExcelsisJsonStringValue = value
            Exit Function
        End If
        If ch = "\" Then
            pos = pos + 1
            If pos > Len(jsonText) Then GoTo UseFallback
            escapedChar = Mid$(jsonText, pos, 1)
            Select Case escapedChar
                Case """", "\", "/": value = value & escapedChar
                Case "b": value = value & Chr$(8)
                Case "f": value = value & Chr$(12)
                Case "n": value = value & vbLf
                Case "r": value = value & vbCr
                Case "t": value = value & vbTab
                Case Else: value = value & escapedChar
            End Select
        Else
            value = value & ch
        End If
        pos = pos + 1
    Loop
UseFallback:
    ExcelsisJsonStringValue = fallbackValue
End Function

Private Function ExcelsisMacroSetting(ByVal settingName As String, ByVal fallbackValue As String) As String
    If Not gExcelsisMacroSettingsLoaded Then
        gExcelsisMacroSettingsLoaded = True
        gExcelsisMacroSettingsJson = ExcelsisReadUtf8Text(ExcelsisMacroRoot() & "\Macros\macro-settings.json")
        If Len(Trim$(gExcelsisMacroSettingsJson)) = 0 Then
            MsgBox "Helper macro settings could not be read. Built-in defaults will be used." & vbCrLf & _
                   ExcelsisMacroRoot() & "\Macros\macro-settings.json" & vbCrLf & _
                   gExcelsisMacroSettingsReadError & vbCrLf & _
                   "Check folder access and save Settings in Helper again.", vbExclamation, "Macro settings"
        End If
    End If
    ExcelsisMacroSetting = ExcelsisJsonStringValue(gExcelsisMacroSettingsJson, settingName, fallbackValue)
End Function

Private Function ConfiguredDefaultMaterial() As String
    ConfiguredDefaultMaterial = ExcelsisMacroSetting("defaultMaterial", DEFAULT_MATERIAL)
End Function

Private Function ConfiguredDxfOutputPrefix() As String
    ConfiguredDxfOutputPrefix = ExcelsisMacroSetting("dxfOutputPrefix", DXF_OUTPUT_PREFIX)
End Function

Private Sub ExcelsisStartMacroRunMarker()
    Dim fso As Object
    Dim markerFile As Object
    Dim root As String
    On Error GoTo Failed
    root = ExcelsisMacroRoot()
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FolderExists(root) Then fso.CreateFolder root
    gExcelsisMacroMarkerPayload = "{""schema"":""excelsis-helper-macro-run-v1"",""pid"":" & _
        CStr(ExcelsisGetCurrentProcessId()) & ",""startedAt"":""" & _
        Format$(Now, "yyyy-mm-dd\Thh:nn:ss") & """,""macroName"":""DXF_v16_ROfriendy.swp""}"
    Set markerFile = fso.CreateTextFile(root & "\macro-running.json", True, False)
    markerFile.Write gExcelsisMacroMarkerPayload
    markerFile.Close
    gExcelsisMacroMarkerOwned = True
    Exit Sub
Failed:
    gExcelsisMacroMarkerOwned = False
End Sub

Private Sub ExcelsisStopMacroRunMarker()
    Dim fso As Object
    Dim markerFile As Object
    Dim markerPath As String
    Dim currentPayload As String
    If Not gExcelsisMacroMarkerOwned Then Exit Sub
    gExcelsisMacroMarkerOwned = False
    On Error GoTo Done
    markerPath = ExcelsisMacroRoot() & "\macro-running.json"
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FileExists(markerPath) Then Exit Sub
    Set markerFile = fso.OpenTextFile(markerPath, 1, False)
    currentPayload = markerFile.ReadAll
    markerFile.Close
    If currentPayload = gExcelsisMacroMarkerPayload Then fso.DeleteFile markerPath, True
Done:
End Sub

Function TraceFileLabel(filePath As String) As String

    Dim slashPos As Long

    slashPos = InStrRev(filePath, "\")

    If slashPos > 0 Then

        TraceFileLabel = Mid$(filePath, slashPos + 1)

    Else

        TraceFileLabel = filePath

    End If

    TraceFileLabel = Replace$(TraceFileLabel, vbCr, " ")
    TraceFileLabel = Replace$(TraceFileLabel, vbLf, " ")

End Function

Sub TraceRun(message As String)
    Dim fileNo As Integer, traceLine As String, target As Variant
    If g_tracePath = "" Then Exit Sub
    traceLine = Format$(Now, "yyyy-mm-dd hh:nn:ss") & " " & DiagnosticLineValue(message)
    If g_traceComponent <> "" Then traceLine = traceLine & " | candidate=" & DiagnosticLineValue(g_traceComponent)
    If InStr(1, message, "reject=", vbTextCompare) > 0 Or _
       InStr(1, message, "skip=", vbTextCompare) > 0 Then g_candidateReason = DiagnosticLineValue(message)
    On Error Resume Next
    For Each target In Array(g_tracePath, g_archiveTracePath)
        If CStr(target) <> "" Then
            fileNo = FreeFile
            Open CStr(target) For Append As #fileNo
            Print #fileNo, traceLine
            Close #fileNo
        End If
    Next target
    On Error GoTo 0
End Sub

Sub BeginDxfCandidate(partPath As String, cfg As String, route As String)
    g_traceComponent = partPath & "@" & cfg
    g_candidateKey = LCase$(partPath) & "@" & cfg
    g_candidateReason = ""
    g_candidateExisting = False
    g_importHint = ""
    If g_candidateResults Is Nothing Then Set g_candidateResults = CreateObject("Scripting.Dictionary")
    g_candidateResults(g_candidateKey) = "PENDING"
    TraceRun "candidate-begin route=" & route & " requested-configuration=" & DiagnosticLineValue(cfg)
End Sub

Sub FinishDxfCandidate(ByVal exported As Boolean)
    If g_candidateKey = "" Then Exit Sub
    Dim result As String
    If exported Then
        result = "EXPORTED"
        If g_candidateExisting Then result = "EXISTS"
    Else
        If g_candidateReason = "" Then g_candidateReason = "No verified output; see export API results above."
        result = "NOT-EXPORTED " & g_candidateReason
    End If
    g_candidateResults(g_candidateKey) = result
    TraceRun "candidate-end result=" & result
    g_candidateKey = ""
End Sub

Sub TraceCandidateSummary()
    Dim key As Variant, exported As Long, existing As Long, remaining As Long
    If g_candidateResults Is Nothing Then Exit Sub
    For Each key In g_candidateResults.Keys
        If CStr(g_candidateResults(key)) = "EXPORTED" Then
            exported = exported + 1
        ElseIf CStr(g_candidateResults(key)) = "EXISTS" Then
            existing = existing + 1
        Else
            remaining = remaining + 1
            TraceRun "review candidate=" & CStr(key) & " result=" & CStr(g_candidateResults(key))
        End If
    Next key
    TraceRun "coverage unique-candidates=" & CStr(g_candidateResults.Count) & _
             " exported=" & CStr(exported) & " existing=" & CStr(existing) & " skipped-or-failed=" & CStr(remaining)
End Sub

Function VerifyDxfOutput(ByVal apiOK As Boolean, ByVal filePath As String) As Boolean
    Dim fso As Object, bytes As Double
    On Error GoTo Failed
    Set fso = CreateObject("Scripting.FileSystemObject")
    If fso.FileExists(filePath) Then bytes = CDbl(fso.GetFile(filePath).Size)
    VerifyDxfOutput = (apiOK And bytes > 0#)
    TraceRun "output api-ok=" & CStr(apiOK) & " bytes=" & CStr(bytes) & _
             " verified=" & CStr(VerifyDxfOutput) & " path=" & DiagnosticLineValue(filePath)
    Exit Function
Failed:
    TraceRun "output reject=verification-failed error=" & CStr(Err.Number) & " path=" & DiagnosticLineValue(filePath)
End Function

Function ClaimDxfOutput(ByVal filePath As String, ByVal partPath As String, ByVal cfg As String) As String
    Dim key As String, owner As String, base As String, index As Long
    owner = LCase$(partPath) & vbTab & cfg
    Dim ambiguous As Boolean, nameKey As String
    ambiguous = g_forceIdentityTags
    nameKey = DxfPartNameKey(partPath, cfg)
    If Not g_partNameOwners Is Nothing Then
        If g_partNameOwners.Exists(nameKey) Then ambiguous = ambiguous Or (CStr(g_partNameOwners(nameKey)) = "*")
    End If
    If ambiguous Then filePath = Left$(filePath, Len(filePath) - 4) & "_" & DxfIdentityTag(owner) & ".dxf"
    If g_outputOwners Is Nothing Then Set g_outputOwners = CreateObject("Scripting.Dictionary")
    base = Left$(filePath, Len(filePath) - 4)
    key = LCase$(filePath)
    index = 1
    Do While g_outputOwners.Exists(key)
        If CStr(g_outputOwners(key)) = owner Then Exit Do
        index = index + 1
        filePath = base & "_variant" & CStr(index) & ".dxf"
        key = LCase$(filePath)
    Loop
    g_outputOwners(key) = owner
    If index > 1 Then TraceRun "output filename-collision disambiguated=" & DiagnosticLineValue(filePath)
    ClaimDxfOutput = filePath
End Function

Private Function DiagnosticLineValue(ByVal value As String) As String

    DiagnosticLineValue = Replace$(Replace$(Replace$(CStr(value), vbCr, " "), vbLf, " "), vbTab, " ")

End Function

Private Sub WriteDxfRunResult(ByVal status As String, ByVal errorNumber As Long, _
                              ByVal errorSource As String, ByVal errorDescription As String)

    Dim fileNo As Integer

    On Error Resume Next

    If g_resultPath = "" Then g_resultPath = Environ$("TEMP") & "\Excelsis_DXF_last_result.txt"

    fileNo = FreeFile

    Open g_resultPath For Output As #fileNo
    Print #fileNo, "schema=excelsis-dxf-result-v1"
    Print #fileNo, "status=" & UCase$(Trim$(status))
    Print #fileNo, "timestamp=" & Format$(Now, "yyyy-mm-dd hh:nn:ss")
    Print #fileNo, "errorNumber=" & CStr(errorNumber)
    Print #fileNo, "errorSource=" & DiagnosticLineValue(errorSource)
    Print #fileNo, "errorDescription=" & DiagnosticLineValue(errorDescription)
    Print #fileNo, "tracePath=" & DiagnosticLineValue(g_tracePath)
    Print #fileNo, "archiveTracePath=" & DiagnosticLineValue(g_archiveTracePath)
    Print #fileNo, "component=" & DiagnosticLineValue(g_traceComponent)
    Close #fileNo

    On Error GoTo 0

End Sub

Private Sub InitializeRunDiagnostics()
    Dim fileNo As Integer, fso As Object, stem As String, index As Long
    g_tracePath = Environ$("TEMP") & "\Excelsis_DXF_last_run.log"
    g_resultPath = Environ$("TEMP") & "\Excelsis_DXF_last_result.txt"
    g_traceComponent = "": g_candidateKey = "": g_candidateReason = ""
    Set g_importComponent = Nothing
    Set g_initiallyVisibleDocuments = Nothing
    Set g_candidateOwnership = CreateObject("Scripting.Dictionary")
    g_stopBatchReason = ""
    g_userCancelled = False
    Set g_preflightToolbox = CreateObject("Scripting.Dictionary")
    Set g_preflightRejected = CreateObject("Scripting.Dictionary")
    g_missingOnly = True: g_assemblyFolders = False
    g_candidateExisting = False: g_existingCount = 0
    g_runRootPath = "": g_runRootConfiguration = ""
    Set g_partNameOwners = CreateObject("Scripting.Dictionary")
    Set g_folderNameOwners = CreateObject("Scripting.Dictionary")
    g_forceIdentityTags = False
    Set g_outputOwners = CreateObject("Scripting.Dictionary")
    Set g_originalConfigurations = CreateObject("Scripting.Dictionary")
    Set g_candidateResults = CreateObject("Scripting.Dictionary")
    Set fso = CreateObject("Scripting.FileSystemObject")
    stem = Environ$("TEMP") & "\Excelsis_DXF_" & Format$(Now, "yyyymmdd-hhnnss") & "_" & CStr(ExcelsisGetCurrentProcessId())
    g_archiveTracePath = stem & ".log"
    Do While fso.FileExists(g_archiveTracePath)
        index = index + 1
        g_archiveTracePath = stem & "_" & CStr(index) & ".log"
    Loop
    On Error Resume Next
    fileNo = FreeFile
    Open g_tracePath For Output As #fileNo
    Print #fileNo, "Excelsis DXF trace"
    Close #fileNo
    On Error GoTo 0
    TraceRun "run-start revision=" & DXF_FILTER_REVISION & " archive=" & g_archiveTracePath
    TraceRun "limits thickness-mm=" & CStr(THICKNESS_LIMIT) & " plate-ratio=" & CStr(THIN_PLATE_MIN_RATIO) & _
             " planar-area=" & CStr(MIN_PLANAR_AREA_RATIO) & " footprint-area=" & CStr(MIN_LARGEST_PLANAR_FOOTPRINT_RATIO) & _
             " washer-length-mm=" & CStr(WASHERLIKE_MAX_LONG_MM) & " washer-ratio=" & CStr(WASHERLIKE_MAX_WIDTH_THICKNESS_RATIO) & _
             " washer-aspect=" & CStr(WASHERLIKE_MIN_ASPECT)
    WriteDxfRunResult "RUNNING", 0, "", ""
End Sub

Sub InitializeRunTrace(swModel As Object)

    If g_tracePath = "" Then InitializeRunDiagnostics

    TraceRun "root=" & GetDocumentActivationName(swModel)

End Sub


' ================================================================

Sub main()
    Dim errorNumber As Long
    Dim errorSource As String
    Dim errorDescription As String
    Dim errorHelpFile As String
    Dim errorHelpContext As Long
    On Error GoTo MacroFailed
    ExcelsisResetMacroSettings
    InitializeRunDiagnostics
    ExcelsisStartMacroRunMarker
    ExcelsisMacroMain
    If g_userCancelled Then
        WriteDxfRunResult "CANCELLED", 0, "", "Stopped by user; completed DXFs were kept."
    Else
        WriteDxfRunResult "OK", 0, "", ""
    End If
    ExcelsisStopMacroRunMarker
    Exit Sub
MacroFailed:
    errorNumber = Err.Number
    errorSource = Err.Source
    errorDescription = Err.Description
    errorHelpFile = Err.HelpFile
    errorHelpContext = Err.HelpContext
    On Error Resume Next
    TraceRun "ERROR number=" & CStr(errorNumber) & _
             " source=" & DiagnosticLineValue(errorSource) & _
             " description=" & DiagnosticLineValue(errorDescription)
    If g_traceComponent <> "" Then TraceRun "ERROR component=" & DiagnosticLineValue(g_traceComponent)
    TraceCandidateSummary
    RestoreOriginalConfigurations
    WriteDxfRunResult "ERROR", errorNumber, errorSource, errorDescription
    ExcelsisStopMacroRunMarker
    MsgBox "DXF export failed." & vbCrLf & _
           "Error " & CStr(errorNumber) & ": " & DiagnosticLineValue(errorDescription) & vbCrLf & _
           "Trace: " & g_tracePath, vbCritical, "DXF Export"
    On Error GoTo 0
End Sub

Private Sub ExcelsisMacroMain()



    Set swApp = Application.SldWorks



    Dim swModel As Object

    Set swModel = swApp.ActiveDoc

    If swModel Is Nothing Then

        MsgBox "No active document."

        Exit Sub

    End If



    Dim mType As Long

    mType = swModel.GetType

    If mType <> swDocPART And mType <> swDocASSEMBLY Then

        MsgBox "Open a Part or Assembly."

        Exit Sub

    End If



    If swModel.GetPathName = "" Then

        MsgBox "Save the active document before exporting DXFs."

        Exit Sub

    End If

    Dim selMgr As Object
    Set selMgr = swModel.SelectionManager

    Dim selCount As Long

    selCount = selMgr.GetSelectedObjectCount2(-1)

    Dim activePartSelectedFace As Object

    Set activePartSelectedFace = Nothing

    If mType = swDocPART And selCount = 1 Then

        Dim activeSelectionType As Long

        activeSelectionType = -1

        On Error Resume Next

        activeSelectionType = selMgr.GetSelectedObjectType3(1, -1)

        If activeSelectionType = swSelFACES Then _
            Set activePartSelectedFace = selMgr.GetSelectedObject6(1, -1)

        On Error GoTo 0

        If activeSelectionType = swSelFACES Then

            If activePartSelectedFace Is Nothing Then

                MsgBox "Could not read the selected face. Select one flat face and run DXF again."

                Exit Sub

            End If

            If Not IsPlanarFace(activePartSelectedFace) Then

                MsgBox "The selected face is not planar. Select one flat face and run DXF again."

                Exit Sub

            End If

        End If

    End If

    InitializeRunTrace swModel
    g_runRootPath = CStr(swModel.GetPathName)
    g_runRootConfiguration = GetActiveConfigName(swModel)
    TraceRun "document-path=" & DiagnosticLineValue(swModel.GetPathName)

    Dim selectedCandidates As Collection
    If mType = swDocASSEMBLY And selCount > 0 Then
        Set selectedCandidates = SnapshotSelectedComponents(swModel, selMgr, selCount)
        If selectedCandidates Is Nothing Then
            Err.Raise 5, "DXF selection", "Could not capture the complete selection. Select the components again; see the trace for details."
        End If
    End If



    If Not AskMaterial() Then Exit Sub



    Debug.Print "==== DXF EXPORT v16 washer ratio split ===="
    Debug.Print "Active: " & swModel.GetPathName

    Debug.Print "Type: " & IIf(mType = swDocPART, "PART", "ASSEMBLY")

    Debug.Print "Selections: " & selCount

    Debug.Print "Material: " & g_material


    Dim mode As Integer
    Dim assemblyExportMethod As Integer
    If Not AskDxfRunOptions(mType, selCount, mode, assemblyExportMethod) Then
        g_userCancelled = True
        Exit Sub
    End If

    Debug.Print "Mode: " & IIf(mode = MODE_REGULAR, "REGULAR", "PRECUT")
    BuildDxfNameInventory swModel

    Debug.Print "General imported filter: " & CStr(g_generalImportedFilter)

    If mType = swDocASSEMBLY And mode = MODE_REGULAR Then

        Debug.Print "Assembly geometry: " & IIf(assemblyExportMethod = ASSEMBLY_EXPORT_CONTEXT, _
                                                 "TEMPORARY PART BODY (ASSEMBLY CONTEXT)", _
                                                 "REGULAR PART FILE")

    End If



    Dim baseFolder As String

    baseFolder = Left(swModel.GetPathName, InStrRev(swModel.GetPathName, "\"))

    Dim dxfFolder As String

    If mode = MODE_PRECUT Then

        dxfFolder = baseFolder & "dxf_precut\"

    Else

        dxfFolder = baseFolder & "dxf\"

    End If

    TraceRun "output-folder-requested=" & DiagnosticLineValue(dxfFolder)

    If Not EnsureFolderPath(dxfFolder) Then

        Err.Raise 76, "DXF_v16", _
                  "The document folder is unavailable or the DXF folder could not be created: " & dxfFolder

    End If

    TraceRun "output-folder-ready=" & DiagnosticLineValue(dxfFolder)

    Debug.Print "Output folder: " & dxfFolder

    TraceRun "mode=" & CStr(mode) & _
             " assembly-method=" & CStr(assemblyExportMethod) & _
             " general-imported-filter=" & CStr(g_generalImportedFilter)



    Dim dictDone   As Object

    Dim dictOpened As Object

    Dim dictInitiallyVisibleDocumentWindows As Object

    Set dictDone = CreateObject("Scripting.Dictionary")

    Set dictOpened = CreateObject("Scripting.Dictionary")

    Set dictInitiallyVisibleDocumentWindows = BuildVisibleDocumentWindowKeyDict()
    Set g_initiallyVisibleDocuments = dictInitiallyVisibleDocumentWindows
    If mType = swDocASSEMBLY And g_initiallyVisibleDocuments Is Nothing Then
        Err.Raise 5, "DXF cleanup", "Could not capture the original document windows; batch export was not started."
    End If

    If mType = swDocPART Then

        Debug.Print "--- Single part mode ---"

        ProcessSinglePart swModel, swModel.GetPathName, _
                          GetActiveConfigName(swModel), 1, dxfFolder, mode, dictDone, _
                          activePartSelectedFace

    ElseIf selCount > 0 Then

        Debug.Print "--- Assembly with selection ---"

        Dim dictQty As Object

        If mode = MODE_REGULAR And _
           assemblyExportMethod = ASSEMBLY_EXPORT_CONTEXT Then

            Set dictQty = BuildAssemblyContextQtyDict(swModel)

        Else

            Set dictQty = BuildQtyDict(swModel)

        End If

        ProcessSelectedComponents swModel, selectedCandidates, dxfFolder, mode, _
                                  assemblyExportMethod, dictQty, dictDone, dictOpened

    Else

        Debug.Print "--- Assembly full export ---"

        ProcessFullAssembly swModel, dxfFolder, assemblyExportMethod, _
                            dictDone, dictOpened

    End If



    Debug.Print "-----------------------------------------"

    TraceRun "export processing complete"

    TraceCandidateSummary
    RestoreOriginalConfigurations
    TraceRun "closing explicitly opened documents"
    CloseExplicitlyOpenedPartDocs dictOpened

    TraceRun "closing extra visible document windows"
    CloseVisibleDocumentsOpenedByMacro dictInitiallyVisibleDocumentWindows, swModel

    TraceRun "reactivating root document"
    ActivateModelDocument swModel


    If g_stopBatchReason <> "" Then Err.Raise 5, "DXF batch stopped", g_stopBatchReason

    Debug.Print "==== EXPORT COMPLETE ===="

    TraceRun "complete exported-entries=" & CStr(dictDone.Count - g_existingCount) & " existing-kept=" & CStr(g_existingCount)

    Dim completionText As String
    completionText = "DXF export done."
    If g_userCancelled Then completionText = "DXF export stopped by user. Completed files were kept."
    MsgBox completionText & vbCrLf & _
           "New exports: " & CStr(dictDone.Count - g_existingCount) & vbCrLf & _
           "Existing DXFs kept: " & CStr(g_existingCount) & vbCrLf & _
           "Folder: " & dxfFolder & vbCrLf & _
            "Trace: " & g_tracePath

    If dictDone.Count > 0 Then ExcelsisOpenExportFolder dxfFolder

End Sub

Private Sub ExcelsisOpenExportFolder(ByVal folderPath As String)
    On Error GoTo OpenFailed
    If Len(Trim$(folderPath)) = 0 Then Exit Sub

    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FolderExists(folderPath) Then Exit Sub

    Dim folderShell As Object
    Set folderShell = CreateObject("Shell.Application")
    folderShell.Open folderPath
    Exit Sub

OpenFailed:
    ' Explorer failure must not turn a completed export into a failed run.
    Debug.Print "Could not open export folder: " & folderPath & " (" & CStr(Err.Number) & ")"
    Err.Clear
End Sub




' ================================================================

Function GetActiveConfigName(swModel As Object) As String

    Dim c As Object

    Set c = swModel.GetActiveConfiguration

    If c Is Nothing Then

        GetActiveConfigName = ""

    Else

        GetActiveConfigName = c.Name

    End If

End Function



' ================================================================

Function AskDxfOutputOptions(docType As Long) As Boolean
    Dim answer As VbMsgBoxResult
    answer = MsgBox("Export only missing DXFs?" & vbCrLf & _
        "YES = keep existing nonempty files (default)." & vbCrLf & _
        "NO = regenerate all candidates." & vbCrLf & _
        "To refresh a changed part in missing-only mode, remove its old DXF first.", _
        vbYesNoCancel + vbQuestion, "Existing DXFs")
    If answer = vbCancel Then Exit Function
    g_missingOnly = (answer = vbYes)
    g_assemblyFolders = False
    If docType = swDocASSEMBLY Then
        answer = MsgBox("Group DXFs into subfolders named after their parent assembly?" & vbCrLf & _
            "YES = one folder per immediate parent assembly/configuration." & vbCrLf & _
            "NO = the existing flat layout (default).", _
            vbYesNoCancel + vbQuestion + vbDefaultButton2, "DXF folder layout")
        If answer = vbCancel Then Exit Function
        g_assemblyFolders = (answer = vbYes)
    End If
    TraceRun "output-options missing-only=" & CStr(g_missingOnly) & " assembly-folders=" & CStr(g_assemblyFolders)
    AskDxfOutputOptions = True
End Function

Function DxfOwnerIdentity(ByVal swComp As Object, ByVal swModel As Object) As String
    Dim parent As Object, ownerPath As String, ownerCfg As String
    On Error Resume Next
    If Not swComp Is Nothing Then Set parent = swComp.GetParent
    If Not parent Is Nothing Then
        ownerPath = CStr(parent.GetPathName)
        ownerCfg = CStr(parent.ReferencedConfiguration)
    End If
    If ownerPath = "" And Not swModel Is Nothing Then
        ownerPath = CStr(swModel.GetPathName)
        ownerCfg = GetActiveConfigName(swModel)
    End If
    If ownerPath = "" Then
        ownerPath = g_runRootPath
        ownerCfg = g_runRootConfiguration
    End If
    On Error GoTo 0
    DxfOwnerIdentity = LCase$(ownerPath) & vbTab & ownerCfg
End Function

Function DxfCandidateScopeKey(ByVal partPath As String, ByVal cfg As String, ByVal swComp As Object, _
                              ByVal swModel As Object, Optional ByVal forceParent As Boolean = False) As String
    DxfCandidateScopeKey = LCase$(partPath) & "@" & cfg
    If g_assemblyFolders Or forceParent Then _
        DxfCandidateScopeKey = DxfCandidateScopeKey & vbTab & DxfOwnerIdentity(swComp, swModel)
End Function

Function DxfIdentityTag(ByVal value As String) As String
    Dim h As Double, i As Long, c As Long
    For i = 1 To Len(value)
        c = AscW(Mid$(value, i, 1))
        If c < 0 Then c = c + 65536
        h = h * 131# + CDbl(c)
        h = h - Fix(h / 2147483629#) * 2147483629#
    Next i
    DxfIdentityTag = Right$("00000000" & Hex$(CLng(h)), 8)
End Function

Function DxfPartNameKey(ByVal partPath As String, ByVal cfg As String) As String
    Dim name As String
    name = TraceFileLabel(partPath)
    If InStrRev(name, ".") > 0 Then name = Left$(name, InStrRev(name, ".") - 1)
    DxfPartNameKey = LCase$(CleanFileName(name) & vbTab & CleanFileName(cfg))
End Function

Function DxfAssemblyFolderStem(ByVal owner As String) As String
    Dim fields As Variant, name As String
    fields = Split(owner, vbTab)
    name = TraceFileLabel(CStr(fields(0)))
    If InStrRev(name, ".") > 0 Then name = Left$(name, InStrRev(name, ".") - 1)
    If UBound(fields) > 0 Then
        If CStr(fields(1)) <> "" And LCase$(CStr(fields(1))) <> "default" Then name = name & " (" & CStr(fields(1)) & ")"
    End If
    name = CleanFileName(name)
    Do While Len(name) > 0
        If Right$(name, 1) <> "." And Right$(name, 1) <> " " Then Exit Do
        name = Left$(name, Len(name) - 1)
    Loop
    If name = "" Then name = "Assembly"
    fields = Split(name, ".")
    Select Case UCase$(CStr(fields(0)))
        Case "CON", "PRN", "AUX", "NUL", "COM1", "COM2", "COM3", "COM4", "COM5", "COM6", "COM7", "COM8", "COM9", _
             "LPT1", "LPT2", "LPT3", "LPT4", "LPT5", "LPT6", "LPT7", "LPT8", "LPT9"
            name = "_" & name
    End Select
    If Len(name) > 100 Then name = Left$(name, 90) & "_" & DxfIdentityTag(owner)
    DxfAssemblyFolderStem = name
End Function

Sub RegisterDxfNameOwner(ByVal owners As Object, ByVal key As String, ByVal owner As String)
    If owners.Exists(key) Then
        If CStr(owners(key)) <> owner Then owners(key) = "*"
    Else
        owners.Add key, owner
    End If
End Sub

Sub BuildDxfNameInventory(swModel As Object)
    Dim components As Variant, c As Object, item As Variant, p As String, cfg As String, owner As String
    On Error GoTo UnknownInventory
    If swModel.GetType = swDocPART Then
        RegisterDxfNameOwner g_partNameOwners, DxfPartNameKey(swModel.GetPathName, GetActiveConfigName(swModel)), LCase$(swModel.GetPathName) & vbTab & GetActiveConfigName(swModel)
        Exit Sub
    End If
    owner = DxfOwnerIdentity(Nothing, swModel)
    RegisterDxfNameOwner g_folderNameOwners, LCase$(DxfAssemblyFolderStem(owner)), owner
    components = swModel.GetComponents(False)
    If IsEmpty(components) Then Exit Sub
    For Each item In components
        Set c = item
        p = CStr(c.GetPathName): cfg = CStr(c.ReferencedConfiguration)
        If IsPartPath(p) Then
            RegisterDxfNameOwner g_partNameOwners, DxfPartNameKey(p, cfg), LCase$(p) & vbTab & cfg
            owner = DxfOwnerIdentity(c, swModel)
            RegisterDxfNameOwner g_folderNameOwners, LCase$(DxfAssemblyFolderStem(owner)), owner
        End If
    Next item
    Exit Sub
UnknownInventory:
    g_forceIdentityTags = True
    TraceRun "output-name inventory incomplete; using stable identity suffixes"
End Sub

Function CandidateExportFolder(ByVal rootFolder As String, ByVal swModel As Object, ByVal swComp As Object) As String
    Dim owner As String, name As String
    CandidateExportFolder = rootFolder
    If Not g_assemblyFolders Then Exit Function
    owner = DxfOwnerIdentity(swComp, swModel)
    name = DxfAssemblyFolderStem(owner)
    If g_forceIdentityTags Then
        name = name & "_" & DxfIdentityTag(owner)
    ElseIf g_folderNameOwners.Exists(LCase$(name)) Then
        If CStr(g_folderNameOwners(LCase$(name))) = "*" Then name = name & "_" & DxfIdentityTag(owner)
    End If
    CandidateExportFolder = EnsureSubFolder(rootFolder, name)
End Function

Function KeepExistingDxf(ByVal filePath As String) As Boolean
    Dim fso As Object
    If Not g_missingOnly Then Exit Function
    On Error GoTo Failed
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FileExists(filePath) Then Exit Function
    If CDbl(fso.GetFile(filePath).Size) <= 0# Then
        TraceRun "output existing-empty=regenerate path=" & DiagnosticLineValue(filePath)
        Exit Function
    End If
    g_candidateExisting = True
    g_existingCount = g_existingCount + 1
    KeepExistingDxf = True
    TraceRun "output skipped=existing-nonempty path=" & DiagnosticLineValue(filePath)
    Exit Function
Failed:
    ' Never fall through to overwriting a file whose existence could not be checked.
    Err.Raise 5, "DXF existing-file check", "Could not safely inspect output: " & filePath
End Function

Function NormalizeVisiblePartScopes(visibleParts As Object) As Object
    Dim result As Object, k As Variant, candidate As Variant, prior As Variant, key As String
    Set result = CreateObject("Scripting.Dictionary")
    For Each k In visibleParts.Keys
        candidate = visibleParts(k)
        key = DxfCandidateScopeKey(CStr(candidate(0)), CStr(candidate(1)), candidate(4), Nothing)
        If result.Exists(key) Then
            prior = result(key)
            prior(2) = CLng(prior(2)) + CLng(candidate(2))
            If CStr(prior(3)) = "" Then prior(3) = candidate(3)
            result(key) = prior
        Else
            result.Add key, candidate
        End If
    Next k
    Set NormalizeVisiblePartScopes = result
End Function

Function DxfStopRequested() As Boolean
    Dim foregroundPid As Long
    If g_userCancelled Then
        DxfStopRequested = True
        Exit Function
    End If
    On Error GoTo Done
    ' Poll only at safe checkpoints; never interrupt a native SOLIDWORKS call.
    If DxfGetAsyncKeyState(&H12) < 0 And DxfGetAsyncKeyState(&H53) < 0 And _
       DxfGetAsyncKeyState(&H11) >= 0 Then
        DxfGetWindowThreadProcessId DxfGetForegroundWindow(), foregroundPid
        If foregroundPid = ExcelsisGetCurrentProcessId() Then
            g_userCancelled = True
            TraceRun "cancel requested=Alt+S; finishing owned-document cleanup"
        End If
    End If
Done:
    DxfStopRequested = g_userCancelled
End Function

Function AskExportMode() As Integer
    Dim r As VbMsgBoxResult
    r = MsgBox("Export as:" & vbCrLf & vbCrLf & _
               "YES = Regular DXF" & vbCrLf & _
               "NO = Crude precut (offset outline)" & vbCrLf & _
               "CANCEL = abort", vbYesNoCancel + vbQuestion, "Export type")
    Select Case r
        Case vbYes
            AskExportMode = MODE_REGULAR
        Case vbNo
            AskExportMode = MODE_PRECUT
    End Select
End Function

Function AskDxfRunOptions(docType As Long, selectionCount As Long, _
                          ByRef mode As Integer, ByRef assemblyExportMethod As Integer) As Boolean
    mode = MODE_REGULAR
    assemblyExportMethod = ASSEMBLY_EXPORT_REGULAR
    g_generalImportedFilter = False
    If docType = swDocPART Or (docType = swDocASSEMBLY And selectionCount > 0) Then
        mode = AskExportMode()
        If mode = 0 Then Exit Function
    End If
    If Not AskImportedFilter() Then Exit Function
    If Not AskDxfOutputOptions(docType) Then Exit Function
    If mode = MODE_PRECUT Then
        If Not AskPrecutSettings() Then Exit Function
    ElseIf docType = swDocASSEMBLY Then
        assemblyExportMethod = AskAssemblyExportMethod()
        If assemblyExportMethod = 0 Then Exit Function
    End If
    AskDxfRunOptions = True
End Function

Function AskImportedFilter() As Boolean
    Dim r As VbMsgBoxResult
    TraceRun "import-filter prompt shown"
    r = MsgBox("Which imported parts should be excluded?" & vbCrLf & vbCrLf & _
               "YES = Exclude ALL imported parts" & vbCrLf & _
               "NO = Exclude imported washer-like parts ONLY (default)" & vbCrLf & _
               "CANCEL = abort" & vbCrLf & vbCrLf & _
               "During export: hold Alt+S to stop after the current operation.", _
               vbYesNoCancel + vbQuestion + vbDefaultButton2, "Imported parts filter")
    Select Case r
        Case vbYes
            g_generalImportedFilter = True
            AskImportedFilter = True
            TraceRun "import-filter choice=all-imported"
        Case vbNo
            g_generalImportedFilter = False
            AskImportedFilter = True
            TraceRun "import-filter choice=washerlike-only"
        Case Else
            TraceRun "import-filter choice=cancel"
    End Select
End Function

Function GetDocumentActivationName(swModel As Object) As String

    If swModel Is Nothing Then Exit Function

    Dim pathName As String

    On Error Resume Next

    pathName = swModel.GetPathName

    On Error GoTo 0

    If pathName <> "" Then

        GetDocumentActivationName = Mid$(pathName, InStrRev(pathName, "\") + 1)

    Else

        GetDocumentActivationName = swModel.GetTitle

    End If

End Function

Function ModelDocumentsAreSame(leftDoc As Object, rightDoc As Object) As Boolean

    If leftDoc Is Nothing Or rightDoc Is Nothing Then Exit Function

    On Error Resume Next

    If leftDoc Is rightDoc Then

        ModelDocumentsAreSame = True

        On Error GoTo 0

        Exit Function

    End If

    Dim leftPath As String

    Dim rightPath As String

    leftPath = leftDoc.GetPathName

    rightPath = rightDoc.GetPathName

    If leftPath <> "" And rightPath <> "" Then

        ModelDocumentsAreSame = (StrComp(leftPath, rightPath, vbTextCompare) = 0)

    Else

        ModelDocumentsAreSame = (leftDoc.GetType = rightDoc.GetType And _
                                 StrComp(leftDoc.GetTitle, rightDoc.GetTitle, _
                                         vbTextCompare) = 0)

    End If

    On Error GoTo 0

End Function

Function ActivateModelDocument(swModel As Object) As Boolean

    ActivateModelDocument = False

    If swModel Is Nothing Then Exit Function

    Dim activeDoc As Object

    Set activeDoc = swApp.ActiveDoc

    If ModelDocumentsAreSame(activeDoc, swModel) Then

        ActivateModelDocument = True

        Exit Function

    End If

    Dim activationName As String

    activationName = GetDocumentActivationName(swModel)

    If activationName = "" Then Exit Function

    Dim activateErrs As Long

    Dim activatedDoc As Object

    On Error Resume Next

    Set activatedDoc = swApp.ActivateDoc3(activationName, False, _
                                          swDontRebuildActiveDoc, activateErrs)

    On Error GoTo 0

    Set activeDoc = swApp.ActiveDoc

    ActivateModelDocument = ModelDocumentsAreSame(activeDoc, swModel)

    If Not ActivateModelDocument Then

        Debug.Print "Could not activate exact document: " & activationName & _
                    " error=" & activateErrs

    End If

End Function

Function ActivateConfigurationChecked(swModel As Object, cfg As String) As Boolean

    ActivateConfigurationChecked = False

    If swModel Is Nothing Then

        TraceRun "configuration reject=model-missing requested=" & _
                 DiagnosticLineValue(cfg)

        Exit Function

    End If

    If Not ActivateModelDocument(swModel) Then

        TraceRun "configuration reject=document-activation-failed document=" & _
                 DiagnosticLineValue(GetDocumentActivationName(swModel)) & _
                 " requested=" & DiagnosticLineValue(cfg)

        Exit Function

    End If

    If cfg = "" Then
        TraceRun "configuration reject=empty-request"
        Exit Function
    End If
    RememberOriginalConfiguration swModel
    TraceRun "configuration requested=" & DiagnosticLineValue(cfg) & _
             " current=" & DiagnosticLineValue(GetActiveConfigName(swModel))
    If StrComp(GetActiveConfigName(swModel), cfg, vbTextCompare) = 0 Then

        ActivateConfigurationChecked = True

        Exit Function

    End If

    Dim switched As Boolean

    On Error Resume Next

    switched = CBool(swModel.ShowConfiguration2(cfg))

    On Error GoTo 0

    If switched And _
       StrComp(GetActiveConfigName(swModel), cfg, vbTextCompare) = 0 Then

        swModel.EditRebuild3

        swModel.ForceRebuild3 False

        ActivateConfigurationChecked = True

    Else

        Debug.Print "Could not activate exact configuration: " & cfg

        TraceRun "configuration reject=switch-failed document=" & _
                 DiagnosticLineValue(GetDocumentActivationName(swModel)) & _
                 " requested=" & DiagnosticLineValue(cfg) & _
                 " current=" & DiagnosticLineValue(GetActiveConfigName(swModel)) & _
                 " api-result=" & CStr(switched)

    End If

End Function

Sub RememberOriginalConfiguration(swModel As Object)
    Dim key As String, cfg As String
    If swModel Is Nothing Then Exit Sub
    If g_originalConfigurations Is Nothing Then Set g_originalConfigurations = CreateObject("Scripting.Dictionary")
    key = LCase$(swModel.GetPathName)
    If key = "" Then Exit Sub
    If g_originalConfigurations.Exists(key) Then Exit Sub
    cfg = GetActiveConfigName(swModel)
    g_originalConfigurations.Add key, cfg
End Sub

Sub RestoreOriginalConfigurations()
    Dim key As Variant, model As Object, cfg As String
    If g_originalConfigurations Is Nothing Then Exit Sub
    On Error Resume Next
    For Each key In g_originalConfigurations.Keys
        Set model = Nothing
        Set model = swApp.GetOpenDocumentByName(CStr(key))
        cfg = CStr(g_originalConfigurations(key))
        If Not model Is Nothing And cfg <> "" Then
            Err.Clear
            If StrComp(GetActiveConfigName(model), cfg, vbTextCompare) <> 0 Then
                If Not ActivateConfigurationChecked(model, cfg) Then _
                    TraceRun "configuration restore-failed path=" & CStr(key) & " requested=" & cfg
            End If
            If Err.Number <> 0 Then TraceRun "configuration restore-error path=" & CStr(key) & " error=" & CStr(Err.Number)
        End If
    Next key
    On Error GoTo 0
End Sub

Function AskAssemblyExportMethod() As Integer

    Dim r As VbMsgBoxResult

    r = MsgBox("Where should regular DXF geometry come from?" & vbCrLf & vbCrLf & _
               "YES = Within assembly: evaluated body + Normal To" & vbCrLf & _
               "      Includes cuts/features that exist only in the assembly" & vbCrLf & _
               "NO = Regular referenced part-file export" & vbCrLf & _
               "CANCEL = abort", _
               vbYesNoCancel + vbQuestion + vbDefaultButton1, _
               "Assembly DXF method")

    Select Case r

        Case vbYes

            AskAssemblyExportMethod = ASSEMBLY_EXPORT_CONTEXT

        Case vbNo

            AskAssemblyExportMethod = ASSEMBLY_EXPORT_REGULAR

        Case Else

            AskAssemblyExportMethod = 0

    End Select

End Function

Function AskMaterial() As Boolean

    g_material = ConfiguredDefaultMaterial()

    Dim choice As VbMsgBoxResult

    choice = MsgBox("Material for DXF filenames defaults to " & ConfiguredDefaultMaterial() & "." & vbCrLf & vbCrLf & _
                    "YES = export now with " & ConfiguredDefaultMaterial() & vbCrLf & _
                    "NO = change material" & vbCrLf & _
                    "CANCEL = abort", _
                    vbYesNoCancel + vbQuestion + vbDefaultButton1, "DXF material")

    If choice = vbCancel Then Exit Function

    If choice = vbYes Then

        AskMaterial = True

        Exit Function

    End If

    Dim s As String

    s = InputBox("Material text for DXF filenames:" & vbCrLf & _
                 "Example: " & ConfiguredDefaultMaterial() & " gives " & ConfiguredDxfOutputPrefix() & "3_" & ConfiguredDefaultMaterial() & "_2db_part(config).dxf", _
                 "DXF material", ConfiguredDefaultMaterial())

    If Trim(s) = "" Then Exit Function

    g_material = UCase(CleanFileName(Trim(s)))

    If g_material = "" Then

        MsgBox "Invalid material."

        Exit Function

    End If

    AskMaterial = True

End Function

Function AskPrecutSettings() As Boolean
    Dim s As String

    s = InputBox("Offset outward from outline (mm):", "Crude precut", "20")

    If s = "" Then

        AskPrecutSettings = False

        Exit Function

    End If

    If Not IsNumeric(s) Then

        MsgBox "Invalid number."

        AskPrecutSettings = False

        Exit Function

    End If

    g_precutOffset_mm = CDbl(s)

    If g_precutOffset_mm < 0 Then g_precutOffset_mm = 0



    Dim r As VbMsgBoxResult

    r = MsgBox("Keep original outline + holes inside the offset outline?" & vbCrLf & vbCrLf & _
               "YES = keep all features + offset" & vbCrLf & _
               "NO  = offset outline only", _
               vbYesNoCancel + vbQuestion, "Crude precut")

    Select Case r

        Case vbYes

            g_precutKeepFeats = True

        Case vbNo

            g_precutKeepFeats = False

        Case vbCancel

            AskPrecutSettings = False

            Exit Function

    End Select

    AskPrecutSettings = True

End Function



' ================================================================
' Component2.Visible uses swComponentVisibilityState_e: hidden=0, visible=1.
' Unknown/error is not permission to export. Parent visibility is checked too.
Function IsComponentHiddenSafe(swComp As Object) As Boolean
    IsComponentHiddenSafe = True
    If swComp Is Nothing Then Exit Function
    Dim v As Long
    v = -1
    On Error Resume Next
    Err.Clear
    v = CLng(swComp.Visible)
    If Err.Number <> 0 Then
        TraceRun "visibility reject=api-error " & Err.Description
        Err.Clear
    End If
    On Error GoTo 0
    IsComponentHiddenSafe = (v <> 1)
End Function

Function GetComponentSuppressionStateSafe(swComp As Object) As Long
    GetComponentSuppressionStateSafe = -1
    If swComp Is Nothing Then Exit Function

    Dim state As Long
    state = -1

    On Error Resume Next
    Err.Clear
    state = CLng(swComp.GetSuppression2)
    If Err.Number <> 0 Then
        Err.Clear
        state = CLng(swComp.GetSuppression)
    End If
    On Error GoTo 0

    GetComponentSuppressionStateSafe = state
End Function

Function IsComponentActuallySuppressedSafe(swComp As Object) As Boolean
    If swComp Is Nothing Then
        IsComponentActuallySuppressedSafe = True
        Exit Function
    End If

    Dim state As Long
    state = GetComponentSuppressionStateSafe(swComp)

    If state >= 0 Then
        IsComponentActuallySuppressedSafe = (state = swComponentSuppressed Or _
                                             state = swComponentInternalIdMismatch)
        Exit Function
    End If

    On Error Resume Next
    IsComponentActuallySuppressedSafe = CBool(swComp.IsSuppressed)
    On Error GoTo 0
End Function

Function IsComponentLightweightSafe(swComp As Object) As Boolean
    Dim state As Long
    state = GetComponentSuppressionStateSafe(swComp)
    IsComponentLightweightSafe = (state = swComponentLightweight Or _
                                  state = swComponentFullyLightweight)
End Function

Sub ResolveSelectedPartIfLightweight(swComp As Object)
    If Not IsComponentLightweightSafe(swComp) Then Exit Sub

    Dim result As Long

    result = -1

    On Error Resume Next

    result = CLng(swComp.SetSuppression2(swComponentResolved))

    On Error GoTo 0

    Debug.Print "    Selected lightweight part resolve result=" & result
End Sub

Function ComponentHasExcludedAssemblyAncestor(swComp As Object, _
                                               Optional excludeLightweight As Boolean = True, _
                                               Optional excludeImportedPathAncestor As Boolean = True) As Boolean

    If swComp Is Nothing Then Exit Function

    Dim currentComp As Object

    Set currentComp = swComp

    Dim parentComp As Object

    On Error Resume Next

    Err.Clear
    Set parentComp = currentComp.GetParent
    If Err.Number <> 0 Then
        ComponentHasExcludedAssemblyAncestor = True
        TraceRun "visibility reject=parent-api-error"
        Exit Function
    End If

    On Error GoTo 0

    Dim depth As Long

    Do While Not parentComp Is Nothing And depth < 64

        If IsComponentActuallySuppressedSafe(parentComp) Or _
           IsComponentHiddenSafe(parentComp) Or _
           (excludeLightweight And IsComponentLightweightSafe(parentComp)) Then

            ComponentHasExcludedAssemblyAncestor = True

            Exit Function

        End If

        Dim parentPath As String

        parentPath = ""

        On Error Resume Next

        parentPath = parentComp.GetPathName

        On Error GoTo 0

        If excludeImportedPathAncestor Then

            If parentPath <> "" And IsImportedPartPath(parentPath) Then

                ComponentHasExcludedAssemblyAncestor = True

                Exit Function

            End If

        End If

        Set currentComp = parentComp

        Set parentComp = Nothing

        On Error Resume Next

        Err.Clear
        Set parentComp = currentComp.GetParent
        If Err.Number <> 0 Then
            ComponentHasExcludedAssemblyAncestor = True
            TraceRun "visibility reject=parent-api-error"
            Exit Function
        End If

        On Error GoTo 0

        depth = depth + 1

    Loop

    If Not parentComp Is Nothing Then
        ComponentHasExcludedAssemblyAncestor = True
        TraceRun "visibility reject=ancestor-depth-limit"
    End If

End Function

' ================================================================

Function BuildQtyDict(swModel As Object) As Object

    Dim d As Object

    Set d = CreateObject("Scripting.Dictionary")

    Dim vc As Variant

    vc = swModel.GetComponents(False)

    If IsEmpty(vc) Then

        Set BuildQtyDict = d

        Exit Function

    End If

    Dim i As Long

    Dim c As Object

    For i = 0 To UBound(vc)

        Set c = vc(i)

        If Not c Is Nothing Then

            If (Not IsComponentActuallySuppressedSafe(c)) And (Not IsComponentHiddenSafe(c)) Then

                If ComponentHasExcludedAssemblyAncestor(c, False, False) Then GoTo NextQtyComp

                Dim p As String

                p = c.GetPathName

                If p = "" Then GoTo NextQtyComp

                If Not IsPartPath(p) And Not IsAssemblyPath(p) Then GoTo NextQtyComp

                Dim k As String
                k = DxfCandidateScopeKey(p, c.ReferencedConfiguration, c, swModel)
                If d.Exists(k) Then

                    d(k) = d(k) + 1

                Else

                    d.Add k, 1

                End If

            End If

        End If

NextQtyComp:

    Next i
    Set BuildQtyDict = d

End Function



' ================================================================

Function BuildAssemblyContextQtyDict(swModel As Object) As Object

    Dim d As Object

    Set d = CreateObject("Scripting.Dictionary")

    Dim components As Variant

    components = swModel.GetComponents(False)

    If IsEmpty(components) Then

        Set BuildAssemblyContextQtyDict = d

        Exit Function

    End If

    Dim i As Long

    For i = 0 To UBound(components)

        Dim swComp As Object

        Set swComp = components(i)

        If swComp Is Nothing Then GoTo NextContextQtyComponent

        If IsComponentActuallySuppressedSafe(swComp) Then GoTo NextContextQtyComponent

        If IsComponentHiddenSafe(swComp) Then GoTo NextContextQtyComponent

        If ComponentHasExcludedAssemblyAncestor(swComp, False, False) Then GoTo NextContextQtyComponent

        Dim partPath As String

        partPath = swComp.GetPathName

        If Not IsPartPath(partPath) And _
           Not IsAssemblyPath(partPath) Then GoTo NextContextQtyComponent

        Dim fullKey As String

        fullKey = DxfCandidateScopeKey(partPath, swComp.ReferencedConfiguration, swComp, swModel)

        If d.Exists(fullKey) Then

            d(fullKey) = CLng(d(fullKey)) + 1

        Else

            d.Add fullKey, 1

        End If

NextContextQtyComponent:

    Next i

    Set BuildAssemblyContextQtyDict = d

End Function

' ================================================================

Function BuildVisibleOpenPartWindowPathDict() As Object

    Dim d As Object

    Set d = CreateObject("Scripting.Dictionary")

    Dim swDoc As Object

    On Error Resume Next

    Set swDoc = swApp.GetFirstDocument

    Do While Not swDoc Is Nothing

        If swDoc.GetType = swDocPART Then

            Dim isVisible As Boolean

            isVisible = False

            Err.Clear

            isVisible = CBool(swDoc.Visible)

            If Err.Number <> 0 Then

                Err.Clear

                isVisible = False

            End If

            If isVisible Then

                Dim pathName As String

                pathName = swDoc.GetPathName

                If IsPartPath(pathName) Then

                    If Not d.Exists(LCase(pathName)) Then d.Add LCase(pathName), pathName

                End If

            End If

        End If

        Set swDoc = swDoc.GetNext

    Loop

    On Error GoTo 0

    Debug.Print "Initially visible part windows: " & d.Count

    Set BuildVisibleOpenPartWindowPathDict = d

End Function

Function IsDocumentWindowVisible(swDoc As Object) As Boolean

    IsDocumentWindowVisible = False
    If swDoc Is Nothing Then Exit Function

    On Error Resume Next
    Err.Clear
    IsDocumentWindowVisible = CBool(swDoc.Visible)
    If Err.Number <> 0 Then
        Err.Clear
        IsDocumentWindowVisible = False
    End If
    On Error GoTo 0

End Function

Function GetDocumentWindowKey(swDoc As Object) As String

    If swDoc Is Nothing Then Exit Function

    Dim docType As Long
    Dim pathName As String
    Dim title As String

    On Error Resume Next
    docType = swDoc.GetType
    pathName = swDoc.GetPathName
    title = swDoc.GetTitle
    On Error GoTo 0

    If pathName <> "" Then
        GetDocumentWindowKey = "path|" & CStr(docType) & "|" & LCase$(pathName)
    ElseIf title <> "" Then
        GetDocumentWindowKey = "title|" & CStr(docType) & "|" & LCase$(title)
    End If

End Function

Function BuildVisibleDocumentWindowKeyDict() As Object

    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")

    Dim snapshotOk As Boolean
    Dim modelDocs As Collection
    Set modelDocs = GetModelWindowDocuments(snapshotOk)

    If Not snapshotOk Or modelDocs Is Nothing Then
        Debug.Print "Could not capture actual model windows; cleanup will fail closed"
        TraceRun "initial model-window snapshot failed"
        Set BuildVisibleDocumentWindowKeyDict = Nothing
        Exit Function
    End If

    Dim swDoc As Object
    Dim i As Long
    For i = 1 To modelDocs.Count
        Set swDoc = modelDocs(i)

        Dim windowKey As String
        windowKey = GetDocumentWindowKey(swDoc)
        If windowKey <> "" Then
            If Not d.Exists(windowKey) Then d.Add windowKey, True
        End If
    Next i

    Debug.Print "Initially visible document windows: " & d.Count
    TraceRun "initial model windows=" & CStr(d.Count)
    Set BuildVisibleDocumentWindowKeyDict = d

End Function

Sub RebuildDocumentIfNeeded(swModel As Object)

    If swModel Is Nothing Then Exit Sub

    Dim rebuildStatus As Long

    rebuildStatus = 0

    On Error Resume Next

    Err.Clear

    rebuildStatus = CLng(swModel.Extension.NeedsRebuild2)

    If Err.Number <> 0 Then

        rebuildStatus = 0

        Err.Clear

    End If

    On Error GoTo 0

    If rebuildStatus <> 0 Then swModel.EditRebuild3

End Sub

Function GetModelWindowDocuments(ByRef snapshotOk As Boolean) As Collection

    snapshotOk = False

    Dim docs As Collection
    Set docs = New Collection

    On Error GoTo SnapshotFailed

    Dim swFrame As Object
    Set swFrame = swApp.Frame
    If swFrame Is Nothing Then GoTo SnapshotFailed

    Dim modelWindows As Variant
    modelWindows = swFrame.ModelWindows
    If Not IsArray(modelWindows) Then GoTo SnapshotFailed

    Dim windowObject As Variant
    For Each windowObject In modelWindows
        Dim swModelWindow As Object
        Dim swDoc As Object

        Set swModelWindow = windowObject
        If Not swModelWindow Is Nothing Then Set swDoc = swModelWindow.ModelDoc
        If Not swDoc Is Nothing Then docs.Add swDoc
    Next windowObject

    snapshotOk = True
    Set GetModelWindowDocuments = docs
    Exit Function

SnapshotFailed:

    Debug.Print "Model-window snapshot error " & Err.Number & ": " & Err.Description
    Err.Clear
    Set GetModelWindowDocuments = Nothing

End Function

Function VisibleDocumentSnapshotContains(dictInitiallyVisible As Object, _
                                         swDoc As Object) As Boolean

    If dictInitiallyVisible Is Nothing Or swDoc Is Nothing Then Exit Function

    Dim windowKey As String
    windowKey = GetDocumentWindowKey(swDoc)
    If windowKey <> "" Then _
        VisibleDocumentSnapshotContains = dictInitiallyVisible.Exists(windowKey)

End Function

Sub CloseVisibleDocumentsOpenedByMacro(dictInitiallyVisible As Object, _
                                       originalDoc As Object)

    If dictInitiallyVisible Is Nothing Then Exit Sub

    Dim snapshotOk As Boolean
    Dim modelDocs As Collection
    Set modelDocs = GetModelWindowDocuments(snapshotOk)

    If Not snapshotOk Or modelDocs Is Nothing Then
        Debug.Print "Could not enumerate current model windows; leaving them unchanged"
        TraceRun "current model-window snapshot failed; cleanup skipped"
        Exit Sub
    End If

    Dim docsToClose As Collection
    Set docsToClose = New Collection

    Dim swDoc As Object
    Dim i As Long
    For i = 1 To modelDocs.Count
        Set swDoc = modelDocs(i)

        If Not ModelDocumentsAreSame(swDoc, originalDoc) Then
            If Not VisibleDocumentSnapshotContains(dictInitiallyVisible, swDoc) Then
                docsToClose.Add swDoc
            End If
        End If
    Next i

    Debug.Print "Extra visible document windows to close: " & docsToClose.Count
    TraceRun "new model windows to close=" & CStr(docsToClose.Count)

    For i = docsToClose.Count To 1 Step -1
        Set swDoc = docsToClose(i)

        Dim closeName As String
        closeName = GetDocumentActivationName(swDoc)

        If closeName <> "" Then
            Debug.Print "  Closing macro-opened window: " & closeName
            TraceRun "closing new model window=" & closeName

            Dim closeErrNumber As Long
            Dim closeErrDescription As String
            On Error Resume Next
            Err.Clear
            swApp.CloseDoc closeName
            closeErrNumber = Err.Number
            closeErrDescription = Err.Description
            On Error GoTo 0

            If closeErrNumber <> 0 Then
                Debug.Print "  Close failed: " & closeName & _
                            " error=" & CStr(closeErrNumber) & _
                            " " & closeErrDescription
                TraceRun "close new model window failed=" & closeName & _
                         " error=" & CStr(closeErrNumber)
            End If
        Else
            Debug.Print "  Could not identify macro-opened window; leaving it open"
            TraceRun "could not identify new model window for close"
        End If
    Next i

    Dim remainingDocs As Collection
    Set remainingDocs = GetModelWindowDocuments(snapshotOk)

    If snapshotOk And Not remainingDocs Is Nothing Then
        Dim remainingCount As Long
        remainingCount = 0

        For i = 1 To remainingDocs.Count
            Set swDoc = remainingDocs(i)
            If Not ModelDocumentsAreSame(swDoc, originalDoc) Then
                If Not VisibleDocumentSnapshotContains(dictInitiallyVisible, swDoc) Then
                    remainingCount = remainingCount + 1
                    TraceRun "new model window remains=" & GetDocumentActivationName(swDoc)
                End If
            End If
        Next i

        TraceRun "new model windows remaining=" & CStr(remainingCount)
    Else
        TraceRun "post-close model-window verification failed"
    End If

    If Not originalDoc Is Nothing Then ActivateModelDocument originalDoc

End Sub

Function BuildAssemblyPartPathDict(swModel As Object, _
                                   Optional resolveLightweight As Boolean = True) As Object

    Dim d As Object

    Set d = CreateObject("Scripting.Dictionary")

    If swModel Is Nothing Then

        Set BuildAssemblyPartPathDict = d

        Exit Function

    End If

    If swModel.GetType <> swDocASSEMBLY Then

        Set BuildAssemblyPartPathDict = d

        Exit Function

    End If

    If resolveLightweight Then

        On Error Resume Next

        swModel.ResolveAllLightWeightComponents True

        On Error GoTo 0

    End If

    Dim vComps As Variant

    vComps = swModel.GetComponents(False)

    If IsEmpty(vComps) Then

        Set BuildAssemblyPartPathDict = d

        Exit Function

    End If

    Dim i As Long

    For i = 0 To UBound(vComps)

        Dim swComp As Object

        Set swComp = vComps(i)

        If Not swComp Is Nothing Then

            If Not IsComponentActuallySuppressedSafe(swComp) Then

                Dim partPath As String

                partPath = swComp.GetPathName

                If partPath <> "" And IsPartPath(partPath) Then

                    If Not d.Exists(LCase(partPath)) Then d.Add LCase(partPath), partPath

                End If

            End If

        End If

    Next i

    Debug.Print "Assembly part documents tracked for cleanup: " & d.Count

    Set BuildAssemblyPartPathDict = d

End Function

Sub CloseAssemblyPartDocs(dictAssemblyParts As Object, _
                          dictInitiallyVisibleDocumentWindows As Object)

    If dictAssemblyParts Is Nothing Then Exit Sub

    Debug.Print "Closing open part docs from starting assembly..."

    Dim k As Variant

    For Each k In dictAssemblyParts.Keys

        Dim swDoc As Object

        Set swDoc = Nothing

        On Error Resume Next

        Set swDoc = swApp.GetOpenDocumentByName(CStr(dictAssemblyParts(k)))

        On Error GoTo 0

        If Not swDoc Is Nothing Then

            If swDoc.GetType = swDocPART Then

                If VisibleDocumentSnapshotContains( _
                    dictInitiallyVisibleDocumentWindows, swDoc) Then

                    Debug.Print "  Leaving initially visible part window open: " & _
                                CStr(dictAssemblyParts(k))

                    GoTo NextDoc

                End If

                Debug.Print "  Closing assembly part: " & _
                            GetDocumentActivationName(swDoc)

                swApp.CloseDoc GetDocumentActivationName(swDoc)

            End If

        End If

NextDoc:

    Next k

End Sub

Sub CloseExplicitlyOpenedPartDocs(dictOpened As Object)
    Dim key As Variant, model As Object
    If dictOpened Is Nothing Then Exit Sub
    For Each key In dictOpened.Keys
        Set model = Nothing
        On Error Resume Next
        Set model = swApp.GetOpenDocumentByName(CStr(key))
        On Error GoTo 0
        If Not CloseCandidateDocument(CStr(key), model, dictOpened) Then Exit For
    Next key
End Sub

Function CloseCandidateDocument(partPath As String, ByRef swPart As Object, _
                                dictOpened As Object) As Boolean
    Dim key As String, closeName As String, snapshotOk As Boolean
    Dim windows As Collection, model As Object, i As Long
    On Error GoTo Failed
    key = LCase$(partPath)
    If dictOpened Is Nothing Then Exit Function
    If key = "" Then Exit Function
    If Not dictOpened.Exists(key) Then
        CloseCandidateDocument = True
        Exit Function
    End If
    If Not swPart Is Nothing Then
        If VisibleDocumentSnapshotContains(g_initiallyVisibleDocuments, swPart) Then
            dictOpened.Remove key
            TraceRun "cleanup preserved protected document=" & DiagnosticLineValue(partPath)
            CloseCandidateDocument = True
            Exit Function
        End If
    End If
    closeName = CStr(dictOpened(key))
    If closeName = "" Or StrComp(closeName, partPath, vbTextCompare) <> 0 Then _
        Err.Raise 5, "DXF cleanup", "Candidate close identity is not the expected full path."
    TraceRun "cleanup close-request path=" & DiagnosticLineValue(partPath)
    Set swPart = Nothing
    swApp.CloseDoc closeName
    Set windows = GetModelWindowDocuments(snapshotOk)
    If Not snapshotOk Or windows Is Nothing Then _
        Err.Raise 5, "DXF cleanup", "Could not verify candidate window closure."
    For i = 1 To windows.Count
        Set model = windows(i)
        If StrComp(CStr(model.GetPathName), partPath, vbTextCompare) = 0 Then _
            Err.Raise 5, "DXF cleanup", "SOLIDWORKS kept the candidate window open."
    Next i
    dictOpened.Remove key
    If Not g_originalConfigurations Is Nothing Then
        If g_originalConfigurations.Exists(key) Then g_originalConfigurations.Remove key
    End If
    TraceRun "cleanup closed candidate path=" & DiagnosticLineValue(partPath) & _
             " pending-owned=" & CStr(dictOpened.Count)
    CloseCandidateDocument = True
    Set model = Nothing
    Set windows = Nothing
    DoEvents
    Exit Function
Failed:
    If g_stopBatchReason = "" Then g_stopBatchReason = _
        "Could not safely close a macro-opened document. Batch stopped to avoid accumulating windows: " & partPath
    TraceRun "cleanup reject=close-failed number=" & CStr(Err.Number) & _
             " description=" & DiagnosticLineValue(Err.Description) & " path=" & DiagnosticLineValue(partPath)
End Function

Sub PreserveCandidateDocument(swModel As Object, reason As String)
    Dim key As String
    On Error Resume Next
    If swModel Is Nothing Or g_initiallyVisibleDocuments Is Nothing Then Exit Sub
    key = GetDocumentWindowKey(swModel)
    If key <> "" Then
        If Not g_initiallyVisibleDocuments.Exists(key) Then _
            g_initiallyVisibleDocuments.Add key, True
    End If
    TraceRun "cleanup preserve=" & reason & " path=" & DiagnosticLineValue(swModel.GetPathName)
    On Error GoTo 0
End Sub

Sub TrackCandidateDocument(swModel As Object, wasLoaded As Boolean, dictOpened As Object)
    Dim partPath As String, key As String
    On Error GoTo UnknownOwnership
    partPath = CStr(swModel.GetPathName)
    key = LCase$(partPath)
    If key = "" Or g_initiallyVisibleDocuments Is Nothing Then GoTo UnknownOwnership
    If VisibleDocumentSnapshotContains(g_initiallyVisibleDocuments, swModel) Then Exit Sub
    If g_candidateOwnership Is Nothing Then Set g_candidateOwnership = CreateObject("Scripting.Dictionary")
    If Not g_candidateOwnership.Exists(key) Then
        If wasLoaded Then
            If swModel.GetSaveFlag Then
                PreserveCandidateDocument swModel, "pre-existing-unsaved-document"
                Exit Sub
            End If
        End If
        g_candidateOwnership.Add key, True
    End If
    If Not dictOpened.Exists(key) Then dictOpened.Add key, partPath
    TraceRun "cleanup acquired path=" & DiagnosticLineValue(partPath) & _
             " already-loaded=" & CStr(wasLoaded) & " pending-owned=" & CStr(dictOpened.Count)
    Exit Sub
UnknownOwnership:
    PreserveCandidateDocument swModel, "unknown-ownership"
    If g_stopBatchReason = "" Then g_stopBatchReason = _
        "Could not determine safe document ownership. Batch stopped before further exports."
    TraceRun "cleanup reject=ownership-unknown path=" & DiagnosticLineValue(partPath)
End Sub

' ================================================================

Function SnapshotSelectedComponents(swModel As Object, selMgr As Object, selCount As Long) As Collection
    Dim captured As New Collection, result As New Collection
    Dim scopes As Object
    Set scopes = CreateObject("Scripting.Dictionary")
    Dim s As Long, selType As Long, selObj As Object, swComp As Object
    Dim partPath As String, cfg As String, record As Variant, key As String
    Dim visibleParts As Object, errorNumber As Long, errorText As String
    On Error GoTo Failed
    TraceRun "selection-snapshot requested=" & CStr(selCount)
    If selMgr.GetSelectedObjectCount2(-1) <> selCount Then _
        Err.Raise 5, "DXF selection", "Selection changed before it could be captured."

    ' Read the whole live selection before opening, resolving or rebuilding anything.
    For s = 1 To selCount
        g_traceComponent = ""
        Set selObj = selMgr.GetSelectedObject6(s, -1)
        selType = selMgr.GetSelectedObjectType3(s, -1)
        Set swComp = Nothing
        On Error Resume Next
        Set swComp = selMgr.GetSelectedObjectsComponent4(s, -1)
        If swComp Is Nothing Then Set swComp = selMgr.GetSelectedObjectsComponent4(s, 0)
        If swComp Is Nothing And Not selObj Is Nothing Then Set swComp = selObj.GetComponent
        On Error GoTo Failed
        If swComp Is Nothing And selType = 20 Then Set swComp = selObj
        If swComp Is Nothing Then
            TraceRun "selection-snapshot skip=no-component index=" & CStr(s) & " type=" & CStr(selType)
            GoTo NextSelection
        End If
        partPath = CStr(swComp.GetPathName)
        cfg = CStr(swComp.ReferencedConfiguration)
        g_traceComponent = TraceFileLabel(partPath) & "@" & cfg
        If IsComponentActuallySuppressedSafe(swComp) Then
            TraceRun "selection-snapshot skip=suppressed index=" & CStr(s)
            GoTo NextSelection
        End If
        If IsComponentHiddenSafe(swComp) Or ComponentHasExcludedAssemblyAncestor(swComp, False, False) Then
            TraceRun "selection-snapshot skip=hidden-or-excluded-ancestor index=" & CStr(s)
            GoTo NextSelection
        End If
        If partPath = "" Or cfg = "" Then
            TraceRun "selection-snapshot skip=missing-path-or-configuration index=" & CStr(s)
            GoTo NextSelection
        End If
        If Not IsPartPath(partPath) And Not IsAssemblyPath(partPath) Then
            TraceRun "selection-snapshot skip=unsupported-document index=" & CStr(s)
            GoTo NextSelection
        End If
        record = Array(s, selType, Nothing, Nothing, partPath, cfg, Nothing)
        Set record(2) = selObj
        Set record(3) = swComp
        captured.Add record
        TraceRun "selection-snapshot captured index=" & CStr(s) & " type=" & CStr(selType) & _
                 " path=" & DiagnosticLineValue(partPath) & " cfg=" & cfg
NextSelection:
    Next s
    If selMgr.GetSelectedObjectCount2(-1) <> selCount Then _
        Err.Raise 5, "DXF selection", "Selection changed while it was being captured."

    ' Freeze subassembly visibility too; reopening may show a different display state.
    For Each record In captured
        partPath = CStr(record(4))
        cfg = CStr(record(5))
        If IsAssemblyPath(partPath) Then
            key = LCase(partPath) & "@" & cfg
            If scopes.Exists(key) Then
                Set visibleParts = scopes(key)
            Else
                Set visibleParts = BuildVisibleSubassemblyPartCandidates(swModel, partPath, cfg)
                scopes.Add key, visibleParts
            End If
            Set record(6) = visibleParts
            TraceRun "selection-snapshot subassembly index=" & CStr(record(0)) & _
                     " candidates=" & CStr(visibleParts.Count) & " path=" & DiagnosticLineValue(partPath)
        End If
        result.Add record
    Next record
    g_traceComponent = ""
    TraceRun "selection-snapshot complete requested=" & CStr(selCount) & _
             " captured=" & CStr(result.Count) & " skipped=" & CStr(selCount - result.Count)
    Set SnapshotSelectedComponents = result
    Exit Function
Failed:
    errorNumber = Err.Number
    errorText = Err.Description
    TraceRun "selection-snapshot reject=incomplete index=" & CStr(s) & _
             " error=" & CStr(errorNumber) & " description=" & DiagnosticLineValue(errorText)
    Set SnapshotSelectedComponents = Nothing
End Function

Sub ProcessSelectedComponents(swModel As Object, selectedCandidates As Collection, _
                              dxfFolder As String, mode As Integer, _
                              assemblyExportMethod As Integer, dictQty As Object, _
                              dictDone As Object, dictOpened As Object)

    Dim dictSelectedAssemblyParts As Object

    Set dictSelectedAssemblyParts = CreateObject("Scripting.Dictionary")

    Dim dictSelectedAssemblyContexts As Object

    Set dictSelectedAssemblyContexts = CreateObject("Scripting.Dictionary")

    Dim dictSelectedAssemblyKeys As Object

    Set dictSelectedAssemblyKeys = CreateObject("Scripting.Dictionary")

    Dim s As Long, visited As Long, selectedCandidate As Variant
    Dim selObj As Object, selType As Long, swComp As Object
    Dim partPath As String, cfg As String
    TraceRun "selected-queue start captured=" & CStr(selectedCandidates.Count)
    For Each selectedCandidate In selectedCandidates
        If DxfStopRequested() Or g_stopBatchReason <> "" Then Exit For
        visited = visited + 1
        s = CLng(selectedCandidate(0))
        selType = CLng(selectedCandidate(1))
        Set selObj = selectedCandidate(2)
        Set swComp = selectedCandidate(3)
        partPath = CStr(selectedCandidate(4))
        cfg = CStr(selectedCandidate(5))
        g_traceComponent = TraceFileLabel(partPath) & "@" & cfg
        If IsComponentActuallySuppressedSafe(swComp) Or IsComponentHiddenSafe(swComp) Or _
           ComponentHasExcludedAssemblyAncestor(swComp, False, False) Then
            TraceRun "selected reject=component-state-changed index=" & CStr(s)
            GoTo NextSel
        End If
        If StrComp(CStr(swComp.GetPathName), partPath, vbTextCompare) <> 0 Or _
           StrComp(CStr(swComp.ReferencedConfiguration), cfg, vbTextCompare) <> 0 Then
            TraceRun "selected reject=component-identity-changed index=" & CStr(s)
            GoTo NextSel
        End If
        TraceRun "selected candidate index=" & CStr(s) & _
                 " type=" & CStr(selType) & _
                 " component=" & g_traceComponent

        If partPath = "" Then GoTo NextSel

        If IsAssemblyPath(partPath) Then

            Debug.Print "    Selected subassembly: " & partPath & " @ " & cfg

            Dim assemblyKey As String

            assemblyKey = LCase(partPath) & "@" & cfg

            If Not dictSelectedAssemblyKeys.Exists(assemblyKey) Then
                dictSelectedAssemblyKeys.Add assemblyKey, True

                Dim visibleParts As Object
                Set visibleParts = selectedCandidate(6)

                If mode = MODE_REGULAR And _
                   assemblyExportMethod = ASSEMBLY_EXPORT_CONTEXT Then
                    AddSelectedSubassemblyContext partPath, cfg, visibleParts, _
                                                  dictSelectedAssemblyContexts
                Else
                    CollectSelectedSubassemblyParts partPath, cfg, visibleParts, _
                                                    dictSelectedAssemblyParts
                End If
            End If

            GoTo NextSel

        End If



        If Not IsPartPath(partPath) Then

            Debug.Print "    Not a part file, skip: " & partPath

            GoTo NextSel

        End If

        Dim fullKey As String
        fullKey = DxfCandidateScopeKey(partPath, cfg, swComp, swModel)

        If dictDone.Exists(fullKey) Then

            TraceRun "selected reject=duplicate component=" & g_traceComponent

            GoTo NextSel

        End If



        Dim qty As Long

        If dictQty.Exists(fullKey) Then

            qty = dictQty(fullKey)

        Else

            qty = 1

        End If

        BeginDxfCandidate partPath, cfg, "selected-component"
        Dim exported As Boolean
        exported = False
        Dim selectedFace As Object
        Set selectedFace = Nothing
        Dim useContext As Boolean
        useContext = (mode = MODE_REGULAR And assemblyExportMethod = ASSEMBLY_EXPORT_CONTEXT)
        If useContext And Not selObj Is Nothing Then
            If IsPlanarFace(selObj) Then Set selectedFace = selObj
        End If
        If Not selectedFace Is Nothing Then _
            TraceRun "selected planar-face override component=" & g_traceComponent
        exported = ExportAssemblyCandidate(swModel, swComp, partPath, cfg, qty, dxfFolder, _
                                           useContext, dictOpened, mode, selectedFace)

        TraceRun "selected result component=" & g_traceComponent & _
                 " exported=" & CStr(exported)

        If exported Then dictDone.Add fullKey, True
        FinishDxfCandidate exported

NextSel:
        Set g_importComponent = Nothing
    Next selectedCandidate
    TraceRun "selected-queue complete captured=" & CStr(selectedCandidates.Count) & " visited=" & CStr(visited)

    If DxfStopRequested() Or g_stopBatchReason <> "" Then Exit Sub
    If mode = MODE_REGULAR And _
       assemblyExportMethod = ASSEMBLY_EXPORT_CONTEXT Then

        ExportSelectedSubassembliesInContext dictSelectedAssemblyContexts, _
                                             dxfFolder, dictDone, dictOpened

    Else

        ExportSelectedSubassemblyParts swModel, dictSelectedAssemblyParts, dxfFolder, mode, _
                                       dictDone, dictOpened

    End If

End Sub

' Snapshot the original instances before opening a subassembly in its own window.
' Their display state may differ from the standalone subassembly display state.
Function BuildVisibleSubassemblyPartCandidates(swModel As Object, assemblyPath As String, _
                                                cfg As String) As Object
    Dim candidates As Object
    Set candidates = CreateObject("Scripting.Dictionary")
    Set BuildVisibleSubassemblyPartCandidates = candidates

    Dim components As Variant
    components = Empty
    On Error Resume Next
    components = swModel.GetComponents(False)
    On Error GoTo 0
    If IsEmpty(components) Then Exit Function

    Dim i As Long
    For i = 0 To UBound(components)
        Dim instance As Object
        Set instance = components(i)
        If instance Is Nothing Then GoTo NextInstance
        If IsComponentActuallySuppressedSafe(instance) Then GoTo NextInstance
        If IsComponentHiddenSafe(instance) Then GoTo NextInstance
        If ComponentHasExcludedAssemblyAncestor(instance, False, False) Then GoTo NextInstance
        If StrComp(instance.GetPathName, assemblyPath, vbTextCompare) <> 0 Then GoTo NextInstance
        If StrComp(instance.ReferencedConfiguration, cfg, vbTextCompare) <> 0 Then GoTo NextInstance
        CollectEligibleSubassemblyChildren instance, 1, candidates
NextInstance:
    Next i
End Function

Sub AddSelectedSubassemblyContext(assemblyPath As String, cfg As String, _
                                  visibleParts As Object, dictContexts As Object)
    Dim contextKey As String
    contextKey = LCase(assemblyPath) & "@" & cfg
    If dictContexts.Exists(contextKey) Then Exit Sub
    Dim contextInfo As Variant
    contextInfo = Array(assemblyPath, cfg, Nothing)
    Set contextInfo(2) = visibleParts
    dictContexts.Add contextKey, contextInfo
End Sub

Sub ExportSelectedSubassembliesInContext(dictContexts As Object, dxfFolder As String, _
                                         dictDone As Object, dictOpened As Object)

    If dictContexts Is Nothing Then Exit Sub

    Debug.Print "  Selected subassembly contexts: " & dictContexts.Count

    Dim contextKey As Variant

    For Each contextKey In dictContexts.Keys
        If DxfStopRequested() Or g_stopBatchReason <> "" Then Exit For

        Dim contextInfo As Variant

        contextInfo = dictContexts(contextKey)

        Dim visibleParts As Object
        Set visibleParts = contextInfo(2)

        ProcessSelectedSubassemblyContext CStr(contextInfo(0)), _
                                          CStr(contextInfo(1)), _
                                          visibleParts, _
                                          dxfFolder, dictDone, dictOpened

    Next contextKey

End Sub

Sub ProcessSelectedSubassemblyContext(assemblyPath As String, cfg As String, _
                                      visibleParts As Object, dxfFolder As String, _
                                      dictDone As Object, dictOpened As Object)
    Dim originalActiveDoc As Object, swAssembly As Object, originalCfg As String
    Dim wasLoaded As Boolean, errs As Long, warns As Long, restoreOk As Boolean
    If Not IsAssemblyPath(assemblyPath) Or DxfStopRequested() Or g_stopBatchReason <> "" Then Exit Sub
    On Error GoTo Failed
    Set originalActiveDoc = swApp.ActiveDoc
    Set swAssembly = swApp.GetOpenDocumentByName(assemblyPath)
    wasLoaded = Not swAssembly Is Nothing
    If swAssembly Is Nothing Then _
        Set swAssembly = swApp.OpenDoc6(assemblyPath, swDocASSEMBLY, swOpenDocOptions_Silent Or swOpenDocOptions_ReadOnly, cfg, errs, warns)
    If swAssembly Is Nothing Then
        TraceRun "subassembly reject=open-failed path=" & DiagnosticLineValue(assemblyPath)
        GoTo CleanUp
    End If
    TrackCandidateDocument swAssembly, wasLoaded, dictOpened
    originalCfg = GetActiveConfigName(swAssembly)
    If DxfStopRequested() Or g_stopBatchReason <> "" Then GoTo CleanUp
    If swAssembly.GetType <> swDocASSEMBLY Or originalCfg = "" Then GoTo CleanUp
    If Not ActivateModelDocument(swAssembly) Then GoTo CleanUp
    If Not ActivateConfigurationChecked(swAssembly, cfg) Then GoTo CleanUp
    swAssembly.EditRebuild3
    Dim allowedScopes As Object
    Set allowedScopes = NormalizeVisiblePartScopes(visibleParts)
    ProcessAssemblyCandidateSnapshot swAssembly, dxfFolder, True, allowedScopes, dictDone, dictOpened
CleanUp:
    On Error Resume Next
    restoreOk = True
    If Not swAssembly Is Nothing And originalCfg <> "" Then
        Err.Clear
        If StrComp(GetActiveConfigName(swAssembly), originalCfg, vbTextCompare) <> 0 Then
            restoreOk = ActivateConfigurationChecked(swAssembly, originalCfg)
        End If
        If Err.Number <> 0 Then restoreOk = False
    End If
    If Not restoreOk Then
        PreserveCandidateDocument swAssembly, "subassembly-configuration-restore-failed"
        If g_stopBatchReason = "" Then g_stopBatchReason = "Could not restore the selected subassembly configuration."
    End If
    If Not CloseCandidateDocument(assemblyPath, swAssembly, dictOpened) Then _
        TraceRun "subassembly cleanup=stopped"
    Set swAssembly = Nothing
    If Not originalActiveDoc Is Nothing Then ActivateModelDocument originalActiveDoc
    Set originalActiveDoc = Nothing
    On Error GoTo 0
    Exit Sub
Failed:
    TraceRun "subassembly reject=api-error number=" & CStr(Err.Number) & _
             " description=" & DiagnosticLineValue(Err.Description) & " path=" & DiagnosticLineValue(assemblyPath)
    Resume CleanUp
End Sub

Sub CollectSelectedSubassemblyParts(assemblyPath As String, cfg As String, _
                                     visibleParts As Object, dictCandidates As Object)
    ' The original assembly snapshot is authoritative, not a reopened display state.
    Dim partKey As Variant, candidate As Variant, existing As Variant, scopedParts As Object
    If visibleParts Is Nothing Then Exit Sub
    Set scopedParts = NormalizeVisiblePartScopes(visibleParts)
    For Each partKey In scopedParts.Keys
        candidate = scopedParts(partKey)
        If dictCandidates.Exists(partKey) Then
            existing = dictCandidates(partKey)
            existing(2) = CLng(existing(2)) + CLng(candidate(2))
            If CStr(existing(3)) = "" Then existing(3) = candidate(3)
            dictCandidates(partKey) = existing
        Else
            dictCandidates.Add partKey, candidate
        End If
        TraceRun "subassembly-queue path=" & CStr(candidate(0)) & _
                 " cfg=" & CStr(candidate(1)) & " quantity=" & CStr(candidate(2))
    Next partKey
End Sub

Sub CollectEligibleSubassemblyChildren(parentComp As Object, _
                                       assemblyCopies As Long, _
                                       dictCandidates As Object)

    Dim children As Variant

    children = Empty

    On Error Resume Next

    children = parentComp.GetChildren

    On Error GoTo 0

    If IsEmpty(children) Then Exit Sub

    Dim i As Long

    For i = 0 To UBound(children)

        Dim childComp As Object

        Set childComp = children(i)

        If childComp Is Nothing Then GoTo NextChild

        If IsComponentActuallySuppressedSafe(childComp) Then

            Debug.Print "      Suppressed component, skip: " & childComp.Name2

            GoTo NextChild

        End If

        If IsComponentHiddenSafe(childComp) Then

            Debug.Print "      Hidden component, skip: " & childComp.Name2

            GoTo NextChild

        End If

        Dim childPath As String

        childPath = childComp.GetPathName

        If childPath = "" Then GoTo NextChild

        If IsAssemblyPath(childPath) Then

            CollectEligibleSubassemblyChildren childComp, assemblyCopies, _
                                               dictCandidates

            GoTo NextChild

        End If

        If Not IsPartPath(childPath) Then GoTo NextChild

        Dim childCfg As String

        childCfg = childComp.ReferencedConfiguration

        Dim fullKey As String

        fullKey = DxfCandidateScopeKey(childPath, childCfg, childComp, Nothing, True)

        Dim candidate As Variant

        If dictCandidates.Exists(fullKey) Then

            candidate = dictCandidates(fullKey)

            candidate(2) = CLng(candidate(2)) + assemblyCopies
            If CStr(candidate(3)) = "" Then candidate(3) = ComponentImportHint(childComp)

            dictCandidates(fullKey) = candidate

        Else

            candidate = Array(childPath, childCfg, assemblyCopies, ComponentImportHint(childComp), Nothing)
            Set candidate(4) = childComp

            dictCandidates.Add fullKey, candidate

        End If

NextChild:

    Next i

End Sub

Sub ExportSelectedSubassemblyParts(swModel As Object, dictCandidates As Object, dxfFolder As String, _
                                   mode As Integer, dictDone As Object, dictOpened As Object)
    Dim key As Variant, candidate As Variant, partPath As String, cfg As String
    Dim qty As Long, exported As Boolean
    If dictCandidates Is Nothing Then Exit Sub
    For Each key In dictCandidates.Keys
        If DxfStopRequested() Or g_stopBatchReason <> "" Then Exit For
        If dictDone.Exists(CStr(key)) Then GoTo NextCandidate
        candidate = dictCandidates(key)
        partPath = CStr(candidate(0)): cfg = CStr(candidate(1)): qty = CLng(candidate(2))
        BeginDxfCandidate partPath, cfg, "selected-subassembly-part"
        exported = ExportAssemblyCandidate(swModel, candidate(4), partPath, cfg, qty, dxfFolder, _
                                           False, dictOpened, mode, Nothing, CStr(candidate(3)))
        If exported Then dictDone.Add CStr(key), True
        FinishDxfCandidate exported
NextCandidate:
    Next key
End Sub



' ================================================================

Sub ProcessFullAssembly(swModel As Object, dxfFolder As String, _
                        assemblyExportMethod As Integer, dictDone As Object, _
                        dictOpened As Object)
    If assemblyExportMethod = ASSEMBLY_EXPORT_CONTEXT Then
        ProcessFullAssemblyInContext swModel, dxfFolder, dictDone, dictOpened
    Else
        ProcessAssemblyCandidateSnapshot swModel, dxfFolder, False, Nothing, dictDone, dictOpened
    End If
End Sub

Function SnapshotAssemblyPartInstances(swModel As Object) As Collection
    Dim result As Collection, components As Variant, i As Long, c As Object
    Dim pathName As String, cfg As String, reason As String, entry As Variant
    Set result = New Collection
    Set SnapshotAssemblyPartInstances = result
    On Error GoTo Failed
    components = swModel.GetComponents(False)
    If IsEmpty(components) Then Exit Function
    For i = LBound(components) To UBound(components)
        Set c = components(i)
        pathName = "": cfg = "": reason = ""
        If c Is Nothing Then
            TraceRun "snapshot skip=missing-component index=" & CStr(i)
        Else
            pathName = c.GetPathName: cfg = c.ReferencedConfiguration
            If IsComponentActuallySuppressedSafe(c) Then
                reason = "suppressed"
            ElseIf IsComponentHiddenSafe(c) Then
                reason = "hidden-or-visibility-unknown"
            ElseIf ComponentHasExcludedAssemblyAncestor(c, False, False) Then
                reason = "excluded-ancestor"
            ElseIf Not IsPartPath(pathName) Then
                reason = "not-part"
            ElseIf cfg = "" Then
                reason = "configuration-unavailable"
            End If
            If reason = "" Then
                entry = Array(pathName, cfg, c)
                result.Add entry
                TraceRun "snapshot eligible index=" & CStr(i) & " path=" & DiagnosticLineValue(pathName) & _
                         " cfg=" & DiagnosticLineValue(cfg) & " instance=" & DiagnosticLineValue(c.Name2)
            Else
                TraceRun "snapshot skip=" & reason & " index=" & CStr(i) & _
                         " path=" & DiagnosticLineValue(pathName) & " cfg=" & DiagnosticLineValue(cfg)
            End If
        End If
    Next i
    TraceRun "snapshot complete instances=" & CStr(result.Count)
    Exit Function
Failed:
    TraceRun "snapshot reject=api-error index=" & CStr(i) & " number=" & CStr(Err.Number)
    ' Never silently export a partial snapshot.
    Set SnapshotAssemblyPartInstances = Nothing
End Function

Sub ProcessAssemblyCandidateSnapshot(swModel As Object, dxfFolder As String, _
                                     useContext As Boolean, allowedParts As Object, _
                                     dictDone As Object, dictOpened As Object)
    Dim instances As Collection, entry As Variant, quantities As Object
    Dim swComp As Object, partPath As String, cfg As String, key As String
    Dim qty As Long, i As Long, exported As Boolean
    If DxfStopRequested() Or g_stopBatchReason <> "" Then Exit Sub
    If Not ActivateModelDocument(swModel) Then Exit Sub
    RebuildDocumentIfNeeded swModel
    Set instances = SnapshotAssemblyPartInstances(swModel)
    If instances Is Nothing Then Exit Sub
    Set quantities = CreateObject("Scripting.Dictionary")
    For Each entry In instances
        key = DxfCandidateScopeKey(CStr(entry(0)), CStr(entry(1)), entry(2), swModel)
        If quantities.Exists(key) Then
            quantities(key) = CLng(quantities(key)) + 1
        Else
            quantities.Add key, 1&
        End If
    Next entry
    TraceRun "queue unique-path-configurations=" & CStr(quantities.Count) & " assembly-context=" & CStr(useContext)
    For i = 1 To instances.Count
        If DxfStopRequested() Or g_stopBatchReason <> "" Then Exit For
        entry = instances(i)
        partPath = CStr(entry(0)): cfg = CStr(entry(1)): Set swComp = entry(2)
        key = DxfCandidateScopeKey(partPath, cfg, swComp, swModel)
        If dictDone.Exists(key) Then
            TraceRun "queue skip=already-exported path=" & partPath & " cfg=" & cfg
            GoTo NextCandidate
        End If
        qty = CLng(quantities(key))
        If Not allowedParts Is Nothing Then
            If Not allowedParts.Exists(key) Then
                TraceRun "queue skip=outside-original-selection path=" & partPath & " cfg=" & cfg
                GoTo NextCandidate
            End If
            entry = allowedParts(key)
            qty = CLng(entry(2))
        End If
        BeginDxfCandidate partPath, cfg, IIf(useContext, "assembly-context", "assembly-part")
        exported = ExportAssemblyCandidate(swModel, swComp, partPath, cfg, qty, dxfFolder, useContext, dictOpened)
        If exported Then dictDone.Add key, True
        FinishDxfCandidate exported
NextCandidate:
        Set swComp = Nothing
        DoEvents
    Next i
End Sub

Function ExportAssemblyCandidate(swModel As Object, ByVal swComp As Object, partPath As String, _
                                 cfg As String, qty As Long, dxfFolder As String, _
                                 useContext As Boolean, dictOpened As Object, _
                                 Optional mode As Integer = MODE_REGULAR, _
                                 Optional ByVal preferredFace As Object = Nothing, _
                                 Optional importHint As String = "") As Boolean
    Dim swPart As Object, originalCfg As String, restoreOk As Boolean, openedPath As String
    Dim exported As Boolean, errorNumber As Long, errorText As String
    If DxfStopRequested() Or g_stopBatchReason <> "" Then Exit Function
    Set g_importComponent = swComp
    Dim exportFolder As String
    If g_candidateKey <> "" Then
        Dim scopeKey As String
        scopeKey = DxfCandidateScopeKey(partPath, cfg, swComp, swModel)
        If scopeKey <> g_candidateKey Then
            If g_candidateResults.Exists(g_candidateKey) Then g_candidateResults.Remove g_candidateKey
            g_candidateKey = scopeKey
            g_candidateResults(g_candidateKey) = "PENDING"
        End If
    End If
    openedPath = partPath
    g_importHint = importHint
    On Error GoTo Failed
    If Not swComp Is Nothing Then
        If IsComponentHiddenSafe(swComp) Or IsComponentActuallySuppressedSafe(swComp) Or _
           ComponentHasExcludedAssemblyAncestor(swComp, False, False) Then
            TraceRun "queue reject=component-state-changed"
            GoTo CleanUp
        End If
        If Not CandidatePreflightAllows(swComp, partPath, cfg, useContext, mode, Not preferredFace Is Nothing) Then GoTo CleanUp
        ResolveSelectedPartIfLightweight swComp
        If useContext And IsComponentLightweightSafe(swComp) Then
            TraceRun "queue reject=unresolved-lightweight-component"
            GoTo CleanUp
        End If
        If StrComp(CStr(swComp.ReferencedConfiguration), cfg, vbTextCompare) <> 0 Then
            TraceRun "queue reject=instance-configuration-changed requested=" & cfg
            GoTo CleanUp
        End If
    ElseIf useContext Then
        TraceRun "queue reject=context-component-missing"
        GoTo CleanUp
    End If
    If swComp Is Nothing Then
        If Not CandidatePreflightAllows(Nothing, partPath, cfg, False, mode, False) Then GoTo CleanUp
    End If
    Set swPart = OpenPartForExport(partPath, dictOpened, False)
    If swPart Is Nothing Then
        TraceRun "queue reject=open-part-failed"
        GoTo CleanUp
    End If
    originalCfg = GetActiveConfigName(swPart)
    If CStr(swPart.GetPathName) <> "" Then openedPath = CStr(swPart.GetPathName)
    If DxfStopRequested() Or g_stopBatchReason <> "" Then GoTo CleanUp
    If originalCfg = "" Then
        TraceRun "queue reject=original-configuration-unreadable"
        GoTo CleanUp
    End If
    exportFolder = CandidateExportFolder(dxfFolder, swModel, swComp)
    If useContext Then
        exported = ExportOnePartInAssemblyContext(swModel, swComp, swPart, partPath, cfg, qty, exportFolder, preferredFace)
    ElseIf ActivateConfigurationChecked(swPart, cfg) Then
        exported = ExportOnePart(swPart, partPath, cfg, qty, exportFolder, mode, Nothing)
    End If
CleanUp:
    On Error Resume Next
    restoreOk = True
    If Not swPart Is Nothing And originalCfg <> "" Then
        Err.Clear
        If StrComp(GetActiveConfigName(swPart), originalCfg, vbTextCompare) <> 0 Then
            restoreOk = ActivateConfigurationChecked(swPart, originalCfg)
        End If
        If Err.Number <> 0 Then restoreOk = False
    End If
    If Not restoreOk Then
        PreserveCandidateDocument swPart, "configuration-restore-failed"
        If g_stopBatchReason = "" Then g_stopBatchReason = _
            "Could not restore a candidate configuration. Batch stopped; the document was left open."
        TraceRun "configuration restore-failed requested=" & originalCfg
        exported = False
    End If
    If Not CloseCandidateDocument(openedPath, swPart, dictOpened) Then exported = False
    Set swPart = Nothing
    If Not swModel Is Nothing Then
        If Not ActivateModelDocument(swModel) Then
            If g_stopBatchReason = "" Then g_stopBatchReason = "Could not reactivate the export assembly."
        End If
    End If
    On Error GoTo 0
    Set g_importComponent = Nothing
    g_importHint = ""
    ExportAssemblyCandidate = exported
    Exit Function
Failed:
    errorNumber = Err.Number: errorText = Err.Description
    TraceRun "queue reject=candidate-api-error number=" & CStr(errorNumber) & _
             " description=" & DiagnosticLineValue(errorText)
    exported = False
    Resume CleanUp
End Function



' ================================================================

Sub ProcessFullAssemblyInContext(swModel As Object, dxfFolder As String, _
                                 dictDone As Object, dictOpened As Object)
    ProcessAssemblyCandidateSnapshot swModel, dxfFolder, True, Nothing, dictDone, dictOpened
End Sub

' ================================================================

Sub ProcessSinglePart(swPart As Object, partPath As String, cfg As String, _
                      qty As Long, dxfFolder As String, mode As Integer, _
                      dictDone As Object, ByVal selectedFace As Object)

    If DxfStopRequested() Then Exit Sub
    Dim fullKey As String

    fullKey = LCase(partPath) & "@" & cfg

    If dictDone.Exists(fullKey) Then Exit Sub

    BeginDxfCandidate partPath, cfg, "single-part"
    Set g_importComponent = Nothing
    If Not ActivateConfigurationChecked(swPart, cfg) Then
        FinishDxfCandidate False
        Exit Sub
    End If

    If ExportOnePart(swPart, partPath, cfg, qty, dxfFolder, mode, selectedFace) Then _
        dictDone.Add fullKey, True
    FinishDxfCandidate dictDone.Exists(fullKey)

End Sub



' ================================================================

Function OpenPartForExport(partPath As String, dictOpened As Object, _
                           Optional activateAfterOpen As Boolean = True) As Object

    If Not IsPartPath(partPath) Then

        Set OpenPartForExport = Nothing

        Exit Function

    End If

    Dim already As Object
    Set already = swApp.GetOpenDocumentByName(partPath)

    If Not already Is Nothing Then
        TrackCandidateDocument already, True, dictOpened

        Set OpenPartForExport = already

        Exit Function

    End If



    Dim errs As Long

    Dim warns As Long

    Dim p As Object

    Set p = swApp.OpenDoc6(partPath, swDocPART, swOpenDocOptions_Silent Or swOpenDocOptions_ReadOnly, "", errs, warns)

    If p Is Nothing Then

        Set OpenPartForExport = Nothing

        Exit Function

    End If



    TrackCandidateDocument p, False, dictOpened
    If activateAfterOpen And g_stopBatchReason = "" Then ActivateModelDocument p

    Set OpenPartForExport = p

End Function



' ================================================================

Function ExportOnePart(swPart As Object, partPath As String, cfg As String, _
                       qty As Long, dxfFolder As String, _
                       mode As Integer, ByVal selectedFace As Object) As Boolean

    If swPart Is Nothing Or DxfStopRequested() Then Exit Function
    If StrComp(GetActiveConfigName(swPart), cfg, vbTextCompare) <> 0 Or cfg = "" Then
        TraceRun "candidate reject=wrong-active-configuration requested=" & cfg
        Exit Function
    End If
    If IsToolboxPartSafe(swPart) Then
        TraceRun "candidate reject=toolbox route=part-export path=" & DiagnosticLineValue(partPath)
        Exit Function
    End If

    Dim exportSelectedFace As Boolean

    exportSelectedFace = False

    If mode = MODE_REGULAR Then

        If Not selectedFace Is Nothing Then exportSelectedFace = True

    End If

    If Not exportSelectedFace Then

        swPart.EditRebuild3

        swPart.ForceRebuild3 False

    End If



    Dim isSM As Boolean

    isSM = IsSheetMetalSafe(swPart)

    Dim isThin As Boolean

    isThin = False

    If Not isSM And Not exportSelectedFace Then

        isThin = IsThinPlateLike(swPart)
    End If



    If mode = MODE_REGULAR Then

        If Not exportSelectedFace And Not isSM And Not isThin Then

            TraceRun "candidate reject=not-sheetmetal-or-thin-plate"
            Exit Function

        End If

    End If

    Dim candidateIsWasherLike As Boolean

    candidateIsWasherLike = False

    If Not isSM And (isThin Or exportSelectedFace) Then _
        candidateIsWasherLike = IsWasherLikeThinSolid(swPart)

    If ShouldRejectImportedCandidate(swPart, candidateIsWasherLike) Then

        Debug.Print "    Imported candidate rejected after geometry filters"

        Exit Function

    End If



    If DxfStopRequested() Then Exit Function
    Dim partName As String

    partName = Replace(swPart.GetTitle, ".SLDPRT", "")

    partName = Replace(partName, ".sldprt", "")

    partName = CleanFileName(partName)

    Dim cfgName As String

    cfgName = CleanFileName(cfg)


    Dim thickness As Double

    Dim thickStr As String

    If isSM Then

        thickness = GetSheetMetalThicknessFallback(swPart)
    Else

        thickness = GetThinSolidThickness(swPart)

    End If

    thickStr = FormatThickness(thickness)



    Dim suffix As String

    If mode = MODE_PRECUT Then

        suffix = "_PRECUT" & CLng(g_precutOffset_mm)

        If Not g_precutKeepFeats Then suffix = suffix & "_BBOX"

    End If



    Dim outPath As String

    Dim outFolder As String

    outFolder = dxfFolder

    If isSM Then

        outFolder = EnsureSubFolder(dxfFolder, "bended")

        Debug.Print "    Sheet metal -> bended folder"

    ElseIf isThin Then

        If candidateIsWasherLike Then

            outFolder = EnsureSubFolder(dxfFolder, "washerlike")

            Debug.Print "    Washerlike thin solid -> washerlike folder"

        End If

    End If

    Dim exportQty As Long

    exportQty = GetExportPieceCount(swPart, qty)

    outPath = outFolder & ConfiguredDxfOutputPrefix() & thickStr & "_" & g_material & "_" & exportQty & "db_" & partName & "(" & cfgName & ")" & suffix & ".dxf"
    outPath = ClaimDxfOutput(outPath, partPath, cfg)
    TraceRun "output planned=" & DiagnosticLineValue(outPath) & " quantity=" & CStr(exportQty)
    If KeepExistingDxf(outPath) Then
        ExportOnePart = True
        Exit Function
    End If



    Dim ok As Boolean

    If mode = MODE_REGULAR Then

        If exportSelectedFace Then

            Debug.Print "    Active-part single-face exception: exporting full body Normal To selected face"

            ok = ExportNormalViewToDxf(swPart, selectedFace, outPath)

            If ok Then

                If CleanProjectedDxfChamferLoops(outPath) Then _
                    Debug.Print "      Selected-face projected DXF cleaned for chamfer boundary loops"

            End If

        ElseIf isSM Then

            ok = ExportSMFlatPattern(swPart, outPath)

        Else

            ok = ExportThinSolidRegularDxf(swPart, outPath)

        End If

    Else

        ok = ExportPartPrecut(swPart, outPath, isSM)

    End If

    Debug.Print "    RESULT: " & IIf(ok, "OK", "FAILED")

    ExportOnePart = VerifyDxfOutput(ok, outPath)

End Function



' ================================================================

Function ExportOnePartInAssemblyContext(swAssembly As Object, swComp As Object, _
                                        swPart As Object, partPath As String, _
                                        cfg As String, qty As Long, _
                                        dxfFolder As String, _
                                        preferredFace As Object) As Boolean

    If swAssembly Is Nothing Or swComp Is Nothing Or swPart Is Nothing Then _
        Exit Function

    Dim originalPartCfg As String

    originalPartCfg = GetActiveConfigName(swPart)
    Set g_importComponent = swComp

    If Not ActivateConfigurationChecked(swPart, cfg) Then

        TraceRun "selected reject=configuration component=" & g_traceComponent & _
                 " requested=" & cfg

        GoTo RestorePartConfiguration

    End If

    swPart.EditRebuild3

    swPart.ForceRebuild3 False

    Dim ok As Boolean

    If IsToolboxPartSafe(swPart) Then

        Debug.Print "    Toolbox part, skip: " & partPath

        TraceRun "selected reject=toolbox component=" & g_traceComponent

        GoTo RestorePartConfiguration

    End If

    Dim isSM As Boolean

    isSM = IsSheetMetalSafe(swPart)

    Dim selectedPlanarFaceOverride As Boolean

    selectedPlanarFaceOverride = False

    If Not preferredFace Is Nothing Then selectedPlanarFaceOverride = True

    TraceRun "selected pre-export component=" & g_traceComponent & _
             " sheet-metal=" & CStr(isSM) & _
             " face-override=" & CStr(selectedPlanarFaceOverride)

    If isSM Then

        Debug.Print "    Sheet metal keeps the proven part-file flat-pattern export"

        ok = ExportOnePart(swPart, partPath, cfg, qty, dxfFolder, MODE_REGULAR, Nothing)

        TraceRun "selected sheet-metal-flat-pattern component=" & _
                 g_traceComponent & " exported=" & CStr(ok)

        GoTo RestorePartConfiguration

    End If

    If selectedPlanarFaceOverride Then

        Debug.Print "    Selected planar assembly face overrides whole-part thin classification"

        TraceRun "selected planar-face thin-classification override component=" & _
                 g_traceComponent

    ElseIf Not IsThinPlateLike(swPart) Then

        Debug.Print "    Assembly context: not SM/plate-like thin solid, skip"

        TraceRun "selected skip thin-classification component=" & g_traceComponent

        GoTo RestorePartConfiguration

    End If

    Dim candidateIsWasherLike As Boolean

    candidateIsWasherLike = IsWasherLikeThinSolid(swPart)

    If ShouldRejectImportedCandidate(swPart, candidateIsWasherLike) Then

        Debug.Print "    Imported candidate rejected after geometry filters"

        TraceRun "selected reject=imported-after-geometry component=" & _
                 g_traceComponent

        GoTo RestorePartConfiguration

    End If

    Dim partName As String

    partName = Replace(swPart.GetTitle, ".SLDPRT", "")

    partName = Replace(partName, ".sldprt", "")

    partName = CleanFileName(partName)

    Dim cfgName As String

    cfgName = CleanFileName(cfg)

    Dim thickStr As String

    thickStr = FormatThickness(GetThinSolidThickness(swPart))

    Dim outFolder As String

    outFolder = dxfFolder

    If Not selectedPlanarFaceOverride And candidateIsWasherLike Then

        outFolder = EnsureSubFolder(dxfFolder, "washerlike")

        Debug.Print "    Washerlike thin solid -> washerlike folder"

    End If

    Dim outPath As String

    Dim exportQty As Long

    exportQty = GetExportPieceCount(swPart, qty)

    outPath = outFolder & ConfiguredDxfOutputPrefix() & thickStr & "_" & g_material & "_" & _
              exportQty & "db_" & partName & "(" & cfgName & ").dxf"

    outPath = ClaimDxfOutput(outPath, partPath, cfg)
    TraceRun "output planned=" & DiagnosticLineValue(outPath) & " quantity=" & CStr(exportQty)
    If KeepExistingDxf(outPath) Then
        ok = True
        GoTo RestorePartConfiguration
    End If

    ok = ExportAssemblyContextThinSolidDxf(swAssembly, swComp, preferredFace, outPath)

    If ok Then

        If CleanProjectedDxfChamferLoops(outPath) Then

            Debug.Print "      Assembly-context DXF cleaned for chamfer boundary loops"

        End If

    End If

    Debug.Print "    RESULT: " & IIf(ok, "OK", "FAILED")

RestorePartConfiguration:

    If originalPartCfg <> "" And _
       StrComp(GetActiveConfigName(swPart), originalPartCfg, vbTextCompare) <> 0 Then

        ActivateConfigurationChecked swPart, originalPartCfg

    End If

    If Not ActivateAssemblyDocument(swAssembly) Then _
        Debug.Print "      Could not restore the exact assembly document"

    If outPath <> "" Then ok = VerifyDxfOutput(ok, outPath)
    ExportOnePartInAssemblyContext = ok

End Function

Function ActivateAssemblyDocument(swAssembly As Object) As Boolean

    ActivateAssemblyDocument = ActivateModelDocument(swAssembly)

End Function

Sub CaptureModelSelection(swModel As Object, ByRef savedObjects As Collection, _
                          ByRef savedTypes As Collection)

    Set savedObjects = New Collection

    Set savedTypes = New Collection

    If swModel Is Nothing Then Exit Sub

    Dim selMgr As Object

    Set selMgr = swModel.SelectionManager

    If selMgr Is Nothing Then Exit Sub

    Dim selectionCount As Long

    selectionCount = selMgr.GetSelectedObjectCount2(-1)

    Dim i As Long

    For i = 1 To selectionCount

        Dim selectedObject As Object

        Set selectedObject = Nothing

        On Error Resume Next

        Set selectedObject = selMgr.GetSelectedObject6(i, -1)

        On Error GoTo 0

        If Not selectedObject Is Nothing Then

            savedObjects.Add selectedObject

            savedTypes.Add CLng(selMgr.GetSelectedObjectType3(i, -1))

        End If

    Next i

End Sub

Sub RestoreModelSelection(swModel As Object, savedObjects As Collection, _
                          savedTypes As Collection)

    If swModel Is Nothing Then Exit Sub

    swModel.ClearSelection2 True

    If savedObjects Is Nothing Or savedTypes Is Nothing Then Exit Sub

    Dim i As Long

    Dim restoredCount As Long

    For i = 1 To savedObjects.Count

        Dim selectedObject As Object

        Set selectedObject = savedObjects(i)

        Dim appendSelection As Boolean

        appendSelection = (restoredCount > 0)

        Dim selectionRestored As Boolean

        selectionRestored = False

        On Error Resume Next

        Err.Clear

        If CLng(savedTypes(i)) = 20 Then

            selectionRestored = CBool(selectedObject.Select4(appendSelection, Nothing, False))

        Else

            selectionRestored = CBool(selectedObject.Select4(appendSelection, Nothing))

        End If

        If Err.Number <> 0 Or Not selectionRestored Then

            Err.Clear

            selectionRestored = CBool(selectedObject.Select2(appendSelection, 0))

        End If

        On Error GoTo 0

        If selectionRestored Then restoredCount = restoredCount + 1

    Next i

End Sub

Function FindLargestPlanarFaceOnComponent(swComp As Object) As Object

    If swComp Is Nothing Then Exit Function

    Dim bodyInfo As Variant

    Dim bodies As Variant

    bodyInfo = Empty

    bodies = Empty

    On Error Resume Next

    bodies = swComp.GetBodies3(swSolidBody, bodyInfo)

    On Error GoTo 0

    If IsEmpty(bodies) Then Exit Function

    Dim maxArea As Double

    Dim i As Long

    For i = 0 To UBound(bodies)

        Dim body As Object

        Set body = bodies(i)

        If body Is Nothing Then GoTo NextAssemblyBody

        Dim faces As Variant

        faces = Empty

        On Error Resume Next

        faces = body.GetFaces

        On Error GoTo 0

        If IsEmpty(faces) Then GoTo NextAssemblyBody

        Dim j As Long

        For j = 0 To UBound(faces)

            Dim face As Object

            Set face = faces(j)

            If IsPlanarFace(face) Then

                Dim area As Double

                area = 0#

                On Error Resume Next

                area = CDbl(face.GetArea)

                On Error GoTo 0

                If area > maxArea Then

                    maxArea = area

                    Set FindLargestPlanarFaceOnComponent = face

                End If

            End If

        Next j

NextAssemblyBody:

    Next i

End Function

Function SolidWorksObjectsAreSame(leftObject As Object, rightObject As Object) As Boolean

    If leftObject Is Nothing Or rightObject Is Nothing Then Exit Function

    On Error Resume Next

    If leftObject Is rightObject Then

        SolidWorksObjectsAreSame = True

        On Error GoTo 0

        Exit Function

    End If

    Dim sameResult As Long

    sameResult = CLng(swApp.IsSame(leftObject, rightObject))

    SolidWorksObjectsAreSame = (sameResult = swObjectSame)

    On Error GoTo 0

End Function

Function DrawingComponentsAreSame(leftDrawingComp As Object, _
                                  rightDrawingComp As Object) As Boolean

    If SolidWorksObjectsAreSame(leftDrawingComp, rightDrawingComp) Then

        DrawingComponentsAreSame = True

        Exit Function

    End If

    Dim leftComp As Object

    Dim rightComp As Object

    On Error Resume Next

    Set leftComp = leftDrawingComp.Component

    Set rightComp = rightDrawingComp.Component

    On Error GoTo 0

    DrawingComponentsAreSame = SolidWorksObjectsAreSame(leftComp, rightComp)

End Function

Function ApplyDrawingComponentVisibility(drawingComp As Object, _
                                         targetDrawingComp As Object) As Boolean

    If drawingComp Is Nothing Then Exit Function

    Dim keepVisible As Boolean

    keepVisible = DrawingComponentsAreSame(drawingComp, targetDrawingComp)

    Dim children As Variant

    children = Empty

    On Error Resume Next

    children = drawingComp.GetChildren

    On Error GoTo 0

    If Not IsEmpty(children) Then

        Dim i As Long

        For i = 0 To UBound(children)

            Dim childComp As Object

            Set childComp = children(i)

            If ApplyDrawingComponentVisibility(childComp, targetDrawingComp) Then

                keepVisible = True

            End If

        Next i

    End If

    On Error Resume Next

    drawingComp.Visible = keepVisible

    On Error GoTo 0

    ApplyDrawingComponentVisibility = keepVisible

End Function

Function FilterDrawingViewToComponent(swView As Object, swComp As Object) As Boolean

    If swView Is Nothing Or swComp Is Nothing Then Exit Function

    Dim targetDrawingComp As Object

    On Error Resume Next

    Set targetDrawingComp = swComp.GetDrawingComponent(swView)

    On Error GoTo 0

    If targetDrawingComp Is Nothing Then

        Debug.Print "      Target component was not found in assembly drawing view"

        Exit Function

    End If

    Dim rootDrawingComp As Object

    On Error Resume Next

    Set rootDrawingComp = swView.RootDrawingComponent

    On Error GoTo 0

    If rootDrawingComp Is Nothing Then Exit Function

    Dim foundTarget As Boolean

    Dim children As Variant

    children = Empty

    On Error Resume Next

    children = rootDrawingComp.GetChildren

    On Error GoTo 0

    If IsEmpty(children) Then

        foundTarget = DrawingComponentsAreSame(rootDrawingComp, targetDrawingComp)

    Else

        Dim i As Long

        For i = 0 To UBound(children)

            Dim childComp As Object

            Set childComp = children(i)

            If ApplyDrawingComponentVisibility(childComp, targetDrawingComp) Then

                foundTarget = True

            End If

        Next i

    End If

    FilterDrawingViewToComponent = foundTarget

End Function

Function ExportAssemblyContextThinSolidDxf(swAssembly As Object, swComp As Object, _
                                           preferredFace As Object, _
                                           filePath As String) As Boolean

    ExportAssemblyContextThinSolidDxf = False

    If swAssembly Is Nothing Or swComp Is Nothing Then Exit Function

    DeleteExistingFile filePath

    Dim orientationFace As Object

    Set orientationFace = Nothing

    If Not preferredFace Is Nothing Then

        If IsPlanarFace(preferredFace) Then Set orientationFace = preferredFace

    End If

    If orientationFace Is Nothing Then

        Set orientationFace = FindLargestPlanarFaceOnComponent(swComp)

    End If

    If orientationFace Is Nothing Then

        Debug.Print "      No planar assembly-context face found"

        TraceRun "component=" & g_traceComponent & _
                 " reject=no-planar-orientation-face"

        Exit Function

    End If

    Dim exportOk As Boolean

    Dim assemblyView As Object

    Dim originalOrientation As Object

    Dim savedSelectionObjects As Collection

    Dim savedSelectionTypes As Collection

    On Error GoTo ExportFailed

    If Not ActivateAssemblyDocument(swAssembly) Then

        Debug.Print "      Could not activate the exact assembly document"

        TraceRun "component=" & g_traceComponent & _
                 " reject=activate-assembly-failed"

        GoTo CleanUpAssemblyExport

    End If

    CaptureModelSelection swAssembly, savedSelectionObjects, savedSelectionTypes

    Set assemblyView = swAssembly.ActiveView

    If Not assemblyView Is Nothing Then Set originalOrientation = assemblyView.Orientation3

    swAssembly.ClearSelection2 True

    Dim faceSelected As Boolean

    faceSelected = CBool(orientationFace.Select4(False, Nothing))

    If Not faceSelected Then

        Debug.Print "      Could not select assembly-context face for Normal To"

        TraceRun "component=" & g_traceComponent & _
                 " reject=orientation-face-selection-failed"

        GoTo CleanUpAssemblyExport

    End If

    swAssembly.ShowNamedView2 "*Normal To", -1

    swAssembly.ViewZoomtofit2

    Dim exportOrientation As Object

    If swAssembly.ActiveView Is Nothing Then

        TraceRun "component=" & g_traceComponent & _
                 " reject=assembly-active-view-missing"

        GoTo CleanUpAssemblyExport

    End If

    Set exportOrientation = swAssembly.ActiveView.Orientation3

    swAssembly.ClearSelection2 True

    exportOk = ExportAssemblyComponentViaTemporaryPart( _
        swComp, exportOrientation, filePath)

    TraceRun "component=" & g_traceComponent & _
             " assembly-context-exported=" & CStr(exportOk)

    If Not exportOk Then

        Debug.Print "      Temporary-part assembly-context export failed"

    End If

    GoTo CleanUpAssemblyExport

ExportFailed:

    Debug.Print "      Assembly-context export error " & Err.Number & ": " & Err.Description

    TraceRun "component=" & g_traceComponent & _
             " reject=assembly-context-exception error=" & CStr(Err.Number) & _
             " description=" & DiagnosticLineValue(Err.Description)

    Err.Clear

CleanUpAssemblyExport:

    On Error Resume Next

    ActivateAssemblyDocument swAssembly

    swAssembly.ClearSelection2 True

    If Not assemblyView Is Nothing And Not originalOrientation Is Nothing Then

        Set assemblyView.Orientation3 = originalOrientation

    End If

    RestoreModelSelection swAssembly, savedSelectionObjects, savedSelectionTypes

    On Error GoTo 0

    ExportAssemblyContextThinSolidDxf = exportOk

End Function

Function ExportAssemblyComponentViaTemporaryPart(swComp As Object, _
                                                  exportOrientation As Object, _
                                                  filePath As String) As Boolean

    ExportAssemblyComponentViaTemporaryPart = False

    If swComp Is Nothing Or exportOrientation Is Nothing Then Exit Function

    Dim stage As String

    Dim tempPartTitle As String

    Dim tempPartPath As String

    Dim exportOk As Boolean

    Dim swTempPart As Object

    On Error GoTo ExportFailed

    stage = "getting assembly-context bodies"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    Dim bodyInfo As Variant

    Dim bodies As Variant

    bodyInfo = Empty

    bodies = Empty

    bodies = swComp.GetBodies3(swSolidBody, bodyInfo)

    If IsEmpty(bodies) Then

        TraceRun "component=" & g_traceComponent & _
                 " reject=no-assembly-context-bodies"

        GoTo CleanUpTemporaryPart

    End If

    stage = "getting the component transform"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    Dim compTransform As Object

    Set compTransform = Nothing

    On Error Resume Next

    Set compTransform = swComp.GetTotalTransform(False)

    If compTransform Is Nothing Then Set compTransform = swComp.Transform2

    On Error GoTo ExportFailed

    stage = "copying assembly-context bodies"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    Dim bodyCopies As Collection

    Set bodyCopies = New Collection

    Dim i As Long

    For i = 0 To UBound(bodies)
        If DxfStopRequested() Then GoTo CleanUpTemporaryPart

        Dim sourceBody As Object

        Dim bodyCopy As Object

        Set sourceBody = bodies(i)

        Set bodyCopy = Nothing

        On Error Resume Next

        Set bodyCopy = sourceBody.Copy2(True)

        If bodyCopy Is Nothing Then Set bodyCopy = sourceBody.Copy

        On Error GoTo ExportFailed

        If bodyCopy Is Nothing Then

            TraceRun "component=" & g_traceComponent & _
                     " reject=body-copy-failed index=" & CStr(i)

            GoTo CleanUpTemporaryPart

        End If

        If Not compTransform Is Nothing Then

            If Not CBool(bodyCopy.ApplyTransform(compTransform)) Then

                TraceRun "component=" & g_traceComponent & _
                         " reject=body-transform-failed index=" & CStr(i)

                GoTo CleanUpTemporaryPart

            End If

        End If

        bodyCopies.Add bodyCopy

    Next i

    If bodyCopies.Count = 0 Then

        TraceRun "component=" & g_traceComponent & _
                 " reject=no-copied-bodies"

        GoTo CleanUpTemporaryPart

    End If

    stage = "creating the temporary part"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    Dim newPartResult As Object

    Set newPartResult = swApp.NewPart

    Set swTempPart = newPartResult

    If newPartResult Is Nothing Or swTempPart Is Nothing Then

        TraceRun "component=" & g_traceComponent & _
                 " reject=temporary-part-creation-failed"

        GoTo CleanUpTemporaryPart

    End If

    tempPartTitle = swTempPart.GetTitle

    stage = "inserting copied bodies"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    Dim insertedCount As Long

    For i = 1 To bodyCopies.Count
        If DxfStopRequested() Then GoTo CleanUpTemporaryPart

        Dim importedFeature As Object

        Set importedFeature = Nothing

        On Error Resume Next

        Set importedFeature = swTempPart.CreateFeatureFromBody3( _
            bodyCopies(i), False, 1)

        If importedFeature Is Nothing Then

            Err.Clear

            Set importedFeature = swTempPart.CreateFeatureFromBody3( _
                bodyCopies(i), False, 0)

        End If

        On Error GoTo ExportFailed

        If Not importedFeature Is Nothing Then insertedCount = insertedCount + 1

    Next i

    If insertedCount <> bodyCopies.Count Then

        TraceRun "component=" & g_traceComponent & _
                 " reject=temporary-body-insert-count expected=" & _
                 CStr(bodyCopies.Count) & " actual=" & CStr(insertedCount)

        GoTo CleanUpTemporaryPart

    End If

    swTempPart.EditRebuild3

    stage = "saving the temporary part"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    Dim runId As String

    runId = Format$(Now, "yyyymmdd_hhnnss") & "_" & CStr(CLng(Timer * 1000#))

    tempPartPath = Environ$("TEMP") & "\Excelsis_DXF_" & runId & ".SLDPRT"

    Dim saveErrors As Long

    Dim saveWarnings As Long

    Dim saved As Boolean

    saved = CBool(swTempPart.Extension.SaveAs( _
                    tempPartPath, swSaveAsCurrentVersion, _
                    swSaveAsOptions_Silent, Nothing, saveErrors, saveWarnings))

    If Not saved Or Not PathFileExists(tempPartPath) Then

        TraceRun "component=" & g_traceComponent & _
                 " reject=temporary-part-save-failed saved=" & CStr(saved) & _
                 " errors=" & CStr(saveErrors) & _
                 " warnings=" & CStr(saveWarnings)

        GoTo CleanUpTemporaryPart

    End If

    stage = "applying the assembly orientation"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    Dim tempView As Object

    Set tempView = swTempPart.ActiveView

    If Not tempView Is Nothing Then Set tempView.Orientation3 = exportOrientation

    swTempPart.ViewZoomtofit2

    stage = "exporting the temporary part current view"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    exportOk = ExportCurrentViewToDxf(swTempPart, filePath)

    TraceRun "component=" & g_traceComponent & _
             " temporary-current-view-exported=" & CStr(exportOk)

    GoTo CleanUpTemporaryPart

ExportFailed:

    Debug.Print "      Temporary-part export error " & Err.Number & _
                " at " & stage & ": " & Err.Description

    TraceRun "component=" & g_traceComponent & " error-stage=" & stage & _
             " error=" & CStr(Err.Number)

    Err.Clear

CleanUpTemporaryPart:

    On Error Resume Next

    TraceRun "component=" & g_traceComponent & " stage=temporary-part-cleanup"

    If Not swTempPart Is Nothing Then

        tempPartTitle = GetDocumentActivationName(swTempPart)

        If Not ActivateModelDocument(swTempPart) Then _
            TraceRun "component=" & g_traceComponent & " temp-activation-failed"

        Set tempView = Nothing
        Set importedFeature = Nothing
        Set sourceBody = Nothing
        Set bodyCopy = Nothing
        Set newPartResult = Nothing
        Set bodyCopies = Nothing
        Set compTransform = Nothing
        bodies = Empty
        bodyInfo = Empty
        Set swTempPart = Nothing

        If Not CloseTemporaryExportDocument(tempPartPath, tempPartTitle) Then
            ExportAssemblyComponentViaTemporaryPart = False
            Exit Function
        End If
    End If

    If tempPartPath <> "" Then

        DeleteFileIfExists tempPartPath

        If PathFileExists(tempPartPath) Then _
            TraceRun "component=" & g_traceComponent & " temp-file-remained-locked"

    End If

    TraceRun "component=" & g_traceComponent & " stage=temporary-part-cleanup-complete"

    On Error GoTo 0

    ExportAssemblyComponentViaTemporaryPart = exportOk

End Function

Function CloseTemporaryExportDocument(tempPath As String, tempTitle As String) As Boolean
    Dim remaining As Object, identity As String
    If tempTitle = "" Then
        If g_stopBatchReason = "" Then g_stopBatchReason = "Temporary export part has no safe close identity."
        Exit Function
    End If
    identity = tempPath
    If identity = "" Then identity = tempTitle
    On Error Resume Next
    swApp.QuitDoc tempTitle
    DoEvents
    Set remaining = swApp.GetOpenDocumentByName(identity)
    ' A failed save can leave the temporary part untitled.
    If remaining Is Nothing Then Set remaining = swApp.GetOpenDocumentByName(tempTitle)
    If Not remaining Is Nothing Then
        identity = CStr(remaining.GetPathName)
        If identity = "" Then identity = CStr(remaining.GetTitle)
        Set remaining = Nothing
        If identity <> "" Then swApp.CloseDoc identity
    End If
    On Error GoTo 0
    CloseTemporaryExportDocument = VerifyTemporaryPartClosed(tempPath, tempTitle)
End Function

Function VerifyTemporaryPartClosed(tempPath As String, tempTitle As String) As Boolean
    Dim windows As Collection, model As Object, snapshotOk As Boolean, i As Long
    On Error GoTo Failed
    Set windows = GetModelWindowDocuments(snapshotOk)
    If Not snapshotOk Or windows Is Nothing Then GoTo Failed
    For i = 1 To windows.Count
        Set model = windows(i)
        If CStr(model.GetPathName) <> "" Then
            If StrComp(CStr(model.GetPathName), tempPath, vbTextCompare) = 0 Then GoTo Failed
        Else
            If StrComp(CStr(model.GetTitle), tempTitle, vbTextCompare) = 0 Then GoTo Failed
        End If
    Next i
    VerifyTemporaryPartClosed = True
    TraceRun "cleanup temporary-window-closed title=" & tempTitle
    Exit Function
Failed:
    If g_stopBatchReason = "" Then g_stopBatchReason = "Could not verify closure of a temporary export part; batch stopped."
    TraceRun "cleanup reject=temporary-window-not-closed title=" & tempTitle
End Function

' ================================================================

Function ExportSMFlatPattern(swPart As Object, filePath As String) As Boolean
    Dim swFeat As Object, originalState As Long, changed As Boolean
    Dim bRet As Boolean, errs As Long, warns As Long, errorNumber As Long
    On Error GoTo Failed
    DeleteExistingFile filePath
    swPart.ClearSelection2 True
    On Error Resume Next
    Err.Clear
    bRet = swPart.ExportToDWG2(filePath, swPart.GetPathName, swExportToDWG_ExportSheetMetal, True, Empty, False, False, SHEET_METAL_EXPORT_OPTIONS, Empty)
    errorNumber = Err.Number
    On Error GoTo Failed
    TraceRun "sheetmetal method=direct ok=" & CStr(bRet) & " error=" & CStr(errorNumber)
    If bRet And PathFileExists(filePath) Then
        ExportSMFlatPattern = True
        Exit Function
    End If
    Set swFeat = FindFlatPatternFeat(swPart)
    If swFeat Is Nothing Then
        TraceRun "sheetmetal reject=no-flat-pattern"
        Exit Function
    End If
    originalState = FeatureSuppressionState(swFeat)
    If originalState < 0 Then
        TraceRun "sheetmetal reject=unknown-flat-pattern-state"
        Exit Function
    End If
    If originalState = 1 Then
        changed = True
        If Not SetFeatureSuppressionChecked(swFeat, False) Then GoTo RestoreFlatPattern
        swPart.EditRebuild3
    End If
    DeleteExistingFile filePath
    swPart.ClearSelection2 True
    swFeat.Select True
    swPart.EditRebuild3
    bRet = False
    On Error Resume Next
    Err.Clear
    bRet = swPart.ExportToDWG2(filePath, swPart.GetPathName, swExportToDWG_ExportSheetMetal, True, Empty, False, False, SHEET_METAL_EXPORT_OPTIONS, Empty)
    errorNumber = Err.Number
    On Error GoTo Failed
    TraceRun "sheetmetal method=selected-flat ok=" & CStr(bRet) & " error=" & CStr(errorNumber)
    If bRet And PathFileExists(filePath) Then
        ExportSMFlatPattern = True
        GoTo RestoreFlatPattern
    End If
    DeleteExistingFile filePath
    bRet = False
    On Error Resume Next
    Err.Clear
    bRet = swPart.ExportFlatPatternView(filePath, swExportFlatPatternOption_RemoveBends)
    If bRet Then bRet = swPart.Extension.SaveAs(filePath, swSaveAsCurrentVersion, swSaveAsOptions_Silent, Nothing, errs, warns)
    errorNumber = Err.Number
    On Error GoTo Failed
    TraceRun "sheetmetal method=flat-view ok=" & CStr(bRet) & " error=" & CStr(errorNumber) & _
             " save-errors=" & CStr(errs) & " warnings=" & CStr(warns)
    ExportSMFlatPattern = (bRet And PathFileExists(filePath))
RestoreFlatPattern:
    On Error Resume Next
    swPart.ClearSelection2 True
    If changed Then
        If Not SetFeatureSuppressionChecked(swFeat, True) Then _
            TraceRun "sheetmetal restore-failed=flat-pattern-suppression"
        swPart.EditRebuild3
    End If
    On Error GoTo 0
    Exit Function
Failed:
    TraceRun "sheetmetal reject=api-error number=" & CStr(Err.Number) & _
             " description=" & DiagnosticLineValue(Err.Description)
    ExportSMFlatPattern = False
    Resume RestoreFlatPattern
End Function

Function SetFeatureSuppressionChecked(feature As Object, suppress As Boolean) As Boolean
    Dim action As Long, expected As Long, ok As Boolean
    expected = Abs(CLng(suppress))
    If FeatureSuppressionState(feature) = expected Then
        SetFeatureSuppressionChecked = True
        Exit Function
    End If
    If suppress Then action = swSuppressFeature Else action = swUnSuppressFeature
    On Error GoTo Failed
    ok = CBool(feature.SetSuppression2(action, swThisConfiguration, Empty))
    SetFeatureSuppressionChecked = (ok And FeatureSuppressionState(feature) = expected)
    TraceRun "feature-suppression current-configuration-only action=" & CStr(action) & _
             " verified=" & CStr(SetFeatureSuppressionChecked)
    Exit Function
Failed:
    TraceRun "feature-suppression failed error=" & CStr(Err.Number)
End Function



