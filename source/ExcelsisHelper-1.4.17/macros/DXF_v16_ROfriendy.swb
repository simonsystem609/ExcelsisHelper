Function ExportCurrentViewToDxf(swModel As Object, filePath As String) As Boolean

    ExportCurrentViewToDxf = False

    If swModel Is Nothing Then Exit Function

    Dim originalHideAllTypes As Boolean

    Dim hideAllTypesStateRead As Boolean

    Dim hideAllTypesChanged As Boolean

    On Error Resume Next

    Err.Clear

    originalHideAllTypes = CBool( _
        swModel.GetUserPreferenceToggle(swViewDisplayHideAllTypes))

    hideAllTypesStateRead = (Err.Number = 0)

    Err.Clear

    If hideAllTypesStateRead And Not originalHideAllTypes Then

        hideAllTypesChanged = CBool( _
            swModel.SetUserPreferenceToggle(swViewDisplayHideAllTypes, True))

        If Err.Number <> 0 Then

            hideAllTypesChanged = False

            Err.Clear

        End If

    End If

    If hideAllTypesChanged Then swModel.GraphicsRedraw2

    On Error GoTo 0

    DeleteExistingFile filePath

    Dim varAlignment As Variant

    varAlignment = DefaultDwgAlignment()

    Dim dataViews(0) As String

    dataViews(0) = "*Current"

    Dim varViews As Variant

    varViews = dataViews

    Dim modelName As String

    On Error Resume Next

    modelName = swModel.GetPathName

    If Len(modelName) = 0 Then modelName = swModel.GetTitle

    Dim ok As Boolean

    Dim exportErr As Long

    Dim exportErrDescription As String

    Err.Clear

    ok = swModel.ExportToDWG2(filePath, modelName, _
                              swExportToDWG_ExportAnnotationViews, _
                              True, varAlignment, False, False, 0, varViews)

    exportErr = Err.Number

    exportErrDescription = Err.Description

    On Error GoTo 0

    If exportErr <> 0 Then

        Debug.Print "      Current-view ExportToDWG2 error " & exportErr & ": " & exportErrDescription

        TraceRun "component=" & g_traceComponent & _
                 " reject=current-view-export-error error=" & CStr(exportErr) & _
                 " description=" & DiagnosticLineValue(exportErrDescription)

        GoTo RestoreCurrentViewDisplayState

    End If

    If ok And PathFileExists(filePath) Then

        On Error Resume Next

        ExportCurrentViewToDxf = (FileLen(filePath) > 0)

        On Error GoTo 0

    End If

    TraceRun "component=" & g_traceComponent & _
             " current-view-exported=" & CStr(ExportCurrentViewToDxf) & _
             " api-ok=" & CStr(ok) & _
             " file-exists=" & CStr(PathFileExists(filePath))

RestoreCurrentViewDisplayState:

    On Error Resume Next

    If hideAllTypesChanged Then

        swModel.SetUserPreferenceToggle swViewDisplayHideAllTypes, _
                                        originalHideAllTypes

        swModel.GraphicsRedraw2

    End If

    On Error GoTo 0

End Function

Function ExportNormalViewToDxf(swPart As Object, swFace As Object, _
                               filePath As String) As Boolean

    ExportNormalViewToDxf = False

    If swPart Is Nothing Or swFace Is Nothing Then Exit Function

    If Not IsPlanarFace(swFace) Then Exit Function

    Dim modelView As Object

    Dim originalOrientation As Object

    Dim savedSelectionObjects As Collection

    Dim savedSelectionTypes As Collection

    CaptureModelSelection swPart, savedSelectionObjects, savedSelectionTypes

    Set modelView = swPart.ActiveView

    If Not modelView Is Nothing Then Set originalOrientation = modelView.Orientation3

    swPart.ClearSelection2 True

    Dim selected As Boolean

    On Error Resume Next

    selected = CBool(swFace.Select4(False, Nothing))

    If Not selected Then

        Err.Clear

        selected = CBool(swFace.Select(False))

    End If

    On Error GoTo 0

    If selected Then

        On Error Resume Next

        swPart.ShowNamedView2 "*Normal To", -1

        swPart.ViewZoomtofit2

        On Error GoTo 0

        swPart.ClearSelection2 True

        ExportNormalViewToDxf = ExportCurrentViewToDxf(swPart, filePath)

    Else

        Debug.Print "      Could not select planar face for Normal To export"

    End If

    On Error Resume Next

    swPart.ClearSelection2 True

    If Not modelView Is Nothing And Not originalOrientation Is Nothing Then

        Set modelView.Orientation3 = originalOrientation

    End If

    RestoreModelSelection swPart, savedSelectionObjects, savedSelectionTypes

    On Error GoTo 0

End Function

' ================================================================

Function ExportBestViewFast(swPart As Object, filePath As String) As Boolean

    Dim cutFace As Object

    Set cutFace = FindLargestPlanarFace(swPart)

    If Not cutFace Is Nothing Then

        If ExportNormalViewToDxf(swPart, cutFace, filePath) Then

            ExportBestViewFast = True

            Exit Function

        End If

        Debug.Print "      Normal current-view DXF failed, trying annotation views"

    End If

    Dim box As Variant
    box = SafeGetPartBox(swPart)

    If IsEmpty(box) Then

        ExportBestViewFast = False

        Exit Function

    End If



    Dim x As Double

    Dim y As Double

    Dim z As Double

    x = Abs(box(3) - box(0))

    y = Abs(box(4) - box(1))

    z = Abs(box(5) - box(2))



    Dim pV As Variant

    Dim fV As Variant

    If x <= y And x <= z Then

        pV = Array("*Right", "*Left")

        fV = Array("*Top", "*Bottom", "*Front", "*Back")

    ElseIf y <= x And y <= z Then

        pV = Array("*Top", "*Bottom")

        fV = Array("*Front", "*Back", "*Right", "*Left")

    Else

        pV = Array("*Front", "*Back")

        fV = Array("*Top", "*Bottom", "*Right", "*Left")

    End If



    If TryViews(swPart, filePath, pV) Then

        ExportBestViewFast = True

        Exit Function

    End If

    If TryViews(swPart, filePath, fV) Then

        ExportBestViewFast = True

        Exit Function

    End If

    ExportBestViewFast = False

End Function

Function ExportProjectedViewFast(swPart As Object, filePath As String) As Boolean

    Debug.Print "      --- ExportProjectedViewFast ---"

    Dim cutFace As Object

    Set cutFace = FindLargestPlanarFace(swPart)

    If Not cutFace Is Nothing Then

        If ExportNormalViewToDxf(swPart, cutFace, filePath) Then

            ExportProjectedViewFast = True

            Exit Function

        End If

        Debug.Print "      Normal current-view DXF failed, trying named annotation views"

    End If

    Dim box As Variant
    box = SafeGetPartBox(swPart)

    If IsEmpty(box) Then Exit Function

    Dim x As Double

    Dim y As Double

    Dim z As Double

    x = Abs(box(3) - box(0))

    y = Abs(box(4) - box(1))

    z = Abs(box(5) - box(2))

    Dim pV As Variant

    Dim fV As Variant

    If x <= y And x <= z Then

        pV = Array("*Right", "*Left")

        fV = Array("*Top", "*Bottom", "*Front", "*Back")

    ElseIf y <= x And y <= z Then

        pV = Array("*Top", "*Bottom")

        fV = Array("*Front", "*Back", "*Right", "*Left")

    Else

        pV = Array("*Front", "*Back")

        fV = Array("*Top", "*Bottom", "*Right", "*Left")

    End If

    If TryViews(swPart, filePath, pV) Then

        ExportProjectedViewFast = True

        Exit Function

    End If

    If TryViews(swPart, filePath, fV) Then

        ExportProjectedViewFast = True

        Exit Function

    End If

End Function



Function TryViews(swPart As Object, filePath As String, viewsArr As Variant) As Boolean

    Dim i As Integer

    For i = 0 To UBound(viewsArr)

        Debug.Print "      Trying annotation view: " & viewsArr(i)

        Dim oneView(0) As String

        oneView(0) = CStr(viewsArr(i))

        Dim varViews As Variant

        varViews = oneView

        Dim varAlignment As Variant

        varAlignment = DefaultDwgAlignment()

        DeleteExistingFile filePath

        Dim ok As Boolean

        On Error Resume Next

        ok = swPart.ExportToDWG2(filePath, swPart.GetPathName, swExportToDWG_ExportAnnotationViews, True, varAlignment, False, False, 0, varViews)

        On Error GoTo 0

        If ok And PathFileExists(filePath) Then

            Debug.Print "      Annotation view used: " & viewsArr(i)

            TryViews = True

            Exit Function

        End If

    Next i

    TryViews = False

End Function

' ================================================================

Function ExportSelectedFaceToDxf(swPart As Object, swFace As Object, filePath As String) As Boolean

    DeleteExistingFile filePath

    swPart.ClearSelection2 True

    Dim selOk As Boolean

    On Error Resume Next

    selOk = swFace.Select4(False, Nothing)

    If Not selOk Then

        Err.Clear

        selOk = swFace.Select(False)

    End If

    On Error GoTo 0

    If Not selOk Then

        Debug.Print "      Could not select planar face for DXF"

        Exit Function

    End If

    Dim varAlignment As Variant

    varAlignment = DefaultDwgAlignment()

    Dim ok As Boolean

    On Error Resume Next

    ok = swPart.ExportToDWG2(filePath, swPart.GetPathName, swExportToDWG_ExportSelectedFacesOrLoops, True, varAlignment, False, False, 0, Empty)

    On Error GoTo 0

    swPart.ClearSelection2 True

    ExportSelectedFaceToDxf = (ok And PathFileExists(filePath))

End Function

Function FindLargestPlanarFace(swPart As Object) As Object

    Dim bodies As Variant

    bodies = GetPartBodies(swPart)

    Set FindLargestPlanarFace = FindLargestPlanarFaceInBodies(bodies)
End Function

Function FindLargestPlanarFaceInBodies(bodies As Variant) As Object

    If IsEmpty(bodies) Then Exit Function

    Dim maxArea As Double

    maxArea = 0#

    Dim i As Long

    For i = 0 To UBound(bodies)

        Dim b As Object

        Set b = bodies(i)

        If Not b Is Nothing Then

            Dim faces As Variant

            faces = Empty

            On Error Resume Next

            faces = b.GetFaces

            On Error GoTo 0

            If Not IsEmpty(faces) Then

                Dim j As Long

                For j = 0 To UBound(faces)

                    Dim f As Object

                    Set f = faces(j)

                    If IsPlanarFace(f) Then

                        Dim a As Double

                        On Error Resume Next

                        a = 0#
                    a = f.GetArea

                        On Error GoTo 0

                        If a > maxArea Then

                            maxArea = a

                            Set FindLargestPlanarFaceInBodies = f

                        End If

                    End If

                Next j

            End If

        End If

    Next i

End Function

Function IsPlanarFace(swFace As Object) As Boolean

    If swFace Is Nothing Then Exit Function

    Dim surf As Object

    On Error Resume Next

    Set surf = swFace.GetSurface

    If Not surf Is Nothing Then IsPlanarFace = surf.IsPlane

    On Error GoTo 0

End Function

Function DefaultDwgAlignment() As Variant

    Dim data(11) As Double

    data(3) = 1#

    data(7) = 1#

    data(11) = 1#

    DefaultDwgAlignment = data

End Function

Function GetPartBodies(swPart As Object) As Variant

    Dim bodies As Variant

    On Error Resume Next

    bodies = swPart.GetBodies2(0, False)

    On Error GoTo 0

    If IsEmpty(bodies) Then

        On Error Resume Next

        bodies = swPart.GetBodies(0)

        On Error GoTo 0

    End If

    If IsEmpty(bodies) Then

        GetPartBodies = Empty

    Else

        GetPartBodies = bodies

    End If

End Function

Function CountPartSolidBodies(swPart As Object) As Long
    CountPartSolidBodies = 1

    If swPart Is Nothing Then Exit Function

    Dim bodies As Variant

    bodies = GetPartBodies(swPart)

    If IsEmpty(bodies) Then Exit Function
    If Not IsArray(bodies) Then Exit Function

    Dim bodyCount As Long
    Dim bodyIndex As Long

    For bodyIndex = LBound(bodies) To UBound(bodies)

        Dim body As Object

        Set body = Nothing

        On Error Resume Next
        Set body = bodies(bodyIndex)
        On Error GoTo 0

        If Not body Is Nothing Then bodyCount = bodyCount + 1

    Next bodyIndex

    If bodyCount > 0 Then CountPartSolidBodies = bodyCount

End Function

Function GetExportPieceCount(swPart As Object, occurrenceQty As Long) As Long
    Dim normalizedQty As Long

    normalizedQty = occurrenceQty
    If normalizedQty < 1 Then normalizedQty = 1

    Dim solidBodyCount As Long

    solidBodyCount = CountPartSolidBodies(swPart)
    If solidBodyCount < 1 Then solidBodyCount = 1

    GetExportPieceCount = normalizedQty * solidBodyCount

    TraceRun "piece-count occurrences=" & CStr(normalizedQty) & _
             " solid-bodies=" & CStr(solidBodyCount) & _
             " exported-pieces=" & CStr(GetExportPieceCount) & _
             " component=" & g_traceComponent

End Function

Function IsPartPath(pathName As String) As Boolean

    IsPartPath = (LCase(Right(pathName, 6)) = "sldprt")

End Function

Function IsAssemblyPath(pathName As String) As Boolean

    IsAssemblyPath = (LCase(Right(pathName, 6)) = "sldasm")

End Function

Function IsImportedPartPath(pathName As String) As Boolean

    Dim p As String

    p = LCase(pathName)

    If InStr(1, p, ".stp.", vbTextCompare) > 0 Then IsImportedPartPath = True
    If InStr(1, p, ".step.", vbTextCompare) > 0 Then IsImportedPartPath = True
    If InStr(1, p, "\ic~~\", vbTextCompare) > 0 Then IsImportedPartPath = True
    If InStr(1, p, "\swx", vbTextCompare) > 0 And InStr(1, p, "\appdata\local\temp\", vbTextCompare) > 0 Then IsImportedPartPath = True

End Function

Function IsImportedAssemblyComponent(swComp As Object) As Boolean
    Dim hint As String
    hint = ComponentImportHint(swComp)
    If hint = "#UNKNOWN" Then
        g_importUnknown = True
    ElseIf hint <> "" Then
        IsImportedAssemblyComponent = True
        TraceRun "import hit=component-path source=" & DiagnosticLineValue(hint)
    End If
End Function

Function ComponentImportHint(swComp As Object) As String
    If swComp Is Nothing Then Exit Function
    On Error GoTo Failed
    ComponentImportHint = Trim$(CStr(swComp.GetImportedPath))
    Exit Function
Failed:
    ComponentImportHint = "#UNKNOWN"
    TraceRun "import component-path unavailable error=" & CStr(Err.Number)
End Function

Function FeatureSuppressionState(feature As Object) As Long
    Dim states As Variant
    FeatureSuppressionState = -1
    On Error Resume Next
    Err.Clear
    states = feature.IsSuppressed2(swThisConfiguration, Empty)
    If Err.Number = 0 And IsArray(states) Then
        FeatureSuppressionState = Abs(CLng(states(LBound(states))))
    Else
        Err.Clear
        FeatureSuppressionState = Abs(CLng(feature.IsSuppressed))
        If Err.Number <> 0 Then FeatureSuppressionState = -1
    End If
    On Error GoTo 0
End Function

Function FeatureTreeHasImport(owner As Object) As Boolean
    Dim pending As Collection, entry As Variant
    Dim f As Object, nextFeature As Object, child As Object
    Dim count As Long, depth As Long, isSub As Boolean, state As Long
    Dim typeName As String, featureName As String, isInterconnect As Boolean
    Dim probeError As Long
    Set pending = New Collection
    On Error GoTo Failed
    Set f = owner.FirstFeature
    If Not f Is Nothing Then pending.Add Array(f, 0&, False)
    Do While pending.Count > 0
        If count >= 2048 Then
            g_importUnknown = True
            TraceRun "import unknown=feature-walk-limit count=" & CStr(count)
            Exit Function
        End If
        entry = pending(pending.Count)
        pending.Remove pending.Count
        Set f = entry(0): depth = CLng(entry(1)): isSub = CBool(entry(2))
        count = count + 1
        Set nextFeature = Nothing
        If isSub Then
            Set nextFeature = f.GetNextSubFeature
        Else
            Set nextFeature = f.GetNextFeature
        End If
        If Not nextFeature Is Nothing Then pending.Add Array(nextFeature, depth, isSub)
        state = FeatureSuppressionState(f)
        If state <> 1 Then
            If state < 0 Then g_importUnknown = True
            typeName = "": featureName = "": isInterconnect = False
            typeName = LCase$(CStr(f.GetTypeName2))
            featureName = LCase$(CStr(f.Name))
            On Error Resume Next
            Err.Clear
            isInterconnect = CBool(f.Is3DInterconnectFeature)
            probeError = Err.Number
            On Error GoTo Failed
            ' Older SOLIDWORKS versions lack this optional API.
            If probeError <> 0 And probeError <> 438 And probeError <> 445 Then g_importUnknown = True
            If InStr(1, typeName, "import", vbTextCompare) > 0 Or _
               Left$(featureName, 8) = "imported" Or _
               InStr(1, featureName, ".stp", vbTextCompare) > 0 Or _
               InStr(1, featureName, ".step", vbTextCompare) > 0 Or isInterconnect Then
                FeatureTreeHasImport = True
                TraceRun "import hit=feature type=" & DiagnosticLineValue(typeName) & _
                         " name=" & DiagnosticLineValue(featureName) & " depth=" & CStr(depth) & _
                         " interconnect=" & CStr(isInterconnect) & " suppression=" & CStr(state)
                Exit Function
            End If
            Set child = f.GetFirstSubFeature
            If Not child Is Nothing Then
                If depth >= 32 Then
                    g_importUnknown = True
                    TraceRun "import unknown=feature-depth-limit"
                Else
                    pending.Add Array(child, depth + 1, True)
                End If
            End If
        End If
    Loop
    TraceRun "import feature-walk count=" & CStr(count) & " incomplete=" & CStr(g_importUnknown)
    Exit Function
Failed:
    g_importUnknown = True
    TraceRun "import unknown=feature-api-error number=" & CStr(Err.Number) & _
             " description=" & DiagnosticLineValue(Err.Description)
End Function

Function CandidatePreflightAllows(ByVal swComp As Object, ByVal partPath As String, ByVal cfg As String, _
                                  ByVal useContext As Boolean, ByVal mode As Integer, ByVal hasSelectedFace As Boolean) As Boolean
    Dim model As Object, bodies As Variant, toolboxType As Long, key As String
    CandidatePreflightAllows = True
    On Error GoTo DeferInspection
    key = LCase$(partPath)
    If g_preflightToolbox.Exists(key) Then
        If CBool(g_preflightToolbox(key)) Then GoTo ToolboxRejected
    Else
        If Not swComp Is Nothing Then Set model = swComp.GetModelDoc2
        If model Is Nothing Then Set model = swApp.GetOpenDocumentByName(partPath)
        If Not model Is Nothing Then
            toolboxType = CLng(model.Extension.ToolboxPartType)
            g_preflightToolbox.Add key, (toolboxType <> 0)
            If toolboxType <> 0 Then GoTo ToolboxRejected
        End If
    End If
    If mode <> MODE_REGULAR Or hasSelectedFace Then Exit Function
    key = key & "@" & cfg
    If Not useContext And g_preflightRejected.Exists(key) Then GoTo ShapeRejected
    If useContext Then
        If swComp Is Nothing Then Exit Function
        ' Lightweight bodies may not report sheet metal reliably.
        If IsComponentLightweightSafe(swComp) Then Exit Function
        If ComponentBodiesMayBeSheetLike(swComp) Then Exit Function
    Else
        If model Is Nothing And Not swComp Is Nothing Then Set model = swComp.GetModelDoc2
        If model Is Nothing Then Set model = swApp.GetOpenDocumentByName(partPath)
        If model Is Nothing Then Exit Function
        If StrComp(GetActiveConfigName(model), cfg, vbTextCompare) <> 0 Then
            TraceRun "preflight defer=source-configuration-not-loaded requested=" & cfg
            Exit Function
        End If
        bodies = model.GetBodies2(swSolidBody, False)
        If BodiesMayBeSheetLike(bodies) Then Exit Function
        g_preflightRejected(key) = True
    End If
ShapeRejected:
    CandidatePreflightAllows = False
    TraceRun "preflight reject=non-sheet-body before-open path=" & DiagnosticLineValue(partPath)
    Exit Function
ToolboxRejected:
    CandidatePreflightAllows = False
    TraceRun "preflight reject=toolbox before-open path=" & DiagnosticLineValue(partPath)
    Exit Function
DeferInspection:
    TraceRun "preflight defer=metadata-unavailable error=" & CStr(Err.Number)
End Function

Function BodiesMayBeSheetLike(bodies As Variant) As Boolean
    Dim b As Object, i As Long, t As Double, w As Double, length As Double
    BodiesMayBeSheetLike = True
    On Error GoTo DeferInspection
    If IsEmpty(bodies) Then GoTo DeferInspection
    If Not IsArray(bodies) Then GoTo DeferInspection
    For i = LBound(bodies) To UBound(bodies)
        Set b = bodies(i)
        If CBool(b.IsSheetMetal) Then Exit Function
    Next i
    If Not GetBodiesPlateDimensions(bodies, t, w, length) Then GoTo DeferInspection
    BodiesMayBeSheetLike = (t <= THICKNESS_LIMIT And _
        w >= t * THIN_PLATE_MIN_RATIO And length >= t * THIN_PLATE_MIN_RATIO)
    TraceRun "body-prefilter accepted=" & CStr(BodiesMayBeSheetLike) & _
             " t-mm=" & CStr(t) & " width-mm=" & CStr(w) & " length-mm=" & CStr(length)
    Exit Function
DeferInspection:
    TraceRun "body-prefilter defer=geometry-unavailable error=" & CStr(Err.Number)
End Function

Function ComponentBodiesMayBeSheetLike(swComp As Object) As Boolean
    Dim bodyInfo As Variant, bodies As Variant
    ComponentBodiesMayBeSheetLike = True
    On Error GoTo DeferInspection
    bodies = swComp.GetBodies3(swSolidBody, bodyInfo)
    ComponentBodiesMayBeSheetLike = BodiesMayBeSheetLike(bodies)
    Exit Function
DeferInspection:
    TraceRun "component-prefilter defer=geometry-unavailable error=" & CStr(Err.Number)
End Function

Function IsImportedGeometryPart(swPart As Object) As Boolean
    Dim pathName As String
    If swPart Is Nothing Then
        g_importUnknown = True
        Exit Function
    End If
    On Error GoTo Failed
    pathName = swPart.GetPathName
    If IsImportedPartPath(pathName) Then
        TraceRun "import hit=part-path path=" & DiagnosticLineValue(pathName)
        IsImportedGeometryPart = True
    Else
        IsImportedGeometryPart = FeatureTreeHasImport(swPart)
    End If
    Exit Function
Failed:
    g_importUnknown = True
    TraceRun "import unknown=part-api-error number=" & CStr(Err.Number)
End Function

Function ShouldRejectImportedCandidate(swPart As Object, _
                                       candidateIsWasherLike As Boolean) As Boolean
    Dim imported As Boolean, filterScope As String
    g_importUnknown = False
    If Not g_generalImportedFilter And Not candidateIsWasherLike Then
        TraceRun "import scope=washerlike result=not-applicable"
        Exit Function
    End If
    If g_generalImportedFilter Then
        filterScope = "general"
    Else
        filterScope = "washerlike"
    End If
    On Error GoTo InspectionFailed
    imported = IsImportedGeometryPart(swPart)
    If g_importHint = "#UNKNOWN" Then
        g_importUnknown = True
    ElseIf g_importHint <> "" Then
        imported = True
        TraceRun "import hit=snapshotted-component-path source=" & DiagnosticLineValue(g_importHint)
    End If
    If Not imported And Not g_importComponent Is Nothing Then
        ' Only the actual candidate, never an imported ancestor or previous part.
        If StrComp(g_importComponent.GetPathName, swPart.GetPathName, vbTextCompare) = 0 And _
           StrComp(g_importComponent.ReferencedConfiguration, GetActiveConfigName(swPart), vbTextCompare) = 0 Then
            imported = IsImportedAssemblyComponent(g_importComponent)
        End If
    End If
InspectionComplete:
    ShouldRejectImportedCandidate = (imported Or g_importUnknown)
    TraceRun "import scope=" & filterScope & " imported=" & CStr(imported) & _
             " unknown=" & CStr(g_importUnknown)
    If ShouldRejectImportedCandidate Then
        If imported Then
            TraceRun "imported-filter reject=imported scope=" & filterScope
        Else
            TraceRun "imported-filter reject=inspection-incomplete scope=" & filterScope
        End If
    End If
    Exit Function
InspectionFailed:
    g_importUnknown = True
    TraceRun "import unknown=candidate-api-error number=" & CStr(Err.Number)
    Resume InspectionComplete
End Function

Function IsToolboxPartSafe(swPart As Object) As Boolean

    If swPart Is Nothing Then Exit Function

    Dim toolboxType As Long

    toolboxType = 0

    On Error Resume Next

    toolboxType = CLng(swPart.Extension.ToolboxPartType)

    On Error GoTo 0

    IsToolboxPartSafe = (toolboxType <> 0)

End Function

Function CleanFileName(value As String) As String

    Dim badChars As Variant

    badChars = Array("\", "/", ":", "*", "?", """", "<", ">", "|")

    Dim result As String

    result = value

    Dim i As Long

    For i = 0 To UBound(badChars)

        result = Replace(result, CStr(badChars(i)), "_")

    Next i

    CleanFileName = Trim(result)

    If CleanFileName = "" Then CleanFileName = "Default"

End Function

Sub DeleteExistingFile(filePath As String)

    On Error Resume Next

    DeleteFileIfExists filePath

    On Error GoTo 0

End Sub

' ================================================================

Function ExportPartPrecut(swPart As Object, filePath As String, isSM As Boolean) As Boolean
    Debug.Print "      --- ExportPartPrecut ---"

    ExportPartPrecut = ExportPartPrecutSimple(swPart, filePath, isSM)
End Function
' ================================================================

Function ExportPartPrecutSimple(swPart As Object, filePath As String, isSM As Boolean) As Boolean

    Dim okBase As Boolean

    DeleteExistingFile filePath

    If isSM Then

        okBase = ExportSMFlatPattern(swPart, filePath)

    Else

        okBase = ExportProjectedViewFast(swPart, filePath)

        If Not okBase Then

            Debug.Print "      Projected view DXF failed, trying selected-face fallback"

            okBase = ExportBestViewFast(swPart, filePath)

        End If

    End If

    If okBase Then

        If AddOffsetOutlineToDxf(filePath, swPart, g_precutOffset_mm, g_precutKeepFeats) Then

            Debug.Print "      Real offset outline DXF saved; keepInternal=" & g_precutKeepFeats

            ExportPartPrecutSimple = True

            Exit Function

        End If

        Debug.Print "      Base DXF saved, but real outline offset failed"

    Else

        Debug.Print "      Base feature DXF failed"

    End If

    Debug.Print "      Falling back to outline box only"

    ExportPartPrecutSimple = WritePrecutBoxDxf(swPart, filePath, isSM)

End Function

Function ExportThinSolidRegularDxf(swPart As Object, filePath As String) As Boolean

    If ExportProjectedViewFast(swPart, filePath) Then

        If CleanProjectedDxfChamferLoops(filePath) Then

            Debug.Print "      Projected DXF cleaned for chamfer boundary loops"

        Else

            Debug.Print "      Projected DXF saved; chamfer cleanup not needed/failed"

        End If

        ExportThinSolidRegularDxf = True

        Exit Function

    End If

    Debug.Print "      Projected view DXF failed, trying selected-face fallback"

    ExportThinSolidRegularDxf = ExportBestViewFast(swPart, filePath)

End Function

Function CleanProjectedDxfChamferLoops(filePath As String) As Boolean

    Dim fso As Object

    Set fso = CreateObject("Scripting.FileSystemObject")

    If Not fso.FileExists(filePath) Then Exit Function

    Dim ts As Object

    Set ts = fso.OpenTextFile(filePath, 1, False)

    Dim raw As String

    raw = ts.ReadAll

    ts.Close

    raw = Replace(raw, vbCrLf, vbLf)

    raw = Replace(raw, vbCr, vbLf)

    Dim lines As Variant

    lines = Split(raw, vbLf)

    Dim inEnt As Boolean

    Dim maxItems As Long

    maxItems = UBound(lines) \ 2 + 5

    Dim entCount As Long

    Dim entType() As String

    Dim entStart() As Long

    Dim entEnd() As Long

    ReDim entType(1 To maxItems)

    ReDim entStart(1 To maxItems)

    ReDim entEnd(1 To maxItems)

    Dim gCount As Long

    Dim gKind() As String

    Dim gEnt() As Long

    Dim gx1() As Double, gy1() As Double, gx2() As Double, gy2() As Double

    ReDim gKind(1 To maxItems)

    ReDim gEnt(1 To maxItems)

    ReDim gx1(1 To maxItems)

    ReDim gy1(1 To maxItems)

    ReDim gx2(1 To maxItems)

    ReDim gy2(1 To maxItems)

    Dim i As Long

    i = 0

    Do While i <= UBound(lines) - 1

        Dim code As String

        Dim val As String

        code = Trim(CStr(lines(i)))

        val = Trim(CStr(lines(i + 1)))

        If code = "2" And UCase(val) = "ENTITIES" Then inEnt = True

        If inEnt And code = "0" Then

            If UCase(val) = "ENDSEC" Then Exit Do

            entCount = entCount + 1

            entType(entCount) = UCase(val)

            entStart(entCount) = i

            Dim j As Long

            j = i + 2

            Dim x10 As Double, y20 As Double, x11 As Double, y21 As Double

            Dim cx As Double, cy As Double, rr As Double, aa1 As Double, aa2 As Double

            Dim has10 As Boolean, has20 As Boolean, has11 As Boolean, has21 As Boolean

            Dim has40 As Boolean, has50 As Boolean, has51 As Boolean

            Dim polyX() As Double, polyY() As Double

            Dim polyN As Long

            Dim polyClosed As Boolean

            Dim pendingPolyX As Boolean

            Dim tmpPolyX As Double

            Do While j <= UBound(lines) - 1

                Dim c As String

                Dim v As String

                c = Trim(CStr(lines(j)))

                v = Trim(CStr(lines(j + 1)))

                If c = "0" Then Exit Do

                If entType(entCount) = "LINE" Then

                    If c = "10" Then x10 = ParseDxfNumber(v): has10 = True

                    If c = "20" Then y20 = ParseDxfNumber(v): has20 = True

                    If c = "11" Then x11 = ParseDxfNumber(v): has11 = True

                    If c = "21" Then y21 = ParseDxfNumber(v): has21 = True

                ElseIf entType(entCount) = "ARC" Then

                    If c = "10" Then cx = ParseDxfNumber(v): has10 = True

                    If c = "20" Then cy = ParseDxfNumber(v): has20 = True

                    If c = "40" Then rr = ParseDxfNumber(v): has40 = True

                    If c = "50" Then aa1 = ParseDxfNumber(v): has50 = True

                    If c = "51" Then aa2 = ParseDxfNumber(v): has51 = True

                ElseIf entType(entCount) = "LWPOLYLINE" Then

                    If c = "70" Then polyClosed = ((CLng(ParseDxfNumber(v)) And 1) <> 0)

                    If c = "10" Then

                        tmpPolyX = ParseDxfNumber(v)

                        pendingPolyX = True

                    End If

                    If c = "20" And pendingPolyX Then

                        polyN = polyN + 1

                        If polyN = 1 Then

                            ReDim polyX(1 To 1)

                            ReDim polyY(1 To 1)

                        Else

                            ReDim Preserve polyX(1 To polyN)

                            ReDim Preserve polyY(1 To polyN)

                        End If

                        polyX(polyN) = tmpPolyX

                        polyY(polyN) = ParseDxfNumber(v)

                        pendingPolyX = False

                    End If

                End If

                j = j + 2

            Loop

            entEnd(entCount) = j - 1

            If entType(entCount) = "LINE" And has10 And has20 And has11 And has21 Then

                gCount = gCount + 1

                gKind(gCount) = "LINE"

                gEnt(gCount) = entCount

                gx1(gCount) = x10

                gy1(gCount) = y20

                gx2(gCount) = x11

                gy2(gCount) = y21

            ElseIf entType(entCount) = "ARC" And has10 And has20 And has40 And has50 And has51 Then

                gCount = gCount + 1

                gKind(gCount) = "ARC"

                gEnt(gCount) = entCount

                gx1(gCount) = ArcPointX(cx, rr, aa1)

                gy1(gCount) = ArcPointY(cy, rr, aa1)

                gx2(gCount) = ArcPointX(cx, rr, aa2)

                gy2(gCount) = ArcPointY(cy, rr, aa2)

            ElseIf entType(entCount) = "LWPOLYLINE" And polyN >= 2 Then

                Dim p As Long

                For p = 1 To polyN - 1

                    gCount = gCount + 1

                    gKind(gCount) = "LINE"

                    gEnt(gCount) = entCount

                    gx1(gCount) = polyX(p)

                    gy1(gCount) = polyY(p)

                    gx2(gCount) = polyX(p + 1)

                    gy2(gCount) = polyY(p + 1)

                Next p

                If polyClosed Then

                    gCount = gCount + 1

                    gKind(gCount) = "LINE"

                    gEnt(gCount) = entCount

                    gx1(gCount) = polyX(polyN)

                    gy1(gCount) = polyY(polyN)

                    gx2(gCount) = polyX(1)

                    gy2(gCount) = polyY(1)

                End If

            End If

            i = j

        Else

            i = i + 2

        End If

    Loop

    If gCount = 0 Then Exit Function

    Dim bestComp As Long

    bestComp = FindOuterGeometryComponent(gCount, gx1, gy1, gx2, gy2)

    If bestComp = 0 Then Exit Function

    MarkOuterDropComponents gCount, gx1, gy1, gx2, gy2, bestComp, False

    Dim out As String

    out = ""

    For i = 0 To UBound(lines)

        If Not ShouldDropDxfLine(i, True, entCount, entType, entStart, entEnd, gCount, gEnt, bestComp, gx1, gy1, gx2, gy2) Then

            If i < UBound(lines) Or Len(CStr(lines(i))) > 0 Then out = out & CStr(lines(i)) & vbCrLf

        End If

    Next i

    Set ts = fso.OpenTextFile(filePath, 2, True)

    ts.Write out

    ts.Close

    CleanProjectedDxfChamferLoops = True

End Function

Function AddOffsetOutlineToDxf(filePath As String, swPart As Object, offsetMm As Double, keepInternal As Boolean) As Boolean

    Dim fso As Object

    Set fso = CreateObject("Scripting.FileSystemObject")

    If Not fso.FileExists(filePath) Then Exit Function

    Dim ts As Object

    Set ts = fso.OpenTextFile(filePath, 1, False)

    Dim raw As String

    raw = ts.ReadAll

    ts.Close

    raw = Replace(raw, vbCrLf, vbLf)

    raw = Replace(raw, vbCr, vbLf)

    Dim lines As Variant

    lines = Split(raw, vbLf)

    Dim inEnt As Boolean

    Dim insertIdx As Long

    insertIdx = -1

    Dim maxItems As Long

    maxItems = UBound(lines) \ 2 + 5

    Dim entCount As Long

    Dim entType() As String

    Dim entStart() As Long

    Dim entEnd() As Long

    ReDim entType(1 To maxItems)

    ReDim entStart(1 To maxItems)

    ReDim entEnd(1 To maxItems)

    Dim gCount As Long

    Dim gKind() As String

    Dim gEnt() As Long

    Dim gx1() As Double, gy1() As Double, gx2() As Double, gy2() As Double

    Dim gcx() As Double, gcy() As Double, gr() As Double, ga1() As Double, ga2() As Double

    ReDim gKind(1 To maxItems)

    ReDim gEnt(1 To maxItems)

    ReDim gx1(1 To maxItems)

    ReDim gy1(1 To maxItems)

    ReDim gx2(1 To maxItems)

    ReDim gy2(1 To maxItems)

    ReDim gcx(1 To maxItems)

    ReDim gcy(1 To maxItems)

    ReDim gr(1 To maxItems)

    ReDim ga1(1 To maxItems)

    ReDim ga2(1 To maxItems)

    Dim i As Long

    i = 0

    Do While i <= UBound(lines) - 1

        Dim code As String

        Dim val As String

        code = Trim(CStr(lines(i)))

        val = Trim(CStr(lines(i + 1)))

        If code = "2" And UCase(val) = "ENTITIES" Then inEnt = True

        If inEnt And code = "0" Then

            If UCase(val) = "ENDSEC" Then

                insertIdx = i

                Exit Do

            End If

            entCount = entCount + 1

            entType(entCount) = UCase(val)

            entStart(entCount) = i

            Dim j As Long

            j = i + 2

            Dim x10 As Double, y20 As Double, x11 As Double, y21 As Double

            Dim cx As Double, cy As Double, rr As Double, aa1 As Double, aa2 As Double

            Dim has10 As Boolean, has20 As Boolean, has11 As Boolean, has21 As Boolean

            Dim has40 As Boolean, has50 As Boolean, has51 As Boolean

            Dim polyX() As Double, polyY() As Double

            Dim polyN As Long

            Dim polyClosed As Boolean

            Dim pendingPolyX As Boolean

            Dim tmpPolyX As Double

            Do While j <= UBound(lines) - 1

                Dim c As String

                Dim v As String

                c = Trim(CStr(lines(j)))

                v = Trim(CStr(lines(j + 1)))

                If c = "0" Then Exit Do

                If entType(entCount) = "LINE" Then

                    If c = "10" Then x10 = ParseDxfNumber(v): has10 = True

                    If c = "20" Then y20 = ParseDxfNumber(v): has20 = True

                    If c = "11" Then x11 = ParseDxfNumber(v): has11 = True

                    If c = "21" Then y21 = ParseDxfNumber(v): has21 = True

                ElseIf entType(entCount) = "ARC" Then

                    If c = "10" Then cx = ParseDxfNumber(v): has10 = True

                    If c = "20" Then cy = ParseDxfNumber(v): has20 = True

                    If c = "40" Then rr = ParseDxfNumber(v): has40 = True

                    If c = "50" Then aa1 = ParseDxfNumber(v): has50 = True

                    If c = "51" Then aa2 = ParseDxfNumber(v): has51 = True

                ElseIf entType(entCount) = "LWPOLYLINE" Then

                    If c = "70" Then polyClosed = ((CLng(ParseDxfNumber(v)) And 1) <> 0)

                    If c = "10" Then

                        tmpPolyX = ParseDxfNumber(v)

                        pendingPolyX = True

                    End If

                    If c = "20" And pendingPolyX Then

                        polyN = polyN + 1

                        If polyN = 1 Then

                            ReDim polyX(1 To 1)

                            ReDim polyY(1 To 1)

                        Else

                            ReDim Preserve polyX(1 To polyN)

                            ReDim Preserve polyY(1 To polyN)

                        End If

                        polyX(polyN) = tmpPolyX

                        polyY(polyN) = ParseDxfNumber(v)

                        pendingPolyX = False

                    End If

                End If

                j = j + 2

            Loop

            entEnd(entCount) = j - 1

            If entType(entCount) = "LINE" And has10 And has20 And has11 And has21 Then

                gCount = gCount + 1

                gKind(gCount) = "LINE"

                gEnt(gCount) = entCount

                gx1(gCount) = x10

                gy1(gCount) = y20

                gx2(gCount) = x11

                gy2(gCount) = y21

            ElseIf entType(entCount) = "ARC" And has10 And has20 And has40 And has50 And has51 Then

                gCount = gCount + 1

                gKind(gCount) = "ARC"

                gEnt(gCount) = entCount

                gcx(gCount) = cx

                gcy(gCount) = cy

                gr(gCount) = rr

                ga1(gCount) = aa1

                ga2(gCount) = aa2

                gx1(gCount) = ArcPointX(cx, rr, aa1)

                gy1(gCount) = ArcPointY(cy, rr, aa1)

                gx2(gCount) = ArcPointX(cx, rr, aa2)

                gy2(gCount) = ArcPointY(cy, rr, aa2)

            ElseIf entType(entCount) = "LWPOLYLINE" And polyN >= 2 Then

                Dim p As Long

                For p = 1 To polyN - 1

                    gCount = gCount + 1

                    gKind(gCount) = "LINE"

                    gEnt(gCount) = entCount

                    gx1(gCount) = polyX(p)

                    gy1(gCount) = polyY(p)

                    gx2(gCount) = polyX(p + 1)

                    gy2(gCount) = polyY(p + 1)

                Next p

                If polyClosed Then

                    gCount = gCount + 1

                    gKind(gCount) = "LINE"

                    gEnt(gCount) = entCount

                    gx1(gCount) = polyX(polyN)

                    gy1(gCount) = polyY(polyN)

                    gx2(gCount) = polyX(1)

                    gy2(gCount) = polyY(1)

                End If

            End If

            i = j

        Else

            i = i + 2

        End If

    Loop

    If insertIdx < 0 Then

        Debug.Print "      DXF outline insert failed: no ENTITIES end"

        Exit Function

    End If

    If gCount = 0 Then

        Debug.Print "      DXF outline insert failed: no line/arc entities"

        Exit Function

    End If

    Dim bestComp As Long

    bestComp = FindOuterGeometryComponent(gCount, gx1, gy1, gx2, gy2)

    If bestComp = 0 Then

        Debug.Print "      DXF outline insert failed: no outer component"

        Exit Function

    End If

    MarkOuterDropComponents gCount, gx1, gy1, gx2, gy2, bestComp, True

    Dim t As Double

    Dim w As Double

    Dim longDim As Double

    Dim unitScale As Double

    unitScale = 1#

    Dim px() As Double

    Dim py() As Double

    Dim pCount As Long

    If Not BuildComponentPointLoop(bestComp, gCount, gKind, gx1, gy1, gx2, gy2, gcx, gcy, gr, ga1, ga2, px, py, pCount) Then

        Debug.Print "      DXF outline insert failed: could not order outer loop"

        Exit Function

    End If

    Dim outX() As Double

    Dim outY() As Double

    Dim outCount As Long

    If GetSortedBoxDimsMM(swPart, t, w, longDim) Then

        Dim dxfLong As Double

        dxfLong = DxfPointSpan(px, py, pCount)

        If longDim > 0 And dxfLong > 0 Then unitScale = dxfLong / longDim

    End If

    If Not OffsetPointLoop(px, py, pCount, offsetMm * unitScale, outX, outY, outCount) Then

        Debug.Print "      DXF outline insert failed: offset failed"

        Exit Function

    End If

    Dim newOutline As String

    newOutline = BuildDxfPolyline(outX, outY, outCount, "PRECUT_OUTLINE")

    Dim out As String

    out = ""

    For i = 0 To UBound(lines)

        If i = insertIdx Then out = out & newOutline

        If Not ShouldDropDxfLine(i, keepInternal, entCount, entType, entStart, entEnd, gCount, gEnt, bestComp, gx1, gy1, gx2, gy2) Then

            If i < UBound(lines) Or Len(CStr(lines(i))) > 0 Then out = out & CStr(lines(i)) & vbCrLf

        End If

    Next i

    Set ts = fso.OpenTextFile(filePath, 2, True)

    ts.Write out

    ts.Close

    AddOffsetOutlineToDxf = True

    Debug.Print "      Real offset outline inserted; DXF unit scale=" & Round(unitScale, 6) & " keepInternal=" & keepInternal

End Function

Function FindOuterGeometryComponent(gCount As Long, gx1() As Double, gy1() As Double, gx2() As Double, gy2() As Double) As Long

    Dim comp() As Long

    ReDim comp(1 To gCount)

    Dim compCount As Long

    Dim i As Long

    For i = 1 To gCount

        If comp(i) = 0 Then

            compCount = compCount + 1

            comp(i) = compCount

            Dim changed As Boolean

            changed = True

            Do While changed

                changed = False

                Dim a As Long

                Dim b As Long

                For a = 1 To gCount

                    If comp(a) = compCount Then

                        For b = 1 To gCount

                            If comp(b) = 0 Then

                                If GeoConnected(a, b, gx1, gy1, gx2, gy2) Then

                                    comp(b) = compCount

                                    changed = True

                                End If

                            End If

                        Next b

                    End If

                Next a

            Loop

        End If

    Next i

    Dim bestScore As Double

    bestScore = -1#

    Dim c As Long

    For c = 1 To compCount

        Dim minX As Double, minY As Double, maxX As Double, maxY As Double

        minX = 1E+30

        minY = 1E+30

        maxX = -1E+30

        maxY = -1E+30

        For i = 1 To gCount

            If comp(i) = c Then

                ExpandBounds minX, minY, maxX, maxY, gx1(i), gy1(i)

                ExpandBounds minX, minY, maxX, maxY, gx2(i), gy2(i)

            End If

        Next i

        Dim score As Double

        score = (maxX - minX) * (maxY - minY)

        If score > bestScore Then

            bestScore = score

            FindOuterGeometryComponent = c

        End If

    Next c

    StoreTempComponents comp

End Function

Sub StoreTempComponents(comp() As Long)

    Dim i As Long

    ReDim g_dxfComp(LBound(comp) To UBound(comp))

    For i = LBound(comp) To UBound(comp)

        g_dxfComp(i) = comp(i)

    Next i

End Sub

Sub MarkOuterDropComponents(gCount As Long, gx1() As Double, gy1() As Double, _
                            gx2() As Double, gy2() As Double, _
                            bestComp As Long, dropBest As Boolean)

    Dim compMax As Long

    Dim i As Long

    For i = 1 To gCount

        If g_dxfComp(i) > compMax Then compMax = g_dxfComp(i)

    Next i

    If compMax <= 0 Then Exit Sub

    ReDim g_dxfDropComp(1 To compMax)

    g_dxfDropComp(bestComp) = dropBest

    Dim bestMinX As Double, bestMinY As Double, bestMaxX As Double, bestMaxY As Double

    bestMinX = 1E+30

    bestMinY = 1E+30

    bestMaxX = -1E+30

    bestMaxY = -1E+30

    For i = 1 To gCount

        If g_dxfComp(i) = bestComp Then

            ExpandBounds bestMinX, bestMinY, bestMaxX, bestMaxY, gx1(i), gy1(i)

            ExpandBounds bestMinX, bestMinY, bestMaxX, bestMaxY, gx2(i), gy2(i)

        End If

    Next i

    Dim bestW As Double

    Dim bestH As Double

    bestW = bestMaxX - bestMinX

    bestH = bestMaxY - bestMinY

    If bestW <= 0# Or bestH <= 0# Then Exit Sub

    Dim compId As Long

    For compId = 1 To compMax

        If compId <> bestComp Then

            Dim minX As Double, minY As Double, maxX As Double, maxY As Double

            minX = 1E+30

            minY = 1E+30

            maxX = -1E+30

            maxY = -1E+30

            For i = 1 To gCount

                If g_dxfComp(i) = compId Then

                    ExpandBounds minX, minY, maxX, maxY, gx1(i), gy1(i)

                    ExpandBounds minX, minY, maxX, maxY, gx2(i), gy2(i)

                End If

            Next i

            Dim compW As Double

            Dim compH As Double

            compW = maxX - minX

            compH = maxY - minY

            If compW >= bestW * 0.6 And compH >= bestH * 0.6 Then

                If Abs(minX - bestMinX) <= bestW * 0.18 And _
                   Abs(maxX - bestMaxX) <= bestW * 0.18 And _
                   Abs(minY - bestMinY) <= bestH * 0.18 And _
                   Abs(maxY - bestMaxY) <= bestH * 0.18 Then

                    g_dxfDropComp(compId) = True

                End If

            End If

            If Not g_dxfDropComp(compId) Then

                Dim closedComp As Boolean

                closedComp = DxfComponentIsClosed(compId, gCount, gx1, gy1, gx2, gy2)

                Dim edgeTolX As Double

                Dim edgeTolY As Double

                edgeTolX = bestW * 0.08

                edgeTolY = bestH * 0.08

                Dim nearLeftEdge As Boolean

                Dim nearRightEdge As Boolean

                Dim nearBottomEdge As Boolean

                Dim nearTopEdge As Boolean

                nearLeftEdge = (Abs(minX - bestMinX) <= edgeTolX And Abs(maxX - bestMinX) <= edgeTolX)

                nearRightEdge = (Abs(minX - bestMaxX) <= edgeTolX And Abs(maxX - bestMaxX) <= edgeTolX)

                nearBottomEdge = (Abs(minY - bestMinY) <= edgeTolY And Abs(maxY - bestMinY) <= edgeTolY)

                nearTopEdge = (Abs(minY - bestMaxY) <= edgeTolY And Abs(maxY - bestMaxY) <= edgeTolY)

                If Not closedComp And compH >= bestH * 0.45 And (nearLeftEdge Or nearRightEdge) Then

                    g_dxfDropComp(compId) = True

                End If

                If Not closedComp And compW >= bestW * 0.45 And (nearBottomEdge Or nearTopEdge) Then

                    g_dxfDropComp(compId) = True

                End If

                Dim closeBounds As Long

                If Abs(minX - bestMinX) <= edgeTolX Then closeBounds = closeBounds + 1

                If Abs(maxX - bestMaxX) <= edgeTolX Then closeBounds = closeBounds + 1

                If Abs(minY - bestMinY) <= edgeTolY Then closeBounds = closeBounds + 1

                If Abs(maxY - bestMaxY) <= edgeTolY Then closeBounds = closeBounds + 1

                If Not closedComp And compW >= bestW * 0.45 And compH >= bestH * 0.45 And closeBounds >= 2 Then

                    g_dxfDropComp(compId) = True

                End If

            End If

        End If

    Next compId

End Sub

Function DxfComponentMarkedDrop(compId As Long) As Boolean

    On Error Resume Next

    DxfComponentMarkedDrop = g_dxfDropComp(compId)

    On Error GoTo 0

End Function

Function DxfComponentIsClosed(compId As Long, gCount As Long, _
                              gx1() As Double, gy1() As Double, _
                              gx2() As Double, gy2() As Double) As Boolean

    Dim hasGeometry As Boolean

    Dim i As Long

    For i = 1 To gCount

        If g_dxfComp(i) = compId Then

            hasGeometry = True

            If DxfEndpointDegree(compId, gx1(i), gy1(i), gCount, gx1, gy1, gx2, gy2) < 2 Then Exit Function

            If DxfEndpointDegree(compId, gx2(i), gy2(i), gCount, gx1, gy1, gx2, gy2) < 2 Then Exit Function

        End If

    Next i

    DxfComponentIsClosed = hasGeometry

End Function

Function DxfEndpointDegree(compId As Long, x As Double, y As Double, gCount As Long, _
                           gx1() As Double, gy1() As Double, _
                           gx2() As Double, gy2() As Double) As Long

    Dim i As Long

    For i = 1 To gCount

        If g_dxfComp(i) = compId Then

            If PointsNear(x, y, gx1(i), gy1(i)) Then DxfEndpointDegree = DxfEndpointDegree + 1

            If PointsNear(x, y, gx2(i), gy2(i)) Then DxfEndpointDegree = DxfEndpointDegree + 1

        End If

    Next i

End Function

Function GeoConnected(a As Long, b As Long, gx1() As Double, gy1() As Double, gx2() As Double, gy2() As Double) As Boolean

    GeoConnected = PointsNear(gx1(a), gy1(a), gx1(b), gy1(b)) Or _
                   PointsNear(gx1(a), gy1(a), gx2(b), gy2(b)) Or _
                   PointsNear(gx2(a), gy2(a), gx1(b), gy1(b)) Or _
                   PointsNear(gx2(a), gy2(a), gx2(b), gy2(b))

End Function

Function PointsNear(x1 As Double, y1 As Double, x2 As Double, y2 As Double) As Boolean

    PointsNear = (Abs(x1 - x2) < 0.001 And Abs(y1 - y2) < 0.001)

End Function

Sub ExpandBounds(ByRef minX As Double, ByRef minY As Double, ByRef maxX As Double, ByRef maxY As Double, x As Double, y As Double)

    If x < minX Then minX = x

    If y < minY Then minY = y

    If x > maxX Then maxX = x

    If y > maxY Then maxY = y

End Sub

Function BuildComponentPointLoop(bestComp As Long, gCount As Long, gKind() As String, _
                                 gx1() As Double, gy1() As Double, gx2() As Double, gy2() As Double, _
                                 gcx() As Double, gcy() As Double, gr() As Double, _
                                 ga1() As Double, ga2() As Double, _
                                 ByRef px() As Double, ByRef py() As Double, ByRef pCount As Long) As Boolean

    Dim used() As Boolean

    ReDim used(1 To gCount)

    Dim first As Long

    Dim i As Long

    For i = 1 To gCount

        If g_dxfComp(i) = bestComp Then

            first = i

            Exit For

        End If

    Next i

    If first = 0 Then Exit Function

    AppendGeoPoints first, False, gKind, gx1, gy1, gx2, gy2, gcx, gcy, gr, ga1, ga2, px, py, pCount

    used(first) = True

    Dim curX As Double

    Dim curY As Double

    curX = gx2(first)

    curY = gy2(first)

    Dim added As Boolean

    Do

        added = False

        For i = 1 To gCount

            If g_dxfComp(i) = bestComp And Not used(i) Then

                If PointsNear(curX, curY, gx1(i), gy1(i)) Then

                    AppendGeoPoints i, False, gKind, gx1, gy1, gx2, gy2, gcx, gcy, gr, ga1, ga2, px, py, pCount

                    curX = gx2(i)

                    curY = gy2(i)

                    used(i) = True

                    added = True

                    Exit For

                ElseIf PointsNear(curX, curY, gx2(i), gy2(i)) Then

                    AppendGeoPoints i, True, gKind, gx1, gy1, gx2, gy2, gcx, gcy, gr, ga1, ga2, px, py, pCount

                    curX = gx1(i)

                    curY = gy1(i)

                    used(i) = True

                    added = True

                    Exit For

                End If

            End If

        Next i

    Loop While added

    BuildComponentPointLoop = (pCount >= 3)

End Function

Sub AppendGeoPoints(idx As Long, reversed As Boolean, gKind() As String, _
                    gx1() As Double, gy1() As Double, gx2() As Double, gy2() As Double, _
                    gcx() As Double, gcy() As Double, gr() As Double, _
                    ga1() As Double, ga2() As Double, _
                    ByRef px() As Double, ByRef py() As Double, ByRef pCount As Long)

    If gKind(idx) = "LINE" Then

        If reversed Then

            AddDxfPoint px, py, pCount, gx2(idx), gy2(idx)

            AddDxfPoint px, py, pCount, gx1(idx), gy1(idx)

        Else

            AddDxfPoint px, py, pCount, gx1(idx), gy1(idx)

            AddDxfPoint px, py, pCount, gx2(idx), gy2(idx)

        End If

    ElseIf gKind(idx) = "ARC" Then

        Dim aStart As Double

        Dim aEnd As Double

        Dim sweep As Double

        If reversed Then

            aStart = ga2(idx)

            aEnd = ga1(idx)

            If aEnd > aStart Then aEnd = aEnd - 360#

            sweep = aStart - aEnd

        Else

            aStart = ga1(idx)

            aEnd = ga2(idx)

            If aEnd < aStart Then aEnd = aEnd + 360#

            sweep = aEnd - aStart

        End If

        Dim steps As Long

        steps = Int(Abs(sweep) / 5#) + 1

        If steps < 4 Then steps = 4

        Dim k As Long

        For k = 0 To steps

            Dim a As Double

            If reversed Then

                a = aStart - sweep * k / steps

            Else

                a = aStart + sweep * k / steps

            End If

            AddDxfPoint px, py, pCount, ArcPointX(gcx(idx), gr(idx), a), ArcPointY(gcy(idx), gr(idx), a)

        Next k

    End If

End Sub

Sub AddDxfPoint(ByRef px() As Double, ByRef py() As Double, ByRef pCount As Long, x As Double, y As Double)

    If pCount > 0 Then

        If PointsNear(px(pCount), py(pCount), x, y) Then Exit Sub

    End If

    pCount = pCount + 1

    If pCount = 1 Then

        ReDim px(1 To pCount)

        ReDim py(1 To pCount)

    Else

        ReDim Preserve px(1 To pCount)

        ReDim Preserve py(1 To pCount)

    End If

    px(pCount) = x

    py(pCount) = y

End Sub

Function OffsetPointLoop(px() As Double, py() As Double, pCount As Long, dist As Double, ByRef ox() As Double, ByRef oy() As Double, ByRef oCount As Long) As Boolean

    Dim n As Long

    n = pCount

    If n > 2 Then

        If PointsNear(px(1), py(1), px(n), py(n)) Then n = n - 1

    End If

    If n < 3 Then Exit Function

    Dim area As Double

    area = PolygonArea(px, py, n)

    Dim nx() As Double

    Dim ny() As Double

    ReDim nx(1 To n)

    ReDim ny(1 To n)

    Dim i As Long

    For i = 1 To n

        Dim j As Long

        j = i + 1

        If j > n Then j = 1

        Dim dx As Double

        Dim dy As Double

        dx = px(j) - px(i)

        dy = py(j) - py(i)

        Dim segLen As Double

        segLen = Sqr(dx * dx + dy * dy)

        If segLen <= 0.000001 Then Exit Function

        If area > 0 Then

            nx(i) = dy / segLen

            ny(i) = -dx / segLen

        Else

            nx(i) = -dy / segLen

            ny(i) = dx / segLen

        End If

    Next i

    oCount = n

    ReDim ox(1 To n)

    ReDim oy(1 To n)

    For i = 1 To n

        Dim prev As Long

        prev = i - 1

        If prev < 1 Then prev = n

        Dim nextI As Long

        nextI = i + 1

        If nextI > n Then nextI = 1

        If Not IntersectOffsetLines(px(prev), py(prev), px(i), py(i), nx(prev) * dist, ny(prev) * dist, px(i), py(i), px(nextI), py(nextI), nx(i) * dist, ny(i) * dist, ox(i), oy(i)) Then

            ox(i) = px(i) + (nx(prev) + nx(i)) * dist / 2#

            oy(i) = py(i) + (ny(prev) + ny(i)) * dist / 2#

        End If

    Next i

    OffsetPointLoop = True

End Function

Function IntersectOffsetLines(x1 As Double, y1 As Double, x2 As Double, y2 As Double, _
                              ox1 As Double, oy1 As Double, _
                              x3 As Double, y3 As Double, x4 As Double, y4 As Double, _
                              ox2 As Double, oy2 As Double, _
                              ByRef ix As Double, ByRef iy As Double) As Boolean

    Dim ax As Double, ay As Double, bx As Double, by As Double

    ax = x1 + ox1

    ay = y1 + oy1

    bx = x2 + ox1

    by = y2 + oy1

    Dim cx As Double, cy As Double, dx As Double, dy As Double

    cx = x3 + ox2

    cy = y3 + oy2

    dx = x4 + ox2

    dy = y4 + oy2

    Dim vx1 As Double, vy1 As Double, vx2 As Double, vy2 As Double

    vx1 = bx - ax

    vy1 = by - ay

    vx2 = dx - cx

    vy2 = dy - cy

    Dim den As Double

    den = vx1 * vy2 - vy1 * vx2

    If Abs(den) < 0.000000001 Then Exit Function

    Dim t As Double

    t = ((cx - ax) * vy2 - (cy - ay) * vx2) / den

    ix = ax + t * vx1

    iy = ay + t * vy1

    IntersectOffsetLines = True

End Function

Function PolygonArea(px() As Double, py() As Double, n As Long) As Double

    Dim a As Double

    Dim i As Long

    For i = 1 To n

        Dim j As Long

        j = i + 1

        If j > n Then j = 1

        a = a + px(i) * py(j) - px(j) * py(i)

    Next i

    PolygonArea = a / 2#

End Function

Function DxfPointSpan(px() As Double, py() As Double, pCount As Long) As Double

    Dim minX As Double, minY As Double, maxX As Double, maxY As Double

    minX = 1E+30

    minY = 1E+30

    maxX = -1E+30

    maxY = -1E+30

    Dim i As Long

    For i = 1 To pCount

        ExpandBounds minX, minY, maxX, maxY, px(i), py(i)

    Next i

    DxfPointSpan = Abs(maxX - minX)

    If Abs(maxY - minY) > DxfPointSpan Then DxfPointSpan = Abs(maxY - minY)

End Function

Function BuildDxfPolyline(px() As Double, py() As Double, pCount As Long, layerName As String) As String

    Dim s As String

    s = "0" & vbCrLf
    s = s & "LWPOLYLINE" & vbCrLf
    s = s & "8" & vbCrLf
    s = s & layerName & vbCrLf
    s = s & "90" & vbCrLf
    s = s & CStr(pCount) & vbCrLf
    s = s & "70" & vbCrLf
    s = s & "1" & vbCrLf

    Dim i As Long

    For i = 1 To pCount

        s = s & "10" & vbCrLf
        s = s & DxfNumber(px(i)) & vbCrLf
        s = s & "20" & vbCrLf
        s = s & DxfNumber(py(i)) & vbCrLf

    Next i

    BuildDxfPolyline = s

End Function

Function ShouldDropDxfLine(lineIdx As Long, keepInternal As Boolean, entCount As Long, _
                           entType() As String, entStart() As Long, entEnd() As Long, _
                           gCount As Long, gEnt() As Long, bestComp As Long, _
                           gx1() As Double, gy1() As Double, gx2() As Double, gy2() As Double) As Boolean

    Dim e As Long

    For e = 1 To entCount

        If lineIdx >= entStart(e) And lineIdx <= entEnd(e) Then

            If UCase(entType(e)) = "INSERT" Or UCase(entType(e)) = "MTEXT" Or UCase(entType(e)) = "TEXT" Then

                ShouldDropDxfLine = True

                Exit Function

            End If

            If Not keepInternal Then

                ShouldDropDxfLine = True

                Exit Function

            End If

            Dim g As Long

            For g = 1 To gCount

                If gEnt(g) = e And DxfComponentMarkedDrop(g_dxfComp(g)) Then

                    ShouldDropDxfLine = True

                    Exit Function

                End If

            Next g

            Exit Function

        End If

    Next e

End Function

Function ArcPointX(cx As Double, r As Double, deg As Double) As Double

    ArcPointX = cx + r * Cos(deg * Atn(1#) / 45#)

End Function

Function ArcPointY(cy As Double, r As Double, deg As Double) As Double

    ArcPointY = cy + r * Sin(deg * Atn(1#) / 45#)

End Function

Function BuildDxfRect(x1 As Double, y1 As Double, x2 As Double, y2 As Double) As String

    Dim s As String

    s = "0" & vbCrLf
    s = s & "LWPOLYLINE" & vbCrLf
    s = s & "8" & vbCrLf
    s = s & "PRECUT_OUTLINE" & vbCrLf
    s = s & "90" & vbCrLf
    s = s & "4" & vbCrLf
    s = s & "70" & vbCrLf
    s = s & "1" & vbCrLf
    s = s & "10" & vbCrLf
    s = s & DxfNumber(x1) & vbCrLf
    s = s & "20" & vbCrLf
    s = s & DxfNumber(y1) & vbCrLf
    s = s & "10" & vbCrLf
    s = s & DxfNumber(x2) & vbCrLf
    s = s & "20" & vbCrLf
    s = s & DxfNumber(y1) & vbCrLf
    s = s & "10" & vbCrLf
    s = s & DxfNumber(x2) & vbCrLf
    s = s & "20" & vbCrLf
    s = s & DxfNumber(y2) & vbCrLf
    s = s & "10" & vbCrLf
    s = s & DxfNumber(x1) & vbCrLf
    s = s & "20" & vbCrLf
    s = s & DxfNumber(y2) & vbCrLf

    BuildDxfRect = s

End Function

Function ParseDxfNumber(value As String) As Double

    Dim decSep As String

    decSep = Mid(CStr(1.1), 2, 1)

    ParseDxfNumber = CDbl(Replace(value, ".", decSep))

End Function

Function DrawPrecutRectangleOnSheet(swDraw As Object, swSheet As Object, outline As Variant) As Boolean

    Dim offsetMeters As Double

    offsetMeters = g_precutOffset_mm / 1000#

    Dim x1 As Double

    Dim y1 As Double

    Dim x2 As Double

    Dim y2 As Double

    x1 = outline(0) - offsetMeters

    y1 = outline(1) - offsetMeters

    x2 = outline(2) + offsetMeters

    y2 = outline(3) + offsetMeters

    On Error Resume Next

    swDraw.ActivateSheet swSheet.GetName

    swDraw.ClearSelection2 True

    swDraw.SketchManager.InsertSketch True

    swDraw.SketchManager.CreateLine x1, y1, 0#, x2, y1, 0#

    swDraw.SketchManager.CreateLine x2, y1, 0#, x2, y2, 0#

    swDraw.SketchManager.CreateLine x2, y2, 0#, x1, y2, 0#

    swDraw.SketchManager.CreateLine x1, y2, 0#, x1, y1, 0#

    swDraw.SketchManager.InsertSketch True

    DrawPrecutRectangleOnSheet = (Err.Number = 0)

    Err.Clear

    On Error GoTo 0

End Function

Function WritePrecutBoxDxf(swPart As Object, filePath As String, isSM As Boolean) As Boolean

    Dim flatFeat As Object

    Dim wasSupp As Boolean

    wasSupp = False
    On Error GoTo WriteFail

    If isSM Then

        Set flatFeat = FindFlatPatternFeat(swPart)

        If Not flatFeat Is Nothing Then

            If FeatureSuppressionState(flatFeat) < 0 Then GoTo CleanFail
            wasSupp = (FeatureSuppressionState(flatFeat) = 1)

            If wasSupp Then

                If Not SetFeatureSuppressionChecked(flatFeat, False) Then GoTo CleanFail

                swPart.EditRebuild3

            End If

        End If

    End If

    Dim t As Double

    Dim w As Double

    Dim longDim As Double

    If Not GetPartFilterDimensions(swPart, t, w, longDim) Then GoTo CleanFail

    Dim off As Double

    off = g_precutOffset_mm

    Dim width As Double

    Dim height As Double

    width = longDim + 2# * off

    height = w + 2# * off

    DeleteExistingFile filePath

    Dim ff As Integer

    ff = FreeFile

    On Error GoTo WriteFail

    Open filePath For Output As #ff

    Print #ff, "0"
    Print #ff, "SECTION"
    Print #ff, "2"
    Print #ff, "HEADER"
    Print #ff, "9"
    Print #ff, "$INSUNITS"
    Print #ff, "70"
    Print #ff, "4"
    Print #ff, "0"
    Print #ff, "ENDSEC"
    Print #ff, "0"
    Print #ff, "SECTION"
    Print #ff, "2"
    Print #ff, "ENTITIES"
    Print #ff, "0"
    Print #ff, "LWPOLYLINE"
    Print #ff, "8"
    Print #ff, "0"
    Print #ff, "90"
    Print #ff, "4"
    Print #ff, "70"
    Print #ff, "1"
    Print #ff, "10"
    Print #ff, "0"
    Print #ff, "20"
    Print #ff, "0"
    Print #ff, "10"
    Print #ff, DxfNumber(width)
    Print #ff, "20"
    Print #ff, "0"
    Print #ff, "10"
    Print #ff, DxfNumber(width)
    Print #ff, "20"
    Print #ff, DxfNumber(height)
    Print #ff, "10"
    Print #ff, "0"
    Print #ff, "20"
    Print #ff, DxfNumber(height)
    Print #ff, "0"
    Print #ff, "ENDSEC"
    Print #ff, "0"
    Print #ff, "EOF"

    Close #ff

    WritePrecutBoxDxf = PathFileExists(filePath)

    Debug.Print "      Box DXF saved=" & WritePrecutBoxDxf & " size=" & Round(width, 2) & "x" & Round(height, 2) & "mm"

CleanUp:

    If wasSupp Then

        On Error Resume Next
        If Not SetFeatureSuppressionChecked(flatFeat, True) Then _
            TraceRun "precut restore-failed=flat-pattern-suppression"

        swPart.EditRebuild3

    End If

    Exit Function

WriteFail:

    On Error Resume Next

    Close #ff

    On Error GoTo 0

CleanFail:

    WritePrecutBoxDxf = False

    Debug.Print "      Box DXF failed"

    GoTo CleanUp

End Function

Function DxfNumber(v As Double) As String

    DxfNumber = Replace(CStr(Round(v, 4)), ",", ".")

End Function

' ================================================================

Function GetOuterEdgesInView(swView As Object) As Variant

    Dim vComps As Variant

    vComps = swView.GetVisibleComponents

    Dim isPart As Boolean

    isPart = IsEmpty(vComps)



    Dim compObj As Object

    If isPart Then

        Set compObj = Nothing

    Else

        Set compObj = vComps(0)

    End If



    Dim vEdges As Variant

    vEdges = swView.GetVisibleEntities2(compObj, 1)

    If IsEmpty(vEdges) Then

        GetOuterEdgesInView = Empty

        Exit Function

    End If



    Dim maxArea As Double

    maxArea = 0

    Dim maxFace As Object



    Dim i As Long

    For i = 0 To UBound(vEdges)

        Dim e As Object

        Set e = vEdges(i)

        On Error Resume Next

        Dim adjFaces As Variant

        adjFaces = e.GetTwoAdjacentFaces

        On Error GoTo 0

        If Not IsEmpty(adjFaces) Then

            Dim f As Long

            For f = 0 To 1

                If Not IsNull(adjFaces(f)) Then

                    Dim fc As Object

                    Set fc = adjFaces(f)

                    On Error Resume Next

                    Dim surf As Object

                    Set surf = fc.GetSurface

                    On Error GoTo 0

                    If Not surf Is Nothing Then

                        If surf.IsPlane Then

                            Dim a As Double

                            a = fc.GetArea

                            If a > maxArea Then

                                maxArea = a

                                Set maxFace = fc

                            End If

                        End If

                    End If

                End If

            Next f

        End If

    Next i



    If maxFace Is Nothing Then

        GetOuterEdgesInView = Empty

        Exit Function

    End If



    Dim loops As Variant

    loops = maxFace.GetLoops

    If IsEmpty(loops) Then

        GetOuterEdgesInView = Empty

        Exit Function

    End If



    Dim L As Long

    For L = 0 To UBound(loops)

        Dim lp As Object

        Set lp = loops(L)

        If lp.IsOuter Then

            Dim eds As Variant

            eds = lp.GetEdges

            If Not IsEmpty(eds) Then

                GetOuterEdgesInView = eds

                Exit Function

            End If

        End If

    Next L



    GetOuterEdgesInView = Empty

End Function



' ================================================================

Sub SelectAllSketchSegmentsInView(sketch As Object, selData As Object)

    Dim segs As Variant

    segs = sketch.GetSketchSegments

    If IsEmpty(segs) Then Exit Sub

    Dim i As Long

    For i = 0 To UBound(segs)

        Dim s As Object

        Set s = segs(i)

        On Error Resume Next

        s.Select4 True, selData

        On Error GoTo 0

    Next i

End Sub



Sub DeleteConstructionEntities(sketch As Object, swDoc As Object, selData As Object)

    Dim segs As Variant

    segs = sketch.GetSketchSegments

    If IsEmpty(segs) Then Exit Sub

    swDoc.ClearSelection2 True

    Dim cnt As Long

    cnt = 0

    Dim i As Long

    For i = 0 To UBound(segs)

        Dim s As Object

        Set s = segs(i)

        Dim isC As Boolean

        isC = False

        On Error Resume Next

        isC = s.ConstructionGeometry

        On Error GoTo 0

        If isC Then

            On Error Resume Next

            s.Select4 True, selData

            On Error GoTo 0

            cnt = cnt + 1

        End If

    Next i

    Debug.Print "      Deleting " & cnt & " construction entities"

    If cnt > 0 Then swDoc.EditDelete

End Sub



Function OffsetIsOutward(sketch As Object) As Boolean

    Dim segs As Variant

    segs = sketch.GetSketchSegments

    If IsEmpty(segs) Then

        OffsetIsOutward = False

        Exit Function

    End If



    Dim cMinX As Double, cMinY As Double, cMaxX As Double, cMaxY As Double

    Dim oMinX As Double, oMinY As Double, oMaxX As Double, oMaxY As Double

    cMinX = 1E+30

    cMinY = 1E+30

    cMaxX = -1E+30

    cMaxY = -1E+30

    oMinX = 1E+30

    oMinY = 1E+30

    oMaxX = -1E+30

    oMaxY = -1E+30



    Dim i As Long

    For i = 0 To UBound(segs)

        Dim s As Object

        Set s = segs(i)

        If Not s Is Nothing Then

            Dim isC As Boolean

            isC = False

            On Error Resume Next

            isC = s.ConstructionGeometry

            On Error GoTo 0

            Dim bx As Variant

            On Error Resume Next

            bx = s.GetEndPoints

            On Error GoTo 0

            If Not IsEmpty(bx) Then

                If isC Then

                    If bx(0) < cMinX Then cMinX = bx(0)

                    If bx(1) < cMinY Then cMinY = bx(1)

                    If bx(0) > cMaxX Then cMaxX = bx(0)

                    If bx(1) > cMaxY Then cMaxY = bx(1)

                    If bx(3) < cMinX Then cMinX = bx(3)

                    If bx(4) < cMinY Then cMinY = bx(4)

                    If bx(3) > cMaxX Then cMaxX = bx(3)

                    If bx(4) > cMaxY Then cMaxY = bx(4)

                Else

                    If bx(0) < oMinX Then oMinX = bx(0)

                    If bx(1) < oMinY Then oMinY = bx(1)

                    If bx(0) > oMaxX Then oMaxX = bx(0)

                    If bx(1) > oMaxY Then oMaxY = bx(1)

                    If bx(3) < oMinX Then oMinX = bx(3)

                    If bx(4) < oMinY Then oMinY = bx(4)

                    If bx(3) > oMaxX Then oMaxX = bx(3)

                    If bx(4) > oMaxY Then oMaxY = bx(4)

                End If

            End If

        End If

    Next i



    Dim cArea As Double

    cArea = (cMaxX - cMinX) * (cMaxY - cMinY)

    Dim oArea As Double

    oArea = (oMaxX - oMinX) * (oMaxY - oMinY)

    OffsetIsOutward = (oArea > cArea)

End Function



' ================================================================

Function PickBestViewName(swPart As Object) As String

    Dim box As Variant

    box = SafeGetPartBox(swPart)

    If IsEmpty(box) Then

        PickBestViewName = "*Front"

        Exit Function

    End If



    Dim x As Double

    Dim y As Double

    Dim z As Double

    x = Abs(box(3) - box(0))

    y = Abs(box(4) - box(1))

    z = Abs(box(5) - box(2))



    If x <= y And x <= z Then

        PickBestViewName = "*Right"

    ElseIf y <= x And y <= z Then

        PickBestViewName = "*Top"

    Else

        PickBestViewName = "*Front"

    End If

End Function



' ================================================================

'  SAFE BOUNDING BOX - tries GetPartBox, falls back to GetBodies+GetBodyBox

' ================================================================

Function SafeGetPartBox(swPart As Object) As Variant

    Dim box As Variant



    ' Try GetPartBox first

    On Error Resume Next

    box = swPart.GetPartBox(True)

    On Error GoTo 0



    If Not IsEmpty(box) Then

        SafeGetPartBox = box

        Exit Function

    End If



    Debug.Print "      GetPartBox failed, falling back to GetBodies..."



    ' Fallback: union of all body boxes

    Dim bodies As Variant

    On Error Resume Next

    bodies = swPart.GetBodies2(0, False)

    On Error GoTo 0

    If IsEmpty(bodies) Then

        On Error Resume Next

        bodies = swPart.GetBodies(0)

        On Error GoTo 0

    End If

    If IsEmpty(bodies) Then

        Debug.Print "      No bodies either"

        SafeGetPartBox = Empty

        Exit Function

    End If



    Dim minX As Double, minY As Double, minZ As Double

    Dim maxX As Double, maxY As Double, maxZ As Double

    minX = 1E+30

    minY = 1E+30

    minZ = 1E+30

    maxX = -1E+30

    maxY = -1E+30

    maxZ = -1E+30



    Dim i As Long

    For i = 0 To UBound(bodies)

        Dim b As Object

        Set b = bodies(i)

        If Not b Is Nothing Then

            Dim bb As Variant

            On Error Resume Next

            bb = b.GetBodyBox

            On Error GoTo 0

            If Not IsEmpty(bb) Then

                If bb(0) < minX Then minX = bb(0)

                If bb(1) < minY Then minY = bb(1)

                If bb(2) < minZ Then minZ = bb(2)

                If bb(3) > maxX Then maxX = bb(3)

                If bb(4) > maxY Then maxY = bb(4)

                If bb(5) > maxZ Then maxZ = bb(5)

            End If

        End If

    Next i



    If minX > 1E+29 Then

        SafeGetPartBox = Empty

        Exit Function

    End If



    Dim result(5) As Double

    result(0) = minX

    result(1) = minY

    result(2) = minZ

    result(3) = maxX

    result(4) = maxY

    result(5) = maxZ

    SafeGetPartBox = result

End Function



' ================================================================

Function FindFlatPatternFeat(swPart As Object) As Object

    Dim f As Object

    Set f = swPart.FirstFeature

    Do While Not f Is Nothing

        If f.GetTypeName2 = "FlatPattern" Then

            Set FindFlatPatternFeat = f

            Exit Function

        End If

        Set f = f.GetNextFeature

    Loop

End Function



Function IsSheetMetal(swPart As Object) As Boolean
    Dim f As Object, count As Long
    If PartHasSheetMetalBody(swPart) Then
        IsSheetMetal = True
        Exit Function
    End If
    On Error GoTo Failed
    Set f = swPart.FirstFeature
    Do While Not f Is Nothing And count < 2048
        count = count + 1
        If f.GetTypeName2 = "SheetMetal" Then
            If FeatureSuppressionState(f) = 0 Then
                IsSheetMetal = True
                Exit Function
            End If
        End If
        Set f = f.GetNextFeature
    Loop
    Exit Function
Failed:
    TraceRun "sheetmetal inspection-error=" & CStr(Err.Number)
End Function



Function IsSheetMetalSafe(swPart As Object) As Boolean
    IsSheetMetalSafe = IsSheetMetal(swPart)
End Function

Function PartHasSheetMetalBody(swPart As Object) As Boolean

    Dim bodies As Variant

    bodies = GetPartBodies(swPart)

    If IsEmpty(bodies) Then Exit Function

    Dim i As Long

    For i = 0 To UBound(bodies)

        Dim b As Object

        Set b = bodies(i)

        If Not b Is Nothing Then

            On Error Resume Next

            PartHasSheetMetalBody = b.IsSheetMetal

            On Error GoTo 0

            If PartHasSheetMetalBody Then Exit Function

        End If

    Next i

End Function

Function GetSheetMetalThickness(swPart As Object) As Double
    Dim f As Object, count As Long
    On Error GoTo Failed
    Set f = swPart.FirstFeature
    Do While Not f Is Nothing And count < 2048
        count = count + 1
        If f.GetTypeName2 = "SheetMetal" Then
            If FeatureSuppressionState(f) = 0 Then
                GetSheetMetalThickness = f.GetDefinition.thickness * 1000#
                Exit Function
            End If
        End If
        Set f = f.GetNextFeature
    Loop
    Exit Function
Failed:
    TraceRun "sheetmetal thickness-unavailable error=" & CStr(Err.Number)
End Function



Function GetSheetMetalThicknessFallback(swPart As Object) As Double

    GetSheetMetalThicknessFallback = GetSheetMetalThickness(swPart)

    If GetSheetMetalThicknessFallback <= 0 Then GetSheetMetalThicknessFallback = GetBoundingThickness(swPart)

End Function

Function IsThinPlateLike(swPart As Object) As Boolean
    Dim t As Double, w As Double, longDim As Double
    If Not GetPartFilterDimensions(swPart, t, w, longDim) Then
        TraceRun "thin-filter reject=dimensions-unavailable"
        Exit Function
    End If
    If t > THICKNESS_LIMIT Or t <= 0# Then
        TraceRun "thin-filter reject=thickness-limit actual-mm=" & CStr(t) & " limit-mm=" & CStr(THICKNESS_LIMIT)
        Exit Function
    End If
    If w < t * THIN_PLATE_MIN_RATIO Or longDim < t * THIN_PLATE_MIN_RATIO Then
        TraceRun "thin-filter reject=dimension-ratio width/t=" & CStr(w / t) & _
                 " length/t=" & CStr(longDim / t) & " minimum=" & CStr(THIN_PLATE_MIN_RATIO)
        Exit Function
    End If
    If Not HasSheetLikePlanarFaces(swPart, w, longDim) Then
        TraceRun "thin-filter reject=planar-face-check"
        Exit Function
    End If
    IsThinPlateLike = True
    TraceRun "thin-filter accept"
End Function

Function IsWasherLikeThinSolid(swPart As Object) As Boolean
    Dim t As Double, w As Double, longDim As Double
    If Not GetPartFilterDimensions(swPart, t, w, longDim) Then
        TraceRun "washer-filter unknown=dimensions-unavailable"
        Exit Function
    End If
    Dim ratio As Double, aspect As Double
    Dim sizePass As Boolean, ratioPass As Boolean, aspectPass As Boolean
    ratio = longDim / t: aspect = w / longDim
    sizePass = (longDim <= WASHERLIKE_MAX_LONG_MM + 0.001)
    ratioPass = (ratio <= WASHERLIKE_MAX_WIDTH_THICKNESS_RATIO + 0.000001)
    aspectPass = (aspect >= WASHERLIKE_MIN_ASPECT - 0.000001)
    IsWasherLikeThinSolid = sizePass And ratioPass And aspectPass
    TraceRun "washer-filter result=" & CStr(IsWasherLikeThinSolid) & _
             " length-mm=" & CStr(Round(longDim, 4)) & " size-pass=" & CStr(sizePass) & _
             " length/t=" & CStr(Round(ratio, 4)) & " ratio-pass=" & CStr(ratioPass) & _
             " width/length=" & CStr(Round(aspect, 4)) & " aspect-pass=" & CStr(aspectPass)
End Function

Private Function StripTrailingPathSeparator(ByVal folderPath As String) As String

    Dim result As String

    result = Trim$(folderPath)

    Do While Len(result) > 3 And (Right$(result, 1) = "\" Or Right$(result, 1) = "/")

        result = Left$(result, Len(result) - 1)

    Loop

    StripTrailingPathSeparator = result

End Function

Private Function PathFileExists(ByVal filePath As String) As Boolean

    Dim fso As Object

    On Error GoTo Missing

    Set fso = CreateObject("Scripting.FileSystemObject")
    PathFileExists = fso.FileExists(filePath)
    Exit Function

Missing:

    Err.Clear

End Function

Private Sub DeleteFileIfExists(ByVal filePath As String)

    Dim fso As Object

    On Error GoTo Done

    Set fso = CreateObject("Scripting.FileSystemObject")
    If fso.FileExists(filePath) Then fso.DeleteFile filePath, True

Done:

    Err.Clear

End Sub

Private Function ResolveMappedFolderPath(ByVal folderPath As String) As String

    Dim driveName As String
    Dim network As Object
    Dim drives As Object
    Dim shell As Object
    Dim remoteRoot As String
    Dim index As Long

    ResolveMappedFolderPath = folderPath

    If Len(folderPath) < 3 Then Exit Function
    If Mid$(folderPath, 2, 2) <> ":\" Then Exit Function

    driveName = UCase$(Left$(folderPath, 2))

    On Error Resume Next

    Set network = CreateObject("WScript.Network")
    Set drives = network.EnumNetworkDrives

    If Not drives Is Nothing Then

        For index = 0 To drives.Count - 1 Step 2

            If UCase$(CStr(drives.Item(index))) = driveName Then

                remoteRoot = CStr(drives.Item(index + 1))
                Exit For

            End If

        Next index

    End If

    If remoteRoot = "" Then

        Err.Clear
        Set shell = CreateObject("WScript.Shell")
        remoteRoot = CStr(shell.RegRead("HKCU\Network\" & Left$(driveName, 1) & "\RemotePath"))

    End If

    On Error GoTo 0

    If remoteRoot <> "" Then _
        ResolveMappedFolderPath = StripTrailingPathSeparator(remoteRoot) & Mid$(folderPath, 3)

End Function

Private Function EnsureFolderPath(ByRef folderPath As String) As Boolean

    Dim fso As Object
    Dim candidate As String
    Dim resolvedCandidate As String
    Dim parentPath As String
    Dim errorNumber As Long
    Dim errorDescription As String

    On Error GoTo Failed

    candidate = StripTrailingPathSeparator(folderPath)
    If candidate = "" Then Exit Function

    Set fso = CreateObject("Scripting.FileSystemObject")

    If Not fso.FolderExists(candidate) Then

        resolvedCandidate = StripTrailingPathSeparator(ResolveMappedFolderPath(candidate))

        If StrComp(resolvedCandidate, candidate, vbTextCompare) <> 0 Then

            TraceRun "mapped-path-fallback=" & DiagnosticLineValue(resolvedCandidate)
            candidate = resolvedCandidate

        End If

    End If

    If Not fso.FolderExists(candidate) Then

        parentPath = fso.GetParentFolderName(candidate)

        If parentPath = "" Or Not fso.FolderExists(parentPath) Then

            TraceRun "folder-parent-unavailable=" & DiagnosticLineValue(parentPath)
            Exit Function

        End If

        fso.CreateFolder candidate

    End If

    If Not fso.FolderExists(candidate) Then Exit Function

    folderPath = candidate
    If Right$(folderPath, 1) <> "\" Then folderPath = folderPath & "\"

    EnsureFolderPath = True
    Exit Function

Failed:

    errorNumber = Err.Number
    errorDescription = Err.Description
    Err.Clear
    TraceRun "folder-error number=" & CStr(errorNumber) & _
             " description=" & DiagnosticLineValue(errorDescription) & _
             " path=" & DiagnosticLineValue(candidate)

End Function

Function EnsureSubFolder(parentFolder As String, subName As String) As String

    Dim baseFolder As String
    Dim resultFolder As String

    baseFolder = parentFolder

    If Right(baseFolder, 1) <> "\" Then baseFolder = baseFolder & "\"

    resultFolder = baseFolder & subName & "\"

    If Not EnsureFolderPath(resultFolder) Then _
        Err.Raise 76, "DXF_v16", "Could not access or create DXF subfolder: " & resultFolder

    EnsureSubFolder = resultFolder

End Function

Function HasSheetLikePlanarFaces(swPart As Object, midDimMm As Double, maxDimMm As Double) As Boolean

    Dim bodies As Variant

    bodies = GetPartBodies(swPart)

    If IsEmpty(bodies) Then

        TraceRun "thin-filter reject=no-solid-bodies"

        Exit Function

    End If

    Dim totalArea As Double

    Dim planarArea As Double

    Dim largestPlanarArea As Double

    Dim planarCount As Long

    Dim bodyCount As Long

    Dim bodyIndex As Long

    For bodyIndex = 0 To UBound(bodies)

        Dim b As Object

        Set b = bodies(bodyIndex)

        If Not b Is Nothing Then

            bodyCount = bodyCount + 1

            Dim faces As Variant

            On Error Resume Next

            faces = Empty
            faces = b.GetFaces

            On Error GoTo 0

            If Not IsEmpty(faces) Then

                Dim faceIndex As Long

                For faceIndex = 0 To UBound(faces)

                    Dim f As Object

                    Set f = faces(faceIndex)

                    If Not f Is Nothing Then

                        Dim area As Double

                        area = 0#

                        On Error Resume Next

                        area = f.GetArea

                        On Error GoTo 0

                        If area > 0# Then

                            totalArea = totalArea + area

                            If IsPlanarFace(f) Then

                                planarCount = planarCount + 1

                                planarArea = planarArea + area

                                If area > largestPlanarArea Then largestPlanarArea = area

                            End If

                        End If

                    End If

                Next faceIndex

            End If

        End If

    Next bodyIndex

    If totalArea <= 0# Then

        TraceRun "thin-filter reject=no-measurable-face-area bodies=" & _
                 CStr(bodyCount)

        Exit Function

    End If

    Dim footprintArea As Double

    footprintArea = (midDimMm * maxDimMm) / 1000000#

    Dim planarRatio As Double

    planarRatio = planarArea / totalArea

    Debug.Print "    Planar face check: planar=" & Round(planarRatio * 100#, 1) & "% count=" & planarCount

    TraceRun "thin-filter planar-summary bodies=" & CStr(bodyCount) & _
             " total-area-m2=" & CStr(totalArea) & _
             " planar-area-m2=" & CStr(planarArea) & _
             " planar-ratio=" & CStr(Round(planarRatio, 6)) & _
             " planar-count=" & CStr(planarCount) & _
             " largest-planar-area-m2=" & CStr(largestPlanarArea) & _
             " footprint-area-m2=" & CStr(footprintArea)

    If planarCount < 2 Then

        TraceRun "thin-filter reject=planar-face-count actual=" & _
                 CStr(planarCount) & " required=2"

        Exit Function

    End If

    If planarRatio < MIN_PLANAR_AREA_RATIO Then

        TraceRun "thin-filter reject=planar-area-ratio actual=" & _
                 CStr(Round(planarRatio, 6)) & _
                 " required=" & CStr(MIN_PLANAR_AREA_RATIO)

        Exit Function

    End If

    If footprintArea > 0# Then

        If bodyCount <= 1 Then

            If largestPlanarArea < footprintArea * MIN_LARGEST_PLANAR_FOOTPRINT_RATIO Then

                TraceRun "thin-filter reject=largest-planar-footprint-ratio actual=" & _
                         CStr(Round(largestPlanarArea / footprintArea, 6)) & _
                         " required=" & CStr(MIN_LARGEST_PLANAR_FOOTPRINT_RATIO)

                Exit Function

            End If

        Else

            Debug.Print "    Multibody thin solid: skip largest-face/combined-footprint ratio"

            TraceRun "thin-filter multibody-count=" & CStr(bodyCount) & _
                     " skip-largest-footprint-ratio"

        End If

    End If

    HasSheetLikePlanarFaces = True

    TraceRun "thin-filter planar-check=accepted bodies=" & CStr(bodyCount)

End Function

Function GetSortedBoxDimsMM(swPart As Object, ByRef minDim As Double, ByRef midDim As Double, ByRef maxDim As Double) As Boolean

    Dim box As Variant

    box = SafeGetPartBox(swPart)

    If IsEmpty(box) Then Exit Function

    Dim a As Double

    Dim b As Double

    Dim c As Double

    a = Abs(box(3) - box(0)) * 1000#

    b = Abs(box(4) - box(1)) * 1000#

    c = Abs(box(5) - box(2)) * 1000#

    Dim tmp As Double

    If a > b Then

        tmp = a

        a = b

        b = tmp

    End If

    If b > c Then

        tmp = b

        b = c

        c = tmp

    End If

    If a > b Then

        tmp = a

        a = b

        b = tmp

    End If

    minDim = a

    midDim = b

    maxDim = c

    GetSortedBoxDimsMM = True

End Function

Function GetBoundingThickness(swPart As Object) As Double
    Dim box As Variant

    box = SafeGetPartBox(swPart)

    If IsEmpty(box) Then

        Debug.Print "    No bounding box, treat as thick"

        GetBoundingThickness = 9999

        Exit Function

    End If



    Dim x As Double

    Dim y As Double

    Dim z As Double

    x = Abs(box(3) - box(0)) * 1000

    y = Abs(box(4) - box(1)) * 1000

    z = Abs(box(5) - box(2)) * 1000



    GetBoundingThickness = x

    If y < GetBoundingThickness Then GetBoundingThickness = y

    If z < GetBoundingThickness Then GetBoundingThickness = z

End Function

' Reads a plane face's normal + a point on the plane via Surface.PlaneParams.
Function TryGetPlaneNormalAndPoint(swFace As Object, outNorm() As Double, _
                                   outPoint() As Double) As Boolean
    TryGetPlaneNormalAndPoint = False
    If swFace Is Nothing Then Exit Function
    Dim surf As Object
    On Error Resume Next
    Set surf = swFace.GetSurface
    On Error GoTo 0
    If surf Is Nothing Then Exit Function
    If Not surf.IsPlane Then Exit Function
    Dim params As Variant
    params = Empty
    On Error Resume Next
    params = surf.PlaneParams
    On Error GoTo 0
    If IsEmpty(params) Then Exit Function
    If UBound(params) < 5 Then Exit Function
    Dim aLen As Double
    aLen = Sqr(params(0) * params(0) + params(1) * params(1) + params(2) * params(2))
    Dim bLen As Double
    bLen = Sqr(params(3) * params(3) + params(4) * params(4) + params(5) * params(5))
    If Abs(aLen - 1#) <= Abs(bLen - 1#) Then
        outNorm(0) = params(0)
        outNorm(1) = params(1)
        outNorm(2) = params(2)
        outPoint(0) = params(3)
        outPoint(1) = params(4)
        outPoint(2) = params(5)
    Else
        outNorm(0) = params(3)
        outNorm(1) = params(4)
        outNorm(2) = params(5)
        outPoint(0) = params(0)
        outPoint(1) = params(1)
        outPoint(2) = params(2)
    End If
    Dim nLen As Double
    nLen = Sqr(outNorm(0) * outNorm(0) + outNorm(1) * outNorm(1) + outNorm(2) * outNorm(2))
    If nLen <= 0.000001 Then Exit Function
    outNorm(0) = outNorm(0) / nLen
    outNorm(1) = outNorm(1) / nLen
    outNorm(2) = outNorm(2) / nLen
    Dim flip As Boolean
    flip = False
    On Error Resume Next
    flip = CBool(swFace.FaceInSurfaceSense)
    On Error GoTo 0
    If flip Then
        outNorm(0) = -outNorm(0)
        outNorm(1) = -outNorm(1)
        outNorm(2) = -outNorm(2)
    End If
    TryGetPlaneNormalAndPoint = True
End Function

Function SignedPlaneDistance(planeNorm() As Double, planePoint() As Double, _
                             ByVal qx As Double, ByVal qy As Double, ByVal qz As Double) As Double
    SignedPlaneDistance = (qx - planePoint(0)) * planeNorm(0) _
                        + (qy - planePoint(1)) * planeNorm(1) _
                        + (qz - planePoint(2)) * planeNorm(2)
End Function

Function GetThicknessAlongLargestPlaneNormal(swPart As Object) As Double
    GetThicknessAlongLargestPlaneNormal = 0
    Dim faceMax As Object
    Set faceMax = FindLargestPlanarFace(swPart)
    If faceMax Is Nothing Then Exit Function
    Dim planeN(2) As Double
    Dim planeP(2) As Double
    If Not TryGetPlaneNormalAndPoint(faceMax, planeN, planeP) Then Exit Function
    Dim bodies As Variant
    bodies = GetPartBodies(swPart)
    If IsEmpty(bodies) Then Exit Function
    Dim minProj As Double
    Dim maxProj As Double
    Dim seen As Boolean
    seen = False
    minProj = 0
    maxProj = 0
    Dim bi As Long
    For bi = 0 To UBound(bodies)
        Dim b As Object
        Set b = bodies(bi)
        If b Is Nothing Then GoTo NextBody
        Dim faces As Variant
        faces = Empty
        On Error Resume Next
        faces = b.GetFaces
        On Error GoTo 0
        If IsEmpty(faces) Then GoTo NextBody
        Dim fi As Long
        For fi = 0 To UBound(faces)
            Dim f As Object
            Set f = faces(fi)
            If f Is Nothing Then GoTo NextFace
            Dim faceBox As Variant
            faceBox = Empty
            On Error Resume Next
            faceBox = f.GetBox
            On Error GoTo 0
            If IsEmpty(faceBox) Then GoTo NextFace
            If UBound(faceBox) < 5 Then GoTo NextFace
            Dim cx As Long
            For cx = 0 To 1
                Dim cy As Long
                For cy = 0 To 1
                    Dim cz As Long
                    For cz = 0 To 1
                        Dim px As Double
                        Dim py As Double
                        Dim pz As Double
                        px = faceBox(IIf(cx = 0, 0, 3))
                        py = faceBox(IIf(cy = 0, 1, 4))
                        pz = faceBox(IIf(cz = 0, 2, 5))
                        Dim sd As Double
                        sd = SignedPlaneDistance(planeN, planeP, px, py, pz)
                        If Not seen Then
                            minProj = sd
                            maxProj = sd
                            seen = True
                        Else
                            If sd < minProj Then minProj = sd
                            If sd > maxProj Then maxProj = sd
                        End If
                    Next cz
                Next cy
            Next cx
NextFace:
        Next fi
NextBody:
    Next bi
    If Not seen Then Exit Function
    GetThicknessAlongLargestPlaneNormal = (maxProj - minProj) * 1000
End Function

Function GetThinSolidThickness(swPart As Object) As Double
    Dim thickness As Double
    thickness = GetThicknessViaBodyExtents(swPart)
    If thickness > 0.001 Then
        GetThinSolidThickness = thickness
        Debug.Print "    thickness via exact body extents: " & thickness & " mm"
        Exit Function
    End If

    thickness = GetThicknessAlongLargestPlaneNormal(swPart)
    If thickness > 0.001 Then
        GetThinSolidThickness = thickness
        TraceRun "thickness fallback=face-bounding-box mm=" & CStr(thickness)
    Else
        GetThinSolidThickness = GetBoundingThickness(swPart)
        TraceRun "thickness fallback=world-bounding-box mm=" & CStr(GetThinSolidThickness)
    End If
End Function

Function GetBodyAxisSpan(bodies As Variant, axis() As Double) As Double
    Dim b As Object, i As Long
    Dim x As Double, y As Double, z As Double
    Dim lo As Double, hi As Double, value As Double
    On Error GoTo Failed
    lo = 1E+30: hi = -1E+30
    For i = LBound(bodies) To UBound(bodies)
        Set b = bodies(i)
        If b Is Nothing Then Exit Function
        If Not b.GetExtremePoint(axis(0), axis(1), axis(2), x, y, z) Then Exit Function
        value = x * axis(0) + y * axis(1) + z * axis(2)
        If value > hi Then hi = value
        If Not b.GetExtremePoint(-axis(0), -axis(1), -axis(2), x, y, z) Then Exit Function
        value = x * axis(0) + y * axis(1) + z * axis(2)
        If value < lo Then lo = value
    Next i
    If hi > lo Then GetBodyAxisSpan = (hi - lo) * 1000#
    Exit Function
Failed:
    TraceRun "geometry axis-extents unavailable error=" & CStr(Err.Number)
End Function

Function GetFaceFootprintAxis(face As Object, normal() As Double, axis() As Double) As Boolean
    Dim edges As Variant, edge As Object, curve As Object
    Dim startVertex As Object, endVertex As Object
    Dim p As Variant, q As Variant, i As Long
    Dim dx As Double, dy As Double, dz As Double, length As Double, longest As Double
    Dim dot As Double
    ' Align with a straight edge when available; circles need no edge vertices.
    On Error GoTo FallbackAxis
    edges = face.GetEdges
    If Not IsEmpty(edges) Then
        For i = LBound(edges) To UBound(edges)
            Set edge = edges(i)
            Set curve = edge.GetCurve
            If curve.IsLine Then
                Set startVertex = edge.GetStartVertex
                Set endVertex = edge.GetEndVertex
                If Not startVertex Is Nothing And Not endVertex Is Nothing Then
                    p = startVertex.GetPoint: q = endVertex.GetPoint
                    dx = q(0) - p(0): dy = q(1) - p(1): dz = q(2) - p(2)
                    dot = dx * normal(0) + dy * normal(1) + dz * normal(2)
                    dx = dx - dot * normal(0): dy = dy - dot * normal(1): dz = dz - dot * normal(2)
                    length = Sqr(dx * dx + dy * dy + dz * dz)
                    If length > longest Then
                        longest = length
                        axis(0) = dx / length: axis(1) = dy / length: axis(2) = dz / length
                    End If
                End If
            End If
        Next i
    End If
FallbackAxis:
    If longest <= 0.0000001 Then
        If Abs(normal(0)) < 0.8 Then
            axis(0) = 0#: axis(1) = normal(2): axis(2) = -normal(1)
        Else
            axis(0) = -normal(2): axis(1) = 0#: axis(2) = normal(0)
        End If
        length = Sqr(axis(0) * axis(0) + axis(1) * axis(1) + axis(2) * axis(2))
        If length <= 0.0000001 Then Exit Function
        axis(0) = axis(0) / length: axis(1) = axis(1) / length: axis(2) = axis(2) / length
    End If
    GetFaceFootprintAxis = True
End Function

Function GetBodiesPlateDimensions(bodies As Variant, ByRef t As Double, _
                                  ByRef w As Double, ByRef longest As Double) As Boolean
    Dim face As Object
    Dim n(2) As Double, p(2) As Double, u(2) As Double, v(2) As Double
    Dim swapValue As Double
    If IsEmpty(bodies) Then Exit Function
    Set face = FindLargestPlanarFaceInBodies(bodies)
    If face Is Nothing Then Exit Function
    If Not TryGetPlaneNormalAndPoint(face, n, p) Then Exit Function
    If Not GetFaceFootprintAxis(face, n, u) Then Exit Function
    v(0) = n(1) * u(2) - n(2) * u(1)
    v(1) = n(2) * u(0) - n(0) * u(2)
    v(2) = n(0) * u(1) - n(1) * u(0)
    t = GetBodyAxisSpan(bodies, n)
    w = GetBodyAxisSpan(bodies, u)
    longest = GetBodyAxisSpan(bodies, v)
    If w > longest Then
        swapValue = w: w = longest: longest = swapValue
    End If
    GetBodiesPlateDimensions = (t > 0.001 And w > 0.001 And longest > 0.001)
End Function

Function GetPartFilterDimensions(swPart As Object, ByRef t As Double, _
                                 ByRef w As Double, ByRef longest As Double) As Boolean
    Dim bodies As Variant, boxThickness As Double
    bodies = GetPartBodies(swPart)
    If GetBodiesPlateDimensions(bodies, t, w, longest) Then
        GetPartFilterDimensions = True
        TraceRun "geometry source=face-aligned-body-extents t-mm=" & CStr(Round(t, 4)) & _
                 " width-mm=" & CStr(Round(w, 4)) & " length-mm=" & CStr(Round(longest, 4))
        Exit Function
    End If
    If Not GetSortedBoxDimsMM(swPart, boxThickness, w, longest) Then Exit Function
    t = GetThinSolidThickness(swPart)
    If t <= 0# Then t = boxThickness
    GetPartFilterDimensions = (t > 0# And w > 0# And longest > 0#)
    TraceRun "geometry fallback=world-footprint-with-normal-thickness t-mm=" & CStr(t) & _
             " width-mm=" & CStr(w) & " length-mm=" & CStr(longest)
End Function

Function GetThicknessViaBodyExtents(swPart As Object) As Double
    Dim bodies As Variant
    bodies = GetPartBodies(swPart)
    GetThicknessViaBodyExtents = GetBodiesThicknessViaExtents(bodies)
End Function

Function GetBodiesThicknessViaExtents(bodies As Variant) As Double
    If IsEmpty(bodies) Then Exit Function
    Dim faceMax As Object
    Set faceMax = FindLargestPlanarFaceInBodies(bodies)
    If faceMax Is Nothing Then Exit Function

    Dim planeN(2) As Double
    Dim planeP(2) As Double
    If Not TryGetPlaneNormalAndPoint(faceMax, planeN, planeP) Then Exit Function

    Dim minProj As Double, maxProj As Double
    Dim lowProj As Double, highProj As Double
    Dim lowX As Double, lowY As Double, lowZ As Double
    Dim highX As Double, highY As Double, highZ As Double
    Dim seen As Boolean, okLow As Boolean, okHigh As Boolean
    Dim bi As Long
    Dim body As Object
    On Error GoTo ExtentsFailed
    For bi = 0 To UBound(bodies)
        Set body = bodies(bi)
        If body Is Nothing Then GoTo ExtentsFailed
        ' Whole-body extrema include curved edges with no endpoint vertices.
        okHigh = body.GetExtremePoint(planeN(0), planeN(1), planeN(2), highX, highY, highZ)
        okLow = body.GetExtremePoint(-planeN(0), -planeN(1), -planeN(2), lowX, lowY, lowZ)
        If Not okHigh Or Not okLow Then GoTo ExtentsFailed
        highProj = SignedPlaneDistance(planeN, planeP, highX, highY, highZ)
        lowProj = SignedPlaneDistance(planeN, planeP, lowX, lowY, lowZ)
        If Not seen Then
            minProj = lowProj
            maxProj = highProj
            seen = True
        Else
            If lowProj < minProj Then minProj = lowProj
            If highProj > maxProj Then maxProj = highProj
        End If
    Next bi
    If seen Then GetBodiesThicknessViaExtents = (maxProj - minProj) * 1000
    Exit Function
ExtentsFailed:
    TraceRun "thickness exact-body-extents unavailable body=" & CStr(bi) & _
             " error=" & CStr(Err.Number)
End Function



Function FormatThickness(v As Double) As String

    ' Round to nearest whole millimeter, half goes up.
    Dim n As Long
    If v <= 0 Then
        n = 0
    Else
        n = Int(v + 0.5)
    End If
    FormatThickness = CStr(n)

End Function
