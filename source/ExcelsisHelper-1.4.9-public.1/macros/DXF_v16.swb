Option Explicit



Const swDocPART       As Long = 1

Const swDocASSEMBLY   As Long = 2

Const THICKNESS_LIMIT As Double = 20.1

Const THIN_PLATE_MIN_RATIO As Double = 2#
Const MIN_PLANAR_AREA_RATIO As Double = 0.25
Const MIN_LARGEST_PLANAR_FOOTPRINT_RATIO As Double = 0.15
' Washerlike binning: keep only parts that are simultaneously small enough
' (longest bbox dimension under WASHERLIKE_MAX_LONG_MM) AND have a low
' longDim/thickness ratio AND have a close-to-square/circular footprint
' (width near longDim). The old single-ratio test caught any small thin
' solid; that mis-binned compact tail plates (for example 60 x 72.735 x 13 mm,
' ratio 5.6) and borderline thin plates near 20-ratio.
Const WASHERLIKE_MAX_WIDTH_THICKNESS_RATIO As Double = 12#
Const WASHERLIKE_MAX_LONG_MM As Double = 60#
Const WASHERLIKE_MIN_ASPECT As Double = 0.7
Const DEFAULT_MATERIAL As String = "MATERIAL"
Const DXF_OUTPUT_PREFIX As String = "PLATE"

Const swSaveAsCurrentVersion      As Long = 0
Const swSaveAsOptions_Silent      As Long = 1
Const swOpenDocOptions_Silent     As Long = 1
Const swExportToDWG_ExportSheetMetal As Long = 1
Const swExportToDWG_ExportSelectedFacesOrLoops As Long = 2
Const swExportToDWG_ExportAnnotationViews As Long = 3
Const SHEET_METAL_EXPORT_OPTIONS  As Long = 1
Const swExportFlatPatternOption_None As Long = 0
Const swExportFlatPatternOption_RemoveBends As Long = 1
Const swComponentSuppressed As Long = 0
Const swComponentLightweight As Long = 1
Const swComponentResolved As Long = 3
Const swComponentFullyLightweight As Long = 4
Const swComponentInternalIdMismatch As Long = 5
Const swSolidBody As Long = 0
Const swObjectSame As Long = 1
Const swSelFACES As Long = 2
Const swDontRebuildActiveDoc As Long = 1


Const MODE_REGULAR As Integer = 1

Const MODE_PRECUT  As Integer = 2

Const ASSEMBLY_EXPORT_REGULAR As Integer = 1

Const ASSEMBLY_EXPORT_CONTEXT As Integer = 2



Dim swApp As Object



Dim g_precutOffset_mm As Double

Dim g_precutKeepFeats As Boolean

Dim g_material As String

Dim g_dxfComp() As Long

Dim g_dxfDropComp() As Boolean

Dim g_tracePath As String

Dim g_traceComponent As String

#If VBA7 Then
Private Declare PtrSafe Function ExcelsisGetCurrentProcessId Lib "kernel32" Alias "GetCurrentProcessId" () As Long
#Else
Private Declare Function ExcelsisGetCurrentProcessId Lib "kernel32" Alias "GetCurrentProcessId" () As Long
#End If

Private gExcelsisMacroMarkerOwned As Boolean
Private gExcelsisMacroMarkerPayload As String
Private gExcelsisMacroSettingsLoaded As Boolean
Private gExcelsisMacroSettingsJson As String

Private Function ExcelsisMacroRoot() As String
    ExcelsisMacroRoot = CreateObject("WScript.Shell").SpecialFolders("MyDocuments") & "\Excelsis Helper"
End Function

Private Function ExcelsisReadUtf8Text(ByVal filePath As String) As String
    Dim stream As Object
    Dim fileNo As Integer
    Dim byteCount As Long
    Dim rawText As String
    On Error GoTo BinaryFallback
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 2
    stream.Charset = "utf-8"
    stream.Open
    stream.LoadFromFile filePath
    ExcelsisReadUtf8Text = stream.ReadText(-1)
    stream.Close
    Exit Function
BinaryFallback:
    On Error Resume Next
    If Not stream Is Nothing Then stream.Close
    fileNo = FreeFile
    Open filePath For Binary Access Read As #fileNo
    byteCount = LOF(fileNo)
    If byteCount > 0 Then
        rawText = Space$(byteCount)
        Get #fileNo, , rawText
        ExcelsisReadUtf8Text = rawText
    End If
    Close #fileNo
    On Error GoTo 0
End Function

Private Function ExcelsisJsonStringValue(ByVal jsonText As String, ByVal settingName As String, ByVal fallbackValue As String) As String
    Dim keyPos As Long
    Dim colonPos As Long
    Dim quotePos As Long
    Dim pos As Long
    Dim ch As String
    Dim escapedChar As String
    Dim value As String
    On Error GoTo UseFallback
    keyPos = InStr(1, jsonText, """" & settingName & """", vbTextCompare)
    If keyPos = 0 Then GoTo UseFallback
    colonPos = InStr(keyPos + Len(settingName) + 2, jsonText, ":")
    If colonPos = 0 Then GoTo UseFallback
    quotePos = InStr(colonPos + 1, jsonText, """")
    If quotePos = 0 Then GoTo UseFallback
    pos = quotePos + 1
    Do While pos <= Len(jsonText)
        ch = Mid$(jsonText, pos, 1)
        If ch = """" Then
            ExcelsisJsonStringValue = value
            Exit Function
        End If
        If ch = "\" Then
            pos = pos + 1
            If pos > Len(jsonText) Then GoTo UseFallback
            escapedChar = Mid$(jsonText, pos, 1)
            Select Case escapedChar
                Case """", "\", "/": value = value & escapedChar
                Case "b": value = value & Chr$(8)
                Case "f": value = value & Chr$(12)
                Case "n": value = value & vbLf
                Case "r": value = value & vbCr
                Case "t": value = value & vbTab
                Case Else: value = value & escapedChar
            End Select
        Else
            value = value & ch
        End If
        pos = pos + 1
    Loop
UseFallback:
    ExcelsisJsonStringValue = fallbackValue
End Function

Private Function ExcelsisMacroSetting(ByVal settingName As String, ByVal fallbackValue As String) As String
    If Not gExcelsisMacroSettingsLoaded Then
        gExcelsisMacroSettingsLoaded = True
        gExcelsisMacroSettingsJson = ExcelsisReadUtf8Text(ExcelsisMacroRoot() & "\Macros\macro-settings.json")
    End If
    ExcelsisMacroSetting = ExcelsisJsonStringValue(gExcelsisMacroSettingsJson, settingName, fallbackValue)
End Function

Private Function ConfiguredDefaultMaterial() As String
    ConfiguredDefaultMaterial = ExcelsisMacroSetting("defaultMaterial", DEFAULT_MATERIAL)
End Function

Private Function ConfiguredDxfOutputPrefix() As String
    ConfiguredDxfOutputPrefix = ExcelsisMacroSetting("dxfOutputPrefix", DXF_OUTPUT_PREFIX)
End Function

Private Sub ExcelsisStartMacroRunMarker()
    Dim fso As Object
    Dim markerFile As Object
    Dim root As String
    On Error GoTo Failed
    root = ExcelsisMacroRoot()
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FolderExists(root) Then fso.CreateFolder root
    gExcelsisMacroMarkerPayload = "{""schema"":""excelsis-helper-macro-run-v1"",""pid"":" & _
        CStr(ExcelsisGetCurrentProcessId()) & ",""startedAt"":""" & _
        Format$(Now, "yyyy-mm-dd\Thh:nn:ss") & """,""macroName"":""DXF_v16.swp""}"
    Set markerFile = fso.CreateTextFile(root & "\macro-running.json", True, False)
    markerFile.Write gExcelsisMacroMarkerPayload
    markerFile.Close
    gExcelsisMacroMarkerOwned = True
    Exit Sub
Failed:
    gExcelsisMacroMarkerOwned = False
End Sub

Private Sub ExcelsisStopMacroRunMarker()
    Dim fso As Object
    Dim markerFile As Object
    Dim markerPath As String
    Dim currentPayload As String
    If Not gExcelsisMacroMarkerOwned Then Exit Sub
    gExcelsisMacroMarkerOwned = False
    On Error GoTo Done
    markerPath = ExcelsisMacroRoot() & "\macro-running.json"
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FileExists(markerPath) Then Exit Sub
    Set markerFile = fso.OpenTextFile(markerPath, 1, False)
    currentPayload = markerFile.ReadAll
    markerFile.Close
    If currentPayload = gExcelsisMacroMarkerPayload Then fso.DeleteFile markerPath, True
Done:
End Sub

Function TraceFileLabel(filePath As String) As String

    Dim slashPos As Long

    slashPos = InStrRev(filePath, "\")

    If slashPos > 0 Then

        TraceFileLabel = Mid$(filePath, slashPos + 1)

    Else

        TraceFileLabel = filePath

    End If

    TraceFileLabel = Replace$(TraceFileLabel, vbCr, " ")
    TraceFileLabel = Replace$(TraceFileLabel, vbLf, " ")

End Function

Sub TraceRun(message As String)

    If g_tracePath = "" Then Exit Sub

    Dim fileNo As Integer

    On Error Resume Next

    fileNo = FreeFile
    Open g_tracePath For Append As #fileNo
    Print #fileNo, Format$(Now, "yyyy-mm-dd hh:nn:ss") & " " & _
                   Replace$(Replace$(message, vbCr, " "), vbLf, " ")
    Close #fileNo

    On Error GoTo 0

End Sub

Sub InitializeRunTrace(swModel As Object)

    g_tracePath = Environ$("TEMP") & "\Excelsis_DXF_last_run.log"
    g_traceComponent = ""

    Dim fileNo As Integer

    On Error Resume Next

    fileNo = FreeFile
    Open g_tracePath For Output As #fileNo
    Print #fileNo, "Excelsis DXF assembly-context trace"
    Close #fileNo

    On Error GoTo 0

    TraceRun "root=" & GetDocumentActivationName(swModel)

End Sub


' ================================================================

Sub main()
    Dim errorNumber As Long
    Dim errorSource As String
    Dim errorDescription As String
    Dim errorHelpFile As String
    Dim errorHelpContext As Long
    On Error GoTo MacroFailed
    ExcelsisStartMacroRunMarker
    ExcelsisMacroMain
    ExcelsisStopMacroRunMarker
    Exit Sub
MacroFailed:
    errorNumber = Err.Number
    errorSource = Err.Source
    errorDescription = Err.Description
    errorHelpFile = Err.HelpFile
    errorHelpContext = Err.HelpContext
    On Error Resume Next
    ExcelsisStopMacroRunMarker
    On Error GoTo 0
    Err.Raise errorNumber, errorSource, errorDescription, errorHelpFile, errorHelpContext
End Sub

Private Sub ExcelsisMacroMain()



    Set swApp = Application.SldWorks



    Dim swModel As Object

    Set swModel = swApp.ActiveDoc

    If swModel Is Nothing Then

        MsgBox "No active document."

        Exit Sub

    End If



    Dim mType As Long

    mType = swModel.GetType

    If mType <> swDocPART And mType <> swDocASSEMBLY Then

        MsgBox "Open a Part or Assembly."

        Exit Sub

    End If



    If swModel.GetPathName = "" Then

        MsgBox "Save the active document before exporting DXFs."

        Exit Sub

    End If

    Dim selMgr As Object
    Set selMgr = swModel.SelectionManager

    Dim selCount As Long

    selCount = selMgr.GetSelectedObjectCount2(-1)

    Dim activePartSelectedFace As Object

    Set activePartSelectedFace = Nothing

    If mType = swDocPART And selCount = 1 Then

        Dim activeSelectionType As Long

        activeSelectionType = -1

        On Error Resume Next

        activeSelectionType = selMgr.GetSelectedObjectType3(1, -1)

        If activeSelectionType = swSelFACES Then _
            Set activePartSelectedFace = selMgr.GetSelectedObject6(1, -1)

        On Error GoTo 0

        If activeSelectionType = swSelFACES Then

            If activePartSelectedFace Is Nothing Then

                MsgBox "Could not read the selected face. Select one flat face and run DXF again."

                Exit Sub

            End If

            If Not IsPlanarFace(activePartSelectedFace) Then

                MsgBox "The selected face is not planar. Select one flat face and run DXF again."

                Exit Sub

            End If

        End If

    End If



    If Not AskMaterial() Then Exit Sub



    Debug.Print "==== DXF EXPORT v16 washer ratio split ===="
    Debug.Print "Active: " & swModel.GetPathName

    Debug.Print "Type: " & IIf(mType = swDocPART, "PART", "ASSEMBLY")

    Debug.Print "Selections: " & selCount

    Debug.Print "Material: " & g_material


    Dim mode As Integer

    mode = MODE_REGULAR

    Dim needPrompt As Boolean

    needPrompt = False

    If mType = swDocPART Then needPrompt = True

    If mType = swDocASSEMBLY And selCount > 0 Then needPrompt = True



    If needPrompt Then

        mode = AskExportMode()

        If mode = 0 Then Exit Sub

        If mode = MODE_PRECUT Then

            If Not AskPrecutSettings() Then Exit Sub

            Debug.Print "Precut: offset=" & g_precutOffset_mm & "mm  keepFeats=" & g_precutKeepFeats

        End If

    End If



    Dim assemblyExportMethod As Integer

    assemblyExportMethod = ASSEMBLY_EXPORT_REGULAR

    If mType = swDocASSEMBLY And mode = MODE_REGULAR Then

        assemblyExportMethod = AskAssemblyExportMethod()

        If assemblyExportMethod = 0 Then Exit Sub

    End If



    Debug.Print "Mode: " & IIf(mode = MODE_REGULAR, "REGULAR", "PRECUT")

    If mType = swDocASSEMBLY And mode = MODE_REGULAR Then

        Debug.Print "Assembly geometry: " & IIf(assemblyExportMethod = ASSEMBLY_EXPORT_CONTEXT, _
                                                 "TEMPORARY PART BODY (ASSEMBLY CONTEXT)", _
                                                 "REGULAR PART FILE")

    End If



    Dim baseFolder As String

    baseFolder = Left(swModel.GetPathName, InStrRev(swModel.GetPathName, "\"))

    Dim dxfFolder As String

    If mode = MODE_PRECUT Then

        dxfFolder = baseFolder & "dxf_precut\"

    Else

        dxfFolder = baseFolder & "dxf\"

    End If

    If Dir(dxfFolder, vbDirectory) = "" Then MkDir dxfFolder

    Debug.Print "Output folder: " & dxfFolder

    InitializeRunTrace swModel

    TraceRun "mode=" & CStr(mode) & " assembly-method=" & CStr(assemblyExportMethod)



    Dim dictDone   As Object

    Dim dictOpened As Object

    Dim dictInitiallyVisibleDocumentWindows As Object

    Set dictDone = CreateObject("Scripting.Dictionary")

    Set dictOpened = CreateObject("Scripting.Dictionary")

    Set dictInitiallyVisibleDocumentWindows = BuildVisibleDocumentWindowKeyDict()

    If mType = swDocPART Then

        Debug.Print "--- Single part mode ---"

        ProcessSinglePart swModel, swModel.GetPathName, _
                          GetActiveConfigName(swModel), 1, dxfFolder, mode, dictDone, _
                          activePartSelectedFace

    ElseIf selCount > 0 Then

        Debug.Print "--- Assembly with selection ---"

        Dim dictQty As Object

        If mode = MODE_REGULAR And _
           assemblyExportMethod = ASSEMBLY_EXPORT_CONTEXT Then

            Set dictQty = BuildAssemblyContextQtyDict(swModel)

        Else

            Set dictQty = BuildQtyDict(swModel)

        End If

        ProcessSelectedComponents swModel, selMgr, selCount, dxfFolder, mode, _
                                  assemblyExportMethod, dictQty, dictDone, dictOpened

    Else

        Debug.Print "--- Assembly full export ---"

        ProcessFullAssembly swModel, dxfFolder, assemblyExportMethod, _
                            dictDone, dictOpened

    End If



    Debug.Print "-----------------------------------------"

    TraceRun "export processing complete"

    TraceRun "closing explicitly opened documents"
    CloseExplicitlyOpenedPartDocs dictOpened

    TraceRun "closing extra visible document windows"
    CloseVisibleDocumentsOpenedByMacro dictInitiallyVisibleDocumentWindows, swModel

    TraceRun "reactivating root document"
    ActivateModelDocument swModel


    Debug.Print "==== EXPORT COMPLETE ===="

    TraceRun "complete exported-entries=" & CStr(dictDone.Count)

    MsgBox "DXF export done." & vbCrLf & _
           "Exported entries: " & CStr(dictDone.Count) & vbCrLf & _
           "Trace: " & g_tracePath

End Sub



' ================================================================

Function GetActiveConfigName(swModel As Object) As String

    Dim c As Object

    Set c = swModel.GetActiveConfiguration

    If c Is Nothing Then

        GetActiveConfigName = ""

    Else

        GetActiveConfigName = c.Name

    End If

End Function



' ================================================================

Function AskExportMode() As Integer
    Dim r As VbMsgBoxResult

    r = MsgBox("Export as:" & vbCrLf & vbCrLf & _
               "YES   = Regular DXF" & vbCrLf & _
               "NO    = Crude precut (offset outline)" & vbCrLf & _
               "CANCEL = abort", vbYesNoCancel + vbQuestion, "Export type")

    Select Case r

        Case vbYes

            AskExportMode = MODE_REGULAR

        Case vbNo

            AskExportMode = MODE_PRECUT

        Case vbCancel

            AskExportMode = 0

    End Select

End Function

Function GetDocumentActivationName(swModel As Object) As String

    If swModel Is Nothing Then Exit Function

    Dim pathName As String

    On Error Resume Next

    pathName = swModel.GetPathName

    On Error GoTo 0

    If pathName <> "" Then

        GetDocumentActivationName = Mid$(pathName, InStrRev(pathName, "\") + 1)

    Else

        GetDocumentActivationName = swModel.GetTitle

    End If

End Function

Function ModelDocumentsAreSame(leftDoc As Object, rightDoc As Object) As Boolean

    If leftDoc Is Nothing Or rightDoc Is Nothing Then Exit Function

    On Error Resume Next

    If leftDoc Is rightDoc Then

        ModelDocumentsAreSame = True

        On Error GoTo 0

        Exit Function

    End If

    Dim leftPath As String

    Dim rightPath As String

    leftPath = leftDoc.GetPathName

    rightPath = rightDoc.GetPathName

    If leftPath <> "" And rightPath <> "" Then

        ModelDocumentsAreSame = (StrComp(leftPath, rightPath, vbTextCompare) = 0)

    Else

        ModelDocumentsAreSame = (leftDoc.GetType = rightDoc.GetType And _
                                 StrComp(leftDoc.GetTitle, rightDoc.GetTitle, _
                                         vbTextCompare) = 0)

    End If

    On Error GoTo 0

End Function

Function ActivateModelDocument(swModel As Object) As Boolean

    ActivateModelDocument = False

    If swModel Is Nothing Then Exit Function

    Dim activeDoc As Object

    Set activeDoc = swApp.ActiveDoc

    If ModelDocumentsAreSame(activeDoc, swModel) Then

        ActivateModelDocument = True

        Exit Function

    End If

    Dim activationName As String

    activationName = GetDocumentActivationName(swModel)

    If activationName = "" Then Exit Function

    Dim activateErrs As Long

    Dim activatedDoc As Object

    On Error Resume Next

    Set activatedDoc = swApp.ActivateDoc3(activationName, False, _
                                          swDontRebuildActiveDoc, activateErrs)

    On Error GoTo 0

    Set activeDoc = swApp.ActiveDoc

    ActivateModelDocument = ModelDocumentsAreSame(activeDoc, swModel)

    If Not ActivateModelDocument Then

        Debug.Print "Could not activate exact document: " & activationName & _
                    " error=" & activateErrs

    End If

End Function

Function ActivateConfigurationChecked(swModel As Object, cfg As String) As Boolean

    ActivateConfigurationChecked = False

    If swModel Is Nothing Then Exit Function

    If Not ActivateModelDocument(swModel) Then Exit Function

    If cfg = "" Or _
       StrComp(GetActiveConfigName(swModel), cfg, vbTextCompare) = 0 Then

        ActivateConfigurationChecked = True

        Exit Function

    End If

    Dim switched As Boolean

    On Error Resume Next

    switched = CBool(swModel.ShowConfiguration2(cfg))

    On Error GoTo 0

    If switched And _
       StrComp(GetActiveConfigName(swModel), cfg, vbTextCompare) = 0 Then

        swModel.EditRebuild3

        swModel.ForceRebuild3 False

        ActivateConfigurationChecked = True

    Else

        Debug.Print "Could not activate exact configuration: " & cfg

    End If

End Function

Function AskAssemblyExportMethod() As Integer

    Dim r As VbMsgBoxResult

    r = MsgBox("Where should regular DXF geometry come from?" & vbCrLf & vbCrLf & _
               "YES = Within assembly: evaluated body + Normal To" & vbCrLf & _
               "      Includes cuts/features that exist only in the assembly" & vbCrLf & _
               "NO = Regular referenced part-file export" & vbCrLf & _
               "CANCEL = abort", _
               vbYesNoCancel + vbQuestion + vbDefaultButton1, _
               "Assembly DXF method")

    Select Case r

        Case vbYes

            AskAssemblyExportMethod = ASSEMBLY_EXPORT_CONTEXT

        Case vbNo

            AskAssemblyExportMethod = ASSEMBLY_EXPORT_REGULAR

        Case Else

            AskAssemblyExportMethod = 0

    End Select

End Function

Function AskMaterial() As Boolean

    g_material = ConfiguredDefaultMaterial()

    Dim choice As VbMsgBoxResult

    choice = MsgBox("Material for DXF filenames defaults to " & ConfiguredDefaultMaterial() & "." & vbCrLf & vbCrLf & _
                    "YES = export now with " & ConfiguredDefaultMaterial() & vbCrLf & _
                    "NO = change material" & vbCrLf & _
                    "CANCEL = abort", _
                    vbYesNoCancel + vbQuestion + vbDefaultButton1, "DXF material")

    If choice = vbCancel Then Exit Function

    If choice = vbYes Then

        AskMaterial = True

        Exit Function

    End If

    Dim s As String

    s = InputBox("Material text for DXF filenames:" & vbCrLf & _
                 "Example: " & ConfiguredDefaultMaterial() & " gives " & ConfiguredDxfOutputPrefix() & "3_" & ConfiguredDefaultMaterial() & "_2db_part(config).dxf", _
                 "DXF material", ConfiguredDefaultMaterial())

    If Trim(s) = "" Then Exit Function

    g_material = UCase(CleanFileName(Trim(s)))

    If g_material = "" Then

        MsgBox "Invalid material."

        Exit Function

    End If

    AskMaterial = True

End Function

Function AskPrecutSettings() As Boolean
    Dim s As String

    s = InputBox("Offset outward from outline (mm):", "Crude precut", "20")

    If s = "" Then

        AskPrecutSettings = False

        Exit Function

    End If

    If Not IsNumeric(s) Then

        MsgBox "Invalid number."

        AskPrecutSettings = False

        Exit Function

    End If

    g_precutOffset_mm = CDbl(s)

    If g_precutOffset_mm < 0 Then g_precutOffset_mm = 0



    Dim r As VbMsgBoxResult

    r = MsgBox("Keep original outline + holes inside the offset outline?" & vbCrLf & vbCrLf & _
               "YES = keep all features + offset" & vbCrLf & _
               "NO  = offset outline only", _
               vbYesNoCancel + vbQuestion, "Crude precut")

    Select Case r

        Case vbYes

            g_precutKeepFeats = True

        Case vbNo

            g_precutKeepFeats = False

        Case vbCancel

            AskPrecutSettings = False

            Exit Function

    End Select

    AskPrecutSettings = True

End Function



' ================================================================
' Hidden-component check. SOLIDWORKS Component2.Visible returns:
'   1 = visible, 2 = hidden, 3 = visible-with-an-ambiguous-parent
' We treat 2 as "skip" so a part hidden by the user (or whose parent
' assembly hid it) does not get counted or saved as a DXF.
Function IsComponentHiddenSafe(swComp As Object) As Boolean
    IsComponentHiddenSafe = False
    If swComp Is Nothing Then Exit Function
    Dim v As Long
    v = 1
    On Error Resume Next
    v = CLng(swComp.Visible)
    On Error GoTo 0
    If v = 2 Then IsComponentHiddenSafe = True
End Function

Function GetComponentSuppressionStateSafe(swComp As Object) As Long
    GetComponentSuppressionStateSafe = -1
    If swComp Is Nothing Then Exit Function

    Dim state As Long
    state = -1

    On Error Resume Next
    Err.Clear
    state = CLng(swComp.GetSuppression2)
    If Err.Number <> 0 Then
        Err.Clear
        state = CLng(swComp.GetSuppression)
    End If
    On Error GoTo 0

    GetComponentSuppressionStateSafe = state
End Function

Function IsComponentActuallySuppressedSafe(swComp As Object) As Boolean
    If swComp Is Nothing Then
        IsComponentActuallySuppressedSafe = True
        Exit Function
    End If

    Dim state As Long
    state = GetComponentSuppressionStateSafe(swComp)

    If state >= 0 Then
        IsComponentActuallySuppressedSafe = (state = swComponentSuppressed Or _
                                             state = swComponentInternalIdMismatch)
        Exit Function
    End If

    On Error Resume Next
    IsComponentActuallySuppressedSafe = CBool(swComp.IsSuppressed)
    On Error GoTo 0
End Function

Function IsComponentLightweightSafe(swComp As Object) As Boolean
    Dim state As Long
    state = GetComponentSuppressionStateSafe(swComp)
    IsComponentLightweightSafe = (state = swComponentLightweight Or _
                                  state = swComponentFullyLightweight)
End Function

Sub ResolveSelectedPartIfLightweight(swComp As Object)
    If Not IsComponentLightweightSafe(swComp) Then Exit Sub

    Dim result As Long

    result = -1

    On Error Resume Next

    result = CLng(swComp.SetSuppression2(swComponentResolved))

    On Error GoTo 0

    Debug.Print "    Selected lightweight part resolve result=" & result
End Sub

Function ComponentHasExcludedAssemblyAncestor(swComp As Object, _
                                               Optional excludeLightweight As Boolean = True, _
                                               Optional excludeImportedPathAncestor As Boolean = True) As Boolean

    If swComp Is Nothing Then Exit Function

    Dim currentComp As Object

    Set currentComp = swComp

    Dim parentComp As Object

    On Error Resume Next

    Set parentComp = currentComp.GetParent

    On Error GoTo 0

    Dim depth As Long

    Do While Not parentComp Is Nothing And depth < 64

        If IsComponentActuallySuppressedSafe(parentComp) Or _
           IsComponentHiddenSafe(parentComp) Or _
           (excludeLightweight And IsComponentLightweightSafe(parentComp)) Then

            ComponentHasExcludedAssemblyAncestor = True

            Exit Function

        End If

        Dim parentPath As String

        parentPath = ""

        On Error Resume Next

        parentPath = parentComp.GetPathName

        On Error GoTo 0

        If excludeImportedPathAncestor Then

            If parentPath <> "" And IsImportedPartPath(parentPath) Then

                ComponentHasExcludedAssemblyAncestor = True

                Exit Function

            End If

        End If

        Set currentComp = parentComp

        Set parentComp = Nothing

        On Error Resume Next

        Set parentComp = currentComp.GetParent

        On Error GoTo 0

        depth = depth + 1

    Loop

End Function

' ================================================================

Function BuildQtyDict(swModel As Object) As Object

    Dim d As Object

    Set d = CreateObject("Scripting.Dictionary")

    Dim vc As Variant

    vc = swModel.GetComponents(False)

    If IsEmpty(vc) Then

        Set BuildQtyDict = d

        Exit Function

    End If

    Dim i As Long

    Dim c As Object

    For i = 0 To UBound(vc)

        Set c = vc(i)

        If Not c Is Nothing Then

            If (Not IsComponentActuallySuppressedSafe(c)) And (Not IsComponentHiddenSafe(c)) Then

                Dim p As String

                p = c.GetPathName

                If p = "" Then GoTo NextQtyComp

                If Not IsPartPath(p) And Not IsAssemblyPath(p) Then GoTo NextQtyComp

                Dim k As String
                k = LCase(p) & "@" & c.ReferencedConfiguration
                If d.Exists(k) Then

                    d(k) = d(k) + 1

                Else

                    d.Add k, 1

                End If

            End If

        End If

NextQtyComp:

    Next i
    Set BuildQtyDict = d

End Function



' ================================================================

Function BuildAssemblyContextQtyDict(swModel As Object) As Object

    Dim d As Object

    Set d = CreateObject("Scripting.Dictionary")

    Dim components As Variant

    components = swModel.GetComponents(False)

    If IsEmpty(components) Then

        Set BuildAssemblyContextQtyDict = d

        Exit Function

    End If

    Dim i As Long

    For i = 0 To UBound(components)

        Dim swComp As Object

        Set swComp = components(i)

        If swComp Is Nothing Then GoTo NextContextQtyComponent

        If IsComponentActuallySuppressedSafe(swComp) Then GoTo NextContextQtyComponent

        If IsComponentHiddenSafe(swComp) Then GoTo NextContextQtyComponent

        If ComponentHasExcludedAssemblyAncestor(swComp, False) Then GoTo NextContextQtyComponent

        Dim partPath As String

        partPath = swComp.GetPathName

        If Not IsPartPath(partPath) And _
           Not IsAssemblyPath(partPath) Then GoTo NextContextQtyComponent

        If IsImportedPartPath(partPath) Then GoTo NextContextQtyComponent

        Dim fullKey As String

        fullKey = LCase(partPath) & "@" & swComp.ReferencedConfiguration

        If d.Exists(fullKey) Then

            d(fullKey) = CLng(d(fullKey)) + 1

        Else

            d.Add fullKey, 1

        End If

NextContextQtyComponent:

    Next i

    Set BuildAssemblyContextQtyDict = d

End Function

' ================================================================

Function BuildVisibleOpenPartWindowPathDict() As Object

    Dim d As Object

    Set d = CreateObject("Scripting.Dictionary")

    Dim swDoc As Object

    On Error Resume Next

    Set swDoc = swApp.GetFirstDocument

    Do While Not swDoc Is Nothing

        If swDoc.GetType = swDocPART Then

            Dim isVisible As Boolean

            isVisible = False

            Err.Clear

            isVisible = CBool(swDoc.Visible)

            If Err.Number <> 0 Then

                Err.Clear

                isVisible = False

            End If

            If isVisible Then

                Dim pathName As String

                pathName = swDoc.GetPathName

                If IsPartPath(pathName) Then

                    If Not d.Exists(LCase(pathName)) Then d.Add LCase(pathName), pathName

                End If

            End If

        End If

        Set swDoc = swDoc.GetNext

    Loop

    On Error GoTo 0

    Debug.Print "Initially visible part windows: " & d.Count

    Set BuildVisibleOpenPartWindowPathDict = d

End Function

Function IsDocumentWindowVisible(swDoc As Object) As Boolean

    IsDocumentWindowVisible = False
    If swDoc Is Nothing Then Exit Function

    On Error Resume Next
    Err.Clear
    IsDocumentWindowVisible = CBool(swDoc.Visible)
    If Err.Number <> 0 Then
        Err.Clear
        IsDocumentWindowVisible = False
    End If
    On Error GoTo 0

End Function

Function GetDocumentWindowKey(swDoc As Object) As String

    If swDoc Is Nothing Then Exit Function

    Dim docType As Long
    Dim pathName As String
    Dim title As String

    On Error Resume Next
    docType = swDoc.GetType
    pathName = swDoc.GetPathName
    title = swDoc.GetTitle
    On Error GoTo 0

    If pathName <> "" Then
        GetDocumentWindowKey = "path|" & CStr(docType) & "|" & LCase$(pathName)
    ElseIf title <> "" Then
        GetDocumentWindowKey = "title|" & CStr(docType) & "|" & LCase$(title)
    End If

End Function

Function BuildVisibleDocumentWindowKeyDict() As Object

    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")

    Dim snapshotOk As Boolean
    Dim modelDocs As Collection
    Set modelDocs = GetModelWindowDocuments(snapshotOk)

    If Not snapshotOk Or modelDocs Is Nothing Then
        Debug.Print "Could not capture actual model windows; cleanup will fail closed"
        TraceRun "initial model-window snapshot failed"
        Set BuildVisibleDocumentWindowKeyDict = Nothing
        Exit Function
    End If

    Dim swDoc As Object
    Dim i As Long
    For i = 1 To modelDocs.Count
        Set swDoc = modelDocs(i)

        Dim windowKey As String
        windowKey = GetDocumentWindowKey(swDoc)
        If windowKey <> "" Then
            If Not d.Exists(windowKey) Then d.Add windowKey, True
        End If
    Next i

    Debug.Print "Initially visible document windows: " & d.Count
    TraceRun "initial model windows=" & CStr(d.Count)
    Set BuildVisibleDocumentWindowKeyDict = d

End Function

Sub RebuildDocumentIfNeeded(swModel As Object)

    If swModel Is Nothing Then Exit Sub

    Dim rebuildStatus As Long

    rebuildStatus = 0

    On Error Resume Next

    Err.Clear

    rebuildStatus = CLng(swModel.Extension.NeedsRebuild2)

    If Err.Number <> 0 Then

        rebuildStatus = 0

        Err.Clear

    End If

    On Error GoTo 0

    If rebuildStatus <> 0 Then swModel.EditRebuild3

End Sub

Function GetModelWindowDocuments(ByRef snapshotOk As Boolean) As Collection

    snapshotOk = False

    Dim docs As Collection
    Set docs = New Collection

    On Error GoTo SnapshotFailed

    Dim swFrame As Object
    Set swFrame = swApp.Frame
    If swFrame Is Nothing Then GoTo SnapshotFailed

    Dim modelWindows As Variant
    modelWindows = swFrame.ModelWindows
    If Not IsArray(modelWindows) Then GoTo SnapshotFailed

    Dim windowObject As Variant
    For Each windowObject In modelWindows
        Dim swModelWindow As Object
        Dim swDoc As Object

        Set swModelWindow = windowObject
        If Not swModelWindow Is Nothing Then Set swDoc = swModelWindow.ModelDoc
        If Not swDoc Is Nothing Then docs.Add swDoc
    Next windowObject

    snapshotOk = True
    Set GetModelWindowDocuments = docs
    Exit Function

SnapshotFailed:

    Debug.Print "Model-window snapshot error " & Err.Number & ": " & Err.Description
    Err.Clear
    Set GetModelWindowDocuments = Nothing

End Function

Function VisibleDocumentSnapshotContains(dictInitiallyVisible As Object, _
                                         swDoc As Object) As Boolean

    If dictInitiallyVisible Is Nothing Or swDoc Is Nothing Then Exit Function

    Dim windowKey As String
    windowKey = GetDocumentWindowKey(swDoc)
    If windowKey <> "" Then _
        VisibleDocumentSnapshotContains = dictInitiallyVisible.Exists(windowKey)

End Function

Sub CloseVisibleDocumentsOpenedByMacro(dictInitiallyVisible As Object, _
                                       originalDoc As Object)

    If dictInitiallyVisible Is Nothing Then Exit Sub

    Dim snapshotOk As Boolean
    Dim modelDocs As Collection
    Set modelDocs = GetModelWindowDocuments(snapshotOk)

    If Not snapshotOk Or modelDocs Is Nothing Then
        Debug.Print "Could not enumerate current model windows; leaving them unchanged"
        TraceRun "current model-window snapshot failed; cleanup skipped"
        Exit Sub
    End If

    Dim docsToClose As Collection
    Set docsToClose = New Collection

    Dim swDoc As Object
    Dim i As Long
    For i = 1 To modelDocs.Count
        Set swDoc = modelDocs(i)

        If Not ModelDocumentsAreSame(swDoc, originalDoc) Then
            If Not VisibleDocumentSnapshotContains(dictInitiallyVisible, swDoc) Then
                docsToClose.Add swDoc
            End If
        End If
    Next i

    Debug.Print "Extra visible document windows to close: " & docsToClose.Count
    TraceRun "new model windows to close=" & CStr(docsToClose.Count)

    For i = docsToClose.Count To 1 Step -1
        Set swDoc = docsToClose(i)

        Dim closeName As String
        closeName = GetDocumentActivationName(swDoc)

        If closeName <> "" Then
            Debug.Print "  Closing macro-opened window: " & closeName
            TraceRun "closing new model window=" & closeName

            Dim closeErrNumber As Long
            Dim closeErrDescription As String
            On Error Resume Next
            Err.Clear
            swApp.CloseDoc closeName
            closeErrNumber = Err.Number
            closeErrDescription = Err.Description
            On Error GoTo 0

            If closeErrNumber <> 0 Then
                Debug.Print "  Close failed: " & closeName & _
                            " error=" & CStr(closeErrNumber) & _
                            " " & closeErrDescription
                TraceRun "close new model window failed=" & closeName & _
                         " error=" & CStr(closeErrNumber)
            End If
        Else
            Debug.Print "  Could not identify macro-opened window; leaving it open"
            TraceRun "could not identify new model window for close"
        End If
    Next i

    Dim remainingDocs As Collection
    Set remainingDocs = GetModelWindowDocuments(snapshotOk)

    If snapshotOk And Not remainingDocs Is Nothing Then
        Dim remainingCount As Long
        remainingCount = 0

        For i = 1 To remainingDocs.Count
            Set swDoc = remainingDocs(i)
            If Not ModelDocumentsAreSame(swDoc, originalDoc) Then
                If Not VisibleDocumentSnapshotContains(dictInitiallyVisible, swDoc) Then
                    remainingCount = remainingCount + 1
                    TraceRun "new model window remains=" & GetDocumentActivationName(swDoc)
                End If
            End If
        Next i

        TraceRun "new model windows remaining=" & CStr(remainingCount)
    Else
        TraceRun "post-close model-window verification failed"
    End If

    If Not originalDoc Is Nothing Then ActivateModelDocument originalDoc

End Sub

Function BuildAssemblyPartPathDict(swModel As Object, _
                                   Optional resolveLightweight As Boolean = True) As Object

    Dim d As Object

    Set d = CreateObject("Scripting.Dictionary")

    If swModel Is Nothing Then

        Set BuildAssemblyPartPathDict = d

        Exit Function

    End If

    If swModel.GetType <> swDocASSEMBLY Then

        Set BuildAssemblyPartPathDict = d

        Exit Function

    End If

    If resolveLightweight Then

        On Error Resume Next

        swModel.ResolveAllLightWeightComponents True

        On Error GoTo 0

    End If

    Dim vComps As Variant

    vComps = swModel.GetComponents(False)

    If IsEmpty(vComps) Then

        Set BuildAssemblyPartPathDict = d

        Exit Function

    End If

    Dim i As Long

    For i = 0 To UBound(vComps)

        Dim swComp As Object

        Set swComp = vComps(i)

        If Not swComp Is Nothing Then

            If Not IsComponentActuallySuppressedSafe(swComp) Then

                Dim partPath As String

                partPath = swComp.GetPathName

                If partPath <> "" And IsPartPath(partPath) Then

                    If Not d.Exists(LCase(partPath)) Then d.Add LCase(partPath), partPath

                End If

            End If

        End If

    Next i

    Debug.Print "Assembly part documents tracked for cleanup: " & d.Count

    Set BuildAssemblyPartPathDict = d

End Function

Sub CloseAssemblyPartDocs(dictAssemblyParts As Object, _
                          dictInitiallyVisibleDocumentWindows As Object)

    If dictAssemblyParts Is Nothing Then Exit Sub

    Debug.Print "Closing open part docs from starting assembly..."

    Dim k As Variant

    For Each k In dictAssemblyParts.Keys

        Dim swDoc As Object

        Set swDoc = Nothing

        On Error Resume Next

        Set swDoc = swApp.GetOpenDocumentByName(CStr(dictAssemblyParts(k)))

        On Error GoTo 0

        If Not swDoc Is Nothing Then

            If swDoc.GetType = swDocPART Then

                If VisibleDocumentSnapshotContains( _
                    dictInitiallyVisibleDocumentWindows, swDoc) Then

                    Debug.Print "  Leaving initially visible part window open: " & _
                                CStr(dictAssemblyParts(k))

                    GoTo NextDoc

                End If

                Debug.Print "  Closing assembly part: " & _
                            GetDocumentActivationName(swDoc)

                swApp.CloseDoc GetDocumentActivationName(swDoc)

            End If

        End If

NextDoc:

    Next k

End Sub

Sub CloseExplicitlyOpenedPartDocs(dictOpened As Object)

    If dictOpened Is Nothing Then Exit Sub

    Dim k As Variant

    For Each k In dictOpened.Keys

        Debug.Print "  Closing explicitly opened part: " & dictOpened(k)

        On Error Resume Next

        swApp.CloseDoc CStr(dictOpened(k))

        On Error GoTo 0

    Next k

End Sub

Sub ClosePartOpenedForCandidate(partPath As String, ByRef swPart As Object, _
                                dictOpened As Object)

    If dictOpened Is Nothing Then Exit Sub

    Dim openedKey As String

    openedKey = LCase(partPath)

    If openedKey = "" Then Exit Sub
    If Not dictOpened.Exists(openedKey) Then Exit Sub

    Dim closeName As String

    closeName = CStr(dictOpened(openedKey))

    Set swPart = Nothing

    On Error Resume Next

    swApp.CloseDoc closeName
    dictOpened.Remove openedKey

    On Error GoTo 0

    TraceRun "closed candidate part=" & TraceFileLabel(partPath)

    DoEvents

End Sub

' ================================================================

Sub ProcessSelectedComponents(swModel As Object, selMgr As Object, selCount As Long, _
                              dxfFolder As String, mode As Integer, _
                              assemblyExportMethod As Integer, dictQty As Object, _
                              dictDone As Object, dictOpened As Object)

    Dim dictSelectedAssemblyParts As Object

    Set dictSelectedAssemblyParts = CreateObject("Scripting.Dictionary")

    Dim dictSelectedAssemblyContexts As Object

    Set dictSelectedAssemblyContexts = CreateObject("Scripting.Dictionary")

    Dim dictSelectedAssemblyKeys As Object

    Set dictSelectedAssemblyKeys = CreateObject("Scripting.Dictionary")

    Dim s As Long

    For s = 1 To selCount

        Debug.Print "  --- Sel " & s & " ---"



        Dim selObj As Object

        Set selObj = Nothing

        Dim selType As Long

        selType = -1

        On Error Resume Next

        Set selObj = selMgr.GetSelectedObject6(s, -1)

        selType = selMgr.GetSelectedObjectType3(s, -1)

        On Error GoTo 0

        Debug.Print "    SelType=" & selType



        Dim swComp As Object

        Set swComp = Nothing



        On Error Resume Next

        Set swComp = selMgr.GetSelectedObjectsComponent4(s, -1)

        On Error GoTo 0

        If Not swComp Is Nothing Then

            Debug.Print "    via Comp4(-1)"

            GoTo HaveComp

        End If



        On Error Resume Next

        Set swComp = selMgr.GetSelectedObjectsComponent4(s, 0)

        On Error GoTo 0

        If Not swComp Is Nothing Then

            Debug.Print "    via Comp4(0)"

            GoTo HaveComp

        End If



        If Not selObj Is Nothing Then

            On Error Resume Next

            Set swComp = selObj.GetComponent

            On Error GoTo 0

            If Not swComp Is Nothing Then

                Debug.Print "    via GetComponent"

                GoTo HaveComp

            End If

        End If



        If selType = 20 Then

            Set swComp = selObj

            If Not swComp Is Nothing Then

                Debug.Print "    sel IS comp"

                GoTo HaveComp

            End If

        End If



        Debug.Print "    No component, skip"

        GoTo NextSel



HaveComp:

        If IsComponentActuallySuppressedSafe(swComp) Then GoTo NextSel

        If IsComponentHiddenSafe(swComp) Then
            Debug.Print "    Component hidden, skip"
            GoTo NextSel
        End If

        Dim partPath As String

        partPath = swComp.GetPathName

        Dim cfg As String

        cfg = swComp.ReferencedConfiguration

        If partPath = "" Then GoTo NextSel

        If IsAssemblyPath(partPath) Then

            Debug.Print "    Selected subassembly: " & partPath & " @ " & cfg

            Dim assemblyKey As String

            assemblyKey = LCase(partPath) & "@" & cfg

            Dim assemblyCopies As Long

            assemblyCopies = 1

            If dictQty.Exists(assemblyKey) Then _
                assemblyCopies = CLng(dictQty(assemblyKey))

            If mode = MODE_REGULAR And _
               assemblyExportMethod = ASSEMBLY_EXPORT_CONTEXT Then

                AddSelectedSubassemblyContext partPath, cfg, assemblyCopies, _
                                              dictSelectedAssemblyContexts

            Else

                If Not dictSelectedAssemblyKeys.Exists(assemblyKey) Then

                    dictSelectedAssemblyKeys.Add assemblyKey, True

                    CollectSelectedSubassemblyParts partPath, cfg, assemblyCopies, _
                                                    dictSelectedAssemblyParts

                End If

            End If

            GoTo NextSel

        End If



        If Not IsPartPath(partPath) Then

            Debug.Print "    Not a part file, skip: " & partPath

            GoTo NextSel

        End If

        Dim fullKey As String
        fullKey = LCase(partPath) & "@" & cfg

        If dictDone.Exists(fullKey) Then GoTo NextSel



        Dim qty As Long

        If dictQty.Exists(fullKey) Then

            qty = dictQty(fullKey)

        Else

            qty = 1

        End If

        ResolveSelectedPartIfLightweight swComp



        Debug.Print "    " & partPath & " @ " & cfg & " qty=" & qty



        Dim swPart As Object

        Set swPart = OpenPartForExport(partPath, dictOpened)

        If swPart Is Nothing Then GoTo NextSel



        Dim exported As Boolean

        If mode = MODE_REGULAR And _
           assemblyExportMethod = ASSEMBLY_EXPORT_CONTEXT Then

            Dim selectedFace As Object

            Set selectedFace = Nothing

            If Not selObj Is Nothing Then

                If IsPlanarFace(selObj) Then Set selectedFace = selObj

            End If

            exported = ExportOnePartInAssemblyContext( _
                swModel, swComp, swPart, partPath, cfg, qty, dxfFolder, selectedFace)

        ElseIf ActivateConfigurationChecked(swPart, cfg) Then

            exported = ExportOnePart(swPart, partPath, cfg, qty, dxfFolder, mode, Nothing)

        End If

        If exported Then dictDone.Add fullKey, True

NextSel:

    Next s

    If mode = MODE_REGULAR And _
       assemblyExportMethod = ASSEMBLY_EXPORT_CONTEXT Then

        ExportSelectedSubassembliesInContext dictSelectedAssemblyContexts, _
                                             dxfFolder, dictDone, dictOpened

    Else

        ExportSelectedSubassemblyParts dictSelectedAssemblyParts, dxfFolder, mode, _
                                       dictDone, dictOpened

    End If

End Sub

Sub AddSelectedSubassemblyContext(assemblyPath As String, cfg As String, _
                                  contextCopies As Long, dictContexts As Object)

    Dim contextKey As String

    contextKey = LCase(assemblyPath) & "@" & cfg

    Dim contextInfo As Variant

    If dictContexts.Exists(contextKey) Then

        contextInfo = dictContexts(contextKey)

        If contextCopies > CLng(contextInfo(2)) Then _
            contextInfo(2) = contextCopies

        dictContexts(contextKey) = contextInfo

    Else

        contextInfo = Array(assemblyPath, cfg, contextCopies)

        dictContexts.Add contextKey, contextInfo

    End If

End Sub

Sub ExportSelectedSubassembliesInContext(dictContexts As Object, dxfFolder As String, _
                                         dictDone As Object, dictOpened As Object)

    If dictContexts Is Nothing Then Exit Sub

    Debug.Print "  Selected subassembly contexts: " & dictContexts.Count

    Dim contextKey As Variant

    For Each contextKey In dictContexts.Keys

        Dim contextInfo As Variant

        contextInfo = dictContexts(contextKey)

        ProcessSelectedSubassemblyContext CStr(contextInfo(0)), _
                                          CStr(contextInfo(1)), _
                                          CLng(contextInfo(2)), _
                                          dxfFolder, dictDone, dictOpened

    Next contextKey

End Sub

Sub ProcessSelectedSubassemblyContext(assemblyPath As String, cfg As String, _
                                      contextCopies As Long, dxfFolder As String, _
                                      dictDone As Object, dictOpened As Object)

    If Not IsAssemblyPath(assemblyPath) Then Exit Sub

    If IsImportedPartPath(assemblyPath) Then

        Debug.Print "    Imported subassembly, skip: " & assemblyPath

        Exit Sub

    End If

    Dim originalActiveDoc As Object

    Set originalActiveDoc = swApp.ActiveDoc

    Dim swAssembly As Object

    Dim openedHere As Boolean

    Set swAssembly = swApp.GetOpenDocumentByName(assemblyPath)

    If swAssembly Is Nothing Then

        Dim errs As Long

        Dim warns As Long

        Set swAssembly = swApp.OpenDoc6(assemblyPath, swDocASSEMBLY, _
                                       swOpenDocOptions_Silent, cfg, errs, warns)

        openedHere = Not swAssembly Is Nothing

    End If

    If swAssembly Is Nothing Then

        Debug.Print "    Could not open selected subassembly context: " & assemblyPath

        GoTo RestoreActiveDocument

    End If

    If swAssembly.GetType <> swDocASSEMBLY Then GoTo CleanUpAssemblyContext

    If Not ActivateModelDocument(swAssembly) Then GoTo CleanUpAssemblyContext

    Dim originalCfg As String

    originalCfg = GetActiveConfigName(swAssembly)

    If Not ActivateConfigurationChecked(swAssembly, cfg) Then _
        GoTo CleanUpAssemblyContext

    swAssembly.EditRebuild3

    Dim dictQty As Object

    Set dictQty = BuildAssemblyContextQtyDict(swAssembly)

    Dim components As Variant

    components = swAssembly.GetComponents(False)

    If IsEmpty(components) Then GoTo CleanUpAssemblyContext

    Dim i As Long

    For i = 0 To UBound(components)

        Dim swComp As Object

        Set swComp = components(i)

        If swComp Is Nothing Then GoTo NextContextComponent

        If IsComponentActuallySuppressedSafe(swComp) Then GoTo NextContextComponent

        If IsComponentHiddenSafe(swComp) Then GoTo NextContextComponent

        If ComponentHasExcludedAssemblyAncestor(swComp, False) Then _
            GoTo NextContextComponent

        Dim partPath As String

        partPath = swComp.GetPathName

        If Not IsPartPath(partPath) Then GoTo NextContextComponent

        If IsImportedPartPath(partPath) Then GoTo NextContextComponent

        Dim partCfg As String

        partCfg = swComp.ReferencedConfiguration

        Dim fullKey As String

        fullKey = LCase(partPath) & "@" & partCfg

        If dictDone.Exists(fullKey) Then GoTo NextContextComponent

        Dim swPart As Object

        Set swPart = swComp.GetModelDoc2

        If swPart Is Nothing Then Set swPart = OpenPartForExport(partPath, dictOpened)

        If swPart Is Nothing Then GoTo NextContextComponent

        If swPart.GetType <> swDocPART Then GoTo NextContextComponent

        If IsToolboxPartSafe(swPart) Then GoTo NextContextComponent

        If IsImportedGeometryPart(swPart) Then GoTo NextContextComponent

        Dim qty As Long

        If dictQty.Exists(fullKey) Then

            qty = CLng(dictQty(fullKey)) * contextCopies

        Else

            qty = contextCopies

        End If

        Dim noPreferredFace As Object

        Set noPreferredFace = Nothing

        Dim exported As Boolean

        exported = ExportOnePartInAssemblyContext( _
            swAssembly, swComp, swPart, partPath, partCfg, qty, dxfFolder, _
            noPreferredFace)

        If exported Then dictDone.Add fullKey, True

NextContextComponent:

    Next i

CleanUpAssemblyContext:

    If Not swAssembly Is Nothing Then

        If Not openedHere And originalCfg <> "" And _
           StrComp(GetActiveConfigName(swAssembly), originalCfg, vbTextCompare) <> 0 Then

            ActivateConfigurationChecked swAssembly, originalCfg

        End If

        If openedHere Then

            Dim assemblyTitle As String

            assemblyTitle = GetDocumentActivationName(swAssembly)

            Set swAssembly = Nothing

            swApp.CloseDoc assemblyTitle

        End If

    End If

RestoreActiveDocument:

    If Not originalActiveDoc Is Nothing Then _
        ActivateModelDocument originalActiveDoc

End Sub

Sub CollectSelectedSubassemblyParts(assemblyPath As String, cfg As String, _
                                     assemblyCopies As Long, _
                                     dictCandidates As Object)

    If Not IsAssemblyPath(assemblyPath) Then Exit Sub

    If IsImportedPartPath(assemblyPath) Then

        Debug.Print "    Imported subassembly, skip: " & assemblyPath

        Exit Sub

    End If

    Dim originalActiveDoc As Object

    Set originalActiveDoc = swApp.ActiveDoc

    Dim swAssembly As Object

    Dim openedHere As Boolean

    Set swAssembly = swApp.GetOpenDocumentByName(assemblyPath)

    If swAssembly Is Nothing Then

        Dim errs As Long

        Dim warns As Long

        Set swAssembly = swApp.OpenDoc6(assemblyPath, swDocASSEMBLY, _
                                       swOpenDocOptions_Silent, cfg, errs, warns)

        openedHere = Not swAssembly Is Nothing

    End If

    If swAssembly Is Nothing Then

        Debug.Print "    Could not open selected subassembly: " & assemblyPath

        Exit Sub

    End If

    If swAssembly.GetType <> swDocASSEMBLY Then GoTo CleanUpAssembly

    If Not ActivateModelDocument(swAssembly) Then GoTo CleanUpAssembly

    Dim originalCfg As String

    originalCfg = GetActiveConfigName(swAssembly)

    If Not ActivateConfigurationChecked(swAssembly, cfg) Then GoTo CleanUpAssembly

    Dim activeCfg As Object

    Set activeCfg = swAssembly.GetActiveConfiguration

    If activeCfg Is Nothing Then GoTo CleanUpAssembly

    Dim rootComp As Object

    Set rootComp = activeCfg.GetRootComponent3(False)

    If rootComp Is Nothing Then

        Debug.Print "    Could not traverse active subassembly configuration without resolving it."

        GoTo CleanUpAssembly

    End If

    CollectEligibleSubassemblyChildren rootComp, assemblyCopies, dictCandidates

CleanUpAssembly:

    If Not openedHere And originalCfg <> "" And _
       StrComp(GetActiveConfigName(swAssembly), originalCfg, vbTextCompare) <> 0 Then

        ActivateConfigurationChecked swAssembly, originalCfg

    End If

    If openedHere Then

        Dim assemblyTitle As String

        assemblyTitle = GetDocumentActivationName(swAssembly)

        Set swAssembly = Nothing

        swApp.CloseDoc assemblyTitle

    End If

    If Not originalActiveDoc Is Nothing Then _
        ActivateModelDocument originalActiveDoc

End Sub

Sub CollectEligibleSubassemblyChildren(parentComp As Object, _
                                       assemblyCopies As Long, _
                                       dictCandidates As Object)

    Dim children As Variant

    children = Empty

    On Error Resume Next

    children = parentComp.GetChildren

    On Error GoTo 0

    If IsEmpty(children) Then Exit Sub

    Dim i As Long

    For i = 0 To UBound(children)

        Dim childComp As Object

        Set childComp = children(i)

        If childComp Is Nothing Then GoTo NextChild

        If IsComponentActuallySuppressedSafe(childComp) Then

            Debug.Print "      Suppressed component, skip: " & childComp.Name2

            GoTo NextChild

        End If

        If IsComponentHiddenSafe(childComp) Then

            Debug.Print "      Hidden component, skip: " & childComp.Name2

            GoTo NextChild

        End If

        Dim childPath As String

        childPath = childComp.GetPathName

        If childPath = "" Then GoTo NextChild

        If IsImportedPartPath(childPath) Then

            Debug.Print "      Imported component path, skip: " & childPath

            GoTo NextChild

        End If

        If IsAssemblyPath(childPath) Then

            CollectEligibleSubassemblyChildren childComp, assemblyCopies, _
                                               dictCandidates

            GoTo NextChild

        End If

        If Not IsPartPath(childPath) Then GoTo NextChild

        Dim childCfg As String

        childCfg = childComp.ReferencedConfiguration

        Dim fullKey As String

        fullKey = LCase(childPath) & "@" & childCfg

        Dim candidate As Variant

        If dictCandidates.Exists(fullKey) Then

            candidate = dictCandidates(fullKey)

            candidate(2) = CLng(candidate(2)) + assemblyCopies

            dictCandidates(fullKey) = candidate

        Else

            candidate = Array(childPath, childCfg, assemblyCopies)

            dictCandidates.Add fullKey, candidate

        End If

NextChild:

    Next i

End Sub

Sub ExportSelectedSubassemblyParts(dictCandidates As Object, dxfFolder As String, _
                                   mode As Integer, dictDone As Object, _
                                   dictOpened As Object)

    If dictCandidates Is Nothing Then Exit Sub

    Debug.Print "  Eligible selected-subassembly part keys: " & dictCandidates.Count

    Dim fullKey As Variant

    For Each fullKey In dictCandidates.Keys

        If dictDone.Exists(CStr(fullKey)) Then GoTo NextCandidate

        Dim candidate As Variant

        candidate = dictCandidates(fullKey)

        Dim partPath As String

        Dim cfg As String

        Dim qty As Long

        partPath = CStr(candidate(0))

        cfg = CStr(candidate(1))

        qty = CLng(candidate(2))

        Dim swPart As Object

        Set swPart = OpenPartForExport(partPath, dictOpened)

        If swPart Is Nothing Then GoTo NextCandidate

        If IsToolboxPartSafe(swPart) Then

            Debug.Print "    Toolbox part, skip: " & partPath

            GoTo NextCandidate

        End If

        If Not ActivateConfigurationChecked(swPart, cfg) Then GoTo NextCandidate

        If IsImportedGeometryPart(swPart) Then

            Debug.Print "    Imported geometry part, skip: " & partPath

            GoTo NextCandidate

        End If

        swPart.EditRebuild3

        swPart.ForceRebuild3 False

        Dim isSM As Boolean

        Dim isThin As Boolean

        isSM = IsSheetMetalSafe(swPart)

        If Not isSM Then isThin = IsThinPlateLike(swPart)

        If Not isSM And Not isThin Then

            Debug.Print "    Selected-subassembly part is not SM/plate-like, skip: " & partPath

            GoTo NextCandidate

        End If

        Debug.Print "    Export selected-subassembly part: " & partPath & _
                    " @ " & cfg & " qty=" & qty

        Dim exported As Boolean

        exported = ExportOnePart(swPart, partPath, cfg, qty, dxfFolder, mode, Nothing)

        If exported Then dictDone.Add CStr(fullKey), True

NextCandidate:

    Next fullKey

End Sub



' ================================================================

Sub ProcessFullAssembly(swModel As Object, dxfFolder As String, _
                        assemblyExportMethod As Integer, dictDone As Object, _
                        dictOpened As Object)

    If assemblyExportMethod = ASSEMBLY_EXPORT_CONTEXT Then

        ProcessFullAssemblyInContext swModel, dxfFolder, dictDone, dictOpened

        Exit Sub

    End If



    If Not ActivateModelDocument(swModel) Then Exit Sub

    swModel.ResolveAllLightWeightComponents True

    RebuildDocumentIfNeeded swModel

    Dim vComps As Variant

    vComps = swModel.GetComponents(False)

    If IsEmpty(vComps) Then

        Debug.Print "Total components: 0"

        Exit Sub

    End If

    Debug.Print "Total components: " & (UBound(vComps) + 1)


    Dim dictQty As Object

    Set dictQty = BuildQtyDict(swModel)



    Dim i As Long

    Dim swComp As Object

    For i = 0 To UBound(vComps)

        Set swComp = vComps(i)

        If swComp Is Nothing Then GoTo NextComp

        If swComp.IsSuppressed Then GoTo NextComp

        If IsComponentHiddenSafe(swComp) Then
            Debug.Print "[" & i & "] Component hidden, skip"
            GoTo NextComp
        End If



        Dim partPath As String

        partPath = swComp.GetPathName

        Dim cfg As String

        cfg = swComp.ReferencedConfiguration



        Dim fullKey As String

        fullKey = LCase(partPath) & "@" & cfg

        If partPath = "" Then GoTo NextComp

        If Not IsPartPath(partPath) Then

            Debug.Print "[" & i & "] Not a part file, skip: " & partPath

            GoTo NextComp

        End If

        If dictDone.Exists(fullKey) Then GoTo NextComp



        Debug.Print "[" & i & "] " & partPath & " @ " & cfg



        Dim swPartCheck As Object

        Set swPartCheck = swComp.GetModelDoc2

        If swPartCheck Is Nothing Then _
            Set swPartCheck = OpenPartForExport(partPath, dictOpened)

        If swPartCheck Is Nothing Then GoTo NextComp

        If swPartCheck.GetType <> swDocPART Then

            Debug.Print "  referenced model is not a part, skip"

            GoTo NextComp

        End If

        If Not ActivateConfigurationChecked(swPartCheck, cfg) Then GoTo NextComp


        Dim isSM As Boolean

        isSM = IsSheetMetalSafe(swPartCheck)
        Dim isThin As Boolean

        isThin = False

        If Not isSM Then

            isThin = IsThinPlateLike(swPartCheck)
        End If

        If Not isSM And Not isThin Then

            Debug.Print "  not SM/plate-like thin solid, skip"
            GoTo NextComp

        End If



        Dim qty As Long

        If dictQty.Exists(fullKey) Then

            qty = CLng(dictQty(fullKey))

        Else

            qty = 1

        End If

        Dim swPart As Object

        Set swPart = OpenPartForExport(partPath, dictOpened)

        If swPart Is Nothing Then GoTo NextComp



        If Not ActivateConfigurationChecked(swPart, cfg) Then GoTo NextComp

        Dim exported As Boolean

        exported = ExportOnePart(swPart, partPath, cfg, qty, dxfFolder, _
                                 MODE_REGULAR, Nothing)

        If exported Then dictDone.Add fullKey, True

NextComp:

    Next i

End Sub



' ================================================================

Sub ProcessFullAssemblyInContext(swModel As Object, dxfFolder As String, _
                                 dictDone As Object, dictOpened As Object)

    If Not ActivateModelDocument(swModel) Then Exit Sub

    RebuildDocumentIfNeeded swModel

    Dim components As Variant

    components = swModel.GetComponents(False)

    If IsEmpty(components) Then

        Debug.Print "Total components: 0"

        Exit Sub

    End If

    Dim totalComponents As Long

    totalComponents = UBound(components) + 1

    Debug.Print "Total assembly-context components: " & totalComponents

    Dim dictQty As Object

    Set dictQty = BuildAssemblyContextQtyDict(swModel)

    Dim dictPartExcluded As Object

    Set dictPartExcluded = CreateObject("Scripting.Dictionary")

    Dim i As Long

    Dim swPart As Object

    Dim openedForCandidate As Boolean

    Dim skippedMissing As Long
    Dim skippedSuppressed As Long
    Dim skippedLightweight As Long
    Dim skippedHidden As Long
    Dim skippedAncestor As Long
    Dim skippedNonPart As Long
    Dim skippedDuplicate As Long
    Dim skippedImported As Long
    Dim skippedBodyShape As Long
    Dim skippedOpen As Long
    Dim skippedToolbox As Long
    Dim candidateCount As Long
    Dim exportedCount As Long

    For i = 0 To UBound(components)

        g_traceComponent = ""

        openedForCandidate = False

        Set swPart = Nothing

        If (i Mod 100) = 0 Then _
            TraceRun "context progress index=" & CStr(i)

        Dim swComp As Object

        Set swComp = components(i)

        If swComp Is Nothing Then
            skippedMissing = skippedMissing + 1
            GoTo NextAssemblyContextComponent
        End If

        If IsComponentActuallySuppressedSafe(swComp) Then
            skippedSuppressed = skippedSuppressed + 1
            GoTo NextAssemblyContextComponent
        End If

        If IsComponentLightweightSafe(swComp) Then
            skippedLightweight = skippedLightweight + 1
            GoTo NextAssemblyContextComponent
        End If

        If IsComponentHiddenSafe(swComp) Then
            skippedHidden = skippedHidden + 1
            GoTo NextAssemblyContextComponent
        End If

        If ComponentHasExcludedAssemblyAncestor(swComp, True, False) Then
            skippedAncestor = skippedAncestor + 1
            GoTo NextAssemblyContextComponent
        End If

        Dim partPath As String

        partPath = swComp.GetPathName

        If Not IsPartPath(partPath) Then
            skippedNonPart = skippedNonPart + 1
            GoTo NextAssemblyContextComponent
        End If

        Dim cfg As String

        cfg = swComp.ReferencedConfiguration

        g_traceComponent = TraceFileLabel(partPath) & "@" & cfg

        Dim fullKey As String

        fullKey = LCase(partPath) & "@" & cfg

        If dictDone.Exists(fullKey) Or dictPartExcluded.Exists(fullKey) Then
            skippedDuplicate = skippedDuplicate + 1
            GoTo NextAssemblyContextComponent
        End If

        candidateCount = candidateCount + 1

        TraceRun "context candidate index=" & CStr(i) & _
                 " component=" & g_traceComponent

        If IsImportedAssemblyComponent(swComp) Then

            skippedImported = skippedImported + 1

            dictPartExcluded.Add fullKey, "imported"

            TraceRun "context skip imported component=" & g_traceComponent

            GoTo NextAssemblyContextComponent

        End If

        If Not ComponentBodiesMayBeSheetLike(swComp) Then

            skippedBodyShape = skippedBodyShape + 1

            TraceRun "context skip body-shape component=" & g_traceComponent

            GoTo NextAssemblyContextComponent

        End If

        Set swPart = swComp.GetModelDoc2

        If swPart Is Nothing Then

            Dim wasTracked As Boolean

            wasTracked = dictOpened.Exists(LCase(partPath))

            Set swPart = OpenPartForExport(partPath, dictOpened, False)

            openedForCandidate = (Not wasTracked And _
                                  dictOpened.Exists(LCase(partPath)))

        End If

        If swPart Is Nothing Then
            skippedOpen = skippedOpen + 1
            GoTo NextAssemblyContextComponent
        End If

        If swPart.GetType <> swDocPART Then
            skippedNonPart = skippedNonPart + 1
            GoTo NextAssemblyContextComponent
        End If

        If IsToolboxPartSafe(swPart) Then

            skippedToolbox = skippedToolbox + 1

            If Not dictPartExcluded.Exists(fullKey) Then _
                dictPartExcluded.Add fullKey, "toolbox"

            TraceRun "context skip toolbox component=" & g_traceComponent

            GoTo NextAssemblyContextComponent

        End If

        If IsImportedGeometryPart(swPart) Then

            skippedImported = skippedImported + 1

            If Not dictPartExcluded.Exists(fullKey) Then _
                dictPartExcluded.Add fullKey, "imported"

            TraceRun "context skip imported component=" & g_traceComponent

            GoTo NextAssemblyContextComponent

        End If

        Dim qty As Long

        If dictQty.Exists(fullKey) Then

            qty = CLng(dictQty(fullKey))

        Else

            qty = 1

        End If

        Dim noPreferredFace As Object

        Set noPreferredFace = Nothing

        Dim exported As Boolean

        exported = ExportOnePartInAssemblyContext( _
            swModel, swComp, swPart, partPath, cfg, qty, dxfFolder, noPreferredFace)

        TraceRun "context result component=" & g_traceComponent & _
                 " exported=" & CStr(exported)

        If exported Then
            dictDone.Add fullKey, True
            exportedCount = exportedCount + 1
        End If

NextAssemblyContextComponent:

        If openedForCandidate Then _
            ClosePartOpenedForCandidate partPath, swPart, dictOpened

        Set swPart = Nothing
        Set swComp = Nothing

        DoEvents

    Next i

    components = Empty
    Set dictPartExcluded = Nothing
    g_traceComponent = ""

    TraceRun "context summary total=" & CStr(totalComponents) & _
             " candidates=" & CStr(candidateCount) & _
             " exported=" & CStr(exportedCount)
    TraceRun "context skipped state missing=" & CStr(skippedMissing) & _
             " suppressed=" & CStr(skippedSuppressed) & _
             " lightweight=" & CStr(skippedLightweight) & _
             " hidden=" & CStr(skippedHidden) & _
             " ancestor=" & CStr(skippedAncestor)
    TraceRun "context skipped type nonpart=" & CStr(skippedNonPart) & _
             " duplicate=" & CStr(skippedDuplicate) & _
             " imported=" & CStr(skippedImported) & _
             " body-shape=" & CStr(skippedBodyShape) & _
             " open=" & CStr(skippedOpen) & _
             " toolbox=" & CStr(skippedToolbox)
    TraceRun "assembly-context loop complete"

End Sub

' ================================================================

Sub ProcessSinglePart(swPart As Object, partPath As String, cfg As String, _
                      qty As Long, dxfFolder As String, mode As Integer, _
                      dictDone As Object, ByVal selectedFace As Object)

    Dim fullKey As String

    fullKey = LCase(partPath) & "@" & cfg

    If dictDone.Exists(fullKey) Then Exit Sub

    If Not ActivateConfigurationChecked(swPart, cfg) Then Exit Sub

    If ExportOnePart(swPart, partPath, cfg, qty, dxfFolder, mode, selectedFace) Then _
        dictDone.Add fullKey, True

End Sub



' ================================================================

Function OpenPartForExport(partPath As String, dictOpened As Object, _
                           Optional activateAfterOpen As Boolean = True) As Object

    If Not IsPartPath(partPath) Then

        Set OpenPartForExport = Nothing

        Exit Function

    End If

    Dim already As Object
    Set already = swApp.GetOpenDocumentByName(partPath)

    If Not already Is Nothing Then

        Set OpenPartForExport = already

        Exit Function

    End If



    Dim errs As Long

    Dim warns As Long

    Dim p As Object

    Set p = swApp.OpenDoc6(partPath, swDocPART, 1, "", errs, warns)

    If p Is Nothing Then

        Set OpenPartForExport = Nothing

        Exit Function

    End If



    If activateAfterOpen Then ActivateModelDocument p

    If Not dictOpened.Exists(LCase(partPath)) Then

        dictOpened.Add LCase(partPath), GetDocumentActivationName(p)

    End If

    Set OpenPartForExport = p

End Function



' ================================================================

Function ExportOnePart(swPart As Object, partPath As String, cfg As String, _
                       qty As Long, dxfFolder As String, _
                       mode As Integer, ByVal selectedFace As Object) As Boolean

    If swPart Is Nothing Then Exit Function

    Dim exportSelectedFace As Boolean

    exportSelectedFace = False

    If mode = MODE_REGULAR Then

        If Not selectedFace Is Nothing Then exportSelectedFace = True

    End If

    If Not exportSelectedFace Then

        swPart.EditRebuild3

        swPart.ForceRebuild3 False

    End If



    Dim isSM As Boolean

    isSM = IsSheetMetalSafe(swPart)
    Dim isThin As Boolean

    isThin = False

    If Not isSM And Not exportSelectedFace Then

        isThin = IsThinPlateLike(swPart)
    End If



    If mode = MODE_REGULAR Then

        If Not exportSelectedFace And Not isSM And Not isThin Then

            Debug.Print "    Regular: not SM/plate-like thin solid, skip"
            Exit Function

        End If

    End If



    Dim partName As String

    partName = Replace(swPart.GetTitle, ".SLDPRT", "")

    partName = Replace(partName, ".sldprt", "")

    partName = CleanFileName(partName)

    Dim cfgName As String

    cfgName = CleanFileName(cfg)


    Dim thickness As Double

    Dim thickStr As String

    If isSM Then

        thickness = GetSheetMetalThicknessFallback(swPart)
    Else

        thickness = GetThinSolidThickness(swPart)

    End If

    thickStr = FormatThickness(thickness)



    Dim suffix As String

    If mode = MODE_PRECUT Then

        suffix = "_PRECUT" & CLng(g_precutOffset_mm)

        If Not g_precutKeepFeats Then suffix = suffix & "_BBOX"

    End If



    Dim outPath As String

    Dim outFolder As String

    outFolder = dxfFolder

    If isSM Then

        outFolder = EnsureSubFolder(dxfFolder, "bended")

        Debug.Print "    Sheet metal -> bended folder"

    ElseIf isThin Then

        If IsWasherLikeThinSolid(swPart) Then

            outFolder = EnsureSubFolder(dxfFolder, "washerlike")

            Debug.Print "    Washerlike thin solid -> washerlike folder"

        End If

    End If

    outPath = outFolder & ConfiguredDxfOutputPrefix() & thickStr & "_" & g_material & "_" & qty & "db_" & partName & "(" & cfgName & ")" & suffix & ".dxf"
    Debug.Print "    Output: " & outPath



    Dim ok As Boolean

    If mode = MODE_REGULAR Then

        If exportSelectedFace Then

            Debug.Print "    Active-part single-face exception: exporting full body Normal To selected face"

            ok = ExportNormalViewToDxf(swPart, selectedFace, outPath)

            If ok Then

                If CleanProjectedDxfChamferLoops(outPath) Then _
                    Debug.Print "      Selected-face projected DXF cleaned for chamfer boundary loops"

            End If

        ElseIf isSM Then

            ok = ExportSMFlatPattern(swPart, outPath)

        Else

            ok = ExportThinSolidRegularDxf(swPart, outPath)

        End If

    Else

        ok = ExportPartPrecut(swPart, outPath, isSM)

    End If

    Debug.Print "    RESULT: " & IIf(ok, "OK", "FAILED")

    ExportOnePart = ok

End Function



' ================================================================

Function ExportOnePartInAssemblyContext(swAssembly As Object, swComp As Object, _
                                        swPart As Object, partPath As String, _
                                        cfg As String, qty As Long, _
                                        dxfFolder As String, _
                                        preferredFace As Object) As Boolean

    If swAssembly Is Nothing Or swComp Is Nothing Or swPart Is Nothing Then _
        Exit Function

    Dim originalPartCfg As String

    originalPartCfg = GetActiveConfigName(swPart)

    If Not ActivateConfigurationChecked(swPart, cfg) Then _
        GoTo RestorePartConfiguration

    swPart.EditRebuild3

    swPart.ForceRebuild3 False

    Dim ok As Boolean

    If IsToolboxPartSafe(swPart) Then

        Debug.Print "    Toolbox part, skip: " & partPath

        GoTo RestorePartConfiguration

    End If

    If IsImportedGeometryPart(swPart) Then

        Debug.Print "    Imported geometry part, skip: " & partPath

        GoTo RestorePartConfiguration

    End If

    Dim isSM As Boolean

    isSM = IsSheetMetalSafe(swPart)

    If isSM Then

        Debug.Print "    Sheet metal keeps the proven part-file flat-pattern export"

        ok = ExportOnePart(swPart, partPath, cfg, qty, dxfFolder, MODE_REGULAR, Nothing)

        GoTo RestorePartConfiguration

    End If

    If Not IsThinPlateLike(swPart) Then

        Debug.Print "    Assembly context: not SM/plate-like thin solid, skip"

        GoTo RestorePartConfiguration

    End If

    Dim partName As String

    partName = Replace(swPart.GetTitle, ".SLDPRT", "")

    partName = Replace(partName, ".sldprt", "")

    partName = CleanFileName(partName)

    Dim cfgName As String

    cfgName = CleanFileName(cfg)

    Dim thickStr As String

    thickStr = FormatThickness(GetThinSolidThickness(swPart))

    Dim outFolder As String

    outFolder = dxfFolder

    If IsWasherLikeThinSolid(swPart) Then

        outFolder = EnsureSubFolder(dxfFolder, "washerlike")

        Debug.Print "    Washerlike thin solid -> washerlike folder"

    End If

    Dim outPath As String

    outPath = outFolder & ConfiguredDxfOutputPrefix() & thickStr & "_" & g_material & "_" & _
              qty & "db_" & partName & "(" & cfgName & ").dxf"

    Debug.Print "    Assembly-context output: " & outPath

    ok = ExportAssemblyContextThinSolidDxf(swAssembly, swComp, _
                                           preferredFace, outPath)

    If ok Then

        If CleanProjectedDxfChamferLoops(outPath) Then

            Debug.Print "      Assembly-context DXF cleaned for chamfer boundary loops"

        End If

    End If

    Debug.Print "    RESULT: " & IIf(ok, "OK", "FAILED")

RestorePartConfiguration:

    If originalPartCfg <> "" And _
       StrComp(GetActiveConfigName(swPart), originalPartCfg, vbTextCompare) <> 0 Then

        ActivateConfigurationChecked swPart, originalPartCfg

    End If

    If Not ActivateAssemblyDocument(swAssembly) Then _
        Debug.Print "      Could not restore the exact assembly document"

    ExportOnePartInAssemblyContext = ok

End Function

Function ActivateAssemblyDocument(swAssembly As Object) As Boolean

    ActivateAssemblyDocument = ActivateModelDocument(swAssembly)

End Function

Sub CaptureModelSelection(swModel As Object, ByRef savedObjects As Collection, _
                          ByRef savedTypes As Collection)

    Set savedObjects = New Collection

    Set savedTypes = New Collection

    If swModel Is Nothing Then Exit Sub

    Dim selMgr As Object

    Set selMgr = swModel.SelectionManager

    If selMgr Is Nothing Then Exit Sub

    Dim selectionCount As Long

    selectionCount = selMgr.GetSelectedObjectCount2(-1)

    Dim i As Long

    For i = 1 To selectionCount

        Dim selectedObject As Object

        Set selectedObject = Nothing

        On Error Resume Next

        Set selectedObject = selMgr.GetSelectedObject6(i, -1)

        On Error GoTo 0

        If Not selectedObject Is Nothing Then

            savedObjects.Add selectedObject

            savedTypes.Add CLng(selMgr.GetSelectedObjectType3(i, -1))

        End If

    Next i

End Sub

Sub RestoreModelSelection(swModel As Object, savedObjects As Collection, _
                          savedTypes As Collection)

    If swModel Is Nothing Then Exit Sub

    swModel.ClearSelection2 True

    If savedObjects Is Nothing Or savedTypes Is Nothing Then Exit Sub

    Dim i As Long

    Dim restoredCount As Long

    For i = 1 To savedObjects.Count

        Dim selectedObject As Object

        Set selectedObject = savedObjects(i)

        Dim appendSelection As Boolean

        appendSelection = (restoredCount > 0)

        Dim selectionRestored As Boolean

        selectionRestored = False

        On Error Resume Next

        Err.Clear

        If CLng(savedTypes(i)) = 20 Then

            selectionRestored = CBool(selectedObject.Select4(appendSelection, Nothing, False))

        Else

            selectionRestored = CBool(selectedObject.Select4(appendSelection, Nothing))

        End If

        If Err.Number <> 0 Or Not selectionRestored Then

            Err.Clear

            selectionRestored = CBool(selectedObject.Select2(appendSelection, 0))

        End If

        On Error GoTo 0

        If selectionRestored Then restoredCount = restoredCount + 1

    Next i

End Sub

Function FindLargestPlanarFaceOnComponent(swComp As Object) As Object

    If swComp Is Nothing Then Exit Function

    Dim bodyInfo As Variant

    Dim bodies As Variant

    bodyInfo = Empty

    bodies = Empty

    On Error Resume Next

    bodies = swComp.GetBodies3(swSolidBody, bodyInfo)

    On Error GoTo 0

    If IsEmpty(bodies) Then Exit Function

    Dim maxArea As Double

    Dim i As Long

    For i = 0 To UBound(bodies)

        Dim body As Object

        Set body = bodies(i)

        If body Is Nothing Then GoTo NextAssemblyBody

        Dim faces As Variant

        faces = Empty

        On Error Resume Next

        faces = body.GetFaces

        On Error GoTo 0

        If IsEmpty(faces) Then GoTo NextAssemblyBody

        Dim j As Long

        For j = 0 To UBound(faces)

            Dim face As Object

            Set face = faces(j)

            If IsPlanarFace(face) Then

                Dim area As Double

                area = 0#

                On Error Resume Next

                area = CDbl(face.GetArea)

                On Error GoTo 0

                If area > maxArea Then

                    maxArea = area

                    Set FindLargestPlanarFaceOnComponent = face

                End If

            End If

        Next j

NextAssemblyBody:

    Next i

End Function

Function SolidWorksObjectsAreSame(leftObject As Object, rightObject As Object) As Boolean

    If leftObject Is Nothing Or rightObject Is Nothing Then Exit Function

    On Error Resume Next

    If leftObject Is rightObject Then

        SolidWorksObjectsAreSame = True

        On Error GoTo 0

        Exit Function

    End If

    Dim sameResult As Long

    sameResult = CLng(swApp.IsSame(leftObject, rightObject))

    SolidWorksObjectsAreSame = (sameResult = swObjectSame)

    On Error GoTo 0

End Function

Function DrawingComponentsAreSame(leftDrawingComp As Object, _
                                  rightDrawingComp As Object) As Boolean

    If SolidWorksObjectsAreSame(leftDrawingComp, rightDrawingComp) Then

        DrawingComponentsAreSame = True

        Exit Function

    End If

    Dim leftComp As Object

    Dim rightComp As Object

    On Error Resume Next

    Set leftComp = leftDrawingComp.Component

    Set rightComp = rightDrawingComp.Component

    On Error GoTo 0

    DrawingComponentsAreSame = SolidWorksObjectsAreSame(leftComp, rightComp)

End Function

Function ApplyDrawingComponentVisibility(drawingComp As Object, _
                                         targetDrawingComp As Object) As Boolean

    If drawingComp Is Nothing Then Exit Function

    Dim keepVisible As Boolean

    keepVisible = DrawingComponentsAreSame(drawingComp, targetDrawingComp)

    Dim children As Variant

    children = Empty

    On Error Resume Next

    children = drawingComp.GetChildren

    On Error GoTo 0

    If Not IsEmpty(children) Then

        Dim i As Long

        For i = 0 To UBound(children)

            Dim childComp As Object

            Set childComp = children(i)

            If ApplyDrawingComponentVisibility(childComp, targetDrawingComp) Then

                keepVisible = True

            End If

        Next i

    End If

    On Error Resume Next

    drawingComp.Visible = keepVisible

    On Error GoTo 0

    ApplyDrawingComponentVisibility = keepVisible

End Function

Function FilterDrawingViewToComponent(swView As Object, swComp As Object) As Boolean

    If swView Is Nothing Or swComp Is Nothing Then Exit Function

    Dim targetDrawingComp As Object

    On Error Resume Next

    Set targetDrawingComp = swComp.GetDrawingComponent(swView)

    On Error GoTo 0

    If targetDrawingComp Is Nothing Then

        Debug.Print "      Target component was not found in assembly drawing view"

        Exit Function

    End If

    Dim rootDrawingComp As Object

    On Error Resume Next

    Set rootDrawingComp = swView.RootDrawingComponent

    On Error GoTo 0

    If rootDrawingComp Is Nothing Then Exit Function

    Dim foundTarget As Boolean

    Dim children As Variant

    children = Empty

    On Error Resume Next

    children = rootDrawingComp.GetChildren

    On Error GoTo 0

    If IsEmpty(children) Then

        foundTarget = DrawingComponentsAreSame(rootDrawingComp, targetDrawingComp)

    Else

        Dim i As Long

        For i = 0 To UBound(children)

            Dim childComp As Object

            Set childComp = children(i)

            If ApplyDrawingComponentVisibility(childComp, targetDrawingComp) Then

                foundTarget = True

            End If

        Next i

    End If

    FilterDrawingViewToComponent = foundTarget

End Function

Function ExportAssemblyContextThinSolidDxf(swAssembly As Object, swComp As Object, _
                                           preferredFace As Object, _
                                           filePath As String) As Boolean

    ExportAssemblyContextThinSolidDxf = False

    If swAssembly Is Nothing Or swComp Is Nothing Then Exit Function

    DeleteExistingFile filePath

    Dim orientationFace As Object

    Set orientationFace = Nothing

    If Not preferredFace Is Nothing Then

        If IsPlanarFace(preferredFace) Then Set orientationFace = preferredFace

    End If

    If orientationFace Is Nothing Then

        Set orientationFace = FindLargestPlanarFaceOnComponent(swComp)

    End If

    If orientationFace Is Nothing Then

        Debug.Print "      No planar assembly-context face found"

        Exit Function

    End If

    Dim exportOk As Boolean

    Dim assemblyView As Object

    Dim originalOrientation As Object

    Dim savedSelectionObjects As Collection

    Dim savedSelectionTypes As Collection

    On Error GoTo ExportFailed

    If Not ActivateAssemblyDocument(swAssembly) Then

        Debug.Print "      Could not activate the exact assembly document"

        GoTo CleanUpAssemblyExport

    End If

    CaptureModelSelection swAssembly, savedSelectionObjects, savedSelectionTypes

    Set assemblyView = swAssembly.ActiveView

    If Not assemblyView Is Nothing Then Set originalOrientation = assemblyView.Orientation3

    swAssembly.ClearSelection2 True

    Dim faceSelected As Boolean

    faceSelected = CBool(orientationFace.Select4(False, Nothing))

    If Not faceSelected Then

        Debug.Print "      Could not select assembly-context face for Normal To"

        GoTo CleanUpAssemblyExport

    End If

    swAssembly.ShowNamedView2 "*Normal To", -1

    swAssembly.ViewZoomtofit2

    Dim exportOrientation As Object

    If swAssembly.ActiveView Is Nothing Then GoTo CleanUpAssemblyExport

    Set exportOrientation = swAssembly.ActiveView.Orientation3

    swAssembly.ClearSelection2 True

    exportOk = ExportAssemblyComponentViaTemporaryPart( _
        swComp, exportOrientation, filePath)

    If Not exportOk Then

        Debug.Print "      Temporary-part assembly-context export failed"

    End If

    GoTo CleanUpAssemblyExport

ExportFailed:

    Debug.Print "      Assembly-context export error " & Err.Number & ": " & Err.Description

    Err.Clear

CleanUpAssemblyExport:

    On Error Resume Next

    ActivateAssemblyDocument swAssembly

    swAssembly.ClearSelection2 True

    If Not assemblyView Is Nothing And Not originalOrientation Is Nothing Then

        Set assemblyView.Orientation3 = originalOrientation

    End If

    RestoreModelSelection swAssembly, savedSelectionObjects, savedSelectionTypes

    On Error GoTo 0

    ExportAssemblyContextThinSolidDxf = exportOk

End Function

Function ExportAssemblyComponentViaTemporaryPart(swComp As Object, _
                                                  exportOrientation As Object, _
                                                  filePath As String) As Boolean

    ExportAssemblyComponentViaTemporaryPart = False

    If swComp Is Nothing Or exportOrientation Is Nothing Then Exit Function

    Dim stage As String

    Dim tempPartTitle As String

    Dim tempPartPath As String

    Dim exportOk As Boolean

    Dim swTempPart As Object

    On Error GoTo ExportFailed

    stage = "getting assembly-context bodies"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    Dim bodyInfo As Variant

    Dim bodies As Variant

    bodyInfo = Empty

    bodies = Empty

    bodies = swComp.GetBodies3(swSolidBody, bodyInfo)

    If IsEmpty(bodies) Then GoTo CleanUpTemporaryPart

    stage = "getting the component transform"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    Dim compTransform As Object

    Set compTransform = Nothing

    On Error Resume Next

    Set compTransform = swComp.GetTotalTransform(False)

    If compTransform Is Nothing Then Set compTransform = swComp.Transform2

    On Error GoTo ExportFailed

    stage = "copying assembly-context bodies"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    Dim bodyCopies As Collection

    Set bodyCopies = New Collection

    Dim i As Long

    For i = 0 To UBound(bodies)

        Dim sourceBody As Object

        Dim bodyCopy As Object

        Set sourceBody = bodies(i)

        Set bodyCopy = Nothing

        On Error Resume Next

        Set bodyCopy = sourceBody.Copy2(True)

        If bodyCopy Is Nothing Then Set bodyCopy = sourceBody.Copy

        On Error GoTo ExportFailed

        If bodyCopy Is Nothing Then GoTo CleanUpTemporaryPart

        If Not compTransform Is Nothing Then

            If Not CBool(bodyCopy.ApplyTransform(compTransform)) Then _
                GoTo CleanUpTemporaryPart

        End If

        bodyCopies.Add bodyCopy

    Next i

    If bodyCopies.Count = 0 Then GoTo CleanUpTemporaryPart

    stage = "creating the temporary part"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    Dim newPartResult As Object

    Set newPartResult = swApp.NewPart

    Set swTempPart = swApp.ActiveDoc

    If newPartResult Is Nothing Or swTempPart Is Nothing Then _
        GoTo CleanUpTemporaryPart

    tempPartTitle = swTempPart.GetTitle

    stage = "inserting copied bodies"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    Dim insertedCount As Long

    For i = 1 To bodyCopies.Count

        Dim importedFeature As Object

        Set importedFeature = Nothing

        On Error Resume Next

        Set importedFeature = swTempPart.CreateFeatureFromBody3( _
            bodyCopies(i), False, 1)

        If importedFeature Is Nothing Then

            Err.Clear

            Set importedFeature = swTempPart.CreateFeatureFromBody3( _
                bodyCopies(i), False, 0)

        End If

        On Error GoTo ExportFailed

        If Not importedFeature Is Nothing Then insertedCount = insertedCount + 1

    Next i

    If insertedCount <> bodyCopies.Count Then GoTo CleanUpTemporaryPart

    swTempPart.EditRebuild3

    stage = "saving the temporary part"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    Dim runId As String

    runId = Format$(Now, "yyyymmdd_hhnnss") & "_" & CStr(CLng(Timer * 1000#))

    tempPartPath = Environ$("TEMP") & "\Excelsis_DXF_" & runId & ".SLDPRT"

    Dim saveErrors As Long

    Dim saveWarnings As Long

    Dim saved As Boolean

    saved = CBool(swTempPart.Extension.SaveAs( _
                    tempPartPath, swSaveAsCurrentVersion, _
                    swSaveAsOptions_Silent, Nothing, saveErrors, saveWarnings))

    If Not saved Or Dir(tempPartPath) = "" Then GoTo CleanUpTemporaryPart

    stage = "applying the assembly orientation"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    Dim tempView As Object

    Set tempView = swTempPart.ActiveView

    If Not tempView Is Nothing Then Set tempView.Orientation3 = exportOrientation

    swTempPart.ViewZoomtofit2

    stage = "exporting the temporary part current view"

    TraceRun "component=" & g_traceComponent & " stage=" & stage

    exportOk = ExportCurrentViewToDxf(swTempPart, filePath)

    GoTo CleanUpTemporaryPart

ExportFailed:

    Debug.Print "      Temporary-part export error " & Err.Number & _
                " at " & stage & ": " & Err.Description

    TraceRun "component=" & g_traceComponent & " error-stage=" & stage & _
             " error=" & CStr(Err.Number)

    Err.Clear

CleanUpTemporaryPart:

    On Error Resume Next

    TraceRun "component=" & g_traceComponent & " stage=temporary-part-cleanup"

    If Not swTempPart Is Nothing Then

        tempPartTitle = GetDocumentActivationName(swTempPart)

        If Not ActivateModelDocument(swTempPart) Then _
            TraceRun "component=" & g_traceComponent & " temp-activation-failed"

        Set tempView = Nothing
        Set importedFeature = Nothing
        Set sourceBody = Nothing
        Set bodyCopy = Nothing
        Set newPartResult = Nothing
        Set bodyCopies = Nothing
        Set compTransform = Nothing
        bodies = Empty
        bodyInfo = Empty
        Set swTempPart = Nothing

        If tempPartTitle <> "" Then swApp.QuitDoc tempPartTitle

        DoEvents

    End If

    Dim stillOpen As Object

    Set stillOpen = Nothing

    If tempPartPath <> "" Then _
        Set stillOpen = swApp.GetOpenDocumentByName(tempPartPath)

    If Not stillOpen Is Nothing Then

        TraceRun "component=" & g_traceComponent & " temp-document-remained-open"

        swApp.CloseDoc GetDocumentActivationName(stillOpen)

    End If

    Set stillOpen = Nothing

    If tempPartPath <> "" Then

        If Dir(tempPartPath) <> "" Then Kill tempPartPath

        If Dir(tempPartPath) <> "" Then _
            TraceRun "component=" & g_traceComponent & " temp-file-remained-locked"

    End If

    TraceRun "component=" & g_traceComponent & " stage=temporary-part-cleanup-complete"

    On Error GoTo 0

    ExportAssemblyComponentViaTemporaryPart = exportOk

End Function

' ================================================================

Function ExportSMFlatPattern(swPart As Object, filePath As String) As Boolean

    Debug.Print "      --- ExportSMFlatPattern ---"

    DeleteExistingFile filePath

    swPart.ClearSelection2 True

    Dim bRet As Boolean

    On Error Resume Next

    bRet = swPart.ExportToDWG2(filePath, swPart.GetPathName, swExportToDWG_ExportSheetMetal, True, Empty, False, False, SHEET_METAL_EXPORT_OPTIONS, Empty)

    On Error GoTo 0

    Debug.Print "      ExportToDWG2 direct=" & bRet & " file=" & (Dir(filePath) <> "")

    If bRet And Dir(filePath) <> "" Then

        ExportSMFlatPattern = True

        Exit Function

    End If

    Dim swFeat As Object

    Set swFeat = FindFlatPatternFeat(swPart)

    If swFeat Is Nothing Then

        Debug.Print "      No FlatPattern feature found"

        Exit Function

    End If

    Dim wasSupp As Boolean

    wasSupp = swFeat.IsSuppressed

    If wasSupp Then

        swFeat.SetSuppression2 2, 2, Nothing

        swPart.EditRebuild3

    End If

    DeleteExistingFile filePath

    swPart.ClearSelection2 True

    swFeat.Select True

    swPart.EditRebuild3

    On Error Resume Next

    bRet = swPart.ExportToDWG2(filePath, swPart.GetPathName, swExportToDWG_ExportSheetMetal, True, Empty, False, False, SHEET_METAL_EXPORT_OPTIONS, Empty)

    On Error GoTo 0

    Debug.Print "      ExportToDWG2 selected flat=" & bRet & " file=" & (Dir(filePath) <> "")

    If bRet And Dir(filePath) <> "" Then

        ExportSMFlatPattern = True

        GoTo RestoreFlatPattern

    End If

    DeleteExistingFile filePath

    Dim errs As Long

    Dim warns As Long

    On Error Resume Next

    bRet = swPart.ExportFlatPatternView(filePath, swExportFlatPatternOption_RemoveBends)

    If bRet Then swPart.Extension.SaveAs filePath, swSaveAsCurrentVersion, swSaveAsOptions_Silent, Nothing, errs, warns

    On Error GoTo 0

    Debug.Print "      ExportFlatPatternView fallback=" & bRet & " file=" & (Dir(filePath) <> "")

    ExportSMFlatPattern = (bRet And Dir(filePath) <> "")

RestoreFlatPattern:

    swPart.ClearSelection2 True

    If wasSupp Then

        swFeat.SetSuppression2 0, 2, Nothing

        swPart.EditRebuild3

    End If

End Function



' ================================================================

Function ExportCurrentViewToDxf(swModel As Object, filePath As String) As Boolean

    ExportCurrentViewToDxf = False

    If swModel Is Nothing Then Exit Function

    DeleteExistingFile filePath

    Dim varAlignment As Variant

    varAlignment = DefaultDwgAlignment()

    Dim dataViews(0) As String

    dataViews(0) = "*Current"

    Dim varViews As Variant

    varViews = dataViews

    Dim modelName As String

    On Error Resume Next

    modelName = swModel.GetPathName

    If Len(modelName) = 0 Then modelName = swModel.GetTitle

    Dim ok As Boolean

    Dim exportErr As Long

    Dim exportErrDescription As String

    Err.Clear

    ok = swModel.ExportToDWG2(filePath, modelName, _
                              swExportToDWG_ExportAnnotationViews, _
                              True, varAlignment, False, False, 0, varViews)

    exportErr = Err.Number

    exportErrDescription = Err.Description

    On Error GoTo 0

    If exportErr <> 0 Then

        Debug.Print "      Current-view ExportToDWG2 error " & exportErr & ": " & exportErrDescription

        Exit Function

    End If

    If ok And Dir(filePath) <> "" Then

        On Error Resume Next

        ExportCurrentViewToDxf = (FileLen(filePath) > 0)

        On Error GoTo 0

    End If

End Function

Function ExportNormalViewToDxf(swPart As Object, swFace As Object, _
                               filePath As String) As Boolean

    ExportNormalViewToDxf = False

    If swPart Is Nothing Or swFace Is Nothing Then Exit Function

    If Not IsPlanarFace(swFace) Then Exit Function

    Dim modelView As Object

    Dim originalOrientation As Object

    Dim savedSelectionObjects As Collection

    Dim savedSelectionTypes As Collection

    CaptureModelSelection swPart, savedSelectionObjects, savedSelectionTypes

    Set modelView = swPart.ActiveView

    If Not modelView Is Nothing Then Set originalOrientation = modelView.Orientation3

    swPart.ClearSelection2 True

    Dim selected As Boolean

    On Error Resume Next

    selected = CBool(swFace.Select4(False, Nothing))

    If Not selected Then

        Err.Clear

        selected = CBool(swFace.Select(False))

    End If

    On Error GoTo 0

    If selected Then

        On Error Resume Next

        swPart.ShowNamedView2 "*Normal To", -1

        swPart.ViewZoomtofit2

        On Error GoTo 0

        swPart.ClearSelection2 True

        ExportNormalViewToDxf = ExportCurrentViewToDxf(swPart, filePath)

    Else

        Debug.Print "      Could not select planar face for Normal To export"

    End If

    On Error Resume Next

    swPart.ClearSelection2 True

    If Not modelView Is Nothing And Not originalOrientation Is Nothing Then

        Set modelView.Orientation3 = originalOrientation

    End If

    RestoreModelSelection swPart, savedSelectionObjects, savedSelectionTypes

    On Error GoTo 0

End Function

' ================================================================

Function ExportBestViewFast(swPart As Object, filePath As String) As Boolean

    Dim cutFace As Object

    Set cutFace = FindLargestPlanarFace(swPart)

    If Not cutFace Is Nothing Then

        If ExportNormalViewToDxf(swPart, cutFace, filePath) Then

            ExportBestViewFast = True

            Exit Function

        End If

        Debug.Print "      Normal current-view DXF failed, trying annotation views"

    End If

    Dim box As Variant
    box = SafeGetPartBox(swPart)

    If IsEmpty(box) Then

        ExportBestViewFast = False

        Exit Function

    End If



    Dim x As Double

    Dim y As Double

    Dim z As Double

    x = Abs(box(3) - box(0))

    y = Abs(box(4) - box(1))

    z = Abs(box(5) - box(2))



    Dim pV As Variant

    Dim fV As Variant

    If x <= y And x <= z Then

        pV = Array("*Right", "*Left")

        fV = Array("*Top", "*Bottom", "*Front", "*Back")

    ElseIf y <= x And y <= z Then

        pV = Array("*Top", "*Bottom")

        fV = Array("*Front", "*Back", "*Right", "*Left")

    Else

        pV = Array("*Front", "*Back")

        fV = Array("*Top", "*Bottom", "*Right", "*Left")

    End If



    If TryViews(swPart, filePath, pV) Then

        ExportBestViewFast = True

        Exit Function

    End If

    If TryViews(swPart, filePath, fV) Then

        ExportBestViewFast = True

        Exit Function

    End If

    ExportBestViewFast = False

End Function

Function ExportProjectedViewFast(swPart As Object, filePath As String) As Boolean

    Debug.Print "      --- ExportProjectedViewFast ---"

    Dim cutFace As Object

    Set cutFace = FindLargestPlanarFace(swPart)

    If Not cutFace Is Nothing Then

        If ExportNormalViewToDxf(swPart, cutFace, filePath) Then

            ExportProjectedViewFast = True

            Exit Function

        End If

        Debug.Print "      Normal current-view DXF failed, trying named annotation views"

    End If

    Dim box As Variant
    box = SafeGetPartBox(swPart)

    If IsEmpty(box) Then Exit Function

    Dim x As Double

    Dim y As Double

    Dim z As Double

    x = Abs(box(3) - box(0))

    y = Abs(box(4) - box(1))

    z = Abs(box(5) - box(2))

    Dim pV As Variant

    Dim fV As Variant

    If x <= y And x <= z Then

        pV = Array("*Right", "*Left")

        fV = Array("*Top", "*Bottom", "*Front", "*Back")

    ElseIf y <= x And y <= z Then

        pV = Array("*Top", "*Bottom")

        fV = Array("*Front", "*Back", "*Right", "*Left")

    Else

        pV = Array("*Front", "*Back")

        fV = Array("*Top", "*Bottom", "*Right", "*Left")

    End If

    If TryViews(swPart, filePath, pV) Then

        ExportProjectedViewFast = True

        Exit Function

    End If

    If TryViews(swPart, filePath, fV) Then

        ExportProjectedViewFast = True

        Exit Function

    End If

End Function



Function TryViews(swPart As Object, filePath As String, viewsArr As Variant) As Boolean

    Dim i As Integer

    For i = 0 To UBound(viewsArr)

        Debug.Print "      Trying annotation view: " & viewsArr(i)

        Dim oneView(0) As String

        oneView(0) = CStr(viewsArr(i))

        Dim varViews As Variant

        varViews = oneView

        Dim varAlignment As Variant

        varAlignment = DefaultDwgAlignment()

        DeleteExistingFile filePath

        Dim ok As Boolean

        On Error Resume Next

        ok = swPart.ExportToDWG2(filePath, swPart.GetPathName, swExportToDWG_ExportAnnotationViews, True, varAlignment, False, False, 0, varViews)

        On Error GoTo 0

        If ok And Dir(filePath) <> "" Then

            Debug.Print "      Annotation view used: " & viewsArr(i)

            TryViews = True

            Exit Function

        End If

    Next i

    TryViews = False

End Function

' ================================================================

Function ExportSelectedFaceToDxf(swPart As Object, swFace As Object, filePath As String) As Boolean

    DeleteExistingFile filePath

    swPart.ClearSelection2 True

    Dim selOk As Boolean

    On Error Resume Next

    selOk = swFace.Select4(False, Nothing)

    If Not selOk Then

        Err.Clear

        selOk = swFace.Select(False)

    End If

    On Error GoTo 0

    If Not selOk Then

        Debug.Print "      Could not select planar face for DXF"

        Exit Function

    End If

    Dim varAlignment As Variant

    varAlignment = DefaultDwgAlignment()

    Dim ok As Boolean

    On Error Resume Next

    ok = swPart.ExportToDWG2(filePath, swPart.GetPathName, swExportToDWG_ExportSelectedFacesOrLoops, True, varAlignment, False, False, 0, Empty)

    On Error GoTo 0

    swPart.ClearSelection2 True

    ExportSelectedFaceToDxf = (ok And Dir(filePath) <> "")

End Function

Function FindLargestPlanarFace(swPart As Object) As Object

    Dim bodies As Variant

    bodies = GetPartBodies(swPart)

    If IsEmpty(bodies) Then Exit Function

    Dim maxArea As Double

    maxArea = 0#

    Dim i As Long

    For i = 0 To UBound(bodies)

        Dim b As Object

        Set b = bodies(i)

        If Not b Is Nothing Then

            Dim faces As Variant

            faces = Empty

            On Error Resume Next

            faces = b.GetFaces

            On Error GoTo 0

            If Not IsEmpty(faces) Then

                Dim j As Long

                For j = 0 To UBound(faces)

                    Dim f As Object

                    Set f = faces(j)

                    If IsPlanarFace(f) Then

                        Dim a As Double

                        On Error Resume Next

                        a = f.GetArea

                        On Error GoTo 0

                        If a > maxArea Then

                            maxArea = a

                            Set FindLargestPlanarFace = f

                        End If

                    End If

                Next j

            End If

        End If

    Next i

End Function

Function IsPlanarFace(swFace As Object) As Boolean

    If swFace Is Nothing Then Exit Function

    Dim surf As Object

    On Error Resume Next

    Set surf = swFace.GetSurface

    If Not surf Is Nothing Then IsPlanarFace = surf.IsPlane

    On Error GoTo 0

End Function

Function DefaultDwgAlignment() As Variant

    Dim data(11) As Double

    data(3) = 1#

    data(7) = 1#

    data(11) = 1#

    DefaultDwgAlignment = data

End Function

Function GetPartBodies(swPart As Object) As Variant

    Dim bodies As Variant

    On Error Resume Next

    bodies = swPart.GetBodies2(0, False)

    On Error GoTo 0

    If IsEmpty(bodies) Then

        On Error Resume Next

        bodies = swPart.GetBodies(0)

        On Error GoTo 0

    End If

    If IsEmpty(bodies) Then

        GetPartBodies = Empty

    Else

        GetPartBodies = bodies

    End If

End Function

Function IsPartPath(pathName As String) As Boolean

    IsPartPath = (LCase(Right(pathName, 6)) = "sldprt")

End Function

Function IsAssemblyPath(pathName As String) As Boolean

    IsAssemblyPath = (LCase(Right(pathName, 6)) = "sldasm")

End Function

Function IsImportedPartPath(pathName As String) As Boolean

    Dim p As String

    p = LCase(pathName)

    If InStr(1, p, ".stp.", vbTextCompare) > 0 Then IsImportedPartPath = True
    If InStr(1, p, ".step.", vbTextCompare) > 0 Then IsImportedPartPath = True
    If InStr(1, p, "\ic~~\", vbTextCompare) > 0 Then IsImportedPartPath = True
    If InStr(1, p, "\swx", vbTextCompare) > 0 And InStr(1, p, "\appdata\local\temp\", vbTextCompare) > 0 Then IsImportedPartPath = True

End Function

Function IsImportedAssemblyComponent(swComp As Object) As Boolean

    If swComp Is Nothing Then Exit Function

    Dim importedPath As String

    On Error Resume Next

    importedPath = CStr(swComp.GetImportedPath)

    On Error GoTo 0

    If Trim$(importedPath) <> "" Then

        IsImportedAssemblyComponent = True

        Exit Function

    End If

    Dim f As Object

    On Error Resume Next

    Set f = swComp.FirstFeature

    On Error GoTo 0

    Dim featureCount As Long

    Do While Not f Is Nothing And featureCount < 256

        Dim typeName As String

        Dim featureName As String

        On Error Resume Next

        typeName = LCase$(CStr(f.GetTypeName2))
        featureName = LCase$(CStr(f.Name))

        On Error GoTo 0

        If InStr(1, typeName, "import", vbTextCompare) > 0 Or _
           Left$(featureName, 8) = "imported" Or _
           InStr(1, featureName, ".stp", vbTextCompare) > 0 Or _
           InStr(1, featureName, ".step", vbTextCompare) > 0 Then

            IsImportedAssemblyComponent = True

            Set f = Nothing

            Exit Function

        End If

        featureCount = featureCount + 1

        On Error Resume Next

        Set f = f.GetNextFeature

        On Error GoTo 0

    Loop

    Set f = Nothing

End Function

Function ComponentBodiesMayBeSheetLike(swComp As Object) As Boolean

    If swComp Is Nothing Then Exit Function

    Dim bodyInfo As Variant

    Dim bodies As Variant

    bodyInfo = Empty
    bodies = Empty

    On Error Resume Next

    bodies = swComp.GetBodies3(swSolidBody, bodyInfo)

    On Error GoTo 0

    If IsEmpty(bodies) Then Exit Function

    Dim minX As Double
    Dim minY As Double
    Dim minZ As Double
    Dim maxX As Double
    Dim maxY As Double
    Dim maxZ As Double

    minX = 1E+30
    minY = 1E+30
    minZ = 1E+30
    maxX = -1E+30
    maxY = -1E+30
    maxZ = -1E+30

    Dim i As Long

    For i = 0 To UBound(bodies)

        Dim b As Object

        Set b = bodies(i)

        If Not b Is Nothing Then

            Dim isSheetMetalBody As Boolean

            isSheetMetalBody = False

            On Error Resume Next

            isSheetMetalBody = CBool(b.IsSheetMetal)

            On Error GoTo 0

            If isSheetMetalBody Then

                ComponentBodiesMayBeSheetLike = True

                Set b = Nothing
                bodies = Empty
                bodyInfo = Empty

                Exit Function

            End If

            Dim bodyBox As Variant

            bodyBox = Empty

            On Error Resume Next

            bodyBox = b.GetBodyBox

            On Error GoTo 0

            If Not IsEmpty(bodyBox) Then

                If bodyBox(0) < minX Then minX = bodyBox(0)
                If bodyBox(1) < minY Then minY = bodyBox(1)
                If bodyBox(2) < minZ Then minZ = bodyBox(2)
                If bodyBox(3) > maxX Then maxX = bodyBox(3)
                If bodyBox(4) > maxY Then maxY = bodyBox(4)
                If bodyBox(5) > maxZ Then maxZ = bodyBox(5)

            End If

        End If

        Set b = Nothing

    Next i

    bodies = Empty
    bodyInfo = Empty

    If minX > 1E+29 Then Exit Function

    Dim a As Double
    Dim middle As Double
    Dim longest As Double

    a = Abs(maxX - minX) * 1000#
    middle = Abs(maxY - minY) * 1000#
    longest = Abs(maxZ - minZ) * 1000#

    Dim swapValue As Double

    If a > middle Then
        swapValue = a
        a = middle
        middle = swapValue
    End If

    If middle > longest Then
        swapValue = middle
        middle = longest
        longest = swapValue
    End If

    If a > middle Then
        swapValue = a
        a = middle
        middle = swapValue
    End If

    If a <= 0# Or a > THICKNESS_LIMIT Then Exit Function

    ComponentBodiesMayBeSheetLike = _
        (middle >= a * THIN_PLATE_MIN_RATIO And _
         longest >= a * THIN_PLATE_MIN_RATIO)

End Function

Function IsImportedGeometryPart(swPart As Object) As Boolean

    If swPart Is Nothing Then Exit Function

    Dim pathName As String

    On Error Resume Next

    pathName = swPart.GetPathName

    On Error GoTo 0

    If IsImportedPartPath(pathName) Then

        IsImportedGeometryPart = True

        Exit Function

    End If

    Dim f As Object

    Set f = swPart.FirstFeature

    Do While Not f Is Nothing

        Dim typeName As String

        Dim featName As String

        On Error Resume Next

        typeName = LCase(f.GetTypeName2)
        featName = LCase(f.Name)

        On Error GoTo 0

        If InStr(1, typeName, "import", vbTextCompare) > 0 Then

            IsImportedGeometryPart = True

            Exit Function

        End If

        If Left(featName, 8) = "imported" Then

            IsImportedGeometryPart = True

            Exit Function

        End If

        If InStr(1, featName, ".stp", vbTextCompare) > 0 Or InStr(1, featName, ".step", vbTextCompare) > 0 Then

            IsImportedGeometryPart = True

            Exit Function

        End If

        Set f = f.GetNextFeature

    Loop

End Function

Function IsToolboxPartSafe(swPart As Object) As Boolean

    If swPart Is Nothing Then Exit Function

    Dim toolboxType As Long

    toolboxType = 0

    On Error Resume Next

    toolboxType = CLng(swPart.Extension.ToolboxPartType)

    On Error GoTo 0

    IsToolboxPartSafe = (toolboxType <> 0)

End Function

Function CleanFileName(value As String) As String

    Dim badChars As Variant

    badChars = Array("\", "/", ":", "*", "?", """", "<", ">", "|")

    Dim result As String

    result = value

    Dim i As Long

    For i = 0 To UBound(badChars)

        result = Replace(result, CStr(badChars(i)), "_")

    Next i

    CleanFileName = Trim(result)

    If CleanFileName = "" Then CleanFileName = "Default"

End Function

Sub DeleteExistingFile(filePath As String)

    On Error Resume Next

    If Dir(filePath) <> "" Then Kill filePath

    On Error GoTo 0

End Sub

' ================================================================

Function ExportPartPrecut(swPart As Object, filePath As String, isSM As Boolean) As Boolean
    Debug.Print "      --- ExportPartPrecut ---"

    ExportPartPrecut = ExportPartPrecutSimple(swPart, filePath, isSM)
End Function
' ================================================================

Function ExportPartPrecutSimple(swPart As Object, filePath As String, isSM As Boolean) As Boolean

    Dim okBase As Boolean

    DeleteExistingFile filePath

    If isSM Then

        okBase = ExportSMFlatPattern(swPart, filePath)

    Else

        okBase = ExportProjectedViewFast(swPart, filePath)

        If Not okBase Then

            Debug.Print "      Projected view DXF failed, trying selected-face fallback"

            okBase = ExportBestViewFast(swPart, filePath)

        End If

    End If

    If okBase Then

        If AddOffsetOutlineToDxf(filePath, swPart, g_precutOffset_mm, g_precutKeepFeats) Then

            Debug.Print "      Real offset outline DXF saved; keepInternal=" & g_precutKeepFeats

            ExportPartPrecutSimple = True

            Exit Function

        End If

        Debug.Print "      Base DXF saved, but real outline offset failed"

    Else

        Debug.Print "      Base feature DXF failed"

    End If

    Debug.Print "      Falling back to outline box only"

    ExportPartPrecutSimple = WritePrecutBoxDxf(swPart, filePath, isSM)

End Function

Function ExportThinSolidRegularDxf(swPart As Object, filePath As String) As Boolean

    If ExportProjectedViewFast(swPart, filePath) Then

        If CleanProjectedDxfChamferLoops(filePath) Then

            Debug.Print "      Projected DXF cleaned for chamfer boundary loops"

        Else

            Debug.Print "      Projected DXF saved; chamfer cleanup not needed/failed"

        End If

        ExportThinSolidRegularDxf = True

        Exit Function

    End If

    Debug.Print "      Projected view DXF failed, trying selected-face fallback"

    ExportThinSolidRegularDxf = ExportBestViewFast(swPart, filePath)

End Function

Function CleanProjectedDxfChamferLoops(filePath As String) As Boolean

    Dim fso As Object

    Set fso = CreateObject("Scripting.FileSystemObject")

    If Not fso.FileExists(filePath) Then Exit Function

    Dim ts As Object

    Set ts = fso.OpenTextFile(filePath, 1, False)

    Dim raw As String

    raw = ts.ReadAll

    ts.Close

    raw = Replace(raw, vbCrLf, vbLf)

    raw = Replace(raw, vbCr, vbLf)

    Dim lines As Variant

    lines = Split(raw, vbLf)

    Dim inEnt As Boolean

    Dim maxItems As Long

    maxItems = UBound(lines) \ 2 + 5

    Dim entCount As Long

    Dim entType() As String

    Dim entStart() As Long

    Dim entEnd() As Long

    ReDim entType(1 To maxItems)

    ReDim entStart(1 To maxItems)

    ReDim entEnd(1 To maxItems)

    Dim gCount As Long

    Dim gKind() As String

    Dim gEnt() As Long

    Dim gx1() As Double, gy1() As Double, gx2() As Double, gy2() As Double

    ReDim gKind(1 To maxItems)

    ReDim gEnt(1 To maxItems)

    ReDim gx1(1 To maxItems)

    ReDim gy1(1 To maxItems)

    ReDim gx2(1 To maxItems)

    ReDim gy2(1 To maxItems)

    Dim i As Long

    i = 0

    Do While i <= UBound(lines) - 1

        Dim code As String

        Dim val As String

        code = Trim(CStr(lines(i)))

        val = Trim(CStr(lines(i + 1)))

        If code = "2" And UCase(val) = "ENTITIES" Then inEnt = True

        If inEnt And code = "0" Then

            If UCase(val) = "ENDSEC" Then Exit Do

            entCount = entCount + 1

            entType(entCount) = UCase(val)

            entStart(entCount) = i

            Dim j As Long

            j = i + 2

            Dim x10 As Double, y20 As Double, x11 As Double, y21 As Double

            Dim cx As Double, cy As Double, rr As Double, aa1 As Double, aa2 As Double

            Dim has10 As Boolean, has20 As Boolean, has11 As Boolean, has21 As Boolean

            Dim has40 As Boolean, has50 As Boolean, has51 As Boolean

            Dim polyX() As Double, polyY() As Double

            Dim polyN As Long

            Dim polyClosed As Boolean

            Dim pendingPolyX As Boolean

            Dim tmpPolyX As Double

            Do While j <= UBound(lines) - 1

                Dim c As String

                Dim v As String

                c = Trim(CStr(lines(j)))

                v = Trim(CStr(lines(j + 1)))

                If c = "0" Then Exit Do

                If entType(entCount) = "LINE" Then

                    If c = "10" Then x10 = ParseDxfNumber(v): has10 = True

                    If c = "20" Then y20 = ParseDxfNumber(v): has20 = True

                    If c = "11" Then x11 = ParseDxfNumber(v): has11 = True

                    If c = "21" Then y21 = ParseDxfNumber(v): has21 = True

                ElseIf entType(entCount) = "ARC" Then

                    If c = "10" Then cx = ParseDxfNumber(v): has10 = True

                    If c = "20" Then cy = ParseDxfNumber(v): has20 = True

                    If c = "40" Then rr = ParseDxfNumber(v): has40 = True

                    If c = "50" Then aa1 = ParseDxfNumber(v): has50 = True

                    If c = "51" Then aa2 = ParseDxfNumber(v): has51 = True

                ElseIf entType(entCount) = "LWPOLYLINE" Then

                    If c = "70" Then polyClosed = ((CLng(ParseDxfNumber(v)) And 1) <> 0)

                    If c = "10" Then

                        tmpPolyX = ParseDxfNumber(v)

                        pendingPolyX = True

                    End If

                    If c = "20" And pendingPolyX Then

                        polyN = polyN + 1

                        If polyN = 1 Then

                            ReDim polyX(1 To 1)

                            ReDim polyY(1 To 1)

                        Else

                            ReDim Preserve polyX(1 To polyN)

                            ReDim Preserve polyY(1 To polyN)

                        End If

                        polyX(polyN) = tmpPolyX

                        polyY(polyN) = ParseDxfNumber(v)

                        pendingPolyX = False

                    End If

                End If

                j = j + 2

            Loop

            entEnd(entCount) = j - 1

            If entType(entCount) = "LINE" And has10 And has20 And has11 And has21 Then

                gCount = gCount + 1

                gKind(gCount) = "LINE"

                gEnt(gCount) = entCount

                gx1(gCount) = x10

                gy1(gCount) = y20

                gx2(gCount) = x11

                gy2(gCount) = y21

            ElseIf entType(entCount) = "ARC" And has10 And has20 And has40 And has50 And has51 Then

                gCount = gCount + 1

                gKind(gCount) = "ARC"

                gEnt(gCount) = entCount

                gx1(gCount) = ArcPointX(cx, rr, aa1)

                gy1(gCount) = ArcPointY(cy, rr, aa1)

                gx2(gCount) = ArcPointX(cx, rr, aa2)

                gy2(gCount) = ArcPointY(cy, rr, aa2)

            ElseIf entType(entCount) = "LWPOLYLINE" And polyN >= 2 Then

                Dim p As Long

                For p = 1 To polyN - 1

                    gCount = gCount + 1

                    gKind(gCount) = "LINE"

                    gEnt(gCount) = entCount

                    gx1(gCount) = polyX(p)

                    gy1(gCount) = polyY(p)

                    gx2(gCount) = polyX(p + 1)

                    gy2(gCount) = polyY(p + 1)

                Next p

                If polyClosed Then

                    gCount = gCount + 1

                    gKind(gCount) = "LINE"

                    gEnt(gCount) = entCount

                    gx1(gCount) = polyX(polyN)

                    gy1(gCount) = polyY(polyN)

                    gx2(gCount) = polyX(1)

                    gy2(gCount) = polyY(1)

                End If

            End If

            i = j

        Else

            i = i + 2

        End If

    Loop

    If gCount = 0 Then Exit Function

    Dim bestComp As Long

    bestComp = FindOuterGeometryComponent(gCount, gx1, gy1, gx2, gy2)

    If bestComp = 0 Then Exit Function

    MarkOuterDropComponents gCount, gx1, gy1, gx2, gy2, bestComp, False

    Dim out As String

    out = ""

    For i = 0 To UBound(lines)

        If Not ShouldDropDxfLine(i, True, entCount, entType, entStart, entEnd, gCount, gEnt, bestComp, gx1, gy1, gx2, gy2) Then

            If i < UBound(lines) Or Len(CStr(lines(i))) > 0 Then out = out & CStr(lines(i)) & vbCrLf

        End If

    Next i

    Set ts = fso.OpenTextFile(filePath, 2, True)

    ts.Write out

    ts.Close

    CleanProjectedDxfChamferLoops = True

End Function

Function AddOffsetOutlineToDxf(filePath As String, swPart As Object, offsetMm As Double, keepInternal As Boolean) As Boolean

    Dim fso As Object

    Set fso = CreateObject("Scripting.FileSystemObject")

    If Not fso.FileExists(filePath) Then Exit Function

    Dim ts As Object

    Set ts = fso.OpenTextFile(filePath, 1, False)

    Dim raw As String

    raw = ts.ReadAll

    ts.Close

    raw = Replace(raw, vbCrLf, vbLf)

    raw = Replace(raw, vbCr, vbLf)

    Dim lines As Variant

    lines = Split(raw, vbLf)

    Dim inEnt As Boolean

    Dim insertIdx As Long

    insertIdx = -1

    Dim maxItems As Long

    maxItems = UBound(lines) \ 2 + 5

    Dim entCount As Long

    Dim entType() As String

    Dim entStart() As Long

    Dim entEnd() As Long

    ReDim entType(1 To maxItems)

    ReDim entStart(1 To maxItems)

    ReDim entEnd(1 To maxItems)

    Dim gCount As Long

    Dim gKind() As String

    Dim gEnt() As Long

    Dim gx1() As Double, gy1() As Double, gx2() As Double, gy2() As Double

    Dim gcx() As Double, gcy() As Double, gr() As Double, ga1() As Double, ga2() As Double

    ReDim gKind(1 To maxItems)

    ReDim gEnt(1 To maxItems)

    ReDim gx1(1 To maxItems)

    ReDim gy1(1 To maxItems)

    ReDim gx2(1 To maxItems)

    ReDim gy2(1 To maxItems)

    ReDim gcx(1 To maxItems)

    ReDim gcy(1 To maxItems)

    ReDim gr(1 To maxItems)

    ReDim ga1(1 To maxItems)

    ReDim ga2(1 To maxItems)

    Dim i As Long

    i = 0

    Do While i <= UBound(lines) - 1

        Dim code As String

        Dim val As String

        code = Trim(CStr(lines(i)))

        val = Trim(CStr(lines(i + 1)))

        If code = "2" And UCase(val) = "ENTITIES" Then inEnt = True

        If inEnt And code = "0" Then

            If UCase(val) = "ENDSEC" Then

                insertIdx = i

                Exit Do

            End If

            entCount = entCount + 1

            entType(entCount) = UCase(val)

            entStart(entCount) = i

            Dim j As Long

            j = i + 2

            Dim x10 As Double, y20 As Double, x11 As Double, y21 As Double

            Dim cx As Double, cy As Double, rr As Double, aa1 As Double, aa2 As Double

            Dim has10 As Boolean, has20 As Boolean, has11 As Boolean, has21 As Boolean

            Dim has40 As Boolean, has50 As Boolean, has51 As Boolean

            Dim polyX() As Double, polyY() As Double

            Dim polyN As Long

            Dim polyClosed As Boolean

            Dim pendingPolyX As Boolean

            Dim tmpPolyX As Double

            Do While j <= UBound(lines) - 1

                Dim c As String

                Dim v As String

                c = Trim(CStr(lines(j)))

                v = Trim(CStr(lines(j + 1)))

                If c = "0" Then Exit Do

                If entType(entCount) = "LINE" Then

                    If c = "10" Then x10 = ParseDxfNumber(v): has10 = True

                    If c = "20" Then y20 = ParseDxfNumber(v): has20 = True

                    If c = "11" Then x11 = ParseDxfNumber(v): has11 = True

                    If c = "21" Then y21 = ParseDxfNumber(v): has21 = True

                ElseIf entType(entCount) = "ARC" Then

                    If c = "10" Then cx = ParseDxfNumber(v): has10 = True

                    If c = "20" Then cy = ParseDxfNumber(v): has20 = True

                    If c = "40" Then rr = ParseDxfNumber(v): has40 = True

                    If c = "50" Then aa1 = ParseDxfNumber(v): has50 = True

                    If c = "51" Then aa2 = ParseDxfNumber(v): has51 = True

                ElseIf entType(entCount) = "LWPOLYLINE" Then

                    If c = "70" Then polyClosed = ((CLng(ParseDxfNumber(v)) And 1) <> 0)

                    If c = "10" Then

                        tmpPolyX = ParseDxfNumber(v)

                        pendingPolyX = True

                    End If

                    If c = "20" And pendingPolyX Then

                        polyN = polyN + 1

                        If polyN = 1 Then

                            ReDim polyX(1 To 1)

                            ReDim polyY(1 To 1)

                        Else

                            ReDim Preserve polyX(1 To polyN)

                            ReDim Preserve polyY(1 To polyN)

                        End If

                        polyX(polyN) = tmpPolyX

                        polyY(polyN) = ParseDxfNumber(v)

                        pendingPolyX = False

                    End If

                End If

                j = j + 2

            Loop

            entEnd(entCount) = j - 1

            If entType(entCount) = "LINE" And has10 And has20 And has11 And has21 Then

                gCount = gCount + 1

                gKind(gCount) = "LINE"

                gEnt(gCount) = entCount

                gx1(gCount) = x10

                gy1(gCount) = y20

                gx2(gCount) = x11

                gy2(gCount) = y21

            ElseIf entType(entCount) = "ARC" And has10 And has20 And has40 And has50 And has51 Then

                gCount = gCount + 1

                gKind(gCount) = "ARC"

                gEnt(gCount) = entCount

                gcx(gCount) = cx

                gcy(gCount) = cy

                gr(gCount) = rr

                ga1(gCount) = aa1

                ga2(gCount) = aa2

                gx1(gCount) = ArcPointX(cx, rr, aa1)

                gy1(gCount) = ArcPointY(cy, rr, aa1)

                gx2(gCount) = ArcPointX(cx, rr, aa2)

                gy2(gCount) = ArcPointY(cy, rr, aa2)

            ElseIf entType(entCount) = "LWPOLYLINE" And polyN >= 2 Then

                Dim p As Long

                For p = 1 To polyN - 1

                    gCount = gCount + 1

                    gKind(gCount) = "LINE"

                    gEnt(gCount) = entCount

                    gx1(gCount) = polyX(p)

                    gy1(gCount) = polyY(p)

                    gx2(gCount) = polyX(p + 1)

                    gy2(gCount) = polyY(p + 1)

                Next p

                If polyClosed Then

                    gCount = gCount + 1

                    gKind(gCount) = "LINE"

                    gEnt(gCount) = entCount

                    gx1(gCount) = polyX(polyN)

                    gy1(gCount) = polyY(polyN)

                    gx2(gCount) = polyX(1)

                    gy2(gCount) = polyY(1)

                End If

            End If

            i = j

        Else

            i = i + 2

        End If

    Loop

    If insertIdx < 0 Then

        Debug.Print "      DXF outline insert failed: no ENTITIES end"

        Exit Function

    End If

    If gCount = 0 Then

        Debug.Print "      DXF outline insert failed: no line/arc entities"

        Exit Function

    End If

    Dim bestComp As Long

    bestComp = FindOuterGeometryComponent(gCount, gx1, gy1, gx2, gy2)

    If bestComp = 0 Then

        Debug.Print "      DXF outline insert failed: no outer component"

        Exit Function

    End If

    MarkOuterDropComponents gCount, gx1, gy1, gx2, gy2, bestComp, True

    Dim t As Double

    Dim w As Double

    Dim longDim As Double

    Dim unitScale As Double

    unitScale = 1#

    Dim px() As Double

    Dim py() As Double

    Dim pCount As Long

    If Not BuildComponentPointLoop(bestComp, gCount, gKind, gx1, gy1, gx2, gy2, gcx, gcy, gr, ga1, ga2, px, py, pCount) Then

        Debug.Print "      DXF outline insert failed: could not order outer loop"

        Exit Function

    End If

    Dim outX() As Double

    Dim outY() As Double

    Dim outCount As Long

    If GetSortedBoxDimsMM(swPart, t, w, longDim) Then

        Dim dxfLong As Double

        dxfLong = DxfPointSpan(px, py, pCount)

        If longDim > 0 And dxfLong > 0 Then unitScale = dxfLong / longDim

    End If

    If Not OffsetPointLoop(px, py, pCount, offsetMm * unitScale, outX, outY, outCount) Then

        Debug.Print "      DXF outline insert failed: offset failed"

        Exit Function

    End If

    Dim newOutline As String

    newOutline = BuildDxfPolyline(outX, outY, outCount, "PRECUT_OUTLINE")

    Dim out As String

    out = ""

    For i = 0 To UBound(lines)

        If i = insertIdx Then out = out & newOutline

        If Not ShouldDropDxfLine(i, keepInternal, entCount, entType, entStart, entEnd, gCount, gEnt, bestComp, gx1, gy1, gx2, gy2) Then

            If i < UBound(lines) Or Len(CStr(lines(i))) > 0 Then out = out & CStr(lines(i)) & vbCrLf

        End If

    Next i

    Set ts = fso.OpenTextFile(filePath, 2, True)

    ts.Write out

    ts.Close

    AddOffsetOutlineToDxf = True

    Debug.Print "      Real offset outline inserted; DXF unit scale=" & Round(unitScale, 6) & " keepInternal=" & keepInternal

End Function

Function FindOuterGeometryComponent(gCount As Long, gx1() As Double, gy1() As Double, gx2() As Double, gy2() As Double) As Long

    Dim comp() As Long

    ReDim comp(1 To gCount)

    Dim compCount As Long

    Dim i As Long

    For i = 1 To gCount

        If comp(i) = 0 Then

            compCount = compCount + 1

            comp(i) = compCount

            Dim changed As Boolean

            changed = True

            Do While changed

                changed = False

                Dim a As Long

                Dim b As Long

                For a = 1 To gCount

                    If comp(a) = compCount Then

                        For b = 1 To gCount

                            If comp(b) = 0 Then

                                If GeoConnected(a, b, gx1, gy1, gx2, gy2) Then

                                    comp(b) = compCount

                                    changed = True

                                End If

                            End If

                        Next b

                    End If

                Next a

            Loop

        End If

    Next i

    Dim bestScore As Double

    bestScore = -1#

    Dim c As Long

    For c = 1 To compCount

        Dim minX As Double, minY As Double, maxX As Double, maxY As Double

        minX = 1E+30

        minY = 1E+30

        maxX = -1E+30

        maxY = -1E+30

        For i = 1 To gCount

            If comp(i) = c Then

                ExpandBounds minX, minY, maxX, maxY, gx1(i), gy1(i)

                ExpandBounds minX, minY, maxX, maxY, gx2(i), gy2(i)

            End If

        Next i

        Dim score As Double

        score = (maxX - minX) * (maxY - minY)

        If score > bestScore Then

            bestScore = score

            FindOuterGeometryComponent = c

        End If

    Next c

    StoreTempComponents comp

End Function

Sub StoreTempComponents(comp() As Long)

    Dim i As Long

    ReDim g_dxfComp(LBound(comp) To UBound(comp))

    For i = LBound(comp) To UBound(comp)

        g_dxfComp(i) = comp(i)

    Next i

End Sub

Sub MarkOuterDropComponents(gCount As Long, gx1() As Double, gy1() As Double, _
                            gx2() As Double, gy2() As Double, _
                            bestComp As Long, dropBest As Boolean)

    Dim compMax As Long

    Dim i As Long

    For i = 1 To gCount

        If g_dxfComp(i) > compMax Then compMax = g_dxfComp(i)

    Next i

    If compMax <= 0 Then Exit Sub

    ReDim g_dxfDropComp(1 To compMax)

    g_dxfDropComp(bestComp) = dropBest

    Dim bestMinX As Double, bestMinY As Double, bestMaxX As Double, bestMaxY As Double

    bestMinX = 1E+30

    bestMinY = 1E+30

    bestMaxX = -1E+30

    bestMaxY = -1E+30

    For i = 1 To gCount

        If g_dxfComp(i) = bestComp Then

            ExpandBounds bestMinX, bestMinY, bestMaxX, bestMaxY, gx1(i), gy1(i)

            ExpandBounds bestMinX, bestMinY, bestMaxX, bestMaxY, gx2(i), gy2(i)

        End If

    Next i

    Dim bestW As Double

    Dim bestH As Double

    bestW = bestMaxX - bestMinX

    bestH = bestMaxY - bestMinY

    If bestW <= 0# Or bestH <= 0# Then Exit Sub

    Dim compId As Long

    For compId = 1 To compMax

        If compId <> bestComp Then

            Dim minX As Double, minY As Double, maxX As Double, maxY As Double

            minX = 1E+30

            minY = 1E+30

            maxX = -1E+30

            maxY = -1E+30

            For i = 1 To gCount

                If g_dxfComp(i) = compId Then

                    ExpandBounds minX, minY, maxX, maxY, gx1(i), gy1(i)

                    ExpandBounds minX, minY, maxX, maxY, gx2(i), gy2(i)

                End If

            Next i

            Dim compW As Double

            Dim compH As Double

            compW = maxX - minX

            compH = maxY - minY

            If compW >= bestW * 0.6 And compH >= bestH * 0.6 Then

                If Abs(minX - bestMinX) <= bestW * 0.18 And _
                   Abs(maxX - bestMaxX) <= bestW * 0.18 And _
                   Abs(minY - bestMinY) <= bestH * 0.18 And _
                   Abs(maxY - bestMaxY) <= bestH * 0.18 Then

                    g_dxfDropComp(compId) = True

                End If

            End If

            If Not g_dxfDropComp(compId) Then

                Dim closedComp As Boolean

                closedComp = DxfComponentIsClosed(compId, gCount, gx1, gy1, gx2, gy2)

                Dim edgeTolX As Double

                Dim edgeTolY As Double

                edgeTolX = bestW * 0.08

                edgeTolY = bestH * 0.08

                Dim nearLeftEdge As Boolean

                Dim nearRightEdge As Boolean

                Dim nearBottomEdge As Boolean

                Dim nearTopEdge As Boolean

                nearLeftEdge = (Abs(minX - bestMinX) <= edgeTolX And Abs(maxX - bestMinX) <= edgeTolX)

                nearRightEdge = (Abs(minX - bestMaxX) <= edgeTolX And Abs(maxX - bestMaxX) <= edgeTolX)

                nearBottomEdge = (Abs(minY - bestMinY) <= edgeTolY And Abs(maxY - bestMinY) <= edgeTolY)

                nearTopEdge = (Abs(minY - bestMaxY) <= edgeTolY And Abs(maxY - bestMaxY) <= edgeTolY)

                If Not closedComp And compH >= bestH * 0.45 And (nearLeftEdge Or nearRightEdge) Then

                    g_dxfDropComp(compId) = True

                End If

                If Not closedComp And compW >= bestW * 0.45 And (nearBottomEdge Or nearTopEdge) Then

                    g_dxfDropComp(compId) = True

                End If

                Dim closeBounds As Long

                If Abs(minX - bestMinX) <= edgeTolX Then closeBounds = closeBounds + 1

                If Abs(maxX - bestMaxX) <= edgeTolX Then closeBounds = closeBounds + 1

                If Abs(minY - bestMinY) <= edgeTolY Then closeBounds = closeBounds + 1

                If Abs(maxY - bestMaxY) <= edgeTolY Then closeBounds = closeBounds + 1

                If Not closedComp And compW >= bestW * 0.45 And compH >= bestH * 0.45 And closeBounds >= 2 Then

                    g_dxfDropComp(compId) = True

                End If

            End If

        End If

    Next compId

End Sub

Function DxfComponentMarkedDrop(compId As Long) As Boolean

    On Error Resume Next

    DxfComponentMarkedDrop = g_dxfDropComp(compId)

    On Error GoTo 0

End Function

Function DxfComponentIsClosed(compId As Long, gCount As Long, _
                              gx1() As Double, gy1() As Double, _
                              gx2() As Double, gy2() As Double) As Boolean

    Dim hasGeometry As Boolean

    Dim i As Long

    For i = 1 To gCount

        If g_dxfComp(i) = compId Then

            hasGeometry = True

            If DxfEndpointDegree(compId, gx1(i), gy1(i), gCount, gx1, gy1, gx2, gy2) < 2 Then Exit Function

            If DxfEndpointDegree(compId, gx2(i), gy2(i), gCount, gx1, gy1, gx2, gy2) < 2 Then Exit Function

        End If

    Next i

    DxfComponentIsClosed = hasGeometry

End Function

Function DxfEndpointDegree(compId As Long, x As Double, y As Double, gCount As Long, _
                           gx1() As Double, gy1() As Double, _
                           gx2() As Double, gy2() As Double) As Long

    Dim i As Long

    For i = 1 To gCount

        If g_dxfComp(i) = compId Then

            If PointsNear(x, y, gx1(i), gy1(i)) Then DxfEndpointDegree = DxfEndpointDegree + 1

            If PointsNear(x, y, gx2(i), gy2(i)) Then DxfEndpointDegree = DxfEndpointDegree + 1

        End If

    Next i

End Function

Function GeoConnected(a As Long, b As Long, gx1() As Double, gy1() As Double, gx2() As Double, gy2() As Double) As Boolean

    GeoConnected = PointsNear(gx1(a), gy1(a), gx1(b), gy1(b)) Or _
                   PointsNear(gx1(a), gy1(a), gx2(b), gy2(b)) Or _
                   PointsNear(gx2(a), gy2(a), gx1(b), gy1(b)) Or _
                   PointsNear(gx2(a), gy2(a), gx2(b), gy2(b))

End Function

Function PointsNear(x1 As Double, y1 As Double, x2 As Double, y2 As Double) As Boolean

    PointsNear = (Abs(x1 - x2) < 0.001 And Abs(y1 - y2) < 0.001)

End Function

Sub ExpandBounds(ByRef minX As Double, ByRef minY As Double, ByRef maxX As Double, ByRef maxY As Double, x As Double, y As Double)

    If x < minX Then minX = x

    If y < minY Then minY = y

    If x > maxX Then maxX = x

    If y > maxY Then maxY = y

End Sub

Function BuildComponentPointLoop(bestComp As Long, gCount As Long, gKind() As String, _
                                 gx1() As Double, gy1() As Double, gx2() As Double, gy2() As Double, _
                                 gcx() As Double, gcy() As Double, gr() As Double, _
                                 ga1() As Double, ga2() As Double, _
                                 ByRef px() As Double, ByRef py() As Double, ByRef pCount As Long) As Boolean

    Dim used() As Boolean

    ReDim used(1 To gCount)

    Dim first As Long

    Dim i As Long

    For i = 1 To gCount

        If g_dxfComp(i) = bestComp Then

            first = i

            Exit For

        End If

    Next i

    If first = 0 Then Exit Function

    AppendGeoPoints first, False, gKind, gx1, gy1, gx2, gy2, gcx, gcy, gr, ga1, ga2, px, py, pCount

    used(first) = True

    Dim curX As Double

    Dim curY As Double

    curX = gx2(first)

    curY = gy2(first)

    Dim added As Boolean

    Do

        added = False

        For i = 1 To gCount

            If g_dxfComp(i) = bestComp And Not used(i) Then

                If PointsNear(curX, curY, gx1(i), gy1(i)) Then

                    AppendGeoPoints i, False, gKind, gx1, gy1, gx2, gy2, gcx, gcy, gr, ga1, ga2, px, py, pCount

                    curX = gx2(i)

                    curY = gy2(i)

                    used(i) = True

                    added = True

                    Exit For

                ElseIf PointsNear(curX, curY, gx2(i), gy2(i)) Then

                    AppendGeoPoints i, True, gKind, gx1, gy1, gx2, gy2, gcx, gcy, gr, ga1, ga2, px, py, pCount

                    curX = gx1(i)

                    curY = gy1(i)

                    used(i) = True

                    added = True

                    Exit For

                End If

            End If

        Next i

    Loop While added

    BuildComponentPointLoop = (pCount >= 3)

End Function

Sub AppendGeoPoints(idx As Long, reversed As Boolean, gKind() As String, _
                    gx1() As Double, gy1() As Double, gx2() As Double, gy2() As Double, _
                    gcx() As Double, gcy() As Double, gr() As Double, _
                    ga1() As Double, ga2() As Double, _
                    ByRef px() As Double, ByRef py() As Double, ByRef pCount As Long)

    If gKind(idx) = "LINE" Then

        If reversed Then

            AddDxfPoint px, py, pCount, gx2(idx), gy2(idx)

            AddDxfPoint px, py, pCount, gx1(idx), gy1(idx)

        Else

            AddDxfPoint px, py, pCount, gx1(idx), gy1(idx)

            AddDxfPoint px, py, pCount, gx2(idx), gy2(idx)

        End If

    ElseIf gKind(idx) = "ARC" Then

        Dim aStart As Double

        Dim aEnd As Double

        Dim sweep As Double

        If reversed Then

            aStart = ga2(idx)

            aEnd = ga1(idx)

            If aEnd > aStart Then aEnd = aEnd - 360#

            sweep = aStart - aEnd

        Else

            aStart = ga1(idx)

            aEnd = ga2(idx)

            If aEnd < aStart Then aEnd = aEnd + 360#

            sweep = aEnd - aStart

        End If

        Dim steps As Long

        steps = Int(Abs(sweep) / 5#) + 1

        If steps < 4 Then steps = 4

        Dim k As Long

        For k = 0 To steps

            Dim a As Double

            If reversed Then

                a = aStart - sweep * k / steps

            Else

                a = aStart + sweep * k / steps

            End If

            AddDxfPoint px, py, pCount, ArcPointX(gcx(idx), gr(idx), a), ArcPointY(gcy(idx), gr(idx), a)

        Next k

    End If

End Sub

Sub AddDxfPoint(ByRef px() As Double, ByRef py() As Double, ByRef pCount As Long, x As Double, y As Double)

    If pCount > 0 Then

        If PointsNear(px(pCount), py(pCount), x, y) Then Exit Sub

    End If

    pCount = pCount + 1

    If pCount = 1 Then

        ReDim px(1 To pCount)

        ReDim py(1 To pCount)

    Else

        ReDim Preserve px(1 To pCount)

        ReDim Preserve py(1 To pCount)

    End If

    px(pCount) = x

    py(pCount) = y

End Sub

Function OffsetPointLoop(px() As Double, py() As Double, pCount As Long, dist As Double, ByRef ox() As Double, ByRef oy() As Double, ByRef oCount As Long) As Boolean

    Dim n As Long

    n = pCount

    If n > 2 Then

        If PointsNear(px(1), py(1), px(n), py(n)) Then n = n - 1

    End If

    If n < 3 Then Exit Function

    Dim area As Double

    area = PolygonArea(px, py, n)

    Dim nx() As Double

    Dim ny() As Double

    ReDim nx(1 To n)

    ReDim ny(1 To n)

    Dim i As Long

    For i = 1 To n

        Dim j As Long

        j = i + 1

        If j > n Then j = 1

        Dim dx As Double

        Dim dy As Double

        dx = px(j) - px(i)

        dy = py(j) - py(i)

        Dim segLen As Double

        segLen = Sqr(dx * dx + dy * dy)

        If segLen <= 0.000001 Then Exit Function

        If area > 0 Then

            nx(i) = dy / segLen

            ny(i) = -dx / segLen

        Else

            nx(i) = -dy / segLen

            ny(i) = dx / segLen

        End If

    Next i

    oCount = n

    ReDim ox(1 To n)

    ReDim oy(1 To n)

    For i = 1 To n

        Dim prev As Long

        prev = i - 1

        If prev < 1 Then prev = n

        Dim nextI As Long

        nextI = i + 1

        If nextI > n Then nextI = 1

        If Not IntersectOffsetLines(px(prev), py(prev), px(i), py(i), nx(prev) * dist, ny(prev) * dist, px(i), py(i), px(nextI), py(nextI), nx(i) * dist, ny(i) * dist, ox(i), oy(i)) Then

            ox(i) = px(i) + (nx(prev) + nx(i)) * dist / 2#

            oy(i) = py(i) + (ny(prev) + ny(i)) * dist / 2#

        End If

    Next i

    OffsetPointLoop = True

End Function

Function IntersectOffsetLines(x1 As Double, y1 As Double, x2 As Double, y2 As Double, _
                              ox1 As Double, oy1 As Double, _
                              x3 As Double, y3 As Double, x4 As Double, y4 As Double, _
                              ox2 As Double, oy2 As Double, _
                              ByRef ix As Double, ByRef iy As Double) As Boolean

    Dim ax As Double, ay As Double, bx As Double, by As Double

    ax = x1 + ox1

    ay = y1 + oy1

    bx = x2 + ox1

    by = y2 + oy1

    Dim cx As Double, cy As Double, dx As Double, dy As Double

    cx = x3 + ox2

    cy = y3 + oy2

    dx = x4 + ox2

    dy = y4 + oy2

    Dim vx1 As Double, vy1 As Double, vx2 As Double, vy2 As Double

    vx1 = bx - ax

    vy1 = by - ay

    vx2 = dx - cx

    vy2 = dy - cy

    Dim den As Double

    den = vx1 * vy2 - vy1 * vx2

    If Abs(den) < 0.000000001 Then Exit Function

    Dim t As Double

    t = ((cx - ax) * vy2 - (cy - ay) * vx2) / den

    ix = ax + t * vx1

    iy = ay + t * vy1

    IntersectOffsetLines = True

End Function

Function PolygonArea(px() As Double, py() As Double, n As Long) As Double

    Dim a As Double

    Dim i As Long

    For i = 1 To n

        Dim j As Long

        j = i + 1

        If j > n Then j = 1

        a = a + px(i) * py(j) - px(j) * py(i)

    Next i

    PolygonArea = a / 2#

End Function

Function DxfPointSpan(px() As Double, py() As Double, pCount As Long) As Double

    Dim minX As Double, minY As Double, maxX As Double, maxY As Double

    minX = 1E+30

    minY = 1E+30

    maxX = -1E+30

    maxY = -1E+30

    Dim i As Long

    For i = 1 To pCount

        ExpandBounds minX, minY, maxX, maxY, px(i), py(i)

    Next i

    DxfPointSpan = Abs(maxX - minX)

    If Abs(maxY - minY) > DxfPointSpan Then DxfPointSpan = Abs(maxY - minY)

End Function

Function BuildDxfPolyline(px() As Double, py() As Double, pCount As Long, layerName As String) As String

    Dim s As String

    s = "0" & vbCrLf
    s = s & "LWPOLYLINE" & vbCrLf
    s = s & "8" & vbCrLf
    s = s & layerName & vbCrLf
    s = s & "90" & vbCrLf
    s = s & CStr(pCount) & vbCrLf
    s = s & "70" & vbCrLf
    s = s & "1" & vbCrLf

    Dim i As Long

    For i = 1 To pCount

        s = s & "10" & vbCrLf
        s = s & DxfNumber(px(i)) & vbCrLf
        s = s & "20" & vbCrLf
        s = s & DxfNumber(py(i)) & vbCrLf

    Next i

    BuildDxfPolyline = s

End Function

Function ShouldDropDxfLine(lineIdx As Long, keepInternal As Boolean, entCount As Long, _
                           entType() As String, entStart() As Long, entEnd() As Long, _
                           gCount As Long, gEnt() As Long, bestComp As Long, _
                           gx1() As Double, gy1() As Double, gx2() As Double, gy2() As Double) As Boolean

    Dim e As Long

    For e = 1 To entCount

        If lineIdx >= entStart(e) And lineIdx <= entEnd(e) Then

            If UCase(entType(e)) = "INSERT" Or UCase(entType(e)) = "MTEXT" Or UCase(entType(e)) = "TEXT" Then

                ShouldDropDxfLine = True

                Exit Function

            End If

            If Not keepInternal Then

                ShouldDropDxfLine = True

                Exit Function

            End If

            Dim g As Long

            For g = 1 To gCount

                If gEnt(g) = e And DxfComponentMarkedDrop(g_dxfComp(g)) Then

                    ShouldDropDxfLine = True

                    Exit Function

                End If

            Next g

            Exit Function

        End If

    Next e

End Function

Function ArcPointX(cx As Double, r As Double, deg As Double) As Double

    ArcPointX = cx + r * Cos(deg * Atn(1#) / 45#)

End Function

Function ArcPointY(cy As Double, r As Double, deg As Double) As Double

    ArcPointY = cy + r * Sin(deg * Atn(1#) / 45#)

End Function

Function BuildDxfRect(x1 As Double, y1 As Double, x2 As Double, y2 As Double) As String

    Dim s As String

    s = "0" & vbCrLf
    s = s & "LWPOLYLINE" & vbCrLf
    s = s & "8" & vbCrLf
    s = s & "PRECUT_OUTLINE" & vbCrLf
    s = s & "90" & vbCrLf
    s = s & "4" & vbCrLf
    s = s & "70" & vbCrLf
    s = s & "1" & vbCrLf
    s = s & "10" & vbCrLf
    s = s & DxfNumber(x1) & vbCrLf
    s = s & "20" & vbCrLf
    s = s & DxfNumber(y1) & vbCrLf
    s = s & "10" & vbCrLf
    s = s & DxfNumber(x2) & vbCrLf
    s = s & "20" & vbCrLf
    s = s & DxfNumber(y1) & vbCrLf
    s = s & "10" & vbCrLf
    s = s & DxfNumber(x2) & vbCrLf
    s = s & "20" & vbCrLf
    s = s & DxfNumber(y2) & vbCrLf
    s = s & "10" & vbCrLf
    s = s & DxfNumber(x1) & vbCrLf
    s = s & "20" & vbCrLf
    s = s & DxfNumber(y2) & vbCrLf

    BuildDxfRect = s

End Function

Function ParseDxfNumber(value As String) As Double

    Dim decSep As String

    decSep = Mid(CStr(1.1), 2, 1)

    ParseDxfNumber = CDbl(Replace(value, ".", decSep))

End Function

Function DrawPrecutRectangleOnSheet(swDraw As Object, swSheet As Object, outline As Variant) As Boolean

    Dim offsetMeters As Double

    offsetMeters = g_precutOffset_mm / 1000#

    Dim x1 As Double

    Dim y1 As Double

    Dim x2 As Double

    Dim y2 As Double

    x1 = outline(0) - offsetMeters

    y1 = outline(1) - offsetMeters

    x2 = outline(2) + offsetMeters

    y2 = outline(3) + offsetMeters

    On Error Resume Next

    swDraw.ActivateSheet swSheet.GetName

    swDraw.ClearSelection2 True

    swDraw.SketchManager.InsertSketch True

    swDraw.SketchManager.CreateLine x1, y1, 0#, x2, y1, 0#

    swDraw.SketchManager.CreateLine x2, y1, 0#, x2, y2, 0#

    swDraw.SketchManager.CreateLine x2, y2, 0#, x1, y2, 0#

    swDraw.SketchManager.CreateLine x1, y2, 0#, x1, y1, 0#

    swDraw.SketchManager.InsertSketch True

    DrawPrecutRectangleOnSheet = (Err.Number = 0)

    Err.Clear

    On Error GoTo 0

End Function

Function WritePrecutBoxDxf(swPart As Object, filePath As String, isSM As Boolean) As Boolean

    Dim flatFeat As Object

    Dim wasSupp As Boolean

    wasSupp = False

    If isSM Then

        Set flatFeat = FindFlatPatternFeat(swPart)

        If Not flatFeat Is Nothing Then

            wasSupp = flatFeat.IsSuppressed

            If wasSupp Then

                flatFeat.SetSuppression2 2, 2, Nothing

                swPart.EditRebuild3

            End If

        End If

    End If

    Dim t As Double

    Dim w As Double

    Dim longDim As Double

    If Not GetSortedBoxDimsMM(swPart, t, w, longDim) Then GoTo CleanFail

    Dim off As Double

    off = g_precutOffset_mm

    Dim width As Double

    Dim height As Double

    width = longDim + 2# * off

    height = w + 2# * off

    DeleteExistingFile filePath

    Dim ff As Integer

    ff = FreeFile

    On Error GoTo WriteFail

    Open filePath For Output As #ff

    Print #ff, "0"
    Print #ff, "SECTION"
    Print #ff, "2"
    Print #ff, "HEADER"
    Print #ff, "9"
    Print #ff, "$INSUNITS"
    Print #ff, "70"
    Print #ff, "4"
    Print #ff, "0"
    Print #ff, "ENDSEC"
    Print #ff, "0"
    Print #ff, "SECTION"
    Print #ff, "2"
    Print #ff, "ENTITIES"
    Print #ff, "0"
    Print #ff, "LWPOLYLINE"
    Print #ff, "8"
    Print #ff, "0"
    Print #ff, "90"
    Print #ff, "4"
    Print #ff, "70"
    Print #ff, "1"
    Print #ff, "10"
    Print #ff, "0"
    Print #ff, "20"
    Print #ff, "0"
    Print #ff, "10"
    Print #ff, DxfNumber(width)
    Print #ff, "20"
    Print #ff, "0"
    Print #ff, "10"
    Print #ff, DxfNumber(width)
    Print #ff, "20"
    Print #ff, DxfNumber(height)
    Print #ff, "10"
    Print #ff, "0"
    Print #ff, "20"
    Print #ff, DxfNumber(height)
    Print #ff, "0"
    Print #ff, "ENDSEC"
    Print #ff, "0"
    Print #ff, "EOF"

    Close #ff

    WritePrecutBoxDxf = (Dir(filePath) <> "")

    Debug.Print "      Box DXF saved=" & WritePrecutBoxDxf & " size=" & Round(width, 2) & "x" & Round(height, 2) & "mm"

CleanUp:

    If wasSupp Then

        flatFeat.SetSuppression2 0, 2, Nothing

        swPart.EditRebuild3

    End If

    Exit Function

WriteFail:

    On Error Resume Next

    Close #ff

    On Error GoTo 0

CleanFail:

    WritePrecutBoxDxf = False

    Debug.Print "      Box DXF failed"

    GoTo CleanUp

End Function

Function DxfNumber(v As Double) As String

    DxfNumber = Replace(CStr(Round(v, 4)), ",", ".")

End Function

' ================================================================

Function GetOuterEdgesInView(swView As Object) As Variant

    Dim vComps As Variant

    vComps = swView.GetVisibleComponents

    Dim isPart As Boolean

    isPart = IsEmpty(vComps)



    Dim compObj As Object

    If isPart Then

        Set compObj = Nothing

    Else

        Set compObj = vComps(0)

    End If



    Dim vEdges As Variant

    vEdges = swView.GetVisibleEntities2(compObj, 1)

    If IsEmpty(vEdges) Then

        GetOuterEdgesInView = Empty

        Exit Function

    End If



    Dim maxArea As Double

    maxArea = 0

    Dim maxFace As Object



    Dim i As Long

    For i = 0 To UBound(vEdges)

        Dim e As Object

        Set e = vEdges(i)

        On Error Resume Next

        Dim adjFaces As Variant

        adjFaces = e.GetTwoAdjacentFaces

        On Error GoTo 0

        If Not IsEmpty(adjFaces) Then

            Dim f As Long

            For f = 0 To 1

                If Not IsNull(adjFaces(f)) Then

                    Dim fc As Object

                    Set fc = adjFaces(f)

                    On Error Resume Next

                    Dim surf As Object

                    Set surf = fc.GetSurface

                    On Error GoTo 0

                    If Not surf Is Nothing Then

                        If surf.IsPlane Then

                            Dim a As Double

                            a = fc.GetArea

                            If a > maxArea Then

                                maxArea = a

                                Set maxFace = fc

                            End If

                        End If

                    End If

                End If

            Next f

        End If

    Next i



    If maxFace Is Nothing Then

        GetOuterEdgesInView = Empty

        Exit Function

    End If



    Dim loops As Variant

    loops = maxFace.GetLoops

    If IsEmpty(loops) Then

        GetOuterEdgesInView = Empty

        Exit Function

    End If



    Dim L As Long

    For L = 0 To UBound(loops)

        Dim lp As Object

        Set lp = loops(L)

        If lp.IsOuter Then

            Dim eds As Variant

            eds = lp.GetEdges

            If Not IsEmpty(eds) Then

                GetOuterEdgesInView = eds

                Exit Function

            End If

        End If

    Next L



    GetOuterEdgesInView = Empty

End Function



' ================================================================

Sub SelectAllSketchSegmentsInView(sketch As Object, selData As Object)

    Dim segs As Variant

    segs = sketch.GetSketchSegments

    If IsEmpty(segs) Then Exit Sub

    Dim i As Long

    For i = 0 To UBound(segs)

        Dim s As Object

        Set s = segs(i)

        On Error Resume Next

        s.Select4 True, selData

        On Error GoTo 0

    Next i

End Sub



Sub DeleteConstructionEntities(sketch As Object, swDoc As Object, selData As Object)

    Dim segs As Variant

    segs = sketch.GetSketchSegments

    If IsEmpty(segs) Then Exit Sub

    swDoc.ClearSelection2 True

    Dim cnt As Long

    cnt = 0

    Dim i As Long

    For i = 0 To UBound(segs)

        Dim s As Object

        Set s = segs(i)

        Dim isC As Boolean

        isC = False

        On Error Resume Next

        isC = s.ConstructionGeometry

        On Error GoTo 0

        If isC Then

            On Error Resume Next

            s.Select4 True, selData

            On Error GoTo 0

            cnt = cnt + 1

        End If

    Next i

    Debug.Print "      Deleting " & cnt & " construction entities"

    If cnt > 0 Then swDoc.EditDelete

End Sub



Function OffsetIsOutward(sketch As Object) As Boolean

    Dim segs As Variant

    segs = sketch.GetSketchSegments

    If IsEmpty(segs) Then

        OffsetIsOutward = False

        Exit Function

    End If



    Dim cMinX As Double, cMinY As Double, cMaxX As Double, cMaxY As Double

    Dim oMinX As Double, oMinY As Double, oMaxX As Double, oMaxY As Double

    cMinX = 1E+30

    cMinY = 1E+30

    cMaxX = -1E+30

    cMaxY = -1E+30

    oMinX = 1E+30

    oMinY = 1E+30

    oMaxX = -1E+30

    oMaxY = -1E+30



    Dim i As Long

    For i = 0 To UBound(segs)

        Dim s As Object

        Set s = segs(i)

        If Not s Is Nothing Then

            Dim isC As Boolean

            isC = False

            On Error Resume Next

            isC = s.ConstructionGeometry

            On Error GoTo 0

            Dim bx As Variant

            On Error Resume Next

            bx = s.GetEndPoints

            On Error GoTo 0

            If Not IsEmpty(bx) Then

                If isC Then

                    If bx(0) < cMinX Then cMinX = bx(0)

                    If bx(1) < cMinY Then cMinY = bx(1)

                    If bx(0) > cMaxX Then cMaxX = bx(0)

                    If bx(1) > cMaxY Then cMaxY = bx(1)

                    If bx(3) < cMinX Then cMinX = bx(3)

                    If bx(4) < cMinY Then cMinY = bx(4)

                    If bx(3) > cMaxX Then cMaxX = bx(3)

                    If bx(4) > cMaxY Then cMaxY = bx(4)

                Else

                    If bx(0) < oMinX Then oMinX = bx(0)

                    If bx(1) < oMinY Then oMinY = bx(1)

                    If bx(0) > oMaxX Then oMaxX = bx(0)

                    If bx(1) > oMaxY Then oMaxY = bx(1)

                    If bx(3) < oMinX Then oMinX = bx(3)

                    If bx(4) < oMinY Then oMinY = bx(4)

                    If bx(3) > oMaxX Then oMaxX = bx(3)

                    If bx(4) > oMaxY Then oMaxY = bx(4)

                End If

            End If

        End If

    Next i



    Dim cArea As Double

    cArea = (cMaxX - cMinX) * (cMaxY - cMinY)

    Dim oArea As Double

    oArea = (oMaxX - oMinX) * (oMaxY - oMinY)

    OffsetIsOutward = (oArea > cArea)

End Function



' ================================================================

Function PickBestViewName(swPart As Object) As String

    Dim box As Variant

    box = SafeGetPartBox(swPart)

    If IsEmpty(box) Then

        PickBestViewName = "*Front"

        Exit Function

    End If



    Dim x As Double

    Dim y As Double

    Dim z As Double

    x = Abs(box(3) - box(0))

    y = Abs(box(4) - box(1))

    z = Abs(box(5) - box(2))



    If x <= y And x <= z Then

        PickBestViewName = "*Right"

    ElseIf y <= x And y <= z Then

        PickBestViewName = "*Top"

    Else

        PickBestViewName = "*Front"

    End If

End Function



' ================================================================

'  SAFE BOUNDING BOX - tries GetPartBox, falls back to GetBodies+GetBodyBox

' ================================================================

Function SafeGetPartBox(swPart As Object) As Variant

    Dim box As Variant



    ' Try GetPartBox first

    On Error Resume Next

    box = swPart.GetPartBox(True)

    On Error GoTo 0



    If Not IsEmpty(box) Then

        SafeGetPartBox = box

        Exit Function

    End If



    Debug.Print "      GetPartBox failed, falling back to GetBodies..."



    ' Fallback: union of all body boxes

    Dim bodies As Variant

    On Error Resume Next

    bodies = swPart.GetBodies2(0, False)

    On Error GoTo 0

    If IsEmpty(bodies) Then

        On Error Resume Next

        bodies = swPart.GetBodies(0)

        On Error GoTo 0

    End If

    If IsEmpty(bodies) Then

        Debug.Print "      No bodies either"

        SafeGetPartBox = Empty

        Exit Function

    End If



    Dim minX As Double, minY As Double, minZ As Double

    Dim maxX As Double, maxY As Double, maxZ As Double

    minX = 1E+30

    minY = 1E+30

    minZ = 1E+30

    maxX = -1E+30

    maxY = -1E+30

    maxZ = -1E+30



    Dim i As Long

    For i = 0 To UBound(bodies)

        Dim b As Object

        Set b = bodies(i)

        If Not b Is Nothing Then

            Dim bb As Variant

            On Error Resume Next

            bb = b.GetBodyBox

            On Error GoTo 0

            If Not IsEmpty(bb) Then

                If bb(0) < minX Then minX = bb(0)

                If bb(1) < minY Then minY = bb(1)

                If bb(2) < minZ Then minZ = bb(2)

                If bb(3) > maxX Then maxX = bb(3)

                If bb(4) > maxY Then maxY = bb(4)

                If bb(5) > maxZ Then maxZ = bb(5)

            End If

        End If

    Next i



    If minX > 1E+29 Then

        SafeGetPartBox = Empty

        Exit Function

    End If



    Dim result(5) As Double

    result(0) = minX

    result(1) = minY

    result(2) = minZ

    result(3) = maxX

    result(4) = maxY

    result(5) = maxZ

    SafeGetPartBox = result

End Function



' ================================================================

Function FindFlatPatternFeat(swPart As Object) As Object

    Dim f As Object

    Set f = swPart.FirstFeature

    Do While Not f Is Nothing

        If f.GetTypeName2 = "FlatPattern" Then

            Set FindFlatPatternFeat = f

            Exit Function

        End If

        Set f = f.GetNextFeature

    Loop

End Function



Function IsSheetMetal(swPart As Object) As Boolean

    Dim f As Object

    Set f = swPart.FirstFeature

    Do While Not f Is Nothing

        If f.GetTypeName2 = "SheetMetal" Then

            IsSheetMetal = True

            Exit Function

        End If

        Set f = f.GetNextFeature

    Loop

End Function



Function IsSheetMetalSafe(swPart As Object) As Boolean

    IsSheetMetalSafe = IsSheetMetal(swPart)

    If Not IsSheetMetalSafe Then IsSheetMetalSafe = PartHasSheetMetalBody(swPart)

End Function

Function PartHasSheetMetalBody(swPart As Object) As Boolean

    Dim bodies As Variant

    bodies = GetPartBodies(swPart)

    If IsEmpty(bodies) Then Exit Function

    Dim i As Long

    For i = 0 To UBound(bodies)

        Dim b As Object

        Set b = bodies(i)

        If Not b Is Nothing Then

            On Error Resume Next

            PartHasSheetMetalBody = b.IsSheetMetal

            On Error GoTo 0

            If PartHasSheetMetalBody Then Exit Function

        End If

    Next i

End Function

Function GetSheetMetalThickness(swPart As Object) As Double
    Dim f As Object

    Set f = swPart.FirstFeature

    Do While Not f Is Nothing

        If f.GetTypeName2 = "SheetMetal" Then

            On Error Resume Next

            GetSheetMetalThickness = f.GetDefinition.thickness * 1000

            On Error GoTo 0

            If GetSheetMetalThickness <= 0 Then GetSheetMetalThickness = GetBoundingThickness(swPart)
            Exit Function

        End If

        Set f = f.GetNextFeature

    Loop

End Function



Function GetSheetMetalThicknessFallback(swPart As Object) As Double

    GetSheetMetalThicknessFallback = GetSheetMetalThickness(swPart)

    If GetSheetMetalThicknessFallback <= 0 Then GetSheetMetalThicknessFallback = GetBoundingThickness(swPart)

End Function

Function IsThinPlateLike(swPart As Object) As Boolean

    Dim t As Double

    Dim boxThickness As Double

    Dim w As Double

    Dim longDim As Double

    If Not GetSortedBoxDimsMM(swPart, boxThickness, w, longDim) Then Exit Function

    t = GetThinSolidThickness(swPart)

    If t <= 0# Then t = boxThickness

    Debug.Print "    Thin check dims mm: actual=" & Round(t, 2) & _
                " bbox=" & Round(boxThickness, 2) & " x " & _
                Round(w, 2) & " x " & Round(longDim, 2)

    If t > THICKNESS_LIMIT Then Exit Function

    If t <= 0 Then Exit Function

    IsThinPlateLike = (w >= t * THIN_PLATE_MIN_RATIO And longDim >= t * THIN_PLATE_MIN_RATIO)

    If Not IsThinPlateLike Then

        Debug.Print "    Rejected thin solid: needs other dimensions >= " & THIN_PLATE_MIN_RATIO & "x thickness"

        Exit Function

    End If

    If Not HasSheetLikePlanarFaces(swPart, w, longDim) Then

        Debug.Print "    Rejected thin solid: mostly curved/noodle-like surface"

        IsThinPlateLike = False

    End If

End Function

Function IsWasherLikeThinSolid(swPart As Object) As Boolean

    Dim t As Double

    Dim w As Double

    Dim longDim As Double

    If Not GetSortedBoxDimsMM(swPart, t, w, longDim) Then Exit Function

    If t <= 0# Or longDim <= 0# Or w <= 0# Then Exit Function

    Dim ratio As Double
    Dim aspect As Double
    ratio = longDim / t
    aspect = w / longDim

    ' Three criteria. A real washer is small, has a low long/thick ratio
    ' (relatively thick for its diameter), and has a roughly square/circular
    ' footprint (width close to longDim). Failing any one of these excludes
    ' the part from the washerlike bin.
    IsWasherLikeThinSolid = (longDim < WASHERLIKE_MAX_LONG_MM) _
                            And (ratio < WASHERLIKE_MAX_WIDTH_THICKNESS_RATIO) _
                            And (aspect >= WASHERLIKE_MIN_ASPECT)

End Function

Function EnsureSubFolder(parentFolder As String, subName As String) As String

    Dim baseFolder As String

    baseFolder = parentFolder

    If Right(baseFolder, 1) <> "\" Then baseFolder = baseFolder & "\"

    EnsureSubFolder = baseFolder & subName & "\"

    If Dir(EnsureSubFolder, vbDirectory) = "" Then MkDir EnsureSubFolder

End Function

Function HasSheetLikePlanarFaces(swPart As Object, midDimMm As Double, maxDimMm As Double) As Boolean

    Dim bodies As Variant

    bodies = GetPartBodies(swPart)

    If IsEmpty(bodies) Then Exit Function

    Dim totalArea As Double

    Dim planarArea As Double

    Dim largestPlanarArea As Double

    Dim planarCount As Long

    Dim bodyIndex As Long

    For bodyIndex = 0 To UBound(bodies)

        Dim b As Object

        Set b = bodies(bodyIndex)

        If Not b Is Nothing Then

            Dim faces As Variant

            On Error Resume Next

            faces = b.GetFaces

            On Error GoTo 0

            If Not IsEmpty(faces) Then

                Dim faceIndex As Long

                For faceIndex = 0 To UBound(faces)

                    Dim f As Object

                    Set f = faces(faceIndex)

                    If Not f Is Nothing Then

                        Dim area As Double

                        area = 0#

                        On Error Resume Next

                        area = f.GetArea

                        On Error GoTo 0

                        If area > 0# Then

                            totalArea = totalArea + area

                            If IsPlanarFace(f) Then

                                planarCount = planarCount + 1

                                planarArea = planarArea + area

                                If area > largestPlanarArea Then largestPlanarArea = area

                            End If

                        End If

                    End If

                Next faceIndex

            End If

        End If

    Next bodyIndex

    If totalArea <= 0# Then Exit Function

    Dim footprintArea As Double

    footprintArea = (midDimMm * maxDimMm) / 1000000#

    Dim planarRatio As Double

    planarRatio = planarArea / totalArea

    Debug.Print "    Planar face check: planar=" & Round(planarRatio * 100#, 1) & "% count=" & planarCount

    If planarCount < 2 Then Exit Function

    If planarRatio < MIN_PLANAR_AREA_RATIO Then Exit Function

    If footprintArea > 0# Then

        If largestPlanarArea < footprintArea * MIN_LARGEST_PLANAR_FOOTPRINT_RATIO Then Exit Function

    End If

    HasSheetLikePlanarFaces = True

End Function

Function GetSortedBoxDimsMM(swPart As Object, ByRef minDim As Double, ByRef midDim As Double, ByRef maxDim As Double) As Boolean

    Dim box As Variant

    box = SafeGetPartBox(swPart)

    If IsEmpty(box) Then Exit Function

    Dim a As Double

    Dim b As Double

    Dim c As Double

    a = Abs(box(3) - box(0)) * 1000#

    b = Abs(box(4) - box(1)) * 1000#

    c = Abs(box(5) - box(2)) * 1000#

    Dim tmp As Double

    If a > b Then

        tmp = a

        a = b

        b = tmp

    End If

    If b > c Then

        tmp = b

        b = c

        c = tmp

    End If

    If a > b Then

        tmp = a

        a = b

        b = tmp

    End If

    minDim = a

    midDim = b

    maxDim = c

    GetSortedBoxDimsMM = True

End Function

Function GetBoundingThickness(swPart As Object) As Double
    Dim box As Variant

    box = SafeGetPartBox(swPart)

    If IsEmpty(box) Then

        Debug.Print "    No bounding box, treat as thick"

        GetBoundingThickness = 9999

        Exit Function

    End If



    Dim x As Double

    Dim y As Double

    Dim z As Double

    x = Abs(box(3) - box(0)) * 1000

    y = Abs(box(4) - box(1)) * 1000

    z = Abs(box(5) - box(2)) * 1000



    GetBoundingThickness = x

    If y < GetBoundingThickness Then GetBoundingThickness = y

    If z < GetBoundingThickness Then GetBoundingThickness = z

End Function

' Reads a plane face's normal + a point on the plane via Surface.PlaneParams.
' PlaneParams returns (rootX, rootY, rootZ, normalX, normalY, normalZ) in
' some SW versions and (normalX, normalY, normalZ, rootX, rootY, rootZ) in
' others. We normalize the normal and pick the layout whose normal length
' is closer to 1.
Function TryGetPlaneNormalAndPoint(swFace As Object, outNorm() As Double, _
                                   outPoint() As Double) As Boolean

    TryGetPlaneNormalAndPoint = False

    If swFace Is Nothing Then Exit Function

    Dim surf As Object

    On Error Resume Next

    Set surf = swFace.GetSurface

    On Error GoTo 0

    If surf Is Nothing Then Exit Function

    If Not surf.IsPlane Then Exit Function

    Dim params As Variant

    params = Empty

    On Error Resume Next

    params = surf.PlaneParams

    On Error GoTo 0

    If IsEmpty(params) Then Exit Function

    If UBound(params) < 5 Then Exit Function



    Dim aLen As Double

    aLen = Sqr(params(0) * params(0) + params(1) * params(1) + params(2) * params(2))

    Dim bLen As Double

    bLen = Sqr(params(3) * params(3) + params(4) * params(4) + params(5) * params(5))



    If Abs(aLen - 1#) <= Abs(bLen - 1#) Then

        outNorm(0) = params(0)

        outNorm(1) = params(1)

        outNorm(2) = params(2)

        outPoint(0) = params(3)

        outPoint(1) = params(4)

        outPoint(2) = params(5)

    Else

        outNorm(0) = params(3)

        outNorm(1) = params(4)

        outNorm(2) = params(5)

        outPoint(0) = params(0)

        outPoint(1) = params(1)

        outPoint(2) = params(2)

    End If



    Dim nLen As Double

    nLen = Sqr(outNorm(0) * outNorm(0) + outNorm(1) * outNorm(1) + outNorm(2) * outNorm(2))

    If nLen <= 0.000001 Then Exit Function

    outNorm(0) = outNorm(0) / nLen

    outNorm(1) = outNorm(1) / nLen

    outNorm(2) = outNorm(2) / nLen



    ' Face2.FaceInSurfaceSense returns True when the face's outward normal is
    ' opposite to the surface normal. Flip so we always get the face normal.
    Dim flip As Boolean

    flip = False

    On Error Resume Next

    flip = CBool(swFace.FaceInSurfaceSense)

    On Error GoTo 0

    If flip Then

        outNorm(0) = -outNorm(0)

        outNorm(1) = -outNorm(1)

        outNorm(2) = -outNorm(2)

    End If



    TryGetPlaneNormalAndPoint = True

End Function

' Perpendicular distance from a point to the plane defined by (planeNorm, planePoint).
Function SignedPlaneDistance(planeNorm() As Double, planePoint() As Double, _
                             ByVal qx As Double, ByVal qy As Double, ByVal qz As Double) As Double

    SignedPlaneDistance = (qx - planePoint(0)) * planeNorm(0) _
                        + (qy - planePoint(1)) * planeNorm(1) _
                        + (qz - planePoint(2)) * planeNorm(2)

End Function

' Iterates all planar faces of a part. Returns the perpendicular span of the
' part along the largest-planar-face's normal. This is the true slab
' thickness of a thin solid, independent of how the part is oriented in
' world coords. Returns 0 if no usable planar face is found.
Function GetThicknessAlongLargestPlaneNormal(swPart As Object) As Double

    GetThicknessAlongLargestPlaneNormal = 0

    Dim faceMax As Object

    Set faceMax = FindLargestPlanarFace(swPart)

    If faceMax Is Nothing Then Exit Function

    Dim planeN(2) As Double

    Dim planeP(2) As Double

    If Not TryGetPlaneNormalAndPoint(faceMax, planeN, planeP) Then Exit Function



    Dim bodies As Variant

    bodies = GetPartBodies(swPart)

    If IsEmpty(bodies) Then Exit Function



    Dim minProj As Double

    Dim maxProj As Double

    Dim seen As Boolean

    seen = False

    minProj = 0

    maxProj = 0



    Dim bi As Long

    For bi = 0 To UBound(bodies)

        Dim b As Object

        Set b = bodies(bi)

        If b Is Nothing Then GoTo NextBody



        Dim faces As Variant

        faces = Empty

        On Error Resume Next

        faces = b.GetFaces

        On Error GoTo 0

        If IsEmpty(faces) Then GoTo NextBody



        Dim fi As Long

        For fi = 0 To UBound(faces)

            Dim f As Object

            Set f = faces(fi)

            If f Is Nothing Then GoTo NextFace



            Dim faceBox As Variant

            faceBox = Empty

            On Error Resume Next

            faceBox = f.GetBox

            On Error GoTo 0

            If IsEmpty(faceBox) Then GoTo NextFace

            If UBound(faceBox) < 5 Then GoTo NextFace



            ' Project all 8 face-box corners onto the plane normal.
            Dim cx As Long

            For cx = 0 To 1

                Dim cy As Long

                For cy = 0 To 1

                    Dim cz As Long

                    For cz = 0 To 1

                        Dim px As Double

                        Dim py As Double

                        Dim pz As Double

                        px = faceBox(IIf(cx = 0, 0, 3))

                        py = faceBox(IIf(cy = 0, 1, 4))

                        pz = faceBox(IIf(cz = 0, 2, 5))

                        Dim sd As Double

                        sd = SignedPlaneDistance(planeN, planeP, px, py, pz)

                        If Not seen Then

                            minProj = sd

                            maxProj = sd

                            seen = True

                        Else

                            If sd < minProj Then minProj = sd

                            If sd > maxProj Then maxProj = sd

                        End If

                    Next cz

                Next cy

            Next cx

NextFace:

        Next fi

NextBody:

    Next bi



    If Not seen Then Exit Function

    GetThicknessAlongLargestPlaneNormal = (maxProj - minProj) * 1000

End Function

' Public: pick the most reliable thickness for a thin solid part.
' Priority chain:
'   1) Vertex-based projection onto largest planar face normal (most
'      accurate -- uses actual body geometry, immune to chamfers).
'   2) Face-bbox projection (older method; can over-estimate by ~1 mm
'      for chamfered/curved parts because face-bboxes are axis-aligned).
'   3) World bounding box min-axis (last resort; orientation-dependent
'      and was the original source of the thickness-classification bug for axis-aligned
'      parts with features that extruded slightly past the main plate).
Function GetThinSolidThickness(swPart As Object) As Double

    Dim viaVerts As Double
    viaVerts = GetThicknessViaVertexProjection(swPart)

    Dim viaPlane As Double
    viaPlane = GetThicknessAlongLargestPlaneNormal(swPart)

    Dim viaBox As Double
    viaBox = GetBoundingThickness(swPart)

    If viaVerts > 0.001 Then

        GetThinSolidThickness = viaVerts

        Debug.Print "    thickness via vertex projection: " & viaVerts & " mm (face-bbox: " & viaPlane & " mm, world-bbox: " & viaBox & " mm)"

    ElseIf viaPlane > 0.001 Then

        GetThinSolidThickness = viaPlane

        Debug.Print "    thickness via plane normal (vertex method failed): " & viaPlane & " mm (bbox: " & viaBox & " mm)"

    Else

        GetThinSolidThickness = viaBox

        Debug.Print "    thickness via bbox fallback: " & viaBox & " mm"

    End If

End Function

' Vertex-based thickness: project EVERY vertex of every body in the part
' onto the normal of the largest planar face, then take max-min range.
' Unlike face-bbox projection, this uses real geometry -- chamfers and
' curved features don't inflate the result because we only measure where
' actual vertices live.
Function GetThicknessViaVertexProjection(swPart As Object) As Double

    GetThicknessViaVertexProjection = 0

    Dim faceMax As Object
    Set faceMax = FindLargestPlanarFace(swPart)
    If faceMax Is Nothing Then Exit Function

    Dim planeN(2) As Double
    Dim planeP(2) As Double
    If Not TryGetPlaneNormalAndPoint(faceMax, planeN, planeP) Then Exit Function

    Dim bodies As Variant
    bodies = GetPartBodies(swPart)
    If IsEmpty(bodies) Then Exit Function

    Dim minProj As Double
    Dim maxProj As Double
    Dim seen As Boolean
    seen = False
    minProj = 0
    maxProj = 0

    Dim bi As Long
    For bi = 0 To UBound(bodies)

        Dim b As Object
        Set b = bodies(bi)
        If b Is Nothing Then GoTo NextBody

        Dim edges As Variant
        edges = Empty
        On Error Resume Next
        edges = b.GetEdges
        On Error GoTo 0
        If IsEmpty(edges) Then GoTo NextBody

        Dim ei As Long
        For ei = 0 To UBound(edges)

            Dim ed As Object
            Set ed = edges(ei)
            If ed Is Nothing Then GoTo NextEdge

            ' Each edge has two endpoint vertices. GetStartVertex/GetEndVertex
            ' return Nothing for closed edges (full circles, etc.) - in that
            ' case the edge curve still bounds the body but we can't get
            ' vertices, so skip. Face-bbox fallback catches those parts.
            Dim startVtx As Object
            Dim endVtx As Object
            Set startVtx = Nothing
            Set endVtx = Nothing
            On Error Resume Next
            Set startVtx = ed.GetStartVertex
            Set endVtx = ed.GetEndVertex
            On Error GoTo 0

            ProjectVertexOntoPlane startVtx, planeN, planeP, minProj, maxProj, seen
            ProjectVertexOntoPlane endVtx, planeN, planeP, minProj, maxProj, seen

NextEdge:
        Next ei

NextBody:
    Next bi

    If Not seen Then Exit Function

    GetThicknessViaVertexProjection = (maxProj - minProj) * 1000

End Function

Sub ProjectVertexOntoPlane(vtx As Object, planeN() As Double, planeP() As Double, ByRef minProj As Double, ByRef maxProj As Double, ByRef seen As Boolean)

    If vtx Is Nothing Then Exit Sub

    Dim pt As Variant
    pt = Empty
    On Error Resume Next
    pt = vtx.GetPoint
    On Error GoTo 0

    If IsEmpty(pt) Then Exit Sub
    If UBound(pt) < 2 Then Exit Sub

    Dim sd As Double
    sd = SignedPlaneDistance(planeN, planeP, pt(0), pt(1), pt(2))

    If Not seen Then
        minProj = sd
        maxProj = sd
        seen = True
    Else
        If sd < minProj Then minProj = sd
        If sd > maxProj Then maxProj = sd
    End If

End Sub



Function FormatThickness(v As Double) As String

    ' Round to nearest whole millimeter, half goes up.
    '   12.0 -> 12   12.4 -> 12   12.5 -> 13   12.9 -> 13

    Dim n As Long

    If v <= 0 Then
        n = 0
    Else
        n = Int(v + 0.5)
    End If

    FormatThickness = CStr(n)

End Function
