Option Explicit

' ============================================================================
' CNCDXF_final_v1 - select one planar face on a part or assembly component, orient
' the owning part normal to that face, and export the complete projected part
' view to DXF with a 7mm registration circle at the DXF bounding-box centre.
' The output folder is chosen by the user every time the macro runs.
'
' Workflow:
'   1) Open an assembly in SOLIDWORKS.
'   2) Pre-select exactly one planar face on the part you want machined.
'   3) Run this macro.
'
' The selected face defines only the viewing direction. The DXF contains the
' complete projected part view, including visible radii and other geometry
' outside the selected face loop. The 7mm circle is added by parsing the DXF
' after SW writes it; no sketch is added to the part.
' ============================================================================

Const swDocPART As Long = 1
Const swDocASSEMBLY As Long = 2
Const swOpenDocOptions_Silent As Long = 1
Const swComponentLightweight As Long = 1
Const swComponentFullyResolved As Long = 2
Const swComponentResolved As Long = 3
Const swComponentFullyLightweight As Long = 4

Const swSelFACES As Long = 2
Const swExportToDWG_ExportSelectedFacesOrLoops As Long = 2
Const swExportToDWG_ExportAnnotationViews As Long = 3

Const REG_CIRCLE_DIAMETER_MM As Double = 7#
Const MOVEFILE_REPLACE_EXISTING As Long = &H1
Const MOVEFILE_WRITE_THROUGH As Long = &H8

' Excelsis Helper synchronizes these legacy values from Settings. CNCDXF now
' always asks for its output folder at run time; these constants remain so an
' installed older Helper can still synchronize the macro without warnings.
Const OUTPUT_ROOT As String = "C:\CAM"
Const PROJECT_PREFIXES As String = ""
Const PROJECT_ROOT_NAMES As String = "CompanyProjects;ToolingProjects"

' ============================================================================

Dim swApp As Object

#If VBA7 Then
Private Declare PtrSafe Function ExcelsisGetCurrentProcessId Lib "kernel32" Alias "GetCurrentProcessId" () As Long
Private Declare PtrSafe Function ReplaceFileW Lib "kernel32" ( _
    ByVal replacedFileName As LongPtr, ByVal replacementFileName As LongPtr, _
    ByVal backupFileName As LongPtr, ByVal replaceFlags As Long, _
    ByVal excludeInfo As LongPtr, ByVal reserved As LongPtr) As Long
Private Declare PtrSafe Function MoveFileExW Lib "kernel32" ( _
    ByVal existingFileName As LongPtr, ByVal newFileName As LongPtr, _
    ByVal moveFlags As Long) As Long
#Else
Private Declare Function ExcelsisGetCurrentProcessId Lib "kernel32" Alias "GetCurrentProcessId" () As Long
Private Declare Function ReplaceFileW Lib "kernel32" ( _
    ByVal replacedFileName As Long, ByVal replacementFileName As Long, _
    ByVal backupFileName As Long, ByVal replaceFlags As Long, _
    ByVal excludeInfo As Long, ByVal reserved As Long) As Long
Private Declare Function MoveFileExW Lib "kernel32" ( _
    ByVal existingFileName As Long, ByVal newFileName As Long, _
    ByVal moveFlags As Long) As Long
#End If

Private gExcelsisMacroMarkerOwned As Boolean
Private gExcelsisMacroMarkerPayload As String
Private gExcelsisMacroSettingsLoaded As Boolean
Private gExcelsisMacroSettingsJson As String

Private Function ExcelsisMacroRoot() As String
    ExcelsisMacroRoot = CreateObject("WScript.Shell").SpecialFolders("MyDocuments") & "\Excelsis Helper"
End Function

Private Function ExcelsisReadUtf8Text(ByVal filePath As String) As String
    Dim stream As Object
    Dim fileNo As Integer
    Dim byteCount As Long
    Dim rawText As String
    On Error GoTo BinaryFallback
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 2
    stream.Charset = "utf-8"
    stream.Open
    stream.LoadFromFile filePath
    ExcelsisReadUtf8Text = stream.ReadText(-1)
    stream.Close
    Exit Function
BinaryFallback:
    On Error Resume Next
    If Not stream Is Nothing Then stream.Close
    fileNo = FreeFile
    Open filePath For Binary Access Read As #fileNo
    byteCount = LOF(fileNo)
    If byteCount > 0 Then
        rawText = Space$(byteCount)
        Get #fileNo, , rawText
        ExcelsisReadUtf8Text = rawText
    End If
    Close #fileNo
    On Error GoTo 0
End Function

Private Function ExcelsisJsonStringValue(ByVal jsonText As String, ByVal settingName As String, ByVal fallbackValue As String) As String
    Dim keyPos As Long
    Dim colonPos As Long
    Dim quotePos As Long
    Dim pos As Long
    Dim ch As String
    Dim escapedChar As String
    Dim value As String
    On Error GoTo UseFallback
    keyPos = InStr(1, jsonText, """" & settingName & """", vbTextCompare)
    If keyPos = 0 Then GoTo UseFallback
    colonPos = InStr(keyPos + Len(settingName) + 2, jsonText, ":")
    If colonPos = 0 Then GoTo UseFallback
    quotePos = InStr(colonPos + 1, jsonText, """")
    If quotePos = 0 Then GoTo UseFallback
    pos = quotePos + 1
    Do While pos <= Len(jsonText)
        ch = Mid$(jsonText, pos, 1)
        If ch = """" Then
            ExcelsisJsonStringValue = value
            Exit Function
        End If
        If ch = "\" Then
            pos = pos + 1
            If pos > Len(jsonText) Then GoTo UseFallback
            escapedChar = Mid$(jsonText, pos, 1)
            Select Case escapedChar
                Case """", "\", "/": value = value & escapedChar
                Case "b": value = value & Chr$(8)
                Case "f": value = value & Chr$(12)
                Case "n": value = value & vbLf
                Case "r": value = value & vbCr
                Case "t": value = value & vbTab
                Case Else: value = value & escapedChar
            End Select
        Else
            value = value & ch
        End If
        pos = pos + 1
    Loop
UseFallback:
    ExcelsisJsonStringValue = fallbackValue
End Function

Private Function ExcelsisMacroSetting(ByVal settingName As String, ByVal fallbackValue As String) As String
    If Not gExcelsisMacroSettingsLoaded Then
        gExcelsisMacroSettingsLoaded = True
        gExcelsisMacroSettingsJson = ExcelsisReadUtf8Text(ExcelsisMacroRoot() & "\Macros\macro-settings.json")
    End If
    ExcelsisMacroSetting = ExcelsisJsonStringValue(gExcelsisMacroSettingsJson, settingName, fallbackValue)
End Function

Private Function ConfiguredProjectPrefixes() As String
    ConfiguredProjectPrefixes = ExcelsisMacroSetting("projectCodePrefixesText", PROJECT_PREFIXES)
End Function

Private Function ConfiguredProjectRootNames() As String
    ConfiguredProjectRootNames = ExcelsisMacroSetting("projectRootNamesText", PROJECT_ROOT_NAMES)
End Function

Private Sub ExcelsisStartMacroRunMarker()
    Dim fso As Object
    Dim markerFile As Object
    Dim root As String
    On Error GoTo Failed
    root = ExcelsisMacroRoot()
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FolderExists(root) Then fso.CreateFolder root
    gExcelsisMacroMarkerPayload = "{""schema"":""excelsis-helper-macro-run-v1"",""pid"":" & _
        CStr(ExcelsisGetCurrentProcessId()) & ",""startedAt"":""" & _
        Format$(Now, "yyyy-mm-dd\Thh:nn:ss") & """,""macroName"":""CNCDXF_final_v1.swp""}"
    Set markerFile = fso.CreateTextFile(root & "\macro-running.json", True, False)
    markerFile.Write gExcelsisMacroMarkerPayload
    markerFile.Close
    gExcelsisMacroMarkerOwned = True
    Exit Sub
Failed:
    gExcelsisMacroMarkerOwned = False
End Sub

Private Sub ExcelsisStopMacroRunMarker()
    Dim fso As Object
    Dim markerFile As Object
    Dim markerPath As String
    Dim currentPayload As String
    If Not gExcelsisMacroMarkerOwned Then Exit Sub
    gExcelsisMacroMarkerOwned = False
    On Error GoTo Done
    markerPath = ExcelsisMacroRoot() & "\macro-running.json"
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FileExists(markerPath) Then Exit Sub
    Set markerFile = fso.OpenTextFile(markerPath, 1, False)
    currentPayload = markerFile.ReadAll
    markerFile.Close
    If currentPayload = gExcelsisMacroMarkerPayload Then fso.DeleteFile markerPath, True
Done:
End Sub

Sub main()
    Dim errorNumber As Long
    Dim errorSource As String
    Dim errorDescription As String
    Dim errorHelpFile As String
    Dim errorHelpContext As Long
    On Error GoTo MacroFailed
    ExcelsisStartMacroRunMarker
    ExcelsisMacroMain
    ExcelsisStopMacroRunMarker
    Exit Sub
MacroFailed:
    errorNumber = Err.Number
    errorSource = Err.Source
    errorDescription = Err.Description
    errorHelpFile = Err.HelpFile
    errorHelpContext = Err.HelpContext
    On Error Resume Next
    ExcelsisStopMacroRunMarker
    On Error GoTo 0
    Err.Raise errorNumber, errorSource, errorDescription, errorHelpFile, errorHelpContext
End Sub

Private Sub ExcelsisMacroMain()

    Dim originalDoc As Object
    Dim selectedOwnerForRestore As Object
    Dim componentForRestore As Object
    Dim dictInitiallyVisibleDocumentWindows As Object
    Dim dictWindowsToPreserve As Object
    Dim originalComponentSuppression As Long
    Dim componentSuppressionChanged As Boolean
    Dim originalOwnerConfig As String
    Dim ownerConfigCaptured As Boolean
    Dim cleanupReady As Boolean
    Dim pendingTempPath As String
    Dim runFailureMessage As String
    Dim cleanupWarnings As String
    Dim finalSummary As String
    Dim finalSummaryStyle As VbMsgBoxStyle
    Dim showFinalSummary As Boolean

    originalComponentSuppression = -1
    On Error GoTo RunFailed

    Set swApp = Application.SldWorks

    Dim swModel As Object
    Set swModel = swApp.ActiveDoc
    If swModel Is Nothing Then
        MsgBox "Open an assembly (or part) first.", vbExclamation, "CNCDXF"
        Exit Sub
    End If

    Dim mType As Long
    mType = swModel.GetType

    Set originalDoc = swModel

    If mType <> swDocASSEMBLY And mType <> swDocPART Then
        MsgBox "Active document must be an assembly or part.", vbExclamation, "CNCDXF"
        Exit Sub
    End If

    Dim selMgr As Object
    Set selMgr = swModel.SelectionManager
    If selMgr Is Nothing Then
        MsgBox "Could not access SelectionManager.", vbCritical, "CNCDXF"
        Exit Sub
    End If

    Dim selCount As Long
    selCount = selMgr.GetSelectedObjectCount2(-1)
    If selCount <> 1 Then
        MsgBox "Select exactly one planar face on one part first.", _
               vbExclamation, "CNCDXF"
        Exit Sub
    End If

    Set dictInitiallyVisibleDocumentWindows = BuildVisibleDocumentWindowKeyDict()
    If dictInitiallyVisibleDocumentWindows Is Nothing Then
        MsgBox "Could not capture the current SOLIDWORKS document windows." & vbCrLf & _
               "Nothing was changed so no unrelated window can be closed.", _
               vbExclamation, "CNCDXF"
        Exit Sub
    End If

    Set dictWindowsToPreserve = CreateObject("Scripting.Dictionary")
    cleanupReady = True

    ' Collect (component, face) pairs from the selection. For part docs
    ' there's no component - we wrap the part itself.
    Dim selections As Collection
    Set selections = New Collection

    Dim i As Long
    For i = 1 To selCount

        Dim selType As Long
        selType = selMgr.GetSelectedObjectType3(i, -1)
        If selType <> swSelFACES Then
            Debug.Print "  selection " & i & " is not a face (type=" & selType & ") - skipped"
            GoTo NextSel
        End If

        Dim swFace As Object
        Set swFace = selMgr.GetSelectedObject6(i, -1)
        If swFace Is Nothing Then GoTo NextSel

        If Not IsPlanarFace(swFace) Then
            MsgBox "The selected face is not planar. Select one flat face and run CNCDXF again.", _
                   vbExclamation, "CNCDXF"
            Exit Sub
        End If

        Dim swComp As Object
        Set swComp = Nothing
        On Error Resume Next
        Set swComp = selMgr.GetSelectedObjectsComponent4(i, -1)
        If swComp Is Nothing Then Set swComp = selMgr.GetSelectedObjectsComponent4(i, 0)
        If swComp Is Nothing Then Set swComp = swFace.GetComponent
        On Error GoTo RunFailed

        Dim faceOwnerDoc As Object
        Set faceOwnerDoc = Nothing

        Dim exportFace As Object
        Set exportFace = swFace

        Dim assemblyFaceRef As Variant
        assemblyFaceRef = Empty
        If mType = swDocASSEMBLY Then
            On Error Resume Next
            assemblyFaceRef = swModel.Extension.GetPersistReference3(swFace)
            On Error GoTo RunFailed
        End If

        If mType = swDocPART Then
            Set faceOwnerDoc = swModel
        Else
            If swComp Is Nothing Then
                runFailureMessage = "Could not identify the component that owns the selected face."
                GoTo RunCleanup
            End If

            Set componentForRestore = swComp
            Set faceOwnerDoc = GetOrOpenComponentPart(swModel, swComp, _
                originalComponentSuppression, componentSuppressionChanged)

            If faceOwnerDoc Is Nothing Then
                runFailureMessage = "Could not resolve or open the selected component's part." & vbCrLf & _
                                    "Check that the component references a saved SLDPRT file and try again."
                GoTo RunCleanup
            End If

            If faceOwnerDoc.GetType <> swDocPART Then
                runFailureMessage = "The selected face must belong directly to a part, not a subassembly."
                GoTo RunCleanup
            End If

        End If

        Set selectedOwnerForRestore = faceOwnerDoc
        originalOwnerConfig = GetActiveConfigName(faceOwnerDoc)
        ownerConfigCaptured = (Len(originalOwnerConfig) > 0)
        If Not ownerConfigCaptured Then
            runFailureMessage = "Could not read the selected part's active configuration."
            PreserveModelWindow dictWindowsToPreserve, faceOwnerDoc
            GoTo RunCleanup
        End If

        Dim selectedConfigName As String
        selectedConfigName = originalOwnerConfig
        If Not swComp Is Nothing Then
            On Error Resume Next
            selectedConfigName = CStr(swComp.ReferencedConfiguration)
            On Error GoTo RunFailed
        End If

        If Len(selectedConfigName) > 0 Then
            If Not ActivateConfigurationChecked(faceOwnerDoc, selectedConfigName) Then
                runFailureMessage = "Could not activate the selected component configuration: " & _
                                    selectedConfigName
                PreserveModelWindow dictWindowsToPreserve, faceOwnerDoc
                GoTo RunCleanup
            End If
        End If

        If mType = swDocASSEMBLY Then
            ' Resolving a lightweight component can replace its assembly-context
            ' face object. Reacquire the same face from its persistent reference
            ' after resolving and switching configuration, before mapping it.
            If Not IsEmpty(assemblyFaceRef) Then
                Dim persistErr As Long
                Dim refreshedFace As Object
                Set refreshedFace = Nothing
                On Error Resume Next
                Set refreshedFace = swModel.Extension.GetObjectByPersistReference3(assemblyFaceRef, persistErr)
                On Error GoTo RunFailed
                If Not refreshedFace Is Nothing Then Set swFace = refreshedFace
            End If

            Set exportFace = GetCorrespondingPartFace(faceOwnerDoc, swFace)
            If exportFace Is Nothing Then
                runFailureMessage = "Could not map the assembly face into the owning part. Resolve the " & _
                                    "component and select the face again."
                GoTo RunCleanup
            End If
        End If

        Dim entry As Object
        Set entry = CreateObject("Scripting.Dictionary")
        entry.Add "face", exportFace
        entry.Add "component", swComp
        entry.Add "ownerDoc", faceOwnerDoc
        entry.Add "config", selectedConfigName

        selections.Add entry

NextSel:
    Next i

    If selections.Count = 0 Then
        runFailureMessage = "No planar face was selected. Pre-select one face and run again."
        GoTo RunCleanup
    End If

    Dim selectedOwner As Object
    Set selectedOwner = selections(1)("ownerDoc")

    Dim selectedPartPath As String
    selectedPartPath = selectedOwner.GetPathName
    If Len(selectedPartPath) = 0 Then
        runFailureMessage = "Save the selected part before running CNCDXF."
        GoTo RunCleanup
    End If

    Dim outFolder As String
    outFolder = BrowseForOutputFolder(PathFileNameNoExt(selectedPartPath) & ".dxf")
    If Len(outFolder) = 0 Then GoTo RunCleanup

    outFolder = EnsureTrailingBackslash(outFolder)
    If Not EnsureFolder(outFolder) Then
        runFailureMessage = "Could not access the selected output folder:" & vbCrLf & outFolder
        GoTo RunCleanup
    End If

    Debug.Print "CNCDXF output folder: " & outFolder

    Dim okCount As Long
    Dim failCount As Long
    Dim skippedDupes As Long
    okCount = 0
    failCount = 0
    skippedDupes = 0

    Dim failures As String
    failures = ""

    ' Dedupe: rule is 1 face per part. If the same part file appears
    ' more than once in the selection (e.g. faces picked on two
    ' instances of the same component), we export the FIRST face we
    ' saw and skip the rest. Two faces on the same part but DIFFERENT
    ' (i.e. user broke the rule) also collapses to the first - they
    ' get a clear log entry showing what was skipped.
    Dim processedPartPaths As Object
    Set processedPartPaths = CreateObject("Scripting.Dictionary")

    Dim s As Long
    For s = 1 To selections.Count

        Dim sel As Object
        Set sel = selections(s)

        Dim ownerDoc As Object
        Set ownerDoc = sel("ownerDoc")
        Dim face As Object
        Set face = sel("face")
        Dim comp As Object
        Set comp = sel("component")

        If ownerDoc Is Nothing Then
            Debug.Print "  [" & s & "] no owner doc - skipping"
            failCount = failCount + 1
            failures = failures & "  - face #" & s & ": no owner part" & vbCrLf
            GoTo NextSelection
        End If

        Dim partPath As String
        partPath = ownerDoc.GetPathName
        If Len(partPath) = 0 Then
            Debug.Print "  [" & s & "] owner doc not saved - skipping"
            failCount = failCount + 1
            failures = failures & "  - face #" & s & ": owner part not saved" & vbCrLf
            GoTo NextSelection
        End If

        ' Dedupe by part file: one face per part = one DXF per part.
        ' Second+ selection on the same part file is a no-op.
        Dim partKey As String
        partKey = LCase$(partPath)
        If processedPartPaths.Exists(partKey) Then
            Debug.Print "  [" & s & "] " & PathFileName(partPath) & " already exported - skipping duplicate selection"
            skippedDupes = skippedDupes + 1
            GoTo NextSelection
        End If
        processedPartPaths.Add partKey, True

        Dim cfgName As String
        cfgName = CStr(sel("config"))
        If Len(cfgName) = 0 Then cfgName = GetActiveConfigName(ownerDoc)

        Dim outPath As String
        outPath = BuildDxfPath(outFolder, partPath, cfgName, s)
        Debug.Print "[" & s & "] export -> " & outPath

        pendingTempPath = BuildTemporaryDxfPath(outPath)
        If Len(pendingTempPath) = 0 Then
            failCount = failCount + 1
            failures = failures & "  - " & PathFileName(partPath) & _
                       ": could not allocate a temporary DXF" & vbCrLf
            GoTo NextSelection
        End If

        ' Activate the part before selecting its corresponding face. The face
        ' sets the Normal To direction; the complete *Current projected view
        ' is then exported rather than only the selected face loop.
        Dim activateErrs As Long
        activateErrs = 0
        Dim activatedDoc As Object
        Set activatedDoc = Nothing
        On Error Resume Next
        Set activatedDoc = swApp.ActivateDoc3(partPath, True, 1, activateErrs)
        On Error GoTo RunFailed

        If activatedDoc Is Nothing Then
            Debug.Print "  could not activate owner part; error=" & activateErrs
            failCount = failCount + 1
            failures = failures & "  - " & PathFileName(partPath) & ": could not activate part" & vbCrLf
            GoTo NextSelection
        End If

        Dim exportOk As Boolean
        Dim viewRestoreFailed As Boolean
        exportOk = ExportNormalViewToDxf(ownerDoc, face, pendingTempPath, viewRestoreFailed)

        If Not exportOk Then
            Debug.Print "  export failed"
            failCount = failCount + 1
            If viewRestoreFailed Then
                failures = failures & "  - " & PathFileName(partPath) & _
                           ": export canceled because the original view could not be restored" & vbCrLf
                PreserveModelWindow dictWindowsToPreserve, ownerDoc
            Else
                failures = failures & "  - " & PathFileName(partPath) & _
                           " (face " & s & "): export failed" & vbCrLf
            End If
            GoTo NextSelection
        End If

        Dim stampOk As Boolean
        stampOk = StampRegistrationCircle(pendingTempPath, REG_CIRCLE_DIAMETER_MM / 2#)
        If Not stampOk Then
            Debug.Print "  registration-circle stamp failed; existing target preserved"
            failCount = failCount + 1
            failures = failures & "  - " & PathFileName(outPath) & _
                       ": registration-circle stamp failed" & vbCrLf
            GoTo NextSelection
        End If

        If Not ValidateStampedDxfFile(pendingTempPath, REG_CIRCLE_DIAMETER_MM / 2#) Then
            Debug.Print "  stamped DXF validation failed; existing target preserved"
            failCount = failCount + 1
            failures = failures & "  - " & PathFileName(outPath) & _
                       ": stamped DXF validation failed" & vbCrLf
            GoTo NextSelection
        End If

        If Not CommitTemporaryDxf(pendingTempPath, outPath) Then
            Debug.Print "  atomic DXF replacement failed; existing target preserved"
            failCount = failCount + 1
            failures = failures & "  - " & PathFileName(outPath) & _
                       ": could not replace the final DXF" & vbCrLf
            GoTo NextSelection
        End If

        pendingTempPath = ""
        okCount = okCount + 1

NextSelection:
    Next s

    finalSummary = "CNCDXF done." & vbCrLf & _
                   "  Exported: " & okCount & vbCrLf & _
                   "  Failed:   " & failCount
    If skippedDupes > 0 Then
        finalSummary = finalSummary & vbCrLf & _
                       "  Skipped:  " & skippedDupes & " (extra faces on parts already exported)"
    End If
    finalSummary = finalSummary & vbCrLf & "  Output:   " & outFolder
    If Len(failures) > 0 Then
        finalSummary = finalSummary & vbCrLf & vbCrLf & "Failures:" & vbCrLf & failures
    End If
    finalSummaryStyle = IIf(failCount = 0, vbInformation, vbExclamation)
    showFinalSummary = True
    GoTo RunCleanup

RunFailed:
    runFailureMessage = "CNCDXF failed: " & CStr(Err.Number) & " - " & Err.Description
    Err.Clear

RunCleanup:
    On Error Resume Next

    If Len(pendingTempPath) > 0 Then DeleteExistingFile pendingTempPath

    If ownerConfigCaptured And Not selectedOwnerForRestore Is Nothing Then
        If Not RestoreConfigurationChecked(selectedOwnerForRestore, originalOwnerConfig) Then
            cleanupWarnings = cleanupWarnings & _
                "Could not restore part configuration " & originalOwnerConfig & "." & vbCrLf
            PreserveModelWindow dictWindowsToPreserve, selectedOwnerForRestore
        End If
    End If

    ActivateModelDocument originalDoc

    If componentSuppressionChanged And Not componentForRestore Is Nothing Then
        Dim restoreSuppressionStatus As Long
        Err.Clear
        restoreSuppressionStatus = componentForRestore.SetSuppression2(originalComponentSuppression)
        If Err.Number <> 0 Or componentForRestore.GetSuppression2 <> originalComponentSuppression Then
            cleanupWarnings = cleanupWarnings & _
                "Could not restore the selected component's suppression state." & vbCrLf
            Err.Clear
        End If
    End If

    If cleanupReady Then
        CloseVisibleDocumentsOpenedByMacro dictInitiallyVisibleDocumentWindows, originalDoc, _
                                           dictWindowsToPreserve
    End If
    ActivateModelDocument originalDoc
    On Error GoTo 0

    If Len(cleanupWarnings) > 0 Then
        If Len(runFailureMessage) > 0 Then
            runFailureMessage = runFailureMessage & vbCrLf & vbCrLf & cleanupWarnings
        ElseIf showFinalSummary Then
            finalSummary = finalSummary & vbCrLf & vbCrLf & cleanupWarnings
            finalSummaryStyle = vbExclamation
        Else
            MsgBox cleanupWarnings, vbExclamation, "CNCDXF"
        End If
    End If

    If Len(runFailureMessage) > 0 Then
        MsgBox runFailureMessage, vbExclamation, "CNCDXF"
    ElseIf showFinalSummary Then
        Debug.Print finalSummary
        MsgBox finalSummary, finalSummaryStyle, "CNCDXF"
    End If

End Sub

' ============================================================================
' DXF EXPORT
' ============================================================================

' Returns the selected component's part document without requiring the user to
' resolve lightweight components manually. Prefer an already loaded document;
' then resolve only this component; finally use the saved component path and the
' same silent OpenDoc6 route already proven by DXF_v16.
Function GetOrOpenComponentPart(assemblyDoc As Object, component As Object, _
                                ByRef originalSuppressionState As Long, _
                                ByRef suppressionChanged As Boolean) As Object

    Set GetOrOpenComponentPart = Nothing
    originalSuppressionState = -1
    suppressionChanged = False
    If assemblyDoc Is Nothing Or component Is Nothing Then Exit Function

    On Error Resume Next
    originalSuppressionState = component.GetSuppression2
    On Error GoTo 0

    Dim partDoc As Object
    Set partDoc = Nothing

    On Error Resume Next
    Set partDoc = component.GetModelDoc2
    On Error GoTo 0

    If partDoc Is Nothing Then
        Debug.Print "CNCDXF component suppression state: " & originalSuppressionState

        If originalSuppressionState = swComponentLightweight Or _
           originalSuppressionState = swComponentFullyLightweight Then
            Dim resolveStatus As Long
            resolveStatus = -1
            On Error Resume Next
            resolveStatus = component.SetSuppression2(swComponentResolved)
            On Error GoTo 0
            Debug.Print "CNCDXF component resolve status: " & resolveStatus

            On Error Resume Next
            Set partDoc = component.GetModelDoc2
            On Error GoTo 0
            suppressionChanged = Not partDoc Is Nothing
        End If
    End If

    Dim partPath As String
    partPath = ""
    On Error Resume Next
    partPath = CStr(component.GetPathName)
    On Error GoTo 0
    Debug.Print "CNCDXF component path: " & partPath

    If partDoc Is Nothing And Len(partPath) > 0 Then
        If LCase$(Right$(partPath, 7)) = ".sldprt" Then
            On Error Resume Next
            Set partDoc = swApp.GetOpenDocumentByName(partPath)
            On Error GoTo 0

            If partDoc Is Nothing Then
                Dim openErrors As Long
                Dim openWarnings As Long
                On Error Resume Next
                Set partDoc = swApp.OpenDoc6(partPath, swDocPART, _
                    swOpenDocOptions_Silent, "", openErrors, openWarnings)
                On Error GoTo 0
                Debug.Print "CNCDXF OpenDoc6 errors=" & openErrors & _
                            " warnings=" & openWarnings
            End If
        End If
    End If

    If partDoc Is Nothing Then Exit Function
    If partDoc.GetType <> swDocPART Then Exit Function

    Set GetOrOpenComponentPart = partDoc

End Function

Function ActivateConfigurationChecked(swModel As Object, configName As String) As Boolean

    ActivateConfigurationChecked = False
    If swModel Is Nothing Then Exit Function
    If Len(configName) = 0 Then
        ActivateConfigurationChecked = True
        Exit Function
    End If

    If StrComp(GetActiveConfigName(swModel), configName, vbTextCompare) = 0 Then
        ActivateConfigurationChecked = True
        Exit Function
    End If

    On Error Resume Next
    Err.Clear
    ActivateConfigurationChecked = CBool(swModel.ShowConfiguration2(configName))
    If Err.Number <> 0 Then
        Err.Clear
        ActivateConfigurationChecked = False
    End If
    On Error GoTo 0

    If ActivateConfigurationChecked Then
        ActivateConfigurationChecked = _
            (StrComp(GetActiveConfigName(swModel), configName, vbTextCompare) = 0)
    End If

End Function

Function RestoreConfigurationChecked(swModel As Object, configName As String) As Boolean

    RestoreConfigurationChecked = ActivateConfigurationChecked(swModel, configName)

End Function

Function GetDocumentWindowKey(swDoc As Object) As String

    If swDoc Is Nothing Then Exit Function

    Dim docType As Long
    Dim pathName As String
    Dim title As String
    On Error Resume Next
    docType = swDoc.GetType
    pathName = swDoc.GetPathName
    title = swDoc.GetTitle
    On Error GoTo 0

    If pathName <> "" Then
        GetDocumentWindowKey = "path|" & CStr(docType) & "|" & LCase$(pathName)
    ElseIf title <> "" Then
        GetDocumentWindowKey = "title|" & CStr(docType) & "|" & LCase$(title)
    End If

End Function

Function GetModelWindowDocuments(ByRef snapshotOk As Boolean) As Collection

    snapshotOk = False

    Dim docs As Collection
    Set docs = New Collection
    On Error GoTo SnapshotFailed

    Dim swFrame As Object
    Set swFrame = swApp.Frame
    If swFrame Is Nothing Then GoTo SnapshotFailed

    Dim modelWindows As Variant
    modelWindows = swFrame.ModelWindows
    If Not IsArray(modelWindows) Then GoTo SnapshotFailed

    Dim windowObject As Variant
    For Each windowObject In modelWindows
        Dim swModelWindow As Object
        Dim swDoc As Object
        Set swModelWindow = windowObject
        If Not swModelWindow Is Nothing Then Set swDoc = swModelWindow.ModelDoc
        If Not swDoc Is Nothing Then docs.Add swDoc
    Next windowObject

    snapshotOk = True
    Set GetModelWindowDocuments = docs
    Exit Function

SnapshotFailed:
    Debug.Print "Model-window snapshot error " & Err.Number & ": " & Err.Description
    Err.Clear
    Set GetModelWindowDocuments = Nothing

End Function

Function BuildVisibleDocumentWindowKeyDict() As Object

    Dim snapshotOk As Boolean
    Dim modelDocs As Collection
    Set modelDocs = GetModelWindowDocuments(snapshotOk)
    If Not snapshotOk Or modelDocs Is Nothing Then
        Set BuildVisibleDocumentWindowKeyDict = Nothing
        Exit Function
    End If

    Dim dict As Object
    Set dict = CreateObject("Scripting.Dictionary")

    Dim swDoc As Object
    Dim i As Long
    For i = 1 To modelDocs.Count
        Set swDoc = modelDocs(i)
        Dim windowKey As String
        windowKey = GetDocumentWindowKey(swDoc)
        If windowKey <> "" Then
            If Not dict.Exists(windowKey) Then dict.Add windowKey, True
        End If
    Next i

    Set BuildVisibleDocumentWindowKeyDict = dict

End Function

Function ModelDocumentsAreSame(leftDoc As Object, rightDoc As Object) As Boolean

    If leftDoc Is Nothing Or rightDoc Is Nothing Then Exit Function

    On Error Resume Next
    If leftDoc Is rightDoc Then
        ModelDocumentsAreSame = True
        On Error GoTo 0
        Exit Function
    End If

    Dim leftPath As String
    Dim rightPath As String
    leftPath = leftDoc.GetPathName
    rightPath = rightDoc.GetPathName

    If leftPath <> "" And rightPath <> "" Then
        ModelDocumentsAreSame = (StrComp(leftPath, rightPath, vbTextCompare) = 0)
    Else
        ModelDocumentsAreSame = (leftDoc.GetType = rightDoc.GetType And _
                                 StrComp(leftDoc.GetTitle, rightDoc.GetTitle, _
                                         vbTextCompare) = 0)
    End If
    On Error GoTo 0

End Function

Function GetDocumentActivationName(swDoc As Object) As String

    If swDoc Is Nothing Then Exit Function

    Dim pathName As String
    On Error Resume Next
    pathName = swDoc.GetPathName
    On Error GoTo 0

    If pathName <> "" Then
        GetDocumentActivationName = Mid$(pathName, InStrRev(pathName, "\") + 1)
    Else
        On Error Resume Next
        GetDocumentActivationName = swDoc.GetTitle
        On Error GoTo 0
    End If

End Function

Function ActivateModelDocument(swDoc As Object) As Boolean

    If swDoc Is Nothing Then Exit Function

    Dim activeDoc As Object
    Set activeDoc = swApp.ActiveDoc
    If ModelDocumentsAreSame(activeDoc, swDoc) Then
        ActivateModelDocument = True
        Exit Function
    End If

    Dim activationName As String
    activationName = GetDocumentActivationName(swDoc)
    If activationName = "" Then Exit Function

    Dim activateErrs As Long
    Dim activatedDoc As Object
    On Error Resume Next
    Set activatedDoc = swApp.ActivateDoc3(activationName, False, 0, activateErrs)
    On Error GoTo 0

    Set activeDoc = swApp.ActiveDoc
    ActivateModelDocument = ModelDocumentsAreSame(activeDoc, swDoc)

End Function

Sub PreserveModelWindow(dictWindowsToPreserve As Object, swDoc As Object)

    If dictWindowsToPreserve Is Nothing Or swDoc Is Nothing Then Exit Sub

    Dim windowKey As String
    windowKey = GetDocumentWindowKey(swDoc)
    If windowKey <> "" Then
        If Not dictWindowsToPreserve.Exists(windowKey) Then _
            dictWindowsToPreserve.Add windowKey, True
    End If

End Sub

Function IsDocumentDirty(swDoc As Object, ByRef stateKnown As Boolean) As Boolean

    stateKnown = False
    If swDoc Is Nothing Then Exit Function

    On Error Resume Next
    Err.Clear
    IsDocumentDirty = CBool(swDoc.GetSaveFlag)
    stateKnown = (Err.Number = 0)
    If Err.Number <> 0 Then Err.Clear
    On Error GoTo 0

End Function

Sub CloseVisibleDocumentsOpenedByMacro(dictInitiallyVisible As Object, _
                                       originalDoc As Object, _
                                       dictWindowsToPreserve As Object)

    If dictInitiallyVisible Is Nothing Then Exit Sub

    Dim snapshotOk As Boolean
    Dim modelDocs As Collection
    Set modelDocs = GetModelWindowDocuments(snapshotOk)
    If Not snapshotOk Or modelDocs Is Nothing Then Exit Sub

    Dim docsToClose As Collection
    Set docsToClose = New Collection

    Dim swDoc As Object
    Dim i As Long
    For i = 1 To modelDocs.Count
        Set swDoc = modelDocs(i)
        If Not ModelDocumentsAreSame(swDoc, originalDoc) Then
            Dim windowKey As String
            windowKey = GetDocumentWindowKey(swDoc)
            If windowKey <> "" And Not dictInitiallyVisible.Exists(windowKey) Then
                Dim dirtyKnown As Boolean
                If IsDocumentDirty(swDoc, dirtyKnown) Or Not dirtyKnown Then
                    Debug.Print "  Leaving dirty or unverifiable macro window open: " & _
                                GetDocumentActivationName(swDoc)
                Else
                    Dim preserveWindow As Boolean
                    preserveWindow = False
                    If Not dictWindowsToPreserve Is Nothing Then
                        preserveWindow = dictWindowsToPreserve.Exists(windowKey)
                    End If

                    If preserveWindow Then
                        Debug.Print "  Leaving reported macro window open: " & _
                                    GetDocumentActivationName(swDoc)
                    Else
                        docsToClose.Add swDoc
                    End If
                End If
            End If
        End If
    Next i

    For i = docsToClose.Count To 1 Step -1
        Set swDoc = docsToClose(i)
        Dim closeName As String
        closeName = GetDocumentActivationName(swDoc)
        If closeName <> "" Then
            On Error Resume Next
            swApp.CloseDoc closeName
            If Err.Number <> 0 Then
                Debug.Print "  Close failed: " & closeName & " error=" & CStr(Err.Number)
                Err.Clear
            End If
            On Error GoTo 0
        End If
    Next i

    ActivateModelDocument originalDoc

End Sub

' Maps an assembly-context entity to the corresponding entity in the owning
' part. GetCorrespondingEntity2 is the supported assembly-to-part direction;
' the older method is retained as a compatibility fallback.
Function GetCorrespondingPartFace(ownerDoc As Object, assemblyFace As Object) As Object

    Set GetCorrespondingPartFace = Nothing
    If ownerDoc Is Nothing Or assemblyFace Is Nothing Then Exit Function

    On Error Resume Next
    Set GetCorrespondingPartFace = ownerDoc.Extension.GetCorrespondingEntity2(assemblyFace)
    If GetCorrespondingPartFace Is Nothing Then
        Err.Clear
        Set GetCorrespondingPartFace = ownerDoc.Extension.GetCorrespondingEntity(assemblyFace)
    End If
    On Error GoTo 0

End Function

Function IsPlanarFace(face As Object) As Boolean

    IsPlanarFace = False
    If face Is Nothing Then Exit Function

    Dim surface As Object
    Set surface = Nothing
    On Error Resume Next
    Set surface = face.GetSurface
    If Not surface Is Nothing Then IsPlanarFace = CBool(surface.IsPlane)
    On Error GoTo 0

End Function

' Displays a real folder picker on every run. The selected path, not a macro
' constant, determines where the DXF is written.
Function BrowseForOutputFolder(ByVal outputFileName As String) As String

    BrowseForOutputFolder = ""

    Dim shellApp As Object
    Dim pickedFolder As Object
    Set shellApp = Nothing
    Set pickedFolder = Nothing

    On Error Resume Next
    Set shellApp = CreateObject("Shell.Application")
    If Not shellApp Is Nothing Then
        Set pickedFolder = shellApp.BrowseForFolder(0, _
            "Select the output folder for " & outputFileName, &H51, 0)
    End If

    If Not pickedFolder Is Nothing Then
        BrowseForOutputFolder = CStr(pickedFolder.Self.Path)
    End If
    On Error GoTo 0

End Function

' Selects the corresponding planar face, orients the whole part Normal To it,
' then exports SOLIDWORKS' *Current annotation view. This keeps projected
' radii, holes, and other visible part geometry that a face-loop export omits.
Function ExportNormalViewToDxf(ownerDoc As Object, face As Object, filePath As String, _
                               ByRef viewRestoreFailed As Boolean) As Boolean

    ExportNormalViewToDxf = False
    viewRestoreFailed = False

    If ownerDoc Is Nothing Or face Is Nothing Then Exit Function
    If Not IsPlanarFace(face) Then Exit Function

    Dim modelView As Object
    Dim originalOrientation As Object
    Dim originalTranslation As Object
    Dim originalScale As Double
    Dim viewStateCaptured As Boolean

    On Error Resume Next
    Err.Clear
    Set modelView = ownerDoc.ActiveView
    If Not modelView Is Nothing Then
        Set originalOrientation = modelView.Orientation3
        Set originalTranslation = modelView.Translation3
        originalScale = modelView.Scale2
        viewStateCaptured = (Err.Number = 0 And _
                             Not originalOrientation Is Nothing And _
                             Not originalTranslation Is Nothing)
    End If
    Err.Clear
    On Error GoTo 0

    If Not viewStateCaptured Then
        Debug.Print "    could not capture the original model view"
        Exit Function
    End If

    ' filePath is a unique same-folder temporary target owned by this run.
    DeleteExistingFile filePath

    ownerDoc.ClearSelection2 True

    Dim selOk As Boolean
    On Error Resume Next
    selOk = face.Select4(False, Nothing)
    If Not selOk Then
        Err.Clear
        selOk = face.Select(False)
    End If
    On Error GoTo 0

    If Not selOk Then
        Debug.Print "    could not select face for Normal To view"
        GoTo ExportCleanup
    End If

    On Error Resume Next
    ownerDoc.ShowNamedView2 "*Normal To", -1
    ownerDoc.ViewZoomtofit2
    On Error GoTo 0

    ownerDoc.ClearSelection2 True

    Dim varAlignment As Variant
    varAlignment = DefaultDwgAlignment()

    Dim dataViews(0) As String
    dataViews(0) = "*Current"

    Dim varViews As Variant
    varViews = dataViews

    Dim ok As Boolean
    On Error Resume Next
    ok = ownerDoc.ExportToDWG2( _
            filePath, ownerDoc.GetPathName, _
            swExportToDWG_ExportAnnotationViews, _
            True, varAlignment, False, False, 0, varViews)
    On Error GoTo 0

    ExportNormalViewToDxf = (ok And Dir(filePath) <> "")

ExportCleanup:
    On Error Resume Next
    Err.Clear
    ownerDoc.ClearSelection2 True
    If viewStateCaptured And Not modelView Is Nothing Then
        Set modelView.Orientation3 = originalOrientation
        Set modelView.Translation3 = originalTranslation
        modelView.Scale2 = originalScale
        ownerDoc.GraphicsRedraw2
    End If
    viewRestoreFailed = (Err.Number <> 0)
    If viewRestoreFailed Then
        ExportNormalViewToDxf = False
        Err.Clear
    End If
    On Error GoTo 0

End Function

' Standard alignment vector for face export. Copied from DXF_v16 so
' both macros produce consistent orientation.
Function DefaultDwgAlignment() As Variant
    Dim data(11) As Double
    data(0) = 0: data(1) = 0: data(2) = 0
    data(3) = 1: data(4) = 0: data(5) = 0
    data(6) = 0: data(7) = 1: data(8) = 0
    data(9) = 0: data(10) = 0: data(11) = 1
    DefaultDwgAlignment = data
End Function

' ============================================================================
' DXF POST-PROCESSING: stamp a registration circle at the bbox centre
' ============================================================================

' Reads the DXF, scans every entity for X/Y coordinates, computes the
' bbox of the geometry, then re-writes the file with a CIRCLE entity
' inserted at the centre right before ENDSEC of the ENTITIES section.
Function StampRegistrationCircle(filePath As String, radius As Double) As Boolean

    StampRegistrationCircle = False

    Dim text As String
    If Not ReadBinaryTextFile(filePath, text) Then Exit Function

    Dim minX As Double, minY As Double, maxX As Double, maxY As Double
    Dim seen As Boolean
    seen = False
    minX = 0: minY = 0: maxX = 0: maxY = 0

    If Not ComputeDxfBoundingBox(text, minX, minY, maxX, maxY, seen) Then Exit Function
    If Not seen Then Exit Function

    Dim cx As Double, cy As Double
    cx = (minX + maxX) / 2#
    cy = (minY + maxY) / 2#

    Dim updated As String
    updated = InsertCircleEntity(text, cx, cy, radius)
    If Len(updated) = 0 Then Exit Function

    StampRegistrationCircle = WriteTextFileExact(filePath, updated)

End Function

Function ValidateStampedDxfFile(filePath As String, expectedRadius As Double) As Boolean

    ValidateStampedDxfFile = False

    Dim text As String
    If Not ReadBinaryTextFile(filePath, text) Then Exit Function
    If Len(text) < 32 Then Exit Function

    Dim minX As Double
    Dim minY As Double
    Dim maxX As Double
    Dim maxY As Double
    Dim seen As Boolean

    If Not ComputeDxfBoundingBox(text, minX, minY, maxX, maxY, seen) Then Exit Function
    If Not seen Then Exit Function
    If Not HasCircleWithRadius(text, expectedRadius) Then Exit Function

    Dim upperText As String
    upperText = UCase$(Replace(Replace(text, vbCrLf, vbLf), vbCr, vbLf))
    If InStr(1, upperText, vbLf & "ENTITIES" & vbLf, vbBinaryCompare) = 0 Then Exit Function
    If InStrRev(upperText, vbLf & "EOF", -1, vbBinaryCompare) = 0 Then Exit Function

    ValidateStampedDxfFile = True

End Function

Function ReadBinaryTextFile(filePath As String, ByRef text As String) As Boolean

    ReadBinaryTextFile = False
    text = ""

    Dim fnum As Long
    Dim opened As Boolean
    On Error GoTo ReadFailed

    fnum = FreeFile
    Open filePath For Binary Access Read As #fnum
    opened = True

    If LOF(fnum) > 0 Then
        text = Space$(LOF(fnum))
        Get #fnum, , text
    End If

    Close #fnum
    opened = False
    ReadBinaryTextFile = (Len(text) > 0)
    Exit Function

ReadFailed:
    On Error Resume Next
    If opened Then Close #fnum
    On Error GoTo 0

End Function

Function WriteTextFileExact(filePath As String, text As String) As Boolean

    WriteTextFileExact = False

    Dim fnum As Long
    Dim opened As Boolean
    On Error GoTo WriteFailed

    fnum = FreeFile
    Open filePath For Output As #fnum
    opened = True
    Print #fnum, text;
    Close #fnum
    opened = False

    WriteTextFileExact = (Dir(filePath) <> "")
    Exit Function

WriteFailed:
    On Error Resume Next
    If opened Then Close #fnum
    On Error GoTo 0

End Function

Function HasCircleWithRadius(text As String, expectedRadius As Double) As Boolean

    Dim lines() As String
    lines = SplitDxfLines(text)
    If (Not Not lines) = 0 Then Exit Function

    Dim inEntities As Boolean
    Dim entityKind As String
    Dim haveRadius As Boolean
    Dim entityRadius As Double
    Dim i As Long

    For i = 0 To UBound(lines) - 1 Step 2
        Dim codeLine As String
        Dim valueLine As String
        codeLine = Trim$(lines(i))
        valueLine = Trim$(lines(i + 1))

        If Not inEntities Then
            If codeLine = "2" And UCase$(valueLine) = "ENTITIES" Then inEntities = True
        ElseIf codeLine = "0" Then
            If entityKind = "CIRCLE" And haveRadius Then
                If Abs(entityRadius - expectedRadius) <= 0.000001 Then
                    HasCircleWithRadius = True
                    Exit Function
                End If
            End If

            If UCase$(valueLine) = "ENDSEC" Then Exit For
            entityKind = UCase$(valueLine)
            haveRadius = False
            entityRadius = 0#
        ElseIf codeLine = "40" And entityKind = "CIRCLE" Then
            entityRadius = ParseDouble(valueLine)
            haveRadius = True
        End If
    Next i

End Function

Function BuildTemporaryDxfPath(finalPath As String) As String

    Dim slashPos As Long
    slashPos = InStrRev(finalPath, "\")
    If slashPos = 0 Then Exit Function

    Dim folder As String
    folder = Left$(finalPath, slashPos)

    Dim baseName As String
    baseName = PathFileNameNoExt(finalPath)
    If Len(baseName) = 0 Then baseName = "cncdxf"

    Dim token As String
    token = Format$(Now, "yyyymmdd_hhnnss") & "_" & _
            CStr(ExcelsisGetCurrentProcessId())

    Dim candidate As String
    Dim suffix As Long
    candidate = folder & "." & baseName & ".excelsis_tmp_" & token & ".dxf"
    Do While Dir(candidate) <> ""
        suffix = suffix + 1
        candidate = folder & "." & baseName & ".excelsis_tmp_" & token & _
                    "_" & CStr(suffix) & ".dxf"
    Loop

    BuildTemporaryDxfPath = candidate

End Function

Function CommitTemporaryDxf(tempPath As String, finalPath As String) As Boolean

    CommitTemporaryDxf = False
    If Len(tempPath) = 0 Or Len(finalPath) = 0 Then Exit Function
    If Dir(tempPath) = "" Then Exit Function

    Dim apiResult As Long
    On Error Resume Next
    Err.Clear

    If Dir(finalPath) <> "" Then
        apiResult = ReplaceFileW(StrPtr(finalPath), StrPtr(tempPath), 0, 0, 0, 0)
    Else
        apiResult = MoveFileExW(StrPtr(tempPath), StrPtr(finalPath), MOVEFILE_WRITE_THROUGH)
    End If

    If Err.Number <> 0 Then
        Debug.Print "  DXF commit error " & Err.Number & ": " & Err.Description
        Err.Clear
        apiResult = 0
    End If
    On Error GoTo 0

    CommitTemporaryDxf = (apiResult <> 0 And Dir(finalPath) <> "")

End Function

' Walks the DXF text line-by-line and harvests every X/Y coordinate
' from each entity. Computes an EXACT bounding box - the previous
' version approximated arcs as full circles (centre +/- radius), which
' biased the centroid by up to half the arc's chord depth. This version
' uses each ARC's start/end angles to find the true extents.
'
' DXF group codes used here:
'   10/20/30 - primary point X/Y/Z (LINE start, ARC/CIRCLE centre,
'              LWPOLYLINE vertex, ELLIPSE centre)
'   11/21    - secondary point X/Y (LINE end, ELLIPSE major-axis endpoint)
'   12/22    - tertiary X/Y (3DFACE third corner)
'   13/23    - quaternary X/Y (3DFACE fourth corner)
'   40       - radius for CIRCLE/ARC; flatness for ELLIPSE
'   50       - start angle for ARC (degrees, CCW from +X axis)
'   51       - end angle for ARC (degrees, CCW from +X axis)
Function ComputeDxfBoundingBox(text As String, ByRef minX As Double, ByRef minY As Double, _
                                ByRef maxX As Double, ByRef maxY As Double, ByRef seen As Boolean) As Boolean

    ComputeDxfBoundingBox = False

    Dim lines() As String
    lines = SplitDxfLines(text)
    If (Not Not lines) = 0 Then Exit Function

    Dim n As Long
    n = UBound(lines)

    ' Per-entity state. We don't flush a point until we have both X (code 10)
    ' and Y (code 20). For ARC/CIRCLE we accumulate the centre+radius (+arc
    ' angles) then compute the real bbox on the next 0 (new entity).
    Dim entityKind As String
    entityKind = ""

    Dim inEntities As Boolean
    Dim foundEntities As Boolean
    inEntities = False
    foundEntities = False

    Dim cx As Double, cy As Double, radius As Double
    Dim startAng As Double, endAng As Double
    Dim haveCentre As Boolean, haveRadius As Boolean
    Dim haveStartAng As Boolean, haveEndAng As Boolean
    haveCentre = False: haveRadius = False
    haveStartAng = False: haveEndAng = False

    Dim pendingX As Double      ' last X seen (for 10/11/12/13 codes)
    Dim pendingXKind As Long    ' 10, 11, 12, 13 - so we know which Y pairs

    Dim i As Long
    i = 0
    Do While i < n - 1

        Dim codeLine As String
        Dim valLine As String
        codeLine = Trim$(lines(i))
        valLine = Trim$(lines(i + 1))

        Dim code As Long
        On Error Resume Next
        code = CLng(codeLine)
        If Err.Number <> 0 Then
            Err.Clear
            i = i + 1
            On Error GoTo 0
            GoTo NextIter
        End If
        On Error GoTo 0

        ' Geometry outside the ENTITIES section is metadata or a block
        ' definition, not part of the final exported contour. In particular,
        ' HEADER extents and block insertion data must not move the marker.
        If Not inEntities Then
            If code = 2 And UCase$(valLine) = "ENTITIES" Then
                inEntities = True
                foundEntities = True
            End If
            i = i + 2
            GoTo NextIter
        End If

        If code = 0 And UCase$(valLine) = "ENDSEC" Then
            FlushEntity entityKind, haveCentre, haveRadius, _
                        haveStartAng, haveEndAng, cx, cy, radius, _
                        startAng, endAng, minX, minY, maxX, maxY, seen
            ComputeDxfBoundingBox = (foundEntities And seen)
            Exit Function
        End If

        Select Case code
            Case 0
                FlushEntity entityKind, haveCentre, haveRadius, _
                            haveStartAng, haveEndAng, cx, cy, radius, _
                            startAng, endAng, minX, minY, maxX, maxY, seen
                entityKind = UCase$(valLine)

            Case 10
                pendingX = ParseDouble(valLine)
                pendingXKind = 10

            Case 20
                Dim y20 As Double
                y20 = ParseDouble(valLine)
                If pendingXKind = 10 Then
                    ' For ARC/CIRCLE/ELLIPSE this is the centre - stash
                    ' it for the entity-level flush instead of feeding
                    ' the bbox directly.
                    If entityKind = "ARC" Or entityKind = "CIRCLE" Or entityKind = "ELLIPSE" Then
                        cx = pendingX
                        cy = y20
                        haveCentre = True
                    Else
                        AccumulatePoint pendingX, y20, minX, minY, maxX, maxY, seen
                    End If
                End If

            Case 11
                pendingX = ParseDouble(valLine)
                pendingXKind = 11

            Case 21
                Dim y21 As Double
                y21 = ParseDouble(valLine)
                If pendingXKind = 11 Then
                    AccumulatePoint pendingX, y21, minX, minY, maxX, maxY, seen
                End If

            Case 12
                pendingX = ParseDouble(valLine)
                pendingXKind = 12

            Case 22
                Dim y22 As Double
                y22 = ParseDouble(valLine)
                If pendingXKind = 12 Then
                    AccumulatePoint pendingX, y22, minX, minY, maxX, maxY, seen
                End If

            Case 13
                pendingX = ParseDouble(valLine)
                pendingXKind = 13

            Case 23
                Dim y23 As Double
                y23 = ParseDouble(valLine)
                If pendingXKind = 13 Then
                    AccumulatePoint pendingX, y23, minX, minY, maxX, maxY, seen
                End If

            Case 40
                If entityKind = "ARC" Or entityKind = "CIRCLE" Then
                    radius = ParseDouble(valLine)
                    haveRadius = True
                End If

            Case 50
                If entityKind = "ARC" Then
                    startAng = ParseDouble(valLine)
                    haveStartAng = True
                End If

            Case 51
                If entityKind = "ARC" Then
                    endAng = ParseDouble(valLine)
                    haveEndAng = True
                End If
        End Select

        i = i + 2
NextIter:
    Loop

    ' Don't forget the trailing entity.
    FlushEntity entityKind, haveCentre, haveRadius, _
                haveStartAng, haveEndAng, cx, cy, radius, _
                startAng, endAng, minX, minY, maxX, maxY, seen

    ComputeDxfBoundingBox = (foundEntities And seen)

End Function

Sub AccumulatePoint(x As Double, y As Double, ByRef minX As Double, ByRef minY As Double, _
                    ByRef maxX As Double, ByRef maxY As Double, ByRef seen As Boolean)
    If Not seen Then
        minX = x: maxX = x
        minY = y: maxY = y
        seen = True
    Else
        If x < minX Then minX = x
        If x > maxX Then maxX = x
        If y < minY Then minY = y
        If y > maxY Then maxY = y
    End If
End Sub

' Flushes a finished entity into the global bbox and resets per-entity
' state. For CIRCLE: full bbox = centre +/- radius. For ARC: the actual
' angular extents (handles partial arcs precisely - the previous version
' over-estimated by treating arcs as full circles).
Sub FlushEntity(ByRef kind As String, _
                ByRef haveCentre As Boolean, ByRef haveRadius As Boolean, _
                ByRef haveStartAng As Boolean, ByRef haveEndAng As Boolean, _
                cx As Double, cy As Double, radius As Double, _
                startAng As Double, endAng As Double, _
                ByRef minX As Double, ByRef minY As Double, _
                ByRef maxX As Double, ByRef maxY As Double, _
                ByRef seen As Boolean)

    If haveCentre And haveRadius And radius > 0 Then
        If kind = "CIRCLE" Then
            AccumulatePoint cx - radius, cy - radius, minX, minY, maxX, maxY, seen
            AccumulatePoint cx + radius, cy + radius, minX, minY, maxX, maxY, seen
        ElseIf kind = "ARC" And haveStartAng And haveEndAng Then
            AccumulateArcExtents cx, cy, radius, startAng, endAng, _
                                  minX, minY, maxX, maxY, seen
        ElseIf kind = "ARC" Then
            ' Missing angles - fall back to full circle bbox.
            AccumulatePoint cx - radius, cy - radius, minX, minY, maxX, maxY, seen
            AccumulatePoint cx + radius, cy + radius, minX, minY, maxX, maxY, seen
        ElseIf kind = "ELLIPSE" Then
            ' Approximate ellipse as the bounding circle of its major
            ' axis. Acceptable for the registration mark; we could
            ' compute the true bbox using code 11/21 (major axis end)
            ' and the ratio (code 40) but DXF ELLIPSE entities are rare
            ' in CNC output.
            AccumulatePoint cx - radius, cy - radius, minX, minY, maxX, maxY, seen
            AccumulatePoint cx + radius, cy + radius, minX, minY, maxX, maxY, seen
        End If
    End If

    haveCentre = False: haveRadius = False
    haveStartAng = False: haveEndAng = False
    cx = 0: cy = 0: radius = 0
    startAng = 0: endAng = 0
End Sub

' Computes the precise X/Y extents of an arc segment.
' DXF ARC angles are degrees, CCW from +X. If endAng < startAng, the arc
' wraps through 0 (we add 360 to endAng so the sweep is monotonic).
' The arc reaches the extreme X at angle 0 (right) or 180 (left), and
' extreme Y at 90 (top) or 270 (bottom). For each such cardinal angle
' (and its 360-shifted copy) that falls inside the sweep, we add the
' corresponding (centre +/- radius) point.
Sub AccumulateArcExtents(cx As Double, cy As Double, r As Double, _
                          startAng As Double, endAng As Double, _
                          ByRef minX As Double, ByRef minY As Double, _
                          ByRef maxX As Double, ByRef maxY As Double, _
                          ByRef seen As Boolean)

    Dim sAng As Double, eAng As Double
    sAng = startAng
    eAng = endAng
    If eAng < sAng Then eAng = eAng + 360#

    Const PI As Double = 3.14159265358979

    ' Both endpoints are always extrema candidates.
    AccumulatePoint cx + r * Cos(sAng * PI / 180#), cy + r * Sin(sAng * PI / 180#), _
                    minX, minY, maxX, maxY, seen
    AccumulatePoint cx + r * Cos(eAng * PI / 180#), cy + r * Sin(eAng * PI / 180#), _
                    minX, minY, maxX, maxY, seen

    Dim cardinals(3) As Double
    cardinals(0) = 0#: cardinals(1) = 90#: cardinals(2) = 180#: cardinals(3) = 270#

    Dim i As Long, offset As Double, ang As Double
    For i = 0 To 3
        For offset = 0# To 720# Step 360#
            ang = cardinals(i) + offset
            If ang >= sAng And ang <= eAng Then
                AccumulatePoint cx + r * Cos(ang * PI / 180#), _
                                cy + r * Sin(ang * PI / 180#), _
                                minX, minY, maxX, maxY, seen
            End If
        Next offset
    Next i

End Sub

Function SplitDxfLines(text As String) As String()
    Dim normalised As String
    normalised = Replace(text, vbCrLf, vbLf)
    normalised = Replace(normalised, vbCr, vbLf)
    SplitDxfLines = Split(normalised, vbLf)
End Function

Function ParseDouble(s As String) As Double
    Dim t As String
    t = Replace(s, ",", ".")
    Dim out As Double
    On Error Resume Next
    out = CDbl(t)
    If Err.Number <> 0 Then
        Err.Clear
        out = 0
    End If
    On Error GoTo 0
    ParseDouble = out
End Function

' Inserts a CIRCLE entity immediately before the code/value pair
' "0 / ENDSEC" that closes the ENTITIES section. DXF is parsed as pairs;
' never search backwards for a bare character because coordinate values such
' as "0.0" can otherwise be mistaken for the group-code line.
Function InsertCircleEntity(text As String, cx As Double, cy As Double, radius As Double) As String

    Dim lines() As String
    lines = SplitDxfLines(text)
    If (Not Not lines) = 0 Then
        InsertCircleEntity = ""
        Exit Function
    End If

    Dim inEntities As Boolean
    Dim insertAt As Long
    inEntities = False
    insertAt = -1

    Dim i As Long
    For i = 0 To UBound(lines) - 1 Step 2
        Dim codeLine As String
        Dim valueLine As String
        codeLine = Trim$(lines(i))
        valueLine = UCase$(Trim$(lines(i + 1)))

        If Not inEntities Then
            If codeLine = "2" And valueLine = "ENTITIES" Then inEntities = True
        ElseIf codeLine = "0" And valueLine = "ENDSEC" Then
            insertAt = i
            Exit For
        End If
    Next i

    If insertAt < 0 Then
        InsertCircleEntity = ""
        Exit Function
    End If

    Dim newline As String
    If InStr(1, text, vbCrLf, vbBinaryCompare) > 0 Then
        newline = vbCrLf
    Else
        newline = vbLf
    End If

    Dim insertion As String
    insertion = BuildCircleEntityText(cx, cy, radius)
    If newline = vbLf Then insertion = Replace(insertion, vbCrLf, vbLf)

    Dim rebuilt As String
    rebuilt = ""
    For i = 0 To UBound(lines)
        If i = insertAt Then rebuilt = rebuilt & insertion
        rebuilt = rebuilt & lines(i)
        If i < UBound(lines) Then rebuilt = rebuilt & newline
    Next i

    InsertCircleEntity = rebuilt

End Function

Function BuildCircleEntityText(cx As Double, cy As Double, radius As Double) As String
    Dim s As String
    s = "  0" & vbCrLf
    s = s & "CIRCLE" & vbCrLf
    s = s & "  8" & vbCrLf
    s = s & "0" & vbCrLf                         ' layer 0
    s = s & " 10" & vbCrLf
    s = s & FormatCoord(cx) & vbCrLf
    s = s & " 20" & vbCrLf
    s = s & FormatCoord(cy) & vbCrLf
    s = s & " 30" & vbCrLf
    s = s & "0.0" & vbCrLf
    s = s & " 40" & vbCrLf
    s = s & FormatCoord(radius) & vbCrLf
    BuildCircleEntityText = s
End Function

Function FormatCoord(v As Double) As String
    ' Plain decimal with dot - CAD readers don't accept locale commas.
    Dim s As String
    s = CStr(v)
    FormatCoord = Replace(s, ",", ".")
End Function

' ============================================================================
' PATH / PROJECT HELPERS
' ============================================================================

Function EnsureTrailingBackslash(ByVal folderPath As String) As String
    EnsureTrailingBackslash = folderPath
    If Len(folderPath) = 0 Then Exit Function
    If Right$(folderPath, 1) <> "\" Then EnsureTrailingBackslash = folderPath & "\"
End Function

' Prefixes are optional. First try configured prefixes, then use the first
' child folder below a configured project-root folder.
Function DeriveProjectFolderName(ByVal docPath As String) As String

    DeriveProjectFolderName = ""

    Dim parts() As String
    parts = Split(docPath, "\")

    Dim prefixes() As String
    prefixes = Split(ConfiguredProjectPrefixes(), ";")

    Dim i As Long, j As Long, prefix As String
    For i = LBound(parts) To UBound(parts) - 1
        For j = LBound(prefixes) To UBound(prefixes)
            prefix = Trim$(prefixes(j))
            If Len(prefix) > 0 And Len(parts(i)) > Len(prefix) Then
                If UCase$(Left$(parts(i), Len(prefix) + 1)) = UCase$(prefix & "-") Then
                    DeriveProjectFolderName = parts(i)
                    Exit Function
                End If
            End If
        Next j
    Next i

    Dim rootNames() As String
    rootNames = Split(ConfiguredProjectRootNames(), ";")
    Dim rootName As String
    For i = LBound(parts) To UBound(parts) - 2
        For j = LBound(rootNames) To UBound(rootNames)
            rootName = Trim$(rootNames(j))
            If Len(rootName) > 0 Then
                If StrComp(parts(i), rootName, vbTextCompare) = 0 Then
                    If Len(parts(i + 1)) > 0 Then
                        DeriveProjectFolderName = parts(i + 1)
                        Exit Function
                    End If
                End If
            End If
        Next j
    Next i

End Function

Function BuildDxfPath(ByVal outFolder As String, ByVal partPath As String, _
                      ByVal cfgName As String, ByVal seq As Long) As String

    ' Plain "<partname>.dxf". Rule: user selects one face per part, so
    ' the path is uniquely determined by the part file. The selection
    ' loop dedupes by partPath before we reach here, so two instances
    ' of the same part don't get processed twice.
    BuildDxfPath = outFolder & PathFileNameNoExt(partPath) & ".dxf"

End Function

Function SanitiseForFilename(ByVal s As String) As String
    Dim t As String
    t = s
    Dim invalid As String
    invalid = "\/:*?""<>|"
    Dim i As Long
    For i = 1 To Len(invalid)
        t = Replace(t, Mid$(invalid, i, 1), "_")
    Next i
    SanitiseForFilename = Trim$(t)
End Function

Function PathFileName(ByVal p As String) As String
    Dim n As Long
    n = InStrRev(p, "\")
    If n = 0 Then
        PathFileName = p
    Else
        PathFileName = Mid$(p, n + 1)
    End If
End Function

Function PathFileNameNoExt(ByVal p As String) As String
    Dim n As String
    n = PathFileName(p)
    Dim dot As Long
    dot = InStrRev(n, ".")
    If dot > 0 Then
        PathFileNameNoExt = Left$(n, dot - 1)
    Else
        PathFileNameNoExt = n
    End If
End Function

Function EnsureFolder(ByVal folderPath As String) As Boolean

    EnsureFolder = False

    Dim trimmed As String
    trimmed = folderPath
    If Right$(trimmed, 1) = "\" Then trimmed = Left$(trimmed, Len(trimmed) - 1)

    If Len(trimmed) = 0 Then Exit Function
    If Dir(trimmed, vbDirectory) <> "" Then
        EnsureFolder = True
        Exit Function
    End If

    Dim parent As String
    Dim slash As Long
    slash = InStrRev(trimmed, "\")
    If slash > 0 Then
        parent = Left$(trimmed, slash - 1)
        ' A drive root ends with ':'; treat it as existing.
        If Right$(parent, 1) <> ":" Then
            If Not EnsureFolder(parent) Then Exit Function
        End If
    End If

    On Error Resume Next
    MkDir trimmed
    If Err.Number <> 0 Then
        Err.Clear
        On Error GoTo 0
        Exit Function
    End If
    On Error GoTo 0

    EnsureFolder = (Dir(trimmed, vbDirectory) <> "")

End Function

Sub DeleteExistingFile(ByVal filePath As String)
    If Dir(filePath) <> "" Then
        On Error Resume Next
        Kill filePath
        On Error GoTo 0
    End If
End Sub

Function GetActiveConfigName(ByVal model As Object) As String
    Dim cfg As Object
    Set cfg = Nothing
    On Error Resume Next
    Set cfg = model.GetActiveConfiguration
    On Error GoTo 0
    If cfg Is Nothing Then
        GetActiveConfigName = ""
    Else
        GetActiveConfigName = cfg.Name
    End If
End Function
